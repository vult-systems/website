---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import { getResourcesPageSEO } from '@/config/seo';
import mayaLogoImg from '@/assets/logos/software-autodesk-maya-logo-01.png';
import pythonLogoImg from '@/assets/logos/programming-python-logo.png';
import substancePainterLogoImg from '@/assets/logos/software-substance-painter-logo-01.webp';
import batLogoImg from '@/assets/logos/programming-bat-logo.png';
import zbrushLogoImg from '@/assets/logos/software-maxon-zbrush-logo-01.png';
import zbrushBrushMaskDepth from '@/assets/learn/resources/zbrush/zbrush-brush-mask-depth.png';
import zbrushBrushSoftForms from '@/assets/learn/resources/zbrush/zbrush-brush-softforms.png';
import zbrushCustomMenus from '@/assets/learn/resources/zbrush/zbrush-custom-menus.png';
import zbrushMatClayPurple from '@/assets/learn/resources/zbrush/zbrush-mat-clay-purple.png';
import zbrushMatCloth from '@/assets/learn/resources/zbrush/zbrush-mat-cloth.png';
import zbrushMatMetal from '@/assets/learn/resources/zbrush/zbrush-mat-metal.png';
import zbrushMatSkin from '@/assets/learn/resources/zbrush/zbrush-mat-skin.png';
import spSmartMatColorVar01 from '@/assets/learn/resources/substance-painter/substancepainter-smartmat-colorvar-01.png';
import mayaScriptPurgeRedshift from '@/assets/learn/resources/maya/maya-script-purge-redshift-nodes.png';
import mayaScriptCreasedEdges from '@/assets/learn/resources/maya/maya-script-selectcreatededges.png';
import mayaScriptLocatorsToJoints from '@/assets/learn/resources/maya/maya-script-locators-to-joints.png';
import mountSDriveThumb from '@/assets/learn/resources/pipeline/mount-s-drive.png';

const seo = getResourcesPageSEO();

// Resources
interface ResourceItem {
	name: string;
	description?: string;
	download?: string;
	previewHtml?: string;
	previewLang?: string;
	logos?: ImageMetadata[];
	thumbnail?: ImageMetadata;
	howToUse?: string;
	hidden?: boolean;
}

interface ResourceSubsection {
	label: string;
	items: ResourceItem[];
}

const resources: { category: string; items?: ResourceItem[]; subsections?: ResourceSubsection[] }[] = [
	{
		category: 'Maya',
		subsections: [
			{
				label: 'Scripts',
				items: [
			{ name: 'Select Creased Edges', description: 'Selects all creased edges on a polygon object. Useful for assets exported from ZBrush with creased edges for use in Maya\'s Crease Set Editor.', howToUse: '1. Select a polygon object in the viewport.\n2. Open the Script Editor (Python tab).\n3. Paste the script and press Ctrl+Enter.\n4. Maya will switch to edge selection mode and highlight all creased edges.\n5. Open Windows > Modeling Editors > Crease Set Editor to manage the selection.', download: '/downloads/maya-select-creased-edges.py', previewLang: 'python', logos: [mayaLogoImg, pythonLogoImg], thumbnail: mayaScriptCreasedEdges, previewHtml: `<span class="hl-keyword">import</span> maya.<span class="hl-builtin">cmds</span> <span class="hl-keyword">as</span> <span class="hl-builtin">cmds</span>

<span class="hl-keyword">def</span> <span class="hl-decorator">select_creased_edges</span>():
    selection = <span class="hl-builtin">cmds</span>.ls(selection=<span class="hl-keyword">True</span>, long=<span class="hl-keyword">True</span>)
    <span class="hl-keyword">if not</span> selection:
        <span class="hl-builtin">cmds</span>.warning(<span class="hl-string">"Please select a polygon object."</span>)
        <span class="hl-keyword">return</span>

    obj = selection[<span class="hl-number">0</span>]
    edge_count = <span class="hl-builtin">cmds</span>.polyEvaluate(obj, edge=<span class="hl-keyword">True</span>)
    creased_edges = []

    <span class="hl-keyword">for</span> i <span class="hl-keyword">in</span> <span class="hl-builtin">range</span>(edge_count):
        edge = <span class="hl-string">f"{obj}.e[{i}]"</span>
        crease = <span class="hl-builtin">cmds</span>.polyCrease(edge, query=<span class="hl-keyword">True</span>, value=<span class="hl-keyword">True</span>)
        <span class="hl-keyword">if</span> crease <span class="hl-keyword">and</span> crease[<span class="hl-number">0</span>] > <span class="hl-number">0.0</span>:
            creased_edges.append(edge)

    <span class="hl-keyword">if</span> creased_edges:
        <span class="hl-builtin">cmds</span>.selectType(edge=<span class="hl-keyword">True</span>)
        <span class="hl-builtin">cmds</span>.select(creased_edges, replace=<span class="hl-keyword">True</span>)
        <span class="hl-builtin">print</span>(<span class="hl-string">f"Selected {len(creased_edges)} creased edge(s)."</span>)
    <span class="hl-keyword">else</span>:
        <span class="hl-builtin">cmds</span>.warning(<span class="hl-string">"No creased edges found on the selected object."</span>)

<span class="hl-decorator">select_creased_edges</span>()` },
			{ name: 'Joints to Locators', hidden: true, howToUse: '1. Select one or more joints in the viewport.\n2. Open the Script Editor (Windows > General Editors > Script Editor).\n3. Set the tab to Python.\n4. Paste the script and press Ctrl+Enter to run.\n5. A locator named [joint]_locator will be created at each joint\'s position and orientation.', download: '/downloads/maya-joints-to-locators.py', previewLang: 'python', logos: [mayaLogoImg, pythonLogoImg], thumbnail: mayaScriptLocatorsToJoints, previewHtml: `<span class="hl-keyword">import</span> maya.<span class="hl-builtin">cmds</span> <span class="hl-keyword">as</span> <span class="hl-builtin">cmds</span>

<span class="hl-keyword">def</span> <span class="hl-decorator">joints_to_locators</span>():
    <span class="hl-comment"># Get a list of all selected joints</span>
    selected_joints = <span class="hl-builtin">cmds</span>.ls(selection=<span class="hl-keyword">True</span>, <span class="hl-builtin">type</span>=<span class="hl-string">'joint'</span>)

    <span class="hl-keyword">if not</span> selected_joints:
        <span class="hl-builtin">print</span>(<span class="hl-string">"Please select at least one joint."</span>)
        <span class="hl-keyword">return</span>

    <span class="hl-comment"># Loop through each selected joint</span>
    <span class="hl-keyword">for</span> joint <span class="hl-keyword">in</span> selected_joints:
        <span class="hl-comment"># Create a locator</span>
        locator_name = joint + <span class="hl-string">"_locator"</span>
        locator = <span class="hl-builtin">cmds</span>.spaceLocator(name=locator_name)[<span class="hl-number">0</span>]

        <span class="hl-comment"># Match the locator's position and orientation to the joint</span>
        <span class="hl-builtin">cmds</span>.delete(<span class="hl-builtin">cmds</span>.pointConstraint(joint, locator))
        <span class="hl-builtin">cmds</span>.delete(<span class="hl-builtin">cmds</span>.orientConstraint(joint, locator))

        <span class="hl-builtin">print</span>(<span class="hl-string">f"Locator created for {joint}: {locator_name}"</span>)

<span class="hl-decorator">joints_to_locators</span>()` },
			{ name: 'Purge Redshift Nodes', description: 'Removes the Redshift unsupported nodes popup and error when opening scenes in Maya without Redshift installed.', howToUse: '1. Open Maya and load your scene.\n2. Open the Script Editor (Windows > General Editors > Script Editor).\n3. Set the tab to Python.\n4. Paste the script and press Ctrl+Enter to run.\n5. A confirmation will print in the output window listing deleted nodes.', download: '/downloads/maya-purge-redshift-nodes.py', previewLang: 'python', logos: [mayaLogoImg, pythonLogoImg], thumbnail: mayaScriptPurgeRedshift, previewHtml: `<span class="hl-keyword">import</span> maya.<span class="hl-builtin">cmds</span> <span class="hl-keyword">as</span> <span class="hl-builtin">cmds</span>

<span class="hl-keyword">def</span> <span class="hl-decorator">purge_redshift_from_loaded_scene</span>():
    deleted = []

    <span class="hl-comment"># Get ALL nodes by name pattern (not type-based)</span>
    all_nodes = <span class="hl-builtin">cmds</span>.ls(long=<span class="hl-keyword">True</span>) <span class="hl-keyword">or</span> []

    <span class="hl-keyword">for</span> n <span class="hl-keyword">in</span> all_nodes:
        <span class="hl-keyword">try</span>:
            <span class="hl-keyword">if</span> <span class="hl-string">"redshift"</span> <span class="hl-keyword">in</span> n.lower():
                <span class="hl-builtin">cmds</span>.lockNode(n, lock=<span class="hl-keyword">False</span>)
                <span class="hl-builtin">cmds</span>.delete(n)
                deleted.append(n)
        <span class="hl-keyword">except</span>:
            <span class="hl-keyword">pass</span>

    <span class="hl-comment"># Also remove unknown nodes (fallback safety)</span>
    unknown = <span class="hl-builtin">cmds</span>.ls(<span class="hl-builtin">type</span>=<span class="hl-string">"unknown"</span>) <span class="hl-keyword">or</span> []
    <span class="hl-keyword">for</span> n <span class="hl-keyword">in</span> unknown:
        <span class="hl-keyword">try</span>:
            t = <span class="hl-builtin">cmds</span>.unknownNode(n, q=<span class="hl-keyword">True</span>, typeName=<span class="hl-keyword">True</span>)
            <span class="hl-keyword">if</span> t <span class="hl-keyword">and</span> <span class="hl-string">"redshift"</span> <span class="hl-keyword">in</span> t.lower():
                <span class="hl-builtin">cmds</span>.delete(n)
                deleted.append(n)
        <span class="hl-keyword">except</span>:
            <span class="hl-keyword">pass</span>

    <span class="hl-builtin">print</span>(<span class="hl-string">"\\n=== PURGE COMPLETE ==="</span>)
    <span class="hl-builtin">print</span>(<span class="hl-string">"Deleted:"</span>, <span class="hl-builtin">len</span>(deleted))
    <span class="hl-keyword">for</span> d <span class="hl-keyword">in</span> deleted:
        <span class="hl-builtin">print</span>(<span class="hl-string">" -"</span>, d)

<span class="hl-decorator">purge_redshift_from_loaded_scene</span>()` },
				],
			},
		],
	},
	{
		category: 'ZBrush',
		subsections: [
			{
				label: 'UI Configs',
				items: [
					{ name: 'ZBrush UI 2026', description: 'Custom ZBrush interface and menu for 2026.', howToUse: '1. Download the .cfg file.\n2. In ZBrush, go to Preferences > Config > Load UI.\n3. Navigate to and select the downloaded .cfg file.\n4. Save the config via Preferences > Config > Save UI so it persists on next launch.', logos: [zbrushLogoImg], thumbnail: zbrushCustomMenus, download: '/downloads/uiw3d-zbrush-ui-2026.cfg' },
				],
			},
			{
				label: 'Brushes',
				items: [
					{ name: 'Mask Depth', description: 'Custom mask depth brush for ZBrush. Useful for masking out 90 degree planes.', howToUse: '1. Download the .ZBP file.\n2. In ZBrush, open the Brush palette and click Import.\n3. Select the downloaded .ZBP file.\n4. The brush will appear in your brush inventory and can be saved to your startup brushes.', logos: [zbrushLogoImg], thumbnail: zbrushBrushMaskDepth, download: '/downloads/uiw3d-mask-depth.zbp' },
					{ name: 'Soft Forms', description: 'Pablanders gio soft forms brush.', howToUse: '1. Download the .ZBP file.\n2. In ZBrush, open the Brush palette and click Import.\n3. Select the downloaded .ZBP file.\n4. The brush will appear in your brush inventory and can be saved to your startup brushes.\nSource: <a href="https://www.pablander.academy/newsletter/the-gio-brush" target="_blank" rel="noopener noreferrer" class="underline">Pablander Academy — The Gio Brush</a>', logos: [zbrushLogoImg], thumbnail: zbrushBrushSoftForms, download: '/downloads/uiw3d-soft-forms.zbp' },
				],
			},
			{
				label: 'Materials',
				items: [
					{ name: 'Skin', description: 'Custom skin material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. The material will appear in your material inventory. Use CopyMat/PasteMat to apply it to a subtool.', logos: [zbrushLogoImg], thumbnail: zbrushMatSkin, download: '/downloads/uiw3d-skin.zmt' },
					{ name: 'Clay Purple', description: 'Custom clay purple material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. Apply via CopyMat/PasteMat or set as active material.', logos: [zbrushLogoImg], thumbnail: zbrushMatClayPurple, download: '/downloads/uiw3d-clay-purple.zmt' },
					{ name: 'Cloth', description: 'Custom cloth material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. Apply via CopyMat/PasteMat or set as active material.', logos: [zbrushLogoImg], thumbnail: zbrushMatCloth, download: '/downloads/uiw3d-cloth.zmt' },
					{ name: 'Metal', description: 'Custom metal material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. Apply via CopyMat/PasteMat or set as active material.', logos: [zbrushLogoImg], thumbnail: zbrushMatMetal, download: '/downloads/uiw3d-metal.ZMT' },
				],
			},
		],
	},
	{
		category: 'Substance Painter',
		subsections: [
			{
				label: 'Smart Materials',
				items: [
					{ name: 'Color Variation 01', description: 'Smart material for procedural color variation.', howToUse: '1. Download the .spsm file.\n2. In Substance 3D Painter, open the Assets panel.\n3. Click Import Resource and select the .spsm file, targeting Project or Shelf.\n4. Drag the smart material from the Assets panel onto a layer to apply it.', logos: [substancePainterLogoImg], thumbnail: spSmartMatColorVar01, download: '/downloads/uiw3d-color-var-01.spsm' },
				],
			},
		],
	},
	{
		category: 'Pipeline',
		subsections: [
			{
				label: 'Scripts',
				items: [
					{ name: 'Mount S: Drive', description: 'Maps S: as a virtual drive pointing to the script\'s directory. Ensures a universal project path across all machines.', howToUse: '1. Download the .bat file and place it in the root of your project folder.\n2. Double-click the .bat file to run it.\n3. S: will now point to that folder on your machine.\n4. All project paths using S:\\ will resolve correctly regardless of where the project is stored.\n5. Re-run the .bat any time you move the project or on a new machine.', download: '/downloads/mount-s-drive.bat', previewLang: 'batch', logos: [batLogoImg], thumbnail: mountSDriveThumb, previewHtml: `<span class="hl-keyword">@echo off</span>
<span class="hl-keyword">set</span> <span class="hl-string">"TARGET_DIR=%~dp0"</span>
<span class="hl-keyword">set</span> <span class="hl-string">"TARGET_DIR=%TARGET_DIR:~0,-1%"</span>
<span class="hl-builtin">subst</span> S: /d
<span class="hl-builtin">subst</span> S: <span class="hl-string">"%TARGET_DIR%"</span>
<span class="hl-builtin">echo</span> S: drive now mapped to: %TARGET_DIR%
<span class="hl-builtin">pause</span>` },
				],
			},
		],
	},
];

const resourceId = (category: string) => category.toLowerCase().replace(/[\s&]+/g, '-');

// Build a flat lookup of howToUse by item name for inline JS injection
const resourceHowToMap: Record<string, string[]> = {};
for (const group of resources) {
	const allItems = group.subsections
		? group.subsections.flatMap(s => s.items)
		: (group.items ?? []);
	for (const item of allItems) {
		if (item.howToUse) {
			resourceHowToMap[item.name] = item.howToUse.split('\n').map(s => s.trim()).filter(Boolean);
		}
	}
}
---


<BaseLayout 
title={seo.title} 
description={seo.description}
keywords={seo.keywords}
>
<Header />
<PageMain class="text-foreground">
<!-- Page Header with Background -->
<div class="relative w-full py-8 sm:py-10">
<div class="absolute inset-0 -z-10 overflow-hidden">
<Image
src={heroBg}
alt=""
class="w-full h-full object-cover object-center !opacity-60 dark:!opacity-[0.12]"
loading="eager"
widths={[800, 1200, 1920]}
/>
<div class="absolute inset-0 bg-white/[0.82] dark:bg-black/[0.62]"></div>
</div>
<PageContainer>
<Heading level={1} size="4xl" class="mb-4">
Resources
</Heading>
<Text size="lg" variant="secondary" class="mb-4">
This page contains a collection of downloadable tools and resources that I use throughout my own workflow and in the classroom. Here you'll find Maya scripts, ZBrush brushes and materials, UI configurations, pipeline utilities, batch files, and other practical resources designed to streamline production and improve day-to-day workflows.
</Text>
</PageContainer>
</div>

<div class="relative z-10 w-full py-8 sm:py-12">
<PageContainer>

<div class="mb-8">
	<label for="resource-search" class="sr-only">Search resources</label>
	<div class="flex items-center gap-3 rounded-md border border-border bg-card px-4 py-3 focus-within:border-accent/60 focus-within:ring-1 focus-within:ring-accent/30 transition-colors">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-foreground-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="11" cy="11" r="8" />
			<path d="m21 21-4.35-4.35" />
		</svg>
		<input
			id="resource-search"
			type="search"
			placeholder="Search resources..."
			class="w-full bg-transparent text-sm text-foreground placeholder:text-foreground-muted outline-none"
			style="font-family: 'Besley', serif !important;"
			autocomplete="off"
		/>
	</div>
</div>

<!-- Content with Sidebar -->
<div class="flex gap-12 lg:gap-16 relative">

<!-- Sidebar -->
<aside class="hidden lg:block w-72 shrink-0">
<div class="sticky top-32">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
Categories
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{resources.map((group) => (
<a
href={`#${resourceId(group.category)}`}
class="learn-nav-link block leading-snug group"
data-slug={resourceId(group.category)}
>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{group.category}</span>
</a>
))}
</nav>
</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">
{resources.map((group, index) => (
<article id={resourceId(group.category)} class="learn-entry scroll-mt-32">
{index > 0 && (
<div class="border-t-2 border-foreground-secondary/10 my-12"></div>
)}
<Heading level={2} size="2xl" class="mb-6">
{group.category}
</Heading>
{group.subsections ? (
	<div class="space-y-8">
		{group.subsections.map((sub) => (
			<div class="resource-subsection">
				<Text variant="secondary" size="xs" class="uppercase tracking-widest mb-3 block">{sub.label}</Text>
				<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
					{sub.items.filter(item => !item.hidden).map((item) => (
					<div
						class="resource-card spotlight-card group relative cursor-pointer"
						data-name={item.name}
						data-description={item.description}
						data-download={item.download ?? ''}
						data-resource-search={`${group.category} ${sub.label} ${item.name} ${item.description ?? ''}`.toLowerCase()}
					>
						<div class="spotlight-inner rounded-md overflow-hidden flex flex-col justify-between gap-3 transition-all duration-300 group-hover:scale-[1.03]">
						{item.thumbnail ? (
							<div class="aspect-square bg-foreground/5 overflow-hidden flex items-center justify-center">
								<Image src={item.thumbnail} alt={item.name} class="w-full h-full object-cover" data-no-lightbox />
							</div>
						) : null}
						<div class="p-4 flex flex-col gap-3 flex-1">
						<div>
							<div class="flex items-center justify-between gap-2 mb-1">
								<Text variant="primary" size="sm" class="font-medium">{item.name}</Text>
								<div class="flex items-center gap-2">
									{item.logos && item.logos.map((logo) => (
										<Image src={logo} alt="" width={48} height={20} class="h-4 w-auto object-contain" data-no-lightbox />
									))}
								</div>
							</div>
							<Text variant="muted" size="sm">{item.description}</Text>
							{item.previewHtml && (
								<div class="mt-3 rounded-md border border-border overflow-hidden">
									<div class="flex items-center justify-between px-3 py-1.5 bg-foreground/5 border-b border-border">
										<span class="text-xs text-foreground-muted font-mono">{item.previewLang ?? ''}</span>
										<button
											class="copy-btn text-xs text-foreground-muted hover:text-accent transition-colors font-mono"
											data-code={item.previewHtml.replace(/<[^>]+>/g, '')}
										>Copy</button>
									</div>
									<pre class="code-block p-3 text-xs font-mono overflow-auto max-h-52 leading-relaxed m-0"><code set:html={item.previewHtml} /></pre>
								</div>
							)}
						</div>
						{item.download && (
							<a href={item.download} download class="inline-flex items-center gap-1.5 text-xs text-foreground-secondary hover:text-accent transition-colors self-start" style="font-family: 'Besley', serif !important;">
								<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
								</svg>
								Download
							</a>
						)}
						</div>
						</div>
					</div>
					))}
				</div>
			</div>
		))}
	</div>
) : (
	<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
	{(group.items ?? []).filter(item => !item.hidden).map((item) => (
	<div
		class="resource-card spotlight-card group relative cursor-pointer"
		data-name={item.name}
		data-description={item.description}
		data-download={item.download ?? ''}
		data-resource-search={`${group.category} ${item.name} ${item.description ?? ''}`.toLowerCase()}
	>
		<div class="spotlight-inner rounded-md overflow-hidden flex flex-col justify-between gap-3 transition-all duration-300 group-hover:scale-[1.03]">
		{item.thumbnail ? (
			<div class="aspect-square bg-foreground/5 overflow-hidden flex items-center justify-center">
				<Image src={item.thumbnail} alt={item.name} class="w-full h-full object-cover" data-no-lightbox />
			</div>
		) : null}
		<div class="p-4 flex flex-col gap-3 flex-1">
		<div>
			<div class="flex items-center justify-between gap-2 mb-1">
				<Text variant="primary" size="sm" class="font-medium">{item.name}</Text>
				<div class="flex items-center gap-2">
					{item.logos && item.logos.map((logo) => (
						<Image src={logo} alt="" width={48} height={20} class="h-4 w-auto object-contain" data-no-lightbox />
					))}
				</div>
			</div>
			<Text variant="muted" size="sm">{item.description}</Text>
			{item.previewHtml && (
				<div class="mt-3 rounded-md border border-border overflow-hidden">
					<div class="flex items-center justify-between px-3 py-1.5 bg-foreground/5 border-b border-border">
						<span class="text-xs text-foreground-muted font-mono">{item.previewLang ?? ''}</span>
						<button
							class="copy-btn text-xs text-foreground-muted hover:text-accent transition-colors font-mono"
							data-code={item.previewHtml.replace(/<[^>]+>/g, '')}
						>Copy</button>
					</div>
					<pre class="code-block p-3 text-xs font-mono overflow-auto max-h-52 leading-relaxed m-0"><code set:html={item.previewHtml} /></pre>
				</div>
			)}
		</div>
		{item.download && (
			<a href={item.download} download class="inline-flex items-center gap-1.5 text-xs text-foreground-secondary hover:text-accent transition-colors self-start" style="font-family: 'Besley', serif !important;">
				<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
				</svg>
				Download
			</a>
		)}
		</div>
		</div>
	</div>
	))}
	</div>
)}
</article>
))}

<p id="tools-search-empty" class="hidden mt-6 text-sm text-foreground-muted" style="font-family: 'Besley', serif !important;">
	No tools or resources match your search.
</p>
</div>

</div>

<!-- Resource Card Modal -->
<div id="resource-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
	<div id="resource-modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
	<div class="resource-modal-card relative z-10 w-full max-w-lg rounded-xl border border-border bg-card shadow-2xl overflow-hidden">
		<button id="resource-modal-close" class="absolute top-3 right-3 z-10 flex items-center justify-center w-7 h-7 rounded-full bg-foreground/10 hover:bg-foreground/20 transition-colors">
			<svg class="w-3.5 h-3.5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
		</button>
		<div id="resource-modal-thumb" class="bg-foreground/5 flex items-center justify-center p-4 hidden">
			<img id="resource-modal-img" src="" alt="" class="w-full h-auto object-contain max-h-64" />
		</div>
		<div class="p-6 overflow-y-auto max-h-[70vh]">
			<p id="resource-modal-name" class="text-xl font-medium text-foreground mb-2" style="font-family: 'Besley', serif"></p>
			<p id="resource-modal-desc" class="text-sm text-foreground-secondary mb-5"></p>
			<div id="resource-modal-how-to" class="hidden mb-5">
				<p class="text-xs uppercase tracking-widest text-foreground-muted mb-2" style="font-family: 'Besley', serif">How to Use</p>
				<ol id="resource-modal-how-to-list" class="space-y-1.5 text-sm text-foreground-secondary list-none"></ol>
			</div>
			<a id="resource-modal-download" href="#" download class="hidden inline-flex items-center gap-2 text-sm text-foreground-secondary hover:text-accent transition-colors" style="font-family: 'Besley', serif">
				<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
				Download
			</a>
		</div>
	</div>
</div>

</PageContainer>
</div>
</PageMain>
<Footer />
<script is:inline define:vars={{ resourceHowToMap }}>
window.__resourceHowTo = resourceHowToMap;
</script>
<ImageLightbox />
</BaseLayout>

<style>
.learn-nav-link {
	opacity: 0.45;
	transition: opacity 0.15s;
}
.learn-nav-link.active,
.learn-nav-link:hover {
	opacity: 1;
}
.learn-nav-link.active .learn-nav-title {
	color: hsl(var(--accent));
}
/* Code block — uses site theme colors */
.code-block { background: hsl(var(--card-bg)); color: hsl(var(--foreground)); margin: 0 !important; border-radius: 0 !important; }
/* Resource modal */
#resource-modal.open { display: flex; }
.resource-modal-card { animation: modal-in 0.18s ease; }
@keyframes modal-in { from { opacity: 0; transform: scale(0.95) translateY(8px); } to { opacity: 1; transform: scale(1) translateY(0); } }
</style>

<script>
const initResources = () => {
let applyResourceSearchFilters: (() => void) | null = null;

// --- Copy buttons ---
document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const code = btn.dataset.code ?? '';
    navigator.clipboard.writeText(code).then(() => {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
});

// --- Scroll spy for sidebar nav ---
let observer: IntersectionObserver | null = null;
const initScrollSpy = () => {
if (observer) observer.disconnect();
const entries = document.querySelectorAll<HTMLElement>('.learn-entry');
const navLinks = document.querySelectorAll<HTMLElement>('.learn-nav-link');
if (!entries.length || !navLinks.length) return;

observer = new IntersectionObserver(
(observed) => {
observed.forEach((entry) => {
if (entry.isIntersecting) {
const id = entry.target.id;
navLinks.forEach((link) => {
link.classList.toggle('active', link.dataset.slug === id);
});
}
});
},
{ rootMargin: '-20% 0px -60% 0px' }
);
entries.forEach((entry) => observer!.observe(entry));
};
initScrollSpy();

// --- Search (resources only) ---
const initResourceSearch = () => {
	const searchInput = document.getElementById('resource-search') as HTMLInputElement | null;
	if (!searchInput) return;

	const savedQuery = sessionStorage.getItem('resource-search') ?? '';
	searchInput.value = savedQuery;

	const normalize = (value: string) => value.toLowerCase().trim();

	applyResourceSearchFilters = () => {
		const query = normalize(searchInput.value);
		const hasQuery = query.length > 0;

		const toolArticles = Array.from(document.querySelectorAll<HTMLElement>('.learn-entry'));
		let toolMatches = 0;

		toolArticles.forEach((article) => {
			const cards = Array.from(article.querySelectorAll<HTMLElement>('.resource-card'));
			let articleHasMatch = false;

			cards.forEach((card) => {
				const haystack = card.dataset.resourceSearch ?? `${card.dataset.name ?? ''} ${card.dataset.description ?? ''}`.toLowerCase();
				const match = !hasQuery || haystack.includes(query);
				card.classList.toggle('hidden', !match);
				if (match) articleHasMatch = true;
			});

			const subsections = Array.from(article.querySelectorAll<HTMLElement>('.resource-subsection'));
			subsections.forEach((subsection) => {
				const subsectionHasMatch = !!subsection.querySelector('.resource-card:not(.hidden)');
				subsection.classList.toggle('hidden', !subsectionHasMatch);
			});

			article.classList.toggle('hidden', !articleHasMatch);
			if (articleHasMatch) toolMatches += 1;
		});

		const toolsEmpty = document.getElementById('tools-search-empty');
		if (toolsEmpty) {
			toolsEmpty.classList.toggle('hidden', toolMatches > 0);
		}
	};

	searchInput.addEventListener('input', () => {
		sessionStorage.setItem('resource-search', searchInput.value);
		applyResourceSearchFilters?.();
	});

	searchInput.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && searchInput.value) {
			searchInput.value = '';
			sessionStorage.setItem('resource-search', '');
			applyResourceSearchFilters?.();
		}
	});

	applyResourceSearchFilters();
};
initResourceSearch();

// --- Resource card modal ---
const modal = document.getElementById('resource-modal')!;
const modalImg = document.getElementById('resource-modal-img') as HTMLImageElement;
const modalThumb = document.getElementById('resource-modal-thumb')!;
const modalName = document.getElementById('resource-modal-name')!;
const modalDesc = document.getElementById('resource-modal-desc')!;
const modalDownload = document.getElementById('resource-modal-download') as HTMLAnchorElement;
const modalHowTo = document.getElementById('resource-modal-how-to')!;
const modalHowToList = document.getElementById('resource-modal-how-to-list')!;

const openResourceModal = (card: HTMLElement) => {
  const name = card.dataset.name ?? '';
  const desc = card.dataset.description ?? '';
  const download = card.dataset.download ?? '';
  const howToUse: string[] = ((window as any).__resourceHowTo?.[name] ?? []);
  const imgEl = card.querySelector<HTMLImageElement>('img[data-no-lightbox]');

  modalName.textContent = name;
  modalDesc.textContent = desc;

  if (imgEl?.src) {
    modalImg.src = imgEl.src;
    modalImg.alt = name;
    modalThumb.classList.remove('hidden');
  } else {
    modalThumb.classList.add('hidden');
  }

  if (howToUse.length) {
    modalHowToList.innerHTML = howToUse.map((step, i) => `<li class="flex gap-2"><span class="text-accent font-medium shrink-0">${i + 1}.</span><span>${step.replace(/^\d+\.\s*/, '')}</span></li>`).join('');
    modalHowTo.classList.remove('hidden');
  } else {
    modalHowTo.classList.add('hidden');
  }

  if (download) {
    modalDownload.href = download;
    modalDownload.classList.remove('hidden');
  } else {
    modalDownload.classList.add('hidden');
  }

  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
};

const closeResourceModal = () => {
  modal.classList.remove('open');
  document.body.style.overflow = '';
};

document.querySelectorAll<HTMLElement>('.resource-card').forEach((card) => {
  card.addEventListener('click', (e) => {
    // Don't open modal when clicking download link inside the card
    if ((e.target as HTMLElement).closest('a')) return;
    openResourceModal(card);
  });
});

document.getElementById('resource-modal-close')?.addEventListener('click', closeResourceModal);
document.getElementById('resource-modal-backdrop')?.addEventListener('click', closeResourceModal);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeResourceModal(); });
};

initResources();
document.addEventListener('astro:after-swap', initResources);
</script>
