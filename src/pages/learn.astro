---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import LectureActions from '@/components/ui/lecture-actions.astro';
import LecturePresenter from '@/components/ui/lecture-presenter.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import { getLearnPageSEO } from '@/config/seo';
import { sanityClient } from '@/lib/sanity/client';
import { coursesQuery, pipelineQuery, learnPageQuery } from '@/lib/sanity/queries';
import { urlFor } from '@/lib/sanity/image';
import { bodyToPlainText, slugify, extractMedia } from '@/lib/sanity/toc';
import PortableText from '@/components/sanity/PortableText.astro';

// Read live from Sanity at request time (edits appear instantly).
export const prerender = false;

const seo = getLearnPageSEO();

// -------------------------------------------------------------------
// Syllabus & Assignment Images
// -------------------------------------------------------------------
// To add a syllabus thumbnail for a course:
//   1. Drop a screenshot/image into src/assets/learn/syllabi/
//      e.g. angd-1312-syllabus.png
//   2. Import it here:
//      import syllabus1312 from '@/assets/learn/syllabi/angd-1312-syllabus.png';
//   3. Add it to the matching course below:
//      { code: 'ANGD 1312', title: '...', syllabus: syllabus1312 }
//
// To add assignment thumbnails for a course:
//   1. Drop images into src/assets/learn/assignments/
//      e.g. angd-1312-assign-01.png
//   2. Import them here:
//      import assign1312_01 from '@/assets/learn/assignments/angd-1312-assign-01.png';
//   3. Add them to the matching course:
//      { code: 'ANGD 1312', title: '...', assignments: [
//          { image: assign1312_01, title: 'Assignment 1' },
//      ]}
// -------------------------------------------------------------------

interface CourseAssignment {
	image: ImageMetadata;
	title: string;
}

interface CourseProjectThread {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
}

interface CourseProject {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
	threads?: CourseProjectThread[];
}

interface Course {
	code: string;
	title: string;
	slug?: string;
	year: string;
	order?: number;
	description?: string;
	outcomes?: string;
	required?: string;
	audience?: string;
	syllabus?: any;
	assignments?: CourseAssignment[];
	projects?: CourseProject[];
}

interface CurriculumYear {
	year: string;
	courses: Course[];
}

// -------------------------------------------------------------------
// Pipeline
// -------------------------------------------------------------------
// The Pipeline section is not tied to a specific class. It groups
// production/workflow topics (e.g. "Source Control") that each contain
// one or more "threads" (e.g. Git, Perforce, Google Drive).
//
// To add a new topic:
//   1. Add a PipelineTopic to the `pipeline` array below with a unique slug.
//   2. Add threads with unique slugs within that topic.
// To attach written content to a thread, import an MDX component and set
// it as `contentComponent` (same pattern as course projects above).
// -------------------------------------------------------------------
interface PipelineThread {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
}

interface PipelineTopic {
	slug: string;
	title: string;
	code?: string;
	description: string;
	body?: any;
	threads?: PipelineThread[];
}

// Curriculum + pipeline now come from Sanity (editable in the Studio).
const YEAR_ORDER: Record<string, number> = {
	'Freshman': 0,
	'Sophomore': 1,
	'Sophomore / Junior': 2,
	'Junior': 3,
	'Senior': 4,
};
const [coursesData, pipelineData, learnPage] = await Promise.all([
	sanityClient.fetch(coursesQuery),
	sanityClient.fetch(pipelineQuery),
	sanityClient.fetch(learnPageQuery),
]);
// Editable page chrome (with fallbacks if the Learn Page doc is empty).
const pageTitle = learnPage?.pageTitle || 'Education';
const pageIntro = learnPage?.intro ||
	'Teaching has become one of the most meaningful parts of my career. This section serves as a companion resource for the courses I teach, providing students with supplemental lectures, notes, demonstrations, project breakdowns, and reference material used throughout the semester. While these pages do not replace the courses themselves, they offer additional context and resources that students can revisit as they develop their skills and continue growing as artists.';
const coursesLabel = learnPage?.coursesLabel || 'University Courses';
const pipelineLabel = learnPage?.pipelineLabel || 'Studio Pipeline';
// Flatten + order for sidebar nav (matches the previous curriculum ordering).
const allCourses = ((coursesData ?? []) as Course[]).sort(
	(a, b) =>
		((YEAR_ORDER[a.year] ?? 99) - (YEAR_ORDER[b.year] ?? 99)) ||
		((a.order ?? 0) - (b.order ?? 0))
);
const pipeline = (pipelineData ?? []) as PipelineTopic[];
// Strips punctuation (e.g. the "·" in course codes) so anchor ids stay URL-safe.
const courseId = (code: string) => slugify(code);
// Pipeline topics are taught as core class content; show this as their "course code".
// Editable per-topic in Sanity (the topic's "Code / Label" field); this is the fallback default.
const PIPELINE_CODE = 'ANGD Core';

// Build the search haystack for a course/topic including full lecture body text,
// so a search like "block-in" finds the lecture that mentions it — not just titles.
const courseSearchData = (course: Course) =>
	`${course.code} ${course.title} ${course.description ?? ''} ${course.outcomes ?? ''} ${(course.projects || [])
		.map((project) =>
			`${project.title} ${project.description ?? ''} ${bodyToPlainText(project.body)} ${(project.threads ?? [])
				.map((thread) => `${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`)
				.join(' ')}`
		)
		.join(' ')}`.toLowerCase();

const projectSearchData = (course: Course, project: CourseProject) =>
	`${course.code} ${course.title} ${project.title} ${project.description ?? ''} ${bodyToPlainText(project.body)} ${(project.threads ?? [])
		.map((thread) => `${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`)
		.join(' ')}`.toLowerCase();

const topicSearchData = (topic: PipelineTopic) =>
	`${topic.code ?? PIPELINE_CODE} ${topic.title} ${topic.description ?? ''} ${bodyToPlainText(topic.body)} ${(topic.threads ?? [])
		.map((thread) => `${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`)
		.join(' ')}`.toLowerCase();

const topicThreadSearchData = (topic: PipelineTopic, thread: CourseProjectThread) =>
	`${topic.title} ${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`.toLowerCase();

// Granular search index for the results view: one entry per lecture / glossary
// term, keeping the original-case text so we can show a highlighted snippet.
type SearchEntry = { kind: string; title: string; crumb: string; hash: string; text: string; thumb?: string };
const searchEntries: SearchEntry[] = [];
const thumbUrl = (src: any): string | undefined => {
	try { return src?.asset ? urlFor(src).width(160).height(100).fit('crop').auto('format').url() : undefined; } catch { return undefined; }
};
const pushMedia = (body: any, crumb: string, hash: string) => {
	for (const m of extractMedia(body)) {
		const alt = String(m.alt ?? '').trim();
		const caption = String(m.caption ?? '').trim();
		const label = caption || alt;
		const isVideo = m._type === 'video';
		const isModel = m._type === 'model3d';
		// Video and 3D model blocks carry their own poster image; a plain
		// figure/image block's asset is the searchable image itself.
		const kind = isModel ? '3D Model' : isVideo ? 'Video' : 'Image';
		// Append the block's own key so the result deep-links straight to it
		// (see scrollToPanelMedia) instead of just the project/thread it's in.
		const entryHash = m._key ? `${hash}/${m._key}` : hash;
		searchEntries.push({ kind, title: label.length > 90 ? `${label.slice(0, 90)}\u2026` : label, crumb, hash: entryHash, text: `${alt} ${caption}`.trim(), thumb: thumbUrl(isVideo || isModel ? m.poster : m) });
	}
};
for (const course of allCourses) {
	const cid = courseId(course.code);
	for (const project of course.projects ?? []) {
		searchEntries.push({ kind: 'Project', title: project.title, crumb: course.code, hash: `${cid}/${project.slug}`, text: `${project.title} ${project.description ?? ''} ${bodyToPlainText(project.body)}`.trim(), thumb: thumbUrl(project.thumbnail) });
		pushMedia(project.body, `${course.code} · ${project.title}`, `${cid}/${project.slug}`);
		for (const thread of project.threads ?? []) {
			searchEntries.push({ kind: 'Lecture', title: thread.title, crumb: `${course.code} · ${project.title}`, hash: `${cid}/${project.slug}/${thread.slug}`, text: `${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`.trim(), thumb: thumbUrl(thread.thumbnail) });
			pushMedia(thread.body, `${course.code} · ${project.title} · ${thread.title}`, `${cid}/${project.slug}/${thread.slug}`);
		}
	}
}
for (const topic of pipeline) {
	const table = (((topic.body as any[]) ?? []).find((b: any) => b?._type === 'table'));
	if (table?.rows?.length) {
		for (const row of table.rows) {
			const cells = row?.cells ?? [];
			const term = String(cells[0] ?? '').trim();
			const def = String(cells[1] ?? '').trim();
			if (!term || term.toLowerCase() === 'name') continue;
			searchEntries.push({ kind: 'Glossary', title: term, crumb: topic.title, hash: `${topic.slug}/${slugify(term)}`, text: `${term} — ${def}` });
		}
	} else if ((topic.threads?.length ?? 0) > 0) {
		for (const thread of topic.threads ?? []) {
			searchEntries.push({ kind: 'Lecture', title: thread.title, crumb: topic.title, hash: `${topic.slug}/${thread.slug}`, text: `${thread.title} ${thread.description ?? ''} ${bodyToPlainText(thread.body)}`.trim(), thumb: thumbUrl(thread.thumbnail) });
			pushMedia(thread.body, `${topic.title} · ${thread.title}`, `${topic.slug}/${thread.slug}`);
		}
	} else {
		const topicText = bodyToPlainText(topic.body);
		if (topicText) searchEntries.push({ kind: 'Topic', title: topic.title, crumb: 'Supplemental', hash: topic.slug, text: topicText });
		pushMedia(topic.body, topic.title, topic.slug);
	}
}
const searchIndexJson = JSON.stringify(searchEntries).replace(/</g, '\\u003c');
---


<BaseLayout 
title={seo.title} 
description={seo.description}
keywords={seo.keywords}
>
<Header />
<PageMain class="learn-body text-foreground">
<!-- Page Header with Background -->
<div class="relative w-full py-8 sm:py-10">
<div class="absolute inset-0 -z-10 overflow-hidden">
<img
src={heroBg.src}
alt=""
class="w-full h-full object-cover object-center !opacity-60 dark:!opacity-[0.12]"
loading="eager"
/>
<div class="absolute inset-0 bg-white/[0.82] dark:bg-black/[0.62]"></div>
</div>
<PageContainer>
<Heading level={1} size="4xl" class="mb-4">
{pageTitle}
</Heading>
<Text size="lg" variant="secondary" class="mb-4">
{pageIntro}
</Text>
<!-- WIP Banner -->
<div class="mt-2 flex items-center gap-3 rounded-md border border-accent/30 bg-accent/5 px-4 py-3">
	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
	</svg>
	<p class="text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;">
		Currently undergoing active updates. New content and changes are being made as you read this!
	</p>
</div>
</PageContainer>
</div>

<div class="relative z-10 w-full py-8 sm:py-12">
<PageContainer>

<div class="mb-8">
	<label for="course-search" class="sr-only">Search courses</label>
	<div class="flex items-center gap-3 rounded-md border border-border bg-card px-4 py-3 focus-within:border-accent/60 focus-within:ring-1 focus-within:ring-accent/30 transition-colors">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-foreground-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="11" cy="11" r="8" />
			<path d="m21 21-4.35-4.35" />
		</svg>
		<input
			id="course-search"
			type="search"
			placeholder="Search courses..."
			class="w-full bg-transparent text-sm text-foreground placeholder:text-foreground-muted outline-none"
			style="font-family: 'Besley', serif !important;"
			autocomplete="off"
		/>
	</div>
</div>

<!-- Content with Sidebar -->
<div class="flex flex-col lg:flex-row gap-8 lg:gap-16 relative">

<!-- Sidebar -->
<aside class="w-full lg:w-72 shrink-0">
<div class="lg:sticky lg:top-32">

<div id="sidebar-classes">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
{coursesLabel}
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{allCourses.map((course) => (
<div class="course-nav-group">
<a
href={`#${courseId(course.code)}`}
class="learn-nav-link block leading-snug group"
data-slug={courseId(course.code)}
data-course-nav="true"
data-course-search={courseSearchData(course)}
>
<span class="block text-base font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{course.title}</span>
</a>
{(course.projects?.length ?? 0) > 0 && (
<div class="course-subnav hidden mt-3 space-y-2 border-l border-foreground-secondary/10 pl-3" data-course-subnav={courseId(course.code)}>
{(course.projects ?? []).map((project) => (
<div class="project-nav-group">
<a
href={`#${courseId(course.code)}/${project.slug}`}
class="subnav-link learn-nav-link block leading-snug group"
data-course={courseId(course.code)}
data-project={project.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{project.title}</span>
</a>
{(project.threads?.length ?? 0) > 0 && (
<div class="project-subnav hidden mt-2 space-y-1.5 border-l border-foreground-secondary/10 pl-3" data-course={courseId(course.code)} data-project={project.slug}>
{(project.threads ?? []).map((thread) => (
<a
href={`#${courseId(course.code)}/${project.slug}/${thread.slug}`}
class="subnav-thread-link learn-nav-link block leading-snug group"
data-course={courseId(course.code)}
data-project={project.slug}
data-thread={thread.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{thread.title}</span>
</a>
))}
</div>
)}
</div>
))}
</div>
)}
</div>
))}
</nav>
</div>

<div id="sidebar-pipeline" class="mt-8">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
{pipelineLabel}
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{pipeline.map((topic) => (
<div class="course-nav-group">
<a
href={`#${topic.slug}`}
class="learn-nav-link block leading-snug group"
data-slug={topic.slug}
data-course-nav="true"
data-course-search={topicSearchData(topic)}
>
<span class="block text-base font-medium text-accent" style="font-family: 'Besley', serif !important;">{topic.code ?? PIPELINE_CODE}</span>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{topic.title}</span>
</a>
{(topic.threads?.length ?? 0) > 0 && (
<div class="course-subnav hidden mt-3 space-y-2 border-l border-foreground-secondary/10 pl-3" data-course-subnav={topic.slug}>
{(topic.threads ?? []).map((thread) => (
<a
href={`#${topic.slug}/${thread.slug}`}
class="subnav-link learn-nav-link block leading-snug group"
data-course={topic.slug}
data-project={thread.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{thread.title}</span>
</a>
))}
</div>
)}
</div>
))}
</nav>
</div>

</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">

<!-- Search results (replaces the content area while searching) -->
<div id="search-results" class="hidden"></div>
<script id="learn-search-index" type="application/json" is:inline set:html={searchIndexJson}></script>

<!-- Course list -->
<div id="classes-list" class="space-y-3 hidden">
	{allCourses.map((course) => (
		<button
			class="course-card w-full text-left rounded-lg border border-border bg-card hover:border-accent/50 hover:bg-foreground/[0.03] transition-all p-5 group"
			data-course={courseId(course.code)}
			data-course-search={courseSearchData(course)}
		>
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0">
					<div class="flex items-center gap-2 mb-2">
						<span class="text-xs font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
						<span class="text-xs text-foreground-muted">{course.year}</span>
					</div>
					<p class="text-base font-medium text-foreground mb-1" style="font-family: 'Besley', serif !important;">{course.title}</p>
					<p class="text-sm text-foreground-secondary line-clamp-2">{course.description}</p>
				</div>
				<svg class="w-5 h-5 text-foreground-muted group-hover:text-accent transition-colors shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
				</svg>
			</div>
		</button>
	))}
</div>

<!-- Course detail -->
<div id="classes-detail">

	<!-- Dynamic course content -->
	{allCourses.map((course) => (
		<div
			id={`detail-${courseId(course.code)}`}
			class="course-detail-content hidden"
			data-course-search={courseSearchData(course)}
		>
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<Badge variant="accent" size="sm">{course.code}</Badge>
					<Badge variant="outline" size="sm">{course.year}</Badge>
				</div>
				<Heading level={2} size="2xl" class="mb-3">
					{course.title}
				</Heading>
				<Text size="base" variant="secondary">
					{course.description}
				</Text>
				{course.outcomes && (
					<div class="mt-5">
						<p class="text-xs uppercase tracking-widest text-foreground-muted mb-1" style="font-family: 'Besley', serif !important;">Outcomes</p>
						<Text size="base" variant="secondary">{course.outcomes}</Text>
					</div>
				)}
				{(course.required || course.audience) && (
					<div class="mt-4 flex flex-col gap-2">
						{course.required && (
							<p class="text-base" style="font-family: 'Besley', serif !important;">
								<span class="text-foreground-muted">Required: </span>
								<span class="text-foreground-secondary">{course.required}</span>
							</p>
						)}
						{course.audience && (
							<p class="text-base" style="font-family: 'Besley', serif !important;">
								<span class="text-foreground-muted">Audience: </span>
								<span class="text-foreground-secondary">{course.audience}</span>
							</p>
						)}
					</div>
				)}
			</div>

			<!-- Project cards -->
			<div class="grid grid-cols-1 gap-4">
				{(course.projects || []).map((project) => (
					<button
						class="project-card spotlight-card group relative w-full text-left rounded-lg"
						data-course={courseId(course.code)}
						data-project={project.slug}
						data-project-search={projectSearchData(course, project)}
					>
							<div class="spotlight-inner rounded-lg overflow-hidden transition-all duration-300 group-hover:scale-[1.01]">
							<div class="flex items-stretch min-w-0">
								<!-- Thumbnail -->
								<div class="relative basis-[55%] shrink min-w-0 bg-foreground/5 flex items-center justify-center overflow-hidden rounded-l-lg" style="aspect-ratio: 3840/2426; isolation: isolate;">
								{project.thumbnail ? (
									<img src={urlFor(project.thumbnail).width(1200).auto('format').url()} srcset={`${urlFor(project.thumbnail).width(800).auto('format').url()} 800w, ${urlFor(project.thumbnail).width(1200).auto('format').url()} 1200w, ${urlFor(project.thumbnail).width(1600).auto('format').url()} 1600w, ${urlFor(project.thumbnail).width(2400).auto('format').url()} 2400w`} sizes="(max-width: 1024px) 55vw, 46vw" alt={project.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" data-no-lightbox />
								) : (
									<svg class="w-10 h-10 text-foreground-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								)}
							</div>
							<!-- Text -->
								<div class="flex-1 min-w-0 p-4 lg:p-6 flex flex-col justify-center border-l border-border">
									<p class="text-base text-foreground-muted mb-3 truncate" style="font-family: 'Besley', serif !important;">{course.code} - {course.title}</p>
									<p class="text-fluid-4xl font-normal text-foreground mb-4 leading-tight" style="font-family: 'Besley', serif !important;">{project.title}</p>
								<span class="inline-block text-base text-accent transition-colors duration-200" style="font-family: 'Besley', serif !important;">View Content</span>
							</div>
						</div>
						</div>
					</button>
				))}
			</div>
			<p class="projects-search-empty hidden mt-5 text-sm text-foreground-muted" style="font-family: 'Besley', serif !important;">
				No project content matches this search.
			</p>
		</div>
	))}

	<!-- Pipeline topic content -->
	{pipeline.map((topic) => (
		<div
			id={`detail-${topic.slug}`}
			class="course-detail-content hidden"
			data-course-search={topicSearchData(topic)}
		>
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<Badge variant="accent" size="sm">{topic.code ?? PIPELINE_CODE}</Badge>
