---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import LectureActions from '@/components/ui/lecture-actions.astro';
import LecturePresenter from '@/components/ui/lecture-presenter.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import { getLearnPageSEO } from '@/config/seo';
import { sanityClient } from '@/lib/sanity/client';
import { coursesQuery, pipelineQuery, learnPageQuery } from '@/lib/sanity/queries';
import { urlFor } from '@/lib/sanity/image';
import PortableText from '@/components/sanity/PortableText.astro';

// Read live from Sanity at request time (edits appear instantly).
export const prerender = false;

const seo = getLearnPageSEO();

// -------------------------------------------------------------------
// Syllabus & Assignment Images
// -------------------------------------------------------------------
// To add a syllabus thumbnail for a course:
//   1. Drop a screenshot/image into src/assets/learn/syllabi/
//      e.g. angd-1312-syllabus.png
//   2. Import it here:
//      import syllabus1312 from '@/assets/learn/syllabi/angd-1312-syllabus.png';
//   3. Add it to the matching course below:
//      { code: 'ANGD 1312', title: '...', syllabus: syllabus1312 }
//
// To add assignment thumbnails for a course:
//   1. Drop images into src/assets/learn/assignments/
//      e.g. angd-1312-assign-01.png
//   2. Import them here:
//      import assign1312_01 from '@/assets/learn/assignments/angd-1312-assign-01.png';
//   3. Add them to the matching course:
//      { code: 'ANGD 1312', title: '...', assignments: [
//          { image: assign1312_01, title: 'Assignment 1' },
//      ]}
// -------------------------------------------------------------------

interface CourseAssignment {
	image: ImageMetadata;
	title: string;
}

interface CourseProjectThread {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
}

interface CourseProject {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
	threads?: CourseProjectThread[];
}

interface Course {
	code: string;
	title: string;
	slug?: string;
	year: string;
	order?: number;
	description?: string;
	outcomes?: string;
	required?: string;
	audience?: string;
	syllabus?: any;
	assignments?: CourseAssignment[];
	projects?: CourseProject[];
}

interface CurriculumYear {
	year: string;
	courses: Course[];
}

// -------------------------------------------------------------------
// Pipeline
// -------------------------------------------------------------------
// The Pipeline section is not tied to a specific class. It groups
// production/workflow topics (e.g. "Source Control") that each contain
// one or more "threads" (e.g. Git, Perforce, Google Drive).
//
// To add a new topic:
//   1. Add a PipelineTopic to the `pipeline` array below with a unique slug.
//   2. Add threads with unique slugs within that topic.
// To attach written content to a thread, import an MDX component and set
// it as `contentComponent` (same pattern as course projects above).
// -------------------------------------------------------------------
interface PipelineThread {
	slug: string;
	title: string;
	description?: string;
	thumbnail?: any;
	body?: any;
}

interface PipelineTopic {
	slug: string;
	title: string;
	code?: string;
	description: string;
	body?: any;
	threads?: PipelineThread[];
}

// Curriculum + pipeline now come from Sanity (editable in the Studio).
const YEAR_ORDER: Record<string, number> = {
	'Freshman': 0,
	'Sophomore': 1,
	'Sophomore / Junior': 2,
	'Junior': 3,
	'Senior': 4,
};
const [coursesData, pipelineData, learnPage] = await Promise.all([
	sanityClient.fetch(coursesQuery),
	sanityClient.fetch(pipelineQuery),
	sanityClient.fetch(learnPageQuery),
]);
// Editable page chrome (with fallbacks if the Learn Page doc is empty).
const pageTitle = learnPage?.pageTitle || 'Education';
const pageIntro = learnPage?.intro ||
	'Teaching has become one of the most meaningful parts of my career. This section serves as a companion resource for the courses I teach, providing students with supplemental lectures, notes, demonstrations, project breakdowns, and reference material used throughout the semester. While these pages do not replace the courses themselves, they offer additional context and resources that students can revisit as they develop their skills and continue growing as artists.';
const coursesLabel = learnPage?.coursesLabel || 'University Courses';
const pipelineLabel = learnPage?.pipelineLabel || 'Studio Pipeline';
// Flatten + order for sidebar nav (matches the previous curriculum ordering).
const allCourses = ((coursesData ?? []) as Course[]).sort(
	(a, b) =>
		((YEAR_ORDER[a.year] ?? 99) - (YEAR_ORDER[b.year] ?? 99)) ||
		((a.order ?? 0) - (b.order ?? 0))
);
const pipeline = (pipelineData ?? []) as PipelineTopic[];
const courseId = (code: string) => code.toLowerCase().replace(/\s+/g, '-');
// Pipeline topics are taught as core class content; show this as their "course code".
// Editable per-topic in Sanity (the topic's "Code / Label" field); this is the fallback default.
const PIPELINE_CODE = 'ANGD Core';
---


<BaseLayout 
title={seo.title} 
description={seo.description}
keywords={seo.keywords}
>
<Header />
<PageMain class="text-foreground">
<!-- Page Header with Background -->
<div class="relative w-full py-8 sm:py-10">
<div class="absolute inset-0 -z-10 overflow-hidden">
<Image
src={heroBg}
alt=""
class="w-full h-full object-cover object-center"
loading="eager"
widths={[800, 1200, 1920]}
/>
<div class="absolute inset-0 bg-white/85 dark:bg-black/85"></div>
</div>
<PageContainer>
<Heading level={1} size="4xl" class="mb-4">
{pageTitle}
</Heading>
<Text size="lg" variant="secondary" class="mb-4">
{pageIntro}
</Text>
<!-- WIP Banner -->
<div class="mt-2 flex items-center gap-3 rounded-md border border-accent/30 bg-accent/5 px-4 py-3">
	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
	</svg>
	<p class="text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;">
		Currently undergoing active updates. New content and changes are being made as you read this!
	</p>
</div>
</PageContainer>
</div>

<div class="relative z-10 w-full py-8 sm:py-12">
<PageContainer>

<div class="mb-8">
	<label for="course-search" class="sr-only">Search courses</label>
	<div class="flex items-center gap-3 rounded-md border border-border bg-card px-4 py-3 focus-within:border-accent/60 focus-within:ring-1 focus-within:ring-accent/30 transition-colors">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-foreground-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="11" cy="11" r="8" />
			<path d="m21 21-4.35-4.35" />
		</svg>
		<input
			id="course-search"
			type="search"
			placeholder="Search courses..."
			class="w-full bg-transparent text-sm text-foreground placeholder:text-foreground-muted outline-none"
			style="font-family: 'Besley', serif !important;"
			autocomplete="off"
		/>
	</div>
</div>

<!-- Content with Sidebar -->
<div class="flex flex-col lg:flex-row gap-8 lg:gap-16 relative">

<!-- Sidebar -->
<aside class="w-full lg:w-72 shrink-0">
<div class="lg:sticky lg:top-32">

<div id="sidebar-classes">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
{coursesLabel}
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{allCourses.map((course) => (
<div class="course-nav-group">
<a
href={`#${courseId(course.code)}`}
class="learn-nav-link block leading-snug group"
data-slug={courseId(course.code)}
data-course-nav="true"
data-course-search={`${course.code} ${course.title} ${course.description} ${course.outcomes ?? ''} ${(course.projects || []).map((project) => `${project.title} ${project.description} ${(project.threads ?? []).map((thread) => `${thread.title} ${thread.description ?? ''}`).join(' ')}`).join(' ')}`.toLowerCase()}
>
<span class="block text-base font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{course.title}</span>
</a>
{(course.projects?.length ?? 0) > 0 && (
<div class="course-subnav hidden mt-3 space-y-2 border-l border-foreground-secondary/10 pl-3" data-course-subnav={courseId(course.code)}>
{(course.projects ?? []).map((project) => (
<div class="project-nav-group">
<a
href={`#${courseId(course.code)}/${project.slug}`}
class="subnav-link learn-nav-link block leading-snug group"
data-course={courseId(course.code)}
data-project={project.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{project.title}</span>
</a>
{(project.threads?.length ?? 0) > 0 && (
<div class="project-subnav hidden mt-2 space-y-1.5 border-l border-foreground-secondary/10 pl-3" data-course={courseId(course.code)} data-project={project.slug}>
{(project.threads ?? []).map((thread) => (
<a
href={`#${courseId(course.code)}/${project.slug}/${thread.slug}`}
class="subnav-thread-link learn-nav-link block leading-snug group"
data-course={courseId(course.code)}
data-project={project.slug}
data-thread={thread.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{thread.title}</span>
</a>
))}
</div>
)}
</div>
))}
</div>
)}
</div>
))}
</nav>
</div>

<div id="sidebar-pipeline" class="mt-8">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
{pipelineLabel}
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{pipeline.map((topic) => (
<div class="course-nav-group">
<a
href={`#${topic.slug}`}
class="learn-nav-link block leading-snug group"
data-slug={topic.slug}
data-course-nav="true"
data-course-search={`${topic.code ?? PIPELINE_CODE} ${topic.title} ${topic.description} ${(topic.threads ?? []).map((thread) => `${thread.title} ${thread.description}`).join(' ')}`.toLowerCase()}
>
<span class="block text-base font-medium text-accent" style="font-family: 'Besley', serif !important;">{topic.code ?? PIPELINE_CODE}</span>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{topic.title}</span>
</a>
{(topic.threads?.length ?? 0) > 0 && (
<div class="course-subnav hidden mt-3 space-y-2 border-l border-foreground-secondary/10 pl-3" data-course-subnav={topic.slug}>
{(topic.threads ?? []).map((thread) => (
<a
href={`#${topic.slug}/${thread.slug}`}
class="subnav-link learn-nav-link block leading-snug group"
data-course={topic.slug}
data-project={thread.slug}
>
<span class="learn-nav-title block text-sm text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{thread.title}</span>
</a>
))}
</div>
)}
</div>
))}
</nav>
</div>

</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">

<!-- Course list -->
<div id="classes-list" class="space-y-3 hidden">
	{allCourses.map((course) => (
		<button
			class="course-card w-full text-left rounded-lg border border-border bg-card hover:border-accent/50 hover:bg-foreground/[0.03] transition-all p-5 group"
			data-course={courseId(course.code)}
			data-course-search={`${course.code} ${course.title} ${course.description} ${course.outcomes ?? ''} ${(course.projects || []).map((project) => `${project.title} ${project.description} ${(project.threads ?? []).map((thread) => `${thread.title} ${thread.description ?? ''}`).join(' ')}`).join(' ')}`.toLowerCase()}
		>
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0">
					<div class="flex items-center gap-2 mb-2">
						<span class="text-xs font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
						<span class="text-xs text-foreground-muted">{course.year}</span>
					</div>
					<p class="text-base font-medium text-foreground mb-1" style="font-family: 'Besley', serif !important;">{course.title}</p>
					<p class="text-sm text-foreground-secondary line-clamp-2">{course.description}</p>
				</div>
				<svg class="w-5 h-5 text-foreground-muted group-hover:text-accent transition-colors shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
				</svg>
			</div>
		</button>
	))}
</div>

<!-- Course detail -->
<div id="classes-detail">

	<!-- Dynamic course content -->
	{allCourses.map((course) => (
		<div
			id={`detail-${courseId(course.code)}`}
			class="course-detail-content hidden"
			data-course-search={`${course.code} ${course.title} ${course.description} ${course.outcomes ?? ''} ${(course.projects || []).map((project) => `${project.title} ${project.description} ${(project.threads ?? []).map((thread) => `${thread.title} ${thread.description ?? ''}`).join(' ')}`).join(' ')}`.toLowerCase()}
		>
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<Badge variant="accent" size="sm">{course.code}</Badge>
					<Badge variant="outline" size="sm">{course.year}</Badge>
				</div>
				<Heading level={2} size="2xl" class="mb-3">
					{course.title}
				</Heading>
				<Text size="base" variant="secondary">
					{course.description}
				</Text>
				{course.outcomes && (
					<div class="mt-5">
						<p class="text-xs uppercase tracking-widest text-foreground-muted mb-1" style="font-family: 'Besley', serif !important;">Outcomes</p>
						<Text size="base" variant="secondary">{course.outcomes}</Text>
					</div>
				)}
				{(course.required || course.audience) && (
					<div class="mt-4 flex flex-col gap-2">
						{course.required && (
							<p class="text-base" style="font-family: 'Besley', serif !important;">
								<span class="text-foreground-muted">Required: </span>
								<span class="text-foreground-secondary">{course.required}</span>
							</p>
						)}
						{course.audience && (
							<p class="text-base" style="font-family: 'Besley', serif !important;">
								<span class="text-foreground-muted">Audience: </span>
								<span class="text-foreground-secondary">{course.audience}</span>
							</p>
						)}
					</div>
				)}
			</div>

			<!-- Project cards -->
			<div class="grid grid-cols-1 gap-4">
				{(course.projects || []).map((project) => (
					<button
						class="project-card w-full text-left rounded-lg border border-border bg-card overflow-hidden group transition-transform duration-300 hover:scale-[1.01]"
						data-course={courseId(course.code)}
						data-project={project.slug}
						data-project-search={`${course.code} ${course.title} ${project.title} ${project.description} ${(project.threads ?? []).map((thread) => `${thread.title} ${thread.description ?? ''}`).join(' ')}`.toLowerCase()}
					>
							<div class="flex items-stretch min-w-0">
								<!-- Thumbnail -->
								<div class="relative basis-[55%] shrink min-w-0 bg-foreground/5 flex items-center justify-center overflow-hidden rounded-l-lg" style="aspect-ratio: 3840/2426; isolation: isolate;">
								{project.thumbnail ? (
									<img src={urlFor(project.thumbnail).width(1200).auto('format').url()} srcset={`${urlFor(project.thumbnail).width(800).auto('format').url()} 800w, ${urlFor(project.thumbnail).width(1200).auto('format').url()} 1200w, ${urlFor(project.thumbnail).width(1600).auto('format').url()} 1600w, ${urlFor(project.thumbnail).width(2400).auto('format').url()} 2400w`} sizes="(max-width: 1024px) 55vw, 46vw" alt={project.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" data-no-lightbox />
								) : (
									<svg class="w-10 h-10 text-foreground-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								)}
							</div>
							<!-- Text -->
								<div class="flex-1 min-w-0 p-4 lg:p-6 flex flex-col justify-center border-l border-border">
									<p class="text-base text-foreground-muted mb-3 truncate" style="font-family: 'Besley', serif !important;">{course.code} - {course.title}</p>
									<p class="text-fluid-4xl font-normal text-foreground mb-4 leading-tight" style="font-family: 'Besley', serif !important;">{project.title}</p>
								<span class="inline-block text-base text-accent transition-colors duration-200" style="font-family: 'Besley', serif !important;">View Content</span>
							</div>
						</div>
					</button>
				))}
			</div>
			<p class="projects-search-empty hidden mt-5 text-sm text-foreground-muted" style="font-family: 'Besley', serif !important;">
				No project content matches this search.
			</p>
		</div>
	))}

	<!-- Pipeline topic content -->
	{pipeline.map((topic) => (
		<div
			id={`detail-${topic.slug}`}
			class="course-detail-content hidden"
			data-course-search={`${topic.code ?? PIPELINE_CODE} ${topic.title} ${topic.description} ${(topic.threads ?? []).map((thread) => `${thread.title} ${thread.description}`).join(' ')}`.toLowerCase()}
		>
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<Badge variant="accent" size="sm">{topic.code ?? PIPELINE_CODE}</Badge>
					<Badge variant="outline" size="sm">Pipeline</Badge>
				</div>
				<Heading level={2} size="2xl" class="mb-3">
					{topic.title}
				</Heading>
				<Text size="base" variant="secondary">
					{topic.description}
				</Text>
			</div>

			{(topic.threads?.length ?? 0) > 0 ? (
			<!-- Thread cards -->
			<div class="grid grid-cols-1 gap-4">
				{(topic.threads ?? []).map((thread) => (
					<button
						class="project-card w-full text-left rounded-lg border border-border bg-card overflow-hidden group transition-transform duration-300 hover:scale-[1.01]"
						data-course={topic.slug}
						data-project={thread.slug}
						data-project-search={`${topic.title} ${thread.title} ${thread.description}`.toLowerCase()}
					>
							<div class="flex items-stretch min-w-0">
								<!-- Thumbnail -->
								<div class="relative basis-[55%] shrink min-w-0 bg-foreground/5 flex items-center justify-center overflow-hidden rounded-l-lg" style="aspect-ratio: 3840/2426; isolation: isolate;">
								{thread.thumbnail ? (
									<img src={urlFor(thread.thumbnail).width(1200).auto('format').url()} srcset={`${urlFor(thread.thumbnail).width(800).auto('format').url()} 800w, ${urlFor(thread.thumbnail).width(1200).auto('format').url()} 1200w, ${urlFor(thread.thumbnail).width(1600).auto('format').url()} 1600w, ${urlFor(thread.thumbnail).width(2400).auto('format').url()} 2400w`} sizes="(max-width: 1024px) 55vw, 46vw" alt={thread.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" data-no-lightbox />
								) : (
									<svg class="w-10 h-10 text-foreground-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								)}
							</div>
							<!-- Text -->
								<div class="flex-1 min-w-0 p-4 lg:p-6 flex flex-col justify-center border-l border-border">
									<p class="text-base text-foreground-muted mb-3 truncate" style="font-family: 'Besley', serif !important;">{topic.code ?? PIPELINE_CODE} - {topic.title}</p>
									<p class="text-fluid-4xl font-normal text-foreground mb-4 leading-tight" style="font-family: 'Besley', serif !important;">{thread.title}</p>
								<span class="inline-block text-base text-accent transition-colors duration-200" style="font-family: 'Besley', serif !important;">View Content</span>
							</div>
						</div>
					</button>
				))}
			</div>
			) : topic.body ? (
			<!-- Single-page topic (e.g. Glossary): render body directly, no threads -->
			<div class="lecture-block" data-lecture-title={topic.title} data-lecture-subtitle={topic.description} data-lecture-context={topic.code ? `${topic.code} ${topic.title}` : topic.title}>
				<LectureActions />
				<div class="prose prose-lg dark:prose-invert max-w-none lecture-body">
					<PortableText value={topic.body} />
				</div>
			</div>
			) : (
			<div class="aspect-video rounded-lg border border-border bg-foreground/5 flex flex-col items-center justify-center">
				<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
				</svg>
				<span class="text-sm text-foreground-muted">Content coming soon</span>
			</div>
			)}
			<p class="projects-search-empty hidden mt-5 text-sm text-foreground-muted" style="font-family: 'Besley', serif !important;">
				No content matches this search.
			</p>
		</div>
	))}

	<p id="classes-search-empty" class="hidden mt-6 text-sm text-foreground-muted" style="font-family: 'Besley', serif !important;">
		No courses match your search.
	</p>

</div>

<!-- Project detail -->
<div id="project-detail" class="hidden">
	<button id="project-back" class="flex items-center gap-2 text-sm text-foreground-secondary hover:text-accent transition-colors mb-8" style="font-family: 'Besley', serif !important;">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
		</svg>
		Back to Course
	</button>
	{allCourses.flatMap((course) => (course.projects || []).map((project) => (
		<div id={`project-${courseId(course.code)}-${project.slug}`} class:list={["project-detail-content", "hidden", (project.threads?.length ?? 0) === 0 && "max-w-3xl mx-auto"]}>
			<Heading level={2} size="2xl" class="mb-3">{project.title}</Heading>
			<div class="mb-6"><Badge variant="accent" size="sm">{course.code}</Badge></div>
			<Text size="lg" variant="secondary" class="mb-8">{project.description}</Text>
			{(project.threads?.length ?? 0) > 0 ? (
				<!-- Thread cards (course > project > thread drill-down) -->
				<div class="grid grid-cols-1 gap-4">
					{(project.threads ?? []).map((thread) => (
						<button
							class="thread-card w-full text-left rounded-lg border border-border bg-card overflow-hidden group transition-transform duration-300 hover:scale-[1.01]"
							data-course={courseId(course.code)}
							data-project={project.slug}
							data-thread={thread.slug}
						>
							<div class="flex items-stretch min-w-0">
								<!-- Thumbnail -->
								<div class="relative basis-[55%] shrink min-w-0 bg-foreground/5 flex items-center justify-center overflow-hidden rounded-l-lg" style="aspect-ratio: 3840/2426; isolation: isolate;">
									{thread.thumbnail ? (
										<img src={urlFor(thread.thumbnail).width(1200).auto('format').url()} srcset={`${urlFor(thread.thumbnail).width(800).auto('format').url()} 800w, ${urlFor(thread.thumbnail).width(1200).auto('format').url()} 1200w, ${urlFor(thread.thumbnail).width(1600).auto('format').url()} 1600w, ${urlFor(thread.thumbnail).width(2400).auto('format').url()} 2400w`} sizes="(max-width: 1024px) 55vw, 46vw" alt={thread.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" data-no-lightbox />
									) : (
										<svg class="w-10 h-10 text-foreground-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
										</svg>
									)}
								</div>
								<!-- Text -->
								<div class="flex-1 min-w-0 p-4 lg:p-6 flex flex-col justify-center border-l border-border">
									<p class="text-base text-foreground-muted mb-3 truncate" style="font-family: 'Besley', serif !important;">{project.title}</p>
									<p class="text-fluid-4xl font-normal text-foreground mb-4 leading-tight" style="font-family: 'Besley', serif !important;">{thread.title}</p>
									<span class="inline-block text-base text-accent transition-colors duration-200" style="font-family: 'Besley', serif !important;">View Content</span>
								</div>
							</div>
						</button>
					))}
				</div>
			) : project.body ? (
				<div class="lecture-block" data-lecture-title={project.title} data-lecture-subtitle={project.description} data-lecture-context={`${course.code} ${course.title}`} data-lecture-context-accent={project.title}>
					<LectureActions />
					<div class="prose prose-lg dark:prose-invert max-w-none lecture-body"><PortableText value={project.body} /></div>
				</div>
			) : (
				<div class="aspect-video rounded-lg border border-border bg-foreground/5 flex flex-col items-center justify-center">
					<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span class="text-sm text-foreground-muted">Project content coming soon</span>
				</div>
			)}
		</div>
	)))}
	{pipeline.flatMap((topic) => (topic.threads ?? []).map((thread) => (
		<div id={`project-${topic.slug}-${thread.slug}`} class="project-detail-content hidden max-w-3xl mx-auto">
			<Heading level={2} size="2xl" class="mb-3">{thread.title}</Heading>
			<div class="mb-6"><Badge variant="accent" size="sm">{topic.title}</Badge></div>
			<Text size="lg" variant="secondary" class="mb-8">{thread.description}</Text>
			{thread.body ? (
				<div class="lecture-block" data-lecture-title={thread.title} data-lecture-subtitle={thread.description} data-lecture-context={topic.code ? `${topic.code} ${topic.title}` : topic.title} data-lecture-context-accent={thread.title}>
					<LectureActions />
					<div class="prose prose-lg dark:prose-invert max-w-3xl lecture-body"><PortableText value={thread.body} /></div>
				</div>
			) : (
				<div class="aspect-video rounded-lg border border-border bg-foreground/5 flex flex-col items-center justify-center">
					<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span class="text-sm text-foreground-muted">Content coming soon</span>
				</div>
			)}
		</div>
	)))}
</div>

<!-- Thread detail (3rd level: course > project > thread) -->
<div id="thread-detail" class="hidden">
	<button id="thread-back" class="flex items-center gap-2 text-sm text-foreground-secondary hover:text-accent transition-colors mb-8" style="font-family: 'Besley', serif !important;">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
		</svg>
		Back to Project
	</button>
	{allCourses.flatMap((course) => (course.projects || []).flatMap((project) => (project.threads ?? []).map((thread) => (
		<div id={`thread-${courseId(course.code)}-${project.slug}-${thread.slug}`} class="thread-detail-content hidden max-w-3xl mx-auto">
			<Heading level={2} size="2xl" class="mb-3">{thread.title}</Heading>
			<div class="mb-6 flex items-center gap-2">
				<Badge variant="accent" size="sm">{course.code}</Badge>
				<Badge variant="outline" size="sm">{project.title}</Badge>
			</div>
			<Text size="lg" variant="secondary" class="mb-8">{thread.description}</Text>
			{thread.body ? (
				<div class="lecture-block" data-lecture-title={thread.title} data-lecture-subtitle={thread.description} data-lecture-context={`${course.code} ${course.title}`} data-lecture-context-accent={project.title}>
					<LectureActions />
					<div class="prose prose-lg dark:prose-invert max-w-none lecture-body"><PortableText value={thread.body} /></div>
				</div>
			) : (
				<div class="aspect-video rounded-lg border border-border bg-foreground/5 flex flex-col items-center justify-center">
					<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span class="text-sm text-foreground-muted">Content coming soon</span>
				</div>
			)}
		</div>
	))))}
</div>

</div>

<!-- Right sidebar: Chapters (occupies space only when a project with sections is open) -->
<aside id="chapters-aside" class="w-72 shrink-0">
<div class="sticky top-32">
<div id="sidebar-project-chapters" class="hidden">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
Chapters
</Text>
<nav id="sidebar-project-chapters-nav" class="space-y-2 border-l-2 border-foreground-secondary/10 pl-4"></nav>
</div>
</div>
</aside>
</div>

</PageContainer>
</div>
</PageMain>
<Footer />
<ImageLightbox />
<LecturePresenter />
</BaseLayout>

<style>
.learn-nav-link {
	opacity: 0.45;
	transition: opacity 0.15s;
}
.learn-nav-link.active,
.learn-nav-link:hover {
	opacity: 1;
}
.learn-nav-link.active .learn-nav-title {
	color: hsl(var(--accent));
}

/* Right Chapters sidebar only occupies space when a project with sections is open */
#chapters-aside {
	display: none;
}
@media (min-width: 1280px) {
	#chapters-aside.chapters-visible {
		display: block;
	}
}

/* Glossary term deep-link anchors */
.glossary-term-anchor {
	position: relative;
}
.glossary-term-anchor.glossary-anchor-copied::after {
	content: 'Copied!';
	position: absolute;
	left: 50%;
	bottom: 135%;
	transform: translateX(-50%);
	white-space: nowrap;
	font-size: 0.65rem;
	line-height: 1;
	padding: 0.2rem 0.4rem;
	border-radius: 0.25rem;
	background: hsl(var(--foreground));
	color: hsl(var(--background));
	font-family: 'Besley', serif;
	pointer-events: none;
}
.glossary-term-highlight {
	animation: glossary-flash 2.2s ease-out;
}
@keyframes glossary-flash {
	0%, 15% {
		background-color: hsl(var(--accent) / 0.18);
	}
	100% {
		background-color: transparent;
	}
}
</style>

<script>
let coursesPopstateBound = false;
const initCourses = () => {
let applyCourseSearchFilters: (() => void) | null = null;

// --- Shareable deep links (URL <-> open detail) ---
// Course:  /learn#<courseSlug>
// Project: /learn#<courseSlug>/<projectSlug>
// Thread:  /learn#<courseSlug>/<projectSlug>/<threadSlug>
const updateUrl = (courseSlug: string, projectSlug: string | null, threadSlug: string | null = null) => {
let hash = `#${courseSlug}`;
if (projectSlug) hash += `/${projectSlug}`;
if (projectSlug && threadSlug) hash += `/${threadSlug}`;
if (location.hash !== hash) history.pushState(null, '', hash);
};
const restoreFromHash = (): boolean => {
const raw = decodeURIComponent(location.hash.replace(/^#/, ''));
if (!raw) return false;
const [courseSlug, projectSlug, threadSlug] = raw.split('/');
if (!courseSlug || !document.getElementById(`detail-${courseSlug}`)) return false;
openCourseDetail(courseSlug, false);
if (projectSlug) {
if (threadSlug && document.getElementById(`thread-${courseSlug}-${projectSlug}-${threadSlug}`)) {
openProjectDetail(courseSlug, projectSlug, false);
openThreadDetail(courseSlug, projectSlug, threadSlug, false);
} else if (document.getElementById(`project-${courseSlug}-${projectSlug}`)) {
openProjectDetail(courseSlug, projectSlug, false);
} else {
scrollToGlossaryTerm(courseSlug, projectSlug);
}
}
return true;
};

// Scroll to an in-page anchor (e.g. a glossary term) inside an open topic panel.
const scrollToGlossaryTerm = (courseSlug: string, termSlug: string) => {
const panel = document.getElementById(`detail-${courseSlug}`);
const target = panel?.querySelector<HTMLElement>(`[id="${termSlug}"]`);
if (!target) return;
requestAnimationFrame(() => {
target.scrollIntoView({ behavior: 'smooth', block: 'start' });
target.classList.add('glossary-term-highlight');
window.setTimeout(() => target.classList.remove('glossary-term-highlight'), 2200);
});
};

// Turn each glossary term's anchor into a shareable, click-to-copy deep link.
const initGlossaryAnchors = () => {
document.querySelectorAll<HTMLAnchorElement>('.glossary-term-anchor').forEach((anchor) => {
if (anchor.dataset.bound === 'true') return;
const panel = anchor.closest<HTMLElement>('.course-detail-content');
const term = anchor.dataset.term;
if (!panel || !term) return;
const topicSlug = panel.id.replace(/^detail-/, '');
const hash = `#${topicSlug}/${term}`;
anchor.setAttribute('href', hash);
anchor.dataset.bound = 'true';
anchor.addEventListener('click', (e) => {
e.preventDefault();
history.pushState(null, '', hash);
const url = `${location.origin}${location.pathname}${hash}`;
navigator.clipboard?.writeText(url).catch(() => {});
anchor.classList.add('glossary-anchor-copied');
window.setTimeout(() => anchor.classList.remove('glossary-anchor-copied'), 1400);
document.getElementById(term)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
});
};

// --- Sidebar sub-navigation (projects / threads under the active course) ---
const syncSidebarSubnav = (
courseSlug: string,
projectSlug: string | null = null,
threadSlug: string | null = null,
) => {
document.querySelectorAll<HTMLElement>('.course-subnav').forEach((el) => {
el.classList.toggle('hidden', el.dataset.courseSubnav !== courseSlug);
});
document.querySelectorAll<HTMLElement>('.subnav-link').forEach((link) => {
link.classList.toggle(
'active',
link.dataset.course === courseSlug && link.dataset.project === projectSlug,
);
});
document.querySelectorAll<HTMLElement>('.project-subnav').forEach((el) => {
el.classList.toggle(
'hidden',
!(el.dataset.course === courseSlug && el.dataset.project === projectSlug),
);
});
document.querySelectorAll<HTMLElement>('.subnav-thread-link').forEach((link) => {
link.classList.toggle(
'active',
link.dataset.course === courseSlug &&
link.dataset.project === projectSlug &&
link.dataset.thread === threadSlug,
);
});
};

// --- Course drill-down ---
const openCourseDetail = (courseSlug: string, updateHash = true) => {
document.getElementById('project-detail')?.classList.add('hidden');
document.getElementById('thread-detail')?.classList.add('hidden');
document.getElementById('sidebar-project-chapters')?.classList.add('hidden');
document.getElementById('chapters-aside')?.classList.remove('chapters-visible');
const list = document.getElementById('classes-list');
const detail = document.getElementById('classes-detail');
if (!list || !detail) return;
list.classList.add('hidden');
detail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.course-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `detail-${courseSlug}`);
});
document.querySelectorAll<HTMLElement>('.learn-nav-link[data-course-nav="true"]').forEach((link) => {
link.classList.toggle('active', link.dataset.slug === courseSlug);
});
syncSidebarSubnav(courseSlug);
initProjectCards();
if (applyCourseSearchFilters) applyCourseSearchFilters();
if (updateHash) updateUrl(courseSlug, null);
};

// --- Search (courses only) ---
const initCourseSearch = () => {
	const searchInput = document.getElementById('course-search') as HTMLInputElement | null;
	if (!searchInput) return;

	const savedQuery = sessionStorage.getItem('course-search') ?? '';
	searchInput.value = savedQuery;

	const normalize = (value: string) => value.toLowerCase().trim();

	applyCourseSearchFilters = () => {
		const query = normalize(searchInput.value);
		const hasQuery = query.length > 0;

		const classLinks = Array.from(document.querySelectorAll<HTMLElement>('.learn-nav-link[data-course-nav="true"]'));
		const classDetails = Array.from(document.querySelectorAll<HTMLElement>('.course-detail-content'));
		let classMatches = 0;

		classLinks.forEach((link) => {
			const haystack = link.dataset.courseSearch ?? '';
			const match = !hasQuery || haystack.includes(query);
			link.classList.toggle('hidden', !match);
		});

		classDetails.forEach((detail) => {
			const haystack = detail.dataset.courseSearch ?? '';
			const match = !hasQuery || haystack.includes(query);
			detail.dataset.searchMatch = match ? 'true' : 'false';
			if (match) classMatches += 1;

			const projectCards = Array.from(detail.querySelectorAll<HTMLElement>('.project-card'));
			let projectMatches = 0;
			projectCards.forEach((card) => {
				const projectHaystack = card.dataset.projectSearch ?? '';
				const projectMatch = !hasQuery || projectHaystack.includes(query);
				card.classList.toggle('hidden', !projectMatch);
				if (projectMatch) projectMatches += 1;
			});

			const projectEmpty = detail.querySelector<HTMLElement>('.projects-search-empty');
			if (projectEmpty) {
				projectEmpty.classList.toggle('hidden', !hasQuery || projectMatches > 0 || !match);
			}
		});

		const classesEmpty = document.getElementById('classes-search-empty');
		if (classesEmpty) {
			classesEmpty.classList.toggle('hidden', classMatches > 0);
		}

		const activeClassLink = document.querySelector<HTMLElement>('.learn-nav-link[data-course-nav="true"].active');
		const activeSlug = activeClassLink?.dataset.slug;
		const activeDetail = activeSlug ? document.getElementById(`detail-${activeSlug}`) as HTMLElement | null : null;
		const activeMatches = activeDetail?.dataset.searchMatch === 'true';
		const firstVisibleLink = classLinks.find((link) => !link.classList.contains('hidden'));

		if (hasQuery && firstVisibleLink && !activeMatches) {
			openCourseDetail(firstVisibleLink.dataset.slug!, false);
		}
	};

	searchInput.addEventListener('input', () => {
		sessionStorage.setItem('course-search', searchInput.value);
		applyCourseSearchFilters?.();
	});

	searchInput.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && searchInput.value) {
			searchInput.value = '';
			sessionStorage.setItem('course-search', '');
			applyCourseSearchFilters?.();
		}
	});

	applyCourseSearchFilters();
};

let chapterObserver: IntersectionObserver | null = null;
const buildProjectChapterNav = (projectRoot: HTMLElement) => {
const chapterWrap = document.getElementById('sidebar-project-chapters');
const chapterNav = document.getElementById('sidebar-project-chapters-nav');
if (!chapterWrap || !chapterNav) return;

if (chapterObserver) {
chapterObserver.disconnect();
chapterObserver = null;
}

chapterNav.innerHTML = '';
const chaptersAside = document.getElementById('chapters-aside');
const sections = Array.from(projectRoot.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]'));
if (!sections.length) {
chapterWrap.classList.add('hidden');
chaptersAside?.classList.remove('chapters-visible');
return;
}

const setActiveChapter = (id: string) => {
const chapterLinks = Array.from(chapterNav.querySelectorAll<HTMLElement>('.learn-nav-link'));
chapterLinks.forEach((link) => {
const isActive = link.dataset.slug === id;
link.classList.toggle('active', isActive);
const title = link.querySelector<HTMLElement>('.learn-nav-title');
if (!title) return;
title.classList.toggle('text-accent', isActive);
title.classList.toggle('text-foreground-secondary', !isActive);
});
};

sections.forEach((section) => {
const id = section.id;
const label = (section.textContent || id).trim();
const level = Number(section.tagName.slice(1)) || 2;
const link = document.createElement('a');
link.href = `#${id}`;
link.dataset.slug = id;
link.className = 'learn-nav-link block leading-snug group';

const title = document.createElement('span');
title.className = 'learn-nav-title block text-base text-foreground-secondary group-hover:text-accent transition-colors';
title.style.fontFamily = "'Besley', serif";
if (level >= 3) title.style.paddingLeft = `${(level - 2) * 0.9}rem`;
title.textContent = label;
link.appendChild(title);

link.addEventListener('click', (e) => {
e.preventDefault();
setActiveChapter(id);
document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
chapterNav.appendChild(link);
});

chapterWrap.classList.remove('hidden');
chaptersAside?.classList.add('chapters-visible');

chapterObserver = new IntersectionObserver((entries) => {
const visible = entries
.filter((entry) => entry.isIntersecting)
.sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top));
if (!visible.length) return;
const id = (visible[0].target as HTMLElement).id;
setActiveChapter(id);
}, { rootMargin: '-18% 0px -70% 0px' });

sections.forEach((section) => chapterObserver!.observe(section));
if (sections[0]) {
const firstId = sections[0].id;
setActiveChapter(firstId);
}
};

// --- Project drill-down ---
// Track the currently open course/project so thread-level "Back" can return to it.
let activeCourseSlug = '';
let activeProjectSlug = '';

const openProjectDetail = (courseSlug: string, projectSlug: string, updateHash = true) => {
const detail = document.getElementById('classes-detail');
const projectDetail = document.getElementById('project-detail');
if (!detail || !projectDetail) return;
activeCourseSlug = courseSlug;
activeProjectSlug = projectSlug;
detail.classList.add('hidden');
document.getElementById('thread-detail')?.classList.add('hidden');
projectDetail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.project-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `project-${courseSlug}-${projectSlug}`);
});
const activeProject = document.getElementById(`project-${courseSlug}-${projectSlug}`) as HTMLElement | null;
if (activeProject) {
initThreadCards();
buildProjectChapterNav(activeProject);
}
syncSidebarSubnav(courseSlug, projectSlug);
if (updateHash) updateUrl(courseSlug, projectSlug);
};

// --- Thread drill-down (3rd level: course > project > thread) ---
const openThreadDetail = (courseSlug: string, projectSlug: string, threadSlug: string, updateHash = true) => {
const projectDetail = document.getElementById('project-detail');
const threadDetail = document.getElementById('thread-detail');
if (!projectDetail || !threadDetail) return;
projectDetail.classList.add('hidden');
threadDetail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.thread-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `thread-${courseSlug}-${projectSlug}-${threadSlug}`);
});
const activeThread = document.getElementById(`thread-${courseSlug}-${projectSlug}-${threadSlug}`) as HTMLElement | null;
if (activeThread) buildProjectChapterNav(activeThread);
syncSidebarSubnav(courseSlug, projectSlug, threadSlug);
if (updateHash) updateUrl(courseSlug, projectSlug, threadSlug);
};

const initThreadCards = () => {
document.querySelectorAll<HTMLElement>('.thread-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.thread-card').forEach((card) => {
card.addEventListener('click', () => openThreadDetail(card.dataset.course!, card.dataset.project!, card.dataset.thread!));
});
const threadBackBtn = document.getElementById('thread-back');
if (threadBackBtn) {
const freshBack = threadBackBtn.cloneNode(true) as HTMLElement;
threadBackBtn.parentNode?.replaceChild(freshBack, threadBackBtn);
document.getElementById('thread-back')?.addEventListener('click', () => {
openProjectDetail(activeCourseSlug, activeProjectSlug);
});
}
};

const initProjectCards = () => {
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
card.addEventListener('click', () => openProjectDetail(card.dataset.course!, card.dataset.project!));
});
const projectBackBtn = document.getElementById('project-back');
if (projectBackBtn) {
const freshBack = projectBackBtn.cloneNode(true) as HTMLElement;
projectBackBtn.parentNode?.replaceChild(freshBack, projectBackBtn);
document.getElementById('project-back')?.addEventListener('click', () => {
	const activeLink = document.querySelector<HTMLElement>('.learn-nav-link[data-course-nav="true"].active');
openCourseDetail(activeLink?.dataset.slug || 'angd-1314');
});
}
};

// Course cards
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
card.addEventListener('click', () => openCourseDetail(card.dataset.course!));
});

// Sidebar nav for Courses & Pipeline opens detail directly
document.querySelectorAll<HTMLElement>('.learn-nav-link[data-course-nav="true"]').forEach((link) => {
const fresh = link.cloneNode(true) as HTMLElement;
link.parentNode?.replaceChild(fresh, link);
});
document.querySelectorAll<HTMLElement>('.learn-nav-link[data-course-nav="true"]').forEach((link) => {
link.addEventListener('click', (e) => {
e.preventDefault();
openCourseDetail(link.dataset.slug!);
});
});

// Sidebar sub-nav: project links (and pipeline threads) open the project/thread detail.
document.querySelectorAll<HTMLElement>('.subnav-link').forEach((link) => {
link.addEventListener('click', (e) => {
e.preventDefault();
openProjectDetail(link.dataset.course!, link.dataset.project!);
});
});
document.querySelectorAll<HTMLElement>('.subnav-thread-link').forEach((link) => {
link.addEventListener('click', (e) => {
e.preventDefault();
openThreadDetail(link.dataset.course!, link.dataset.project!, link.dataset.thread!);
});
});

initCourseSearch();
initGlossaryAnchors();
if (!restoreFromHash()) {
openCourseDetail('angd-1314', false);
}

if (!coursesPopstateBound) {
coursesPopstateBound = true;
window.addEventListener('popstate', () => {
if (!restoreFromHash()) openCourseDetail('angd-1314', false);
});
}
};

initCourses();
document.addEventListener('astro:after-swap', initCourses);
</script>
