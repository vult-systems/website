---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import alienBustThumb from '@/assets/courses/organic-modeling/alien-bust/cg-alienbust-thumb-01.png';
import { getLearnPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';
import mayaLogoImg from '@/assets/logos/software-autodesk-maya-logo-01.png';
import pythonLogoImg from '@/assets/logos/programming-python-logo.png';

// Server-side Python syntax highlighter (Kanagawa Dragon colors)
const seo = getLearnPageSEO();

// -------------------------------------------------------------------
// Syllabus & Assignment Images
// -------------------------------------------------------------------
// To add a syllabus thumbnail for a course:
//   1. Drop a screenshot/image into src/assets/learn/syllabi/
//      e.g. angd-1312-syllabus.png
//   2. Import it here:
//      import syllabus1312 from '@/assets/learn/syllabi/angd-1312-syllabus.png';
//   3. Add it to the matching course below:
//      { code: 'ANGD 1312', title: '...', syllabus: syllabus1312 }
//
// To add assignment thumbnails for a course:
//   1. Drop images into src/assets/learn/assignments/
//      e.g. angd-1312-assign-01.png
//   2. Import them here:
//      import assign1312_01 from '@/assets/learn/assignments/angd-1312-assign-01.png';
//   3. Add them to the matching course:
//      { code: 'ANGD 1312', title: '...', assignments: [
//          { image: assign1312_01, title: 'Assignment 1' },
//      ]}
// -------------------------------------------------------------------

interface CourseAssignment {
	image: ImageMetadata;
	title: string;
}

interface CourseProject {
	slug: string;
	title: string;
	description: string;
	thumbnail?: ImageMetadata;
}

interface Course {
	code: string;
	title: string;
	description: string;
	outcomes?: string;
	required?: string;
	audience?: string;
	syllabus?: ImageMetadata;
	assignments?: CourseAssignment[];
	projects?: CourseProject[];
}

interface CurriculumYear {
	year: string;
	courses: Course[];
}

// Curriculum organized by year
const curriculum: CurriculumYear[] = [
	{
		year: 'Freshman',
		courses: [
			{
				code: 'ANGD 1314',
				title: 'Organic Modeling',
				description: 'This beginner-level studio course offers an overview of character sculpting and modeling techniques, laying the foundation for creating detailed, production-ready 3D character sculptures. It blends traditional art principles with a technical approach to mastering ZBrush for both organic and hard surface techniques.',
				required: 'Graphic Tablet and Hard-drive or USB/C Storage Device',
				audience: 'This is a Freshman level course required of ANGD BFA majors.',
				projects: [
					{ slug: 'alien-bust', title: 'Alien Bust', description: '', thumbnail: alienBustThumb },
					{ slug: 'elemental-golem', title: 'Elemental Golem', description: '' },
					{ slug: 'nerf-gun', title: 'Nerf Gun', description: '' },
					{ slug: 'bipedal-character', title: 'Bipedal Character', description: '' },
				],
			},
		],
	},
	{
		year: 'Sophomore',
		courses: [
			{
				code: 'ANGD 1380',
				title: 'Anatomy for 3D Artists',
				description: 'This lecture course develops anatomical knowledge for artists and animators, with a focus on superficial human anatomy, including major muscle groups, skeletal structures, and surface forms of the body.',
				required: 'Graphic Tablet and Hard-drive or USB/C Storage Device',
				audience: 'This is a Sophomore level course required of ANGD BFA majors.',
				projects: [
					{ slug: 'skeletal-study', title: 'Skeletal Reference Study', description: 'Model a skeletal reference for animation study.' },
					{ slug: 'muscle-groups', title: 'Muscle Group Analysis', description: 'Layer primary muscle groups over a base skeleton.' },
					{ slug: 'gesture-figure', title: 'Gesture & Figure', description: 'Dynamic figure study focusing on movement and weight.' },
				],
			},
		],
	},
	{
		year: 'Sophomore / Junior',
		courses: [
			{
				code: 'ANGD 2333 · 2334 · 3331',
				title: 'Environment Production I–III',
				description: 'This progressive studio course sequence develops the skills required to create production-ready 3D environments for both real-time and offline workflows. Students explore modular workflows, hard-surface and organic asset creation, materials, lighting, composition, optimization, world-building, and engine integration while producing increasingly complex environments for games and cinematic applications.',
				required: 'Graphic Tablet and Hard-drive or USB/C Storage Device',
				audience: 'This is a Sophomore–Junior level course required of ANGD BFA majors.',
				projects: [
					{ slug: 'trim-sheet', title: 'Trim Sheet Design', description: 'Create a production-ready trim sheet for an environment set.' },
					{ slug: 'modular-kit', title: 'Modular Kit', description: 'Build a modular architecture kit for real-time use.' },
					{ slug: 'hero-prop', title: 'Hero Prop', description: 'Fully textured hero asset with LODs.' },
					{ slug: 'full-scene', title: 'Full Scene Assembly', description: 'A complete, lit environment built from the semester\'s assets.' },
				],
			},
			{
				code: 'ANGD 2361 · 3361 · 3362',
				title: 'Character Modeling I–III',
				description: 'This progressive studio course sequence focuses on the creation of production-ready 3D characters for both real-time and offline workflows. Students develop skills in anatomy, sculpting, topology, clothing, materials, grooming, optimization, and rigging while advancing from foundational character principles to fully realized, industry-centric character art.',
				required: 'Graphic Tablet and Hard-drive or USB/C Storage Device',
				audience: 'This is a Sophomore–Junior level course required of ANGD BFA majors.',
				projects: [
					{ slug: 'base-mesh', title: 'Base Mesh', description: '' },
					{ slug: 'highpoly-sculpt', title: 'High-Poly Sculpt', description: '' },
					{ slug: 'retopology', title: 'Retopology', description: '' },
					{ slug: 'texturing', title: 'Texturing', description: '' },
					{ slug: 'final-character', title: 'Final Character', description: '' },
				],
			},
		],
	},
];

// Student Work Gallery
interface StudentPiece {
	student: string;
	title: string;
	course: string;
	year: string;
	portfolio?: string;   // URL to student's portfolio
	video?: string;       // Path to video in public/ (e.g. '/student-work/file.mp4')
	// image?: ImageMetadata;  // Uncomment and import when adding real images
}

const studentWork: StudentPiece[] = [
	// -------------------------------------------------------------------
	// To add real student work:
	//   Videos: Drop MP4s into public/student-work/ and set video path
	//   Images: Drop into src/assets/learn/student-work/, import, add image prop
	// -------------------------------------------------------------------
	{ student: 'Annamarie Alvarez', title: 'Space Cat Turnaround', course: 'ANGD 2361', year: '2025', portfolio: 'https://annamariealvarez.com/characters', video: '/student-work/Alvarez-Space-Cat-Turnaround.mp4' },
	{ student: 'Annamarie Alvarez', title: 'Finn Turnaround', course: 'ANGD 2361', year: '2025', portfolio: 'https://annamariealvarez.com/characters', video: '/student-work/Alvarez-Finn-Turnaround.mp4' },
	{ student: 'Student Name', title: 'Hard Surface Asset', course: 'ANGD 1312', year: '2025' },
	{ student: 'Student Name', title: 'Sculpt Study', course: 'ANGD 1314', year: '2025' },
	{ student: 'Student Name', title: 'Character Design', course: 'ANGD 3361', year: '2025' },
	{ student: 'Student Name', title: 'Thesis Project', course: 'ANGD 4360', year: '2025' },
	{ student: 'Student Name', title: 'Armor Set', course: 'ANGD 3362', year: '2024' },
	{ student: 'Student Name', title: 'Environment Diorama', course: 'ANGD 3332', year: '2024' },
	{ student: 'Student Name', title: 'Anatomy Study', course: 'ANGD 1380', year: '2024' },
];

// Resources
interface ResourceItem {
	name: string;
	description: string;
	download?: string;
	previewHtml?: string;
	previewLang?: string;
	logos?: ImageMetadata[];
}

interface ResourceSubsection {
	label: string;
	items: ResourceItem[];
}

const resources: { category: string; items?: ResourceItem[]; subsections?: ResourceSubsection[] }[] = [
	{
		category: 'Maya',
		subsections: [
			{
				label: 'Scripts',
				items: [
			{ name: 'Purge Redshift Nodes', description: 'Removes the Redshift unsupported nodes popup and error when opening scenes in Maya without Redshift installed.', download: '/downloads/maya-purge-redshift-nodes.py', previewLang: 'python', logos: [mayaLogoImg, pythonLogoImg], previewHtml: `<span class="hl-keyword">import</span> maya.<span class="hl-builtin">cmds</span> <span class="hl-keyword">as</span> <span class="hl-builtin">cmds</span>

<span class="hl-keyword">def</span> <span class="hl-decorator">purge_redshift_from_loaded_scene</span>():
    deleted = []

    <span class="hl-comment"># Get ALL nodes by name pattern (not type-based)</span>
    all_nodes = <span class="hl-builtin">cmds</span>.ls(long=<span class="hl-keyword">True</span>) <span class="hl-keyword">or</span> []

    <span class="hl-keyword">for</span> n <span class="hl-keyword">in</span> all_nodes:
        <span class="hl-keyword">try</span>:
            <span class="hl-keyword">if</span> <span class="hl-string">"redshift"</span> <span class="hl-keyword">in</span> n.lower():
                <span class="hl-builtin">cmds</span>.lockNode(n, lock=<span class="hl-keyword">False</span>)
                <span class="hl-builtin">cmds</span>.delete(n)
                deleted.append(n)
        <span class="hl-keyword">except</span>:
            <span class="hl-keyword">pass</span>

    <span class="hl-comment"># Also remove unknown nodes (fallback safety)</span>
    unknown = <span class="hl-builtin">cmds</span>.ls(<span class="hl-builtin">type</span>=<span class="hl-string">"unknown"</span>) <span class="hl-keyword">or</span> []
    <span class="hl-keyword">for</span> n <span class="hl-keyword">in</span> unknown:
        <span class="hl-keyword">try</span>:
            t = <span class="hl-builtin">cmds</span>.unknownNode(n, q=<span class="hl-keyword">True</span>, typeName=<span class="hl-keyword">True</span>)
            <span class="hl-keyword">if</span> t <span class="hl-keyword">and</span> <span class="hl-string">"redshift"</span> <span class="hl-keyword">in</span> t.lower():
                <span class="hl-builtin">cmds</span>.delete(n)
                deleted.append(n)
        <span class="hl-keyword">except</span>:
            <span class="hl-keyword">pass</span>

    <span class="hl-builtin">print</span>(<span class="hl-string">"\\n=== PURGE COMPLETE ==="</span>)
    <span class="hl-builtin">print</span>(<span class="hl-string">"Deleted:"</span>, <span class="hl-builtin">len</span>(deleted))
    <span class="hl-keyword">for</span> d <span class="hl-keyword">in</span> deleted:
        <span class="hl-builtin">print</span>(<span class="hl-string">" -"</span>, d)

<span class="hl-decorator">purge_redshift_from_loaded_scene</span>()` },
				],
			},
			{
				label: 'Languages',
				items: [
					{ name: 'Python', description: 'Scripting for Maya, pipeline tools, and automation' },
					{ name: 'MEL', description: 'Maya Embedded Language for quick automation' },
				],
			},
		],
	},
	{
		category: 'Sculpting',
		items: [
			{ name: 'ZBrush', description: 'High-resolution digital sculpting and detailing' },
			{ name: 'Blender', description: 'Open-source 3D creation suite' },
		],
	},
	{
		category: 'Texturing',
		items: [
			{ name: 'Substance 3D Painter', description: 'PBR texturing and material authoring' },
			{ name: 'Substance 3D Designer', description: 'Procedural material creation' },
			{ name: 'Marmoset Toolbag', description: 'Real-time rendering and baking' },
		],
	},
	{
		category: 'Engines',
		items: [
			{ name: 'Unreal Engine 5', description: 'Real-time rendering, Nanite, Lumen, and MetaHumans' },
			{ name: 'Unity', description: 'Cross-platform real-time engine' },
		],
	},
	{
		category: 'Pipeline',
		items: [
			{ name: 'Git', description: 'Version control for collaborative projects' },
		],
	},
];

// Flatten all courses for sidebar nav
const allCourses = curriculum.flatMap(level =>
	level.courses.map(c => ({ ...c, year: level.year }))
);
const courseId = (code: string) => code.toLowerCase().replace(/\s+/g, '-');
const resourceId = (category: string) => category.toLowerCase().replace(/[\s&]+/g, '-');
const studentId = (piece: StudentPiece) => `student-${piece.student.toLowerCase().replace(/\s+/g, '-')}-${piece.title.toLowerCase().replace(/\s+/g, '-')}`;
---


<BaseLayout 
title={seo.title} 
description={seo.description}
keywords={seo.keywords}
>
<Header />
<PageMain class="text-foreground">
<!-- Page Header with Background -->
<div class="relative w-full py-8 sm:py-10">
<div class="absolute inset-0 -z-10 overflow-hidden">
<Image
src={heroBg}
alt=""
class="w-full h-full object-cover object-center"
loading="eager"
widths={[800, 1200, 1920]}
/>
<div class="absolute inset-0 bg-white/85 dark:bg-black/85"></div>
</div>
<PageContainer>
<Heading level={1} size="4xl" class="mb-4">
Learn
</Heading>
<Text size="lg" variant="secondary" class="mb-4">
A hub for my academic work, curriculum, and the courses I teach. Everything from introductory modeling and anatomy 
to game history and senior thesis production. Below you'll find courses I've created, revised, or taught, along with student work and the tools and resources we use in the program.
</Text>
</PageContainer>
</div>

<div class="relative z-10 w-full py-8 sm:py-12">
<PageContainer>

<!-- WIP Banner -->
<div class="mb-8 flex items-center gap-3 rounded-md border border-accent/30 bg-accent/5 px-4 py-3">
	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
	</svg>
	<p class="text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;">
		Currently undergoing active updates. New content and changes are being made as you read this!
	</p>
</div>
<div class="mb-10 overflow-x-auto -mx-6 px-6 sm:mx-0 sm:px-0">
<div class="flex gap-6 border-b-2 border-foreground-secondary/10 whitespace-nowrap min-w-max sm:min-w-0">
<button class="learn-tab pb-3 text-base text-accent border-b-2 border-accent -mb-[2px] transition-colors" data-tab="classes" style="font-family: 'Besley', serif !important;">
Classes
</button>
<button class="learn-tab pb-3 text-base text-foreground-secondary border-b-2 border-transparent -mb-[2px] hover:text-accent transition-colors" data-tab="student-work" style="font-family: 'Besley', serif !important;">
Student Work
</button>
<button class="learn-tab pb-3 text-base text-foreground-secondary border-b-2 border-transparent -mb-[2px] hover:text-accent transition-colors" data-tab="tools" style="font-family: 'Besley', serif !important;">
Tools & Resources
</button>
</div>
</div>

<!-- Content with Sidebar -->
<div class="flex gap-12 lg:gap-16 relative">

<!-- Sidebar -->
<aside class="hidden lg:block w-72 shrink-0">
<div class="sticky top-32">

<!-- Sidebar: Classes -->
<div id="sidebar-classes" class="learn-sidebar">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
Courses
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{allCourses.map((course) => (
<a
href={`#${courseId(course.code)}`}
class="learn-nav-link block leading-snug group"
data-slug={courseId(course.code)}
>
<span class="block text-base font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{course.title}</span>
</a>
))}
</nav>
</div>

<!-- Sidebar: Student Work -->
<div id="sidebar-student-work" class="learn-sidebar hidden">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
	Artists
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{studentWork.filter((piece, index, arr) => arr.findIndex(p => p.student === piece.student) === index).map((piece) => (
<a
href={`#${studentId(piece)}`}
class="learn-nav-link block leading-snug group"
data-slug={studentId(piece)}
>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{piece.student}</span>
</a>
))}
</nav>
</div>

<!-- Sidebar: Tools -->
<div id="sidebar-tools" class="learn-sidebar hidden">
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
Categories
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{resources.map((group) => (
<a
href={`#${resourceId(group.category)}`}
class="learn-nav-link block leading-snug group"
data-slug={resourceId(group.category)}
>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{group.category}</span>
</a>
))}
</nav>
</div>

</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">

<!-- Panel: Classes -->
<div id="panel-classes" class="learn-panel">

	<!-- Course list -->
	<div id="classes-list" class="space-y-3 hidden">
		{allCourses.map((course) => (
			<button
				class="course-card w-full text-left rounded-lg border border-border bg-card hover:border-accent/50 hover:bg-foreground/[0.03] transition-all p-5 group"
				data-course={courseId(course.code)}
			>
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						<div class="flex items-center gap-2 mb-2">
							<span class="text-xs font-medium text-accent" style="font-family: 'Besley', serif !important;">{course.code}</span>
							<span class="text-xs text-foreground-muted">{course.year}</span>
						</div>
						<p class="text-base font-medium text-foreground mb-1" style="font-family: 'Besley', serif !important;">{course.title}</p>
						<p class="text-sm text-foreground-secondary line-clamp-2">{course.description}</p>
					</div>
					<svg class="w-5 h-5 text-foreground-muted group-hover:text-accent transition-colors shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
					</svg>
				</div>
			</button>
		))}
	</div>

	<!-- Course detail -->
	<div id="classes-detail">

		<!-- Dynamic course content -->
		{allCourses.map((course) => (
			<div id={`detail-${courseId(course.code)}`} class="course-detail-content hidden">
				<div class="mb-8">
					<div class="flex items-center gap-3 mb-3">
						<Badge variant="accent" size="sm">{course.code}</Badge>
						<Badge variant="outline" size="sm">{course.year}</Badge>
					</div>
					<Heading level={2} size="2xl" class="mb-3">
						{course.title}
					</Heading>
					<Text size="base" variant="secondary">
						{course.description}
					</Text>
					{course.outcomes && (
						<div class="mt-5">
							<p class="text-xs uppercase tracking-widest text-foreground-muted mb-1" style="font-family: 'Besley', serif !important;">Outcomes</p>
							<Text size="base" variant="secondary">{course.outcomes}</Text>
						</div>
					)}
					{(course.required || course.audience) && (
						<div class="mt-4 flex flex-col gap-2">
							{course.required && (
								<p class="text-base" style="font-family: 'Besley', serif !important;">
									<span class="text-foreground-muted">Required: </span>
									<span class="text-foreground-secondary">{course.required}</span>
								</p>
							)}
							{course.audience && (
								<p class="text-base" style="font-family: 'Besley', serif !important;">
									<span class="text-foreground-muted">Audience: </span>
									<span class="text-foreground-secondary">{course.audience}</span>
								</p>
							)}
						</div>
					)}
				</div>

				<!-- Project cards -->
				<div class="grid grid-cols-1 gap-4">
					{(course.projects || []).map((project) => (
						<button
							class="project-card w-full text-left rounded-lg border border-border bg-card overflow-hidden group transition-transform duration-300 hover:scale-[1.01]"
							data-course={courseId(course.code)}
							data-project={project.slug}
						>
								<div class="flex items-stretch min-w-0">
									<!-- Thumbnail -->
									<div class="relative basis-[55%] shrink min-w-0 bg-foreground/5 flex items-center justify-center overflow-hidden rounded-l-lg" style="aspect-ratio: 3840/2426; isolation: isolate;">
									{project.thumbnail ? (
										<Image src={project.thumbnail} alt={project.title} class="absolute inset-0 w-full h-full object-cover" data-no-lightbox />
									) : (
										<svg class="w-10 h-10 text-foreground-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
										</svg>
									)}
								</div>
								<!-- Text -->
									<div class="flex-1 min-w-0 p-4 lg:p-6 flex flex-col justify-center border-l border-border">
										<p class="text-base text-foreground-muted mb-3 truncate" style="font-family: 'Besley', serif !important;">{course.code} - {course.title}</p>
										<p class="text-fluid-4xl font-normal text-foreground mb-4 leading-tight" style="font-family: 'Besley', serif !important;">{project.title}</p>
									<span class="inline-block text-base text-accent transition-colors duration-200" style="font-family: 'Besley', serif !important;">View Content</span>
								</div>
							</div>
						</button>
					))}
				</div>
			</div>
		))}

	</div>

	<!-- Project detail -->
	<div id="project-detail" class="hidden">
		<button id="project-back" class="flex items-center gap-2 text-sm text-foreground-secondary hover:text-accent transition-colors mb-8" style="font-family: 'Besley', serif !important;">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
			</svg>
			Back to Course
		</button>
		{allCourses.flatMap((course) => (course.projects || []).map((project) => (
			<div id={`project-${courseId(course.code)}-${project.slug}`} class="project-detail-content hidden">
				<Heading level={2} size="2xl" class="mb-3">{project.title}</Heading>
				<div class="mb-6"><Badge variant="accent" size="sm">{course.code}</Badge></div>
				<Text size="lg" variant="secondary" class="mb-8">{project.description}</Text>
				<div class="aspect-video rounded-lg border border-border bg-foreground/5 flex flex-col items-center justify-center">
					<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span class="text-sm text-foreground-muted">Project content coming soon</span>
				</div>
			</div>
		)))}
	</div>

</div>

<!-- Panel: Student Work -->
<div id="panel-student-work" class="learn-panel hidden">

<div class="grid sm:grid-cols-2 gap-6" id="student-grid">
{studentWork.map((piece) => (
<div
class="student-item"
data-year={piece.year}
id={studentId(piece)}
>
<Card variant="bordered" padding="none">
{piece.video ? (
<div class="video-lightbox-trigger relative bg-foreground/5 rounded-t-md overflow-hidden cursor-pointer" data-video={piece.video}>
<video
src={piece.video}
class="w-full h-auto pointer-events-none"
loop
muted
playsinline
preload="none"
data-autoplay
></video>
<div class="absolute inset-0 flex items-center justify-center transition-opacity bg-transparent hover:bg-black/20 group">
<svg class="w-12 h-12 text-white/80 opacity-0 hover:opacity-100 transition-opacity drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
<path d="M8 5v14l11-7z" />
</svg>
</div>
</div>
) : (
<div class="learn-lightbox-trigger relative aspect-[4/3] bg-foreground/5 flex flex-col items-center justify-center cursor-pointer hover:bg-foreground/10 transition-all" data-label={`${piece.student} — ${piece.title}`}>
<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
</svg>
<span class="text-xs text-foreground-muted">Image Coming Soon</span>
</div>
)}
<div class="p-4 space-y-2">
<Text variant="primary" size="sm" class="font-medium">{piece.student}</Text>
<Text variant="muted" size="sm">{piece.title}</Text>
<div class="flex flex-col gap-1.5">
	{piece.portfolio ? (
		<a href={piece.portfolio} target="_blank" rel="noopener noreferrer">
			<Badge size="sm" variant="accent" class="self-start">Portfolio</Badge>
		</a>
	) : (
		<Badge size="sm" variant="accent" class="self-start">{piece.course}</Badge>
	)}
</div>
</div>
</Card>
</div>
))}
</div>
</div>

<!-- Panel: Tools & Resources -->
<div id="panel-tools" class="learn-panel hidden">
{resources.map((group, index) => (
<article id={resourceId(group.category)} class="learn-entry scroll-mt-32">
{index > 0 && (
<div class="border-t-2 border-foreground-secondary/10 my-12"></div>
)}
<Heading level={2} size="2xl" class="mb-6">
{group.category}
</Heading>
{group.subsections ? (
	<div class="space-y-8">
		{group.subsections.map((sub) => (
			<div>
				<Text variant="secondary" size="xs" class="uppercase tracking-widest mb-3 block">{sub.label}</Text>
				<div class="grid sm:grid-cols-2 gap-4">
					{sub.items.map((item) => (
					<div class="flex flex-col justify-between gap-3 rounded-md border border-border bg-card p-4 transition-transform duration-300 hover:scale-[1.01]">
						<div>
							<div class="flex items-center justify-between gap-2 mb-1">
								<Text variant="primary" size="sm" class="font-medium">{item.name}</Text>
								<div class="flex items-center gap-2">
									{item.logos && item.logos.map((logo) => (
										<Image src={logo} alt="" width={48} height={20} class="h-4 w-auto object-contain" data-no-lightbox />
									))}
								</div>
							</div>
							<Text variant="muted" size="sm">{item.description}</Text>
							{item.previewHtml && (
								<div class="mt-3 rounded-md border border-border overflow-hidden">
									<div class="flex items-center justify-between px-3 py-1.5 bg-foreground/5 border-b border-border">
										<span class="text-xs text-foreground-muted font-mono">{item.previewLang ?? ''}</span>
										<button
											class="copy-btn text-xs text-foreground-muted hover:text-accent transition-colors font-mono"
											data-code={item.previewHtml.replace(/<[^>]+>/g, '')}
										>Copy</button>
									</div>
									<pre class="code-block p-3 text-xs font-mono overflow-auto max-h-52 leading-relaxed m-0"><code set:html={item.previewHtml} /></pre>
								</div>
							)}
						</div>
						{item.download && (
							<a href={item.download} download class="inline-flex items-center gap-1.5 text-xs text-foreground-secondary hover:text-accent transition-colors self-start" style="font-family: 'Besley', serif !important;">
								<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
								</svg>
								Download
							</a>
						)}
					</div>
					))}
				</div>
			</div>
		))}
	</div>
) : (
	<div class="grid sm:grid-cols-2 gap-4">
	{(group.items ?? []).map((item) => (
	<div class="flex flex-col justify-between gap-3 rounded-md border border-border bg-card p-4 transition-transform duration-300 hover:scale-[1.01]">
		<div>
			<div class="flex items-center justify-between gap-2 mb-1">
				<Text variant="primary" size="sm" class="font-medium">{item.name}</Text>
				<div class="flex items-center gap-2">
					{item.logos && item.logos.map((logo) => (
						<Image src={logo} alt="" width={48} height={20} class="h-4 w-auto object-contain" data-no-lightbox />
					))}
				</div>
			</div>
			<Text variant="muted" size="sm">{item.description}</Text>
			{item.previewHtml && (
				<div class="mt-3 rounded-md border border-border overflow-hidden">
					<div class="flex items-center justify-between px-3 py-1.5 bg-foreground/5 border-b border-border">
						<span class="text-xs text-foreground-muted font-mono">{item.previewLang ?? ''}</span>
						<button
							class="copy-btn text-xs text-foreground-muted hover:text-accent transition-colors font-mono"
							data-code={item.previewHtml.replace(/<[^>]+>/g, '')}
						>Copy</button>
					</div>
					<pre class="code-block p-3 text-xs font-mono overflow-auto max-h-52 leading-relaxed m-0"><code set:html={item.previewHtml} /></pre>
				</div>
			)}
		</div>
		{item.download && (
			<a href={item.download} download class="inline-flex items-center gap-1.5 text-xs text-foreground-secondary hover:text-accent transition-colors self-start" style="font-family: 'Besley', serif !important;">
				<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
				</svg>
				Download
			</a>
		)}
	</div>
	))}
	</div>
)}
</article>
))}
</div>

</div>
</div>


</PageContainer>
</div>
</PageMain>
<Footer />
<ImageLightbox />
</BaseLayout>

<style>
.learn-nav-link {
	opacity: 0.45;
	transition: opacity 0.15s;
}
.learn-nav-link.active,
.learn-nav-link:hover {
	opacity: 1;
}
/* Code block — uses site theme colors */
.code-block { background: hsl(var(--card-bg)); color: hsl(var(--foreground)); margin: 0 !important; border-radius: 0 !important; }
</style>

<script>
const initLearn = () => {

// --- Copy buttons ---
document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    const code = btn.dataset.code ?? '';
    navigator.clipboard.writeText(code).then(() => {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
});

// --- Video autoplay via IntersectionObserver ---
const videoObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    const video = entry.target as HTMLVideoElement;
    if (entry.isIntersecting) {
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  });
}, { threshold: 0.25 });

document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
  videoObserver.observe(video);
});

// --- Tab switching ---
const tabs = document.querySelectorAll<HTMLElement>('.learn-tab');
const panels = document.querySelectorAll<HTMLElement>('.learn-panel');
const sidebars = document.querySelectorAll<HTMLElement>('.learn-sidebar');

tabs.forEach((tab) => {
const fresh = tab.cloneNode(true) as HTMLElement;
tab.parentNode?.replaceChild(fresh, tab);
});

document.querySelectorAll<HTMLElement>('.learn-tab').forEach((tab) => {
tab.addEventListener('click', () => {
const target = tab.dataset.tab!;

document.querySelectorAll<HTMLElement>('.learn-tab').forEach((t) => {
t.classList.remove('text-accent', 'border-accent');
t.classList.add('text-foreground-secondary', 'border-transparent');
});
tab.classList.remove('text-foreground-secondary', 'border-transparent');
tab.classList.add('text-accent', 'border-accent');

panels.forEach((panel) => {
panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
});
sidebars.forEach((sidebar) => {
sidebar.classList.toggle('hidden', sidebar.id !== `sidebar-${target}`);
});

// Re-init scroll observer for the new active panel
initScrollSpy();
});
});

// --- Scroll spy for sidebar nav ---
let observer: IntersectionObserver | null = null;
const initScrollSpy = () => {
if (observer) observer.disconnect();
const entries = document.querySelectorAll<HTMLElement>('.learn-entry');
const navLinks = document.querySelectorAll<HTMLElement>('.learn-nav-link');
if (!entries.length || !navLinks.length) return;

observer = new IntersectionObserver(
(observed) => {
observed.forEach((entry) => {
if (entry.isIntersecting) {
const id = entry.target.id;
navLinks.forEach((link) => {
link.classList.toggle('active', link.dataset.slug === id);
});
}
});
},
{ rootMargin: '-20% 0px -60% 0px' }
);
entries.forEach((entry) => observer!.observe(entry));
};
initScrollSpy();

// --- Course drill-down ---
const openCourseDetail = (courseSlug: string) => {
document.getElementById('project-detail')?.classList.add('hidden');
const list = document.getElementById('classes-list');
const detail = document.getElementById('classes-detail');
if (!list || !detail) return;
list.classList.add('hidden');
detail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.course-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `detail-${courseSlug}`);
});
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
link.classList.toggle('active', link.dataset.slug === courseSlug);
});
initLearnLightbox();
initProjectCards();
};

const closeCourseDetail = () => {
const list = document.getElementById('classes-list');
const detail = document.getElementById('classes-detail');
if (!list || !detail) return;
detail.classList.add('hidden');
list.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((l) => l.classList.remove('active'));
};

// --- Project drill-down ---
const openProjectDetail = (courseSlug: string, projectSlug: string) => {
const detail = document.getElementById('classes-detail');
const projectDetail = document.getElementById('project-detail');
if (!detail || !projectDetail) return;
detail.classList.add('hidden');
projectDetail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.project-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `project-${courseSlug}-${projectSlug}`);
});
};

const initProjectCards = () => {
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
card.addEventListener('click', () => openProjectDetail(card.dataset.course!, card.dataset.project!));
});
const projectBackBtn = document.getElementById('project-back');
if (projectBackBtn) {
const freshBack = projectBackBtn.cloneNode(true) as HTMLElement;
projectBackBtn.parentNode?.replaceChild(freshBack, projectBackBtn);
document.getElementById('project-back')?.addEventListener('click', () => {
const activeLink = document.querySelector<HTMLElement>('#sidebar-classes .learn-nav-link.active');
openCourseDetail(activeLink?.dataset.slug || 'angd-1314');
});
}
};

// Course cards
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
card.addEventListener('click', () => openCourseDetail(card.dataset.course!));
});

// Back button
const backBtn = document.getElementById('classes-back');
if (backBtn) {
const freshBack = backBtn.cloneNode(true) as HTMLElement;
backBtn.parentNode?.replaceChild(freshBack, backBtn);
document.getElementById('classes-back')?.addEventListener('click', closeCourseDetail);
}

// Sidebar nav for Classes opens detail directly
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
const fresh = link.cloneNode(true) as HTMLElement;
link.parentNode?.replaceChild(fresh, link);
});
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
link.addEventListener('click', (e) => {
e.preventDefault();
openCourseDetail(link.dataset.slug!);
});
});

// --- Lightbox placeholders ---
const initLearnLightbox = () => {
document.querySelectorAll('.learn-lightbox-trigger').forEach((trigger) => {
const fresh = trigger.cloneNode(true);
trigger.parentNode?.replaceChild(fresh, trigger);
});
document.querySelectorAll<HTMLElement>('.learn-lightbox-trigger').forEach((trigger) => {
trigger.addEventListener('click', () => {
const lightbox = document.getElementById('lightbox');
const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
const imageWrapper = document.getElementById('image-wrapper');
if (!lightbox || !lightboxImage || !imageWrapper) return;
const label = trigger.dataset.label || 'Preview';
const canvas = document.createElement('canvas');
canvas.width = 800; canvas.height = 1000;
const ctx = canvas.getContext('2d');
if (ctx) {
const isDark = document.documentElement.classList.contains('dark');
ctx.fillStyle = isDark ? '#1a1a1a' : '#f0f0f0';
ctx.fillRect(0, 0, 800, 1000);
ctx.strokeStyle = isDark ? '#333' : '#ccc';
ctx.lineWidth = 2;
ctx.strokeRect(20, 20, 760, 960);
ctx.fillStyle = isDark ? '#888' : '#666';
ctx.font = '24px system-ui, sans-serif';
ctx.textAlign = 'center';
ctx.fillText(label, 400, 480);
ctx.font = '16px system-ui, sans-serif';
ctx.fillText('Content coming soon', 400, 520);
}
lightboxImage.src = canvas.toDataURL();
lightboxImage.alt = label;
lightbox.classList.remove('invisible', 'opacity-0');
lightbox.classList.add('visible', 'opacity-100');
requestAnimationFrame(() => {
imageWrapper.classList.remove('opacity-0', 'scale-90');
imageWrapper.classList.add('opacity-100', 'scale-100');
});
document.body.style.overflow = 'hidden';
});
});
};
initLearnLightbox();

// --- Student year filter ---
const initStudentFilter = () => {
document.querySelectorAll('.student-filter').forEach((btn) => {
const fresh = btn.cloneNode(true);
btn.parentNode?.replaceChild(fresh, btn);
});
document.querySelectorAll<HTMLElement>('.student-filter').forEach((btn) => {
btn.addEventListener('click', () => {
const year = btn.dataset.year;
document.querySelectorAll<HTMLElement>('.student-filter').forEach((b) => {
b.classList.remove('text-accent', 'border-accent');
b.classList.add('text-foreground-secondary', 'border-transparent');
});
btn.classList.remove('text-foreground-secondary', 'border-transparent');
btn.classList.add('text-accent', 'border-accent');
document.querySelectorAll<HTMLElement>('.student-item').forEach((item) => {
item.style.display = (year === 'all' || item.dataset.year === year) ? '' : 'none';
});
});
});
};
initStudentFilter();

// Auto-open Organic Modeling by default
openCourseDetail('angd-1314');
};

initLearn();
document.addEventListener('astro:after-swap', initLearn);
</script>
