---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import { getLearnPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';

const seo = getLearnPageSEO();

// Curriculum organized by year
const curriculum = [
	{
		year: 'Freshman',
		courses: [
			{ code: 'ANGD 1101', title: 'Orientation to ANGD' },
			{ code: 'ANGD 1312', title: 'Hard Surface Modeling' },
			{ code: 'ANGD 1314', title: 'Organic Modeling' },
			{ code: 'FYES 1211', title: 'First Year Experience Seminar' },
		],
	},
	{
		year: 'Sophomore',
		courses: [
			{ code: 'ANGD 2333', title: 'Environment Production I' },
			{ code: 'ANGD 2334', title: 'Environment Production II' },
			{ code: 'ANGD 2361', title: 'Character Modeling I' },
			{ code: 'ANGD 1380', title: 'Anatomy for Animators' },
		],
	},
	{
		year: 'Junior',
		courses: [
			{ code: 'ANGD 3331', title: 'Environment Production III' },
			{ code: 'ANGD 3361', title: 'Character Modeling II' },
			{ code: 'ANGD 3330', title: 'History of Games' },
			{ code: 'ANGD 3332', title: 'Environment Production IV' },
			{ code: 'ANGD 4140', title: 'Senior Thesis Workshop' },
			{ code: 'ANGD 3362', title: 'Character Modeling III' },
		],
	},
	{
		year: 'Senior',
		courses: [
			{ code: 'ANGD 4350', title: 'Senior Thesis Production I' },
			{ code: 'ANGD 4360', title: 'Senior Thesis Production II' },
		],
	},
	{
		year: 'Graduate',
		courses: [
			{ code: 'ANGD 6332', title: 'Graduate Environment Arts IV' },
		],
	},
];

// Resources
const resources = [
	{
		category: 'Modeling & Sculpting',
		items: [
			{ name: 'Maya', description: 'Primary DCC for modeling, rigging, and animation' },
			{ name: 'ZBrush', description: 'High-resolution digital sculpting and detailing' },
			{ name: 'Blender', description: 'Open-source 3D creation suite' },
		],
	},
	{
		category: 'Texturing & Materials',
		items: [
			{ name: 'Substance 3D Painter', description: 'PBR texturing and material authoring' },
			{ name: 'Substance 3D Designer', description: 'Procedural material creation' },
			{ name: 'Marmoset Toolbag', description: 'Real-time rendering and baking' },
		],
	},
	{
		category: 'Engine & Real-Time',
		items: [
			{ name: 'Unreal Engine 5', description: 'Real-time rendering, Nanite, Lumen, and MetaHumans' },
			{ name: 'Unity', description: 'Cross-platform real-time engine' },
		],
	},
	{
		category: 'Pipeline & Scripting',
		items: [
			{ name: 'Python', description: 'Scripting for Maya, pipeline tools, and automation' },
			{ name: 'MEL', description: 'Maya Embedded Language for quick automation' },
			{ name: 'Git', description: 'Version control for collaborative projects' },
		],
	},
];
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
	<Header />
	<PageMain class="text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<PageContainer>
				
				<!-- Page Header -->
				<div class="mb-16">
					<Heading level={1} size="4xl" class="mb-4">
						Learn
					</Heading>
					<Text size="lg" variant="secondary" class="mb-4">
						This page is a hub for my academic work—curriculum I've developed, courses I teach, the tools 
						my students use, and the work they produce. Whether you're a prospective student, a colleague 
						in the field, or someone from industry looking to understand what I bring to the classroom, 
						this is where that lives.
					</Text>
					<Text size="lg" variant="secondary">
						I teach 3D art at the university level, covering everything from introductory modeling to senior 
						thesis production. My courses are built around industry workflows and real production standards—students 
						leave with portfolio pieces, not just assignments. The goal is always the same: build artists who can 
						think critically, work professionally, and adapt to whatever the industry throws at them.
					</Text>
				</div>

				<!-- Courses / Curriculum -->
				<section class="mb-20">
					<Heading level={2} size="2xl" class="mb-2">
						Curriculum
					</Heading>
					<Text variant="secondary" class="mb-8 max-w-3xl">
						Courses I've developed and taught, organized by year. The sequence builds from foundational 
						modeling skills through advanced production and thesis work.
					</Text>

					<div class="space-y-8">
						{curriculum.map((level) => (
							<div>
								<Heading level={3} size="lg" class="mb-4">
									{level.year}
								</Heading>
								<div class="grid sm:grid-cols-2 gap-3">
									{level.courses.map((course) => (
										<Card variant="bordered" padding="sm">
											<div class="flex items-center gap-3">
												<Badge variant="accent" size="sm">{course.code}</Badge>
												<Text variant="primary" size="sm">{course.title}</Text>
											</div>
										</Card>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Student Showcase -->
				<section class="mb-20">
					<Heading level={2} size="2xl" class="mb-2">
						Student Showcase
					</Heading>
					<Text variant="secondary" class="mb-8 max-w-3xl">
						Highlights from student work across my courses. These artists came in with curiosity and left 
						with portfolio-ready pieces and a real understanding of production workflows.
					</Text>
					
					<Card variant="bordered" padding="lg">
						<div class="text-center py-8">
							<Text variant="muted" size="lg" class="mb-2">
								Coming Soon
							</Text>
							<Text variant="secondary" size="sm">
								Student showcase gallery is currently being curated.
							</Text>
						</div>
					</Card>
				</section>

				<!-- Tools & Resources -->
				<section class="mb-20">
					<Heading level={2} size="2xl" class="mb-2">
						Tools & Resources
					</Heading>
					<Text variant="secondary" class="mb-8 max-w-3xl">
						Software, tools, and technologies used across my courses. This is the stack students work with to 
						build industry-relevant skills.
					</Text>

					<div class="grid sm:grid-cols-2 gap-6">
						{resources.map((group) => (
							<Card variant="bordered" padding="lg">
								<Heading level={3} size="lg" class="mb-4">
									{group.category}
								</Heading>
								<div class="space-y-3">
									{group.items.map((item) => (
										<div>
											<Text variant="primary" size="sm" class="font-medium">
												{item.name}
											</Text>
											<Text variant="muted" size="sm">
												{item.description}
											</Text>
										</div>
									))}
								</div>
							</Card>
						))}
					</div>
				</section>

				<!-- CTA -->
				<section class="pt-8 border-t-2 border-foreground-secondary/10">
					<Text variant="secondary" class="mb-4">
						Interested in collaborating on curriculum, workshops, or guest lectures?
					</Text>
					<div class="flex gap-4">
						<Link href="/about" variant="accent">
							Get in Touch >
						</Link>
						<Link href="/art" variant="accent">
							View My Work >
						</Link>
					</div>
				</section>

			</PageContainer>
		</div>
	</PageMain>
	<Footer />
</BaseLayout>
