					{ name: 'Clay Purple', description: 'Custom clay purple material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. Apply via CopyMat/PasteMat or set as active material.', logos: [zbrushLogoImg], thumbnail: zbrushMatClayPurple, download: '/downloads/uiw3d-clay-purple.zmt' },
