					{ name: 'Metal', description: 'Custom metal material for ZBrush.', howToUse: '1. Download the .ZMT file.\n2. In ZBrush, open the Material palette and click Load.\n3. Select the downloaded .ZMT file.\n4. Apply via CopyMat/PasteMat or set as active material.', logos: [zbrushLogoImg], thumbnail: zbrushMatMetal, download: '/downloads/uiw3d-metal.ZMT' },
				],
			},
		],
	},
	{
		category: 'Substance Painter',
		subsections: [
			{
				label: 'Smart Materials',
				items: [
					{ name: 'Color Variation 01', description: 'Smart material for procedural color variation.', howToUse: '1. Download the .spsm file.\n2. In Substance 3D Painter, open the Assets panel.\n3. Click Import Resource and select the .spsm file, targeting Project or Shelf.\n4. Drag the smart material from the Assets panel onto a layer to apply it.', logos: [substancePainterLogoImg], thumbnail: spSmartMatColorVar01, download: '/downloads/uiw3d-color-var-01.spsm' },
				],
			},
		],
	},
	{
		category: 'Pipeline',
		subsections: [
			{
				label: 'Scripts',
				items: [
					{ name: 'Mount S: Drive', description: 'Maps S: as a virtual drive pointing to the script\'s directory. Ensures a universal project path across all machines.', howToUse: '1. Download the .bat file and place it in the root of your project folder.\n2. Double-click the .bat file to run it.\n3. S: will now point to that folder on your machine.\n4. All project paths using S:\\ will resolve correctly regardless of where the project is stored.\n5. Re-run the .bat any time you move the project or on a new machine.', download: '/downloads/mount-s-drive.bat', previewLang: 'batch', logos: [batLogoImg], thumbnail: mountSDriveThumb, previewHtml: `<span class="hl-keyword">@echo off</span>
<span class="hl-keyword">set</span> <span class="hl-string">"TARGET_DIR=%~dp0"</span>
<span class="hl-keyword">set</span> <span class="hl-string">"TARGET_DIR=%TARGET_DIR:~0,-1%"</span>
<span class="hl-builtin">subst</span> S: /d
<span class="hl-builtin">subst</span> S: <span class="hl-string">"%TARGET_DIR%"</span>
<span class="hl-builtin">echo</span> S: drive now mapped to: %TARGET_DIR%
<span class="hl-builtin">pause</span>` },
				],
			},
		],
