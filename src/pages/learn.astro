<script>
const initLearn = () => {

// --- Copy buttons ---
document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const code = btn.dataset.code ?? '';
    navigator.clipboard.writeText(code).then(() => {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
});

// --- Video autoplay via IntersectionObserver ---
const videoObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    const video = entry.target as HTMLVideoElement;
    if (entry.isIntersecting) {
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  });
}, { threshold: 0.25 });

document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
  videoObserver.observe(video);
});

// --- Tab switching ---
const tabs = document.querySelectorAll<HTMLElement>('.learn-tab');
const panels = document.querySelectorAll<HTMLElement>('.learn-panel');
const sidebars = document.querySelectorAll<HTMLElement>('.learn-sidebar');

function activateTab(target: string) {
  document.querySelectorAll<HTMLElement>('.learn-tab').forEach((t) => {
    const isActive = t.dataset.tab === target;
    t.classList.toggle('text-accent', isActive);
    t.classList.toggle('border-accent', isActive);
    t.classList.toggle('text-foreground-secondary', !isActive);
    t.classList.toggle('border-transparent', !isActive);
  });
  panels.forEach((panel) => {
    panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
  });
  sidebars.forEach((sidebar) => {
    sidebar.classList.toggle('hidden', sidebar.id !== `sidebar-${target}`);
  });
  initScrollSpy();
}

tabs.forEach((tab) => {
const fresh = tab.cloneNode(true) as HTMLElement;
tab.parentNode?.replaceChild(fresh, tab);
});

document.querySelectorAll<HTMLElement>('.learn-tab').forEach((tab) => {
tab.addEventListener('click', () => {
const target = tab.dataset.tab!;
sessionStorage.setItem('learn-tab', target);
activateTab(target);
});
});

// --- Scroll spy for sidebar nav ---
let observer: IntersectionObserver | null = null;
const initScrollSpy = () => {
if (observer) observer.disconnect();
const entries = document.querySelectorAll<HTMLElement>('.learn-entry');
const navLinks = document.querySelectorAll<HTMLElement>('.learn-nav-link');
if (!entries.length || !navLinks.length) return;

observer = new IntersectionObserver(
(observed) => {
observed.forEach((entry) => {
if (entry.isIntersecting) {
const id = entry.target.id;
navLinks.forEach((link) => {
link.classList.toggle('active', link.dataset.slug === id);
});
}
});
},
{ rootMargin: '-20% 0px -60% 0px' }
);
entries.forEach((entry) => observer!.observe(entry));
};
initScrollSpy();

// Restore tab — URL hash takes priority over sessionStorage
const hashTab = location.hash.replace('#', '');
const savedTab = sessionStorage.getItem('learn-tab');
const validTabs = Array.from(document.querySelectorAll<HTMLElement>('.learn-tab')).map(t => t.dataset.tab!);
const tabToRestore = (hashTab && validTabs.includes(hashTab)) ? hashTab : (savedTab && validTabs.includes(savedTab)) ? savedTab : null;
if (tabToRestore) {
  activateTab(tabToRestore);
}

// --- Course drill-down ---
const openCourseDetail = (courseSlug: string) => {
document.getElementById('project-detail')?.classList.add('hidden');
const list = document.getElementById('classes-list');
const detail = document.getElementById('classes-detail');
if (!list || !detail) return;
list.classList.add('hidden');
detail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.course-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `detail-${courseSlug}`);
});
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
link.classList.toggle('active', link.dataset.slug === courseSlug);
});
initLearnLightbox();
initProjectCards();
};

const closeCourseDetail = () => {
const list = document.getElementById('classes-list');
const detail = document.getElementById('classes-detail');
if (!list || !detail) return;
detail.classList.add('hidden');
list.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((l) => l.classList.remove('active'));
};

// --- Project drill-down ---
const openProjectDetail = (courseSlug: string, projectSlug: string) => {
const detail = document.getElementById('classes-detail');
const projectDetail = document.getElementById('project-detail');
if (!detail || !projectDetail) return;
detail.classList.add('hidden');
projectDetail.classList.remove('hidden');
document.querySelectorAll<HTMLElement>('.project-detail-content').forEach((el) => {
el.classList.toggle('hidden', el.id !== `project-${courseSlug}-${projectSlug}`);
});
};

const initProjectCards = () => {
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
card.addEventListener('click', () => openProjectDetail(card.dataset.course!, card.dataset.project!));
});
const projectBackBtn = document.getElementById('project-back');
if (projectBackBtn) {
const freshBack = projectBackBtn.cloneNode(true) as HTMLElement;
projectBackBtn.parentNode?.replaceChild(freshBack, projectBackBtn);
document.getElementById('project-back')?.addEventListener('click', () => {
const activeLink = document.querySelector<HTMLElement>('#sidebar-classes .learn-nav-link.active');
openCourseDetail(activeLink?.dataset.slug || 'angd-1314');
});
}
};

// Course cards
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
const fresh = card.cloneNode(true) as HTMLElement;
card.parentNode?.replaceChild(fresh, card);
});
document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
card.addEventListener('click', () => openCourseDetail(card.dataset.course!));
});

// Back button
const backBtn = document.getElementById('classes-back');
if (backBtn) {
const freshBack = backBtn.cloneNode(true) as HTMLElement;
backBtn.parentNode?.replaceChild(freshBack, backBtn);
document.getElementById('classes-back')?.addEventListener('click', closeCourseDetail);
}

// Sidebar nav for Classes opens detail directly
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
const fresh = link.cloneNode(true) as HTMLElement;
link.parentNode?.replaceChild(fresh, link);
});
document.querySelectorAll<HTMLElement>('#sidebar-classes .learn-nav-link').forEach((link) => {
link.addEventListener('click', (e) => {
e.preventDefault();
openCourseDetail(link.dataset.slug!);
});
});

// --- Lightbox placeholders ---
const initLearnLightbox = () => {
document.querySelectorAll('.learn-lightbox-trigger').forEach((trigger) => {
const fresh = trigger.cloneNode(true);
trigger.parentNode?.replaceChild(fresh, trigger);
});
document.querySelectorAll<HTMLElement>('.learn-lightbox-trigger').forEach((trigger) => {
trigger.addEventListener('click', () => {
const lightbox = document.getElementById('lightbox');
const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
const imageWrapper = document.getElementById('image-wrapper');
if (!lightbox || !lightboxImage || !imageWrapper) return;
const label = trigger.dataset.label || 'Preview';
const canvas = document.createElement('canvas');
canvas.width = 800; canvas.height = 1000;
const ctx = canvas.getContext('2d');
if (ctx) {
const isDark = document.documentElement.classList.contains('dark');
ctx.fillStyle = isDark ? '#1a1a1a' : '#f0f0f0';
ctx.fillRect(0, 0, 800, 1000);
ctx.strokeStyle = isDark ? '#333' : '#ccc';
ctx.lineWidth = 2;
ctx.strokeRect(20, 20, 760, 960);
ctx.fillStyle = isDark ? '#888' : '#666';
ctx.font = '24px system-ui, sans-serif';
ctx.textAlign = 'center';
ctx.fillText(label, 400, 480);
ctx.font = '16px system-ui, sans-serif';
ctx.fillText('Content coming soon', 400, 520);
}
lightboxImage.src = canvas.toDataURL();
lightboxImage.alt = label;
lightbox.classList.remove('invisible', 'opacity-0');
lightbox.classList.add('visible', 'opacity-100');
requestAnimationFrame(() => {
imageWrapper.classList.remove('opacity-0', 'scale-90');
imageWrapper.classList.add('opacity-100', 'scale-100');
});
document.body.style.overflow = 'hidden';
});
});
};
initLearnLightbox();

// --- Student year filter ---
const initStudentFilter = () => {
document.querySelectorAll('.student-filter').forEach((btn) => {
const fresh = btn.cloneNode(true);
btn.parentNode?.replaceChild(fresh, btn);
});
document.querySelectorAll<HTMLElement>('.student-filter').forEach((btn) => {
btn.addEventListener('click', () => {
const year = btn.dataset.year;
document.querySelectorAll<HTMLElement>('.student-filter').forEach((b) => {
b.classList.remove('text-accent', 'border-accent');
b.classList.add('text-foreground-secondary', 'border-transparent');
});
btn.classList.remove('text-foreground-secondary', 'border-transparent');
btn.classList.add('text-accent', 'border-accent');
document.querySelectorAll<HTMLElement>('.student-item').forEach((item) => {
item.style.display = (year === 'all' || item.dataset.year === year) ? '' : 'none';
});
});
});
};
initStudentFilter();

// Auto-open Organic Modeling by default
openCourseDetail('angd-1314');

// --- Resource card modal ---
const modal = document.getElementById('resource-modal')!;
const modalImg = document.getElementById('resource-modal-img') as HTMLImageElement;
const modalThumb = document.getElementById('resource-modal-thumb')!;
const modalName = document.getElementById('resource-modal-name')!;
const modalDesc = document.getElementById('resource-modal-desc')!;
const modalDownload = document.getElementById('resource-modal-download') as HTMLAnchorElement;
const modalHowTo = document.getElementById('resource-modal-how-to')!;
const modalHowToList = document.getElementById('resource-modal-how-to-list')!;

const openResourceModal = (card: HTMLElement) => {
  const name = card.dataset.name ?? '';
  const desc = card.dataset.description ?? '';
  const download = card.dataset.download ?? '';
  const howToUse: string[] = ((window as any).__resourceHowTo?.[name] ?? []);
  const imgEl = card.querySelector<HTMLImageElement>('img[data-no-lightbox]');

  modalName.textContent = name;
  modalDesc.textContent = desc;

  if (imgEl?.src) {
    modalImg.src = imgEl.src;
    modalImg.alt = name;
    modalThumb.classList.remove('hidden');
  } else {
    modalThumb.classList.add('hidden');
  }

  if (howToUse.length) {
    modalHowToList.innerHTML = howToUse.map((step, i) => `<li class="flex gap-2"><span class="text-accent font-medium shrink-0">${i + 1}.</span><span>${step.replace(/^\d+\.\s*/, '')}</span></li>`).join('');
    modalHowTo.classList.remove('hidden');
  } else {
    modalHowTo.classList.add('hidden');
  }

  if (download) {
    modalDownload.href = download;
    modalDownload.classList.remove('hidden');
  } else {
    modalDownload.classList.add('hidden');
  }

  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
};

const closeResourceModal = () => {
  modal.classList.remove('open');
  document.body.style.overflow = '';
};

document.querySelectorAll<HTMLElement>('.resource-card').forEach((card) => {
  card.addEventListener('click', (e) => {
    // Don't open modal when clicking download link inside the card
    if ((e.target as HTMLElement).closest('a')) return;
    openResourceModal(card);
  });
});

document.getElementById('resource-modal-close')?.addEventListener('click', closeResourceModal);
document.getElementById('resource-modal-backdrop')?.addEventListener('click', closeResourceModal);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeResourceModal(); });
};

initLearn();
document.addEventListener('astro:after-swap', initLearn);
</script>
