---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import { Image } from 'astro:assets';
import { getLearnPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';

const seo = getLearnPageSEO();

// -------------------------------------------------------------------
// Syllabus & Assignment Images
// -------------------------------------------------------------------
// To add a syllabus thumbnail for a course:
//   1. Drop a screenshot/image into src/assets/learn/syllabi/
//      e.g. angd-1312-syllabus.png
//   2. Import it here:
//      import syllabus1312 from '@/assets/learn/syllabi/angd-1312-syllabus.png';
//   3. Add it to the matching course below:
//      { code: 'ANGD 1312', title: '...', syllabus: syllabus1312 }
//
// To add assignment thumbnails for a course:
//   1. Drop images into src/assets/learn/assignments/
//      e.g. angd-1312-assign-01.png
//   2. Import them here:
//      import assign1312_01 from '@/assets/learn/assignments/angd-1312-assign-01.png';
//   3. Add them to the matching course:
//      { code: 'ANGD 1312', title: '...', assignments: [
//          { image: assign1312_01, title: 'Assignment 1' },
//      ]}
// -------------------------------------------------------------------

interface CourseAssignment {
	image: ImageMetadata;
	title: string;
}

interface Course {
	code: string;
	title: string;
	description: string;
	syllabus?: ImageMetadata;
	assignments?: CourseAssignment[];
}

interface CurriculumYear {
	year: string;
	courses: Course[];
}

// Curriculum organized by year
const curriculum: CurriculumYear[] = [
	{
		year: 'Freshman',
		courses: [
			{ code: 'ANGD 1101', title: 'Orientation to ANGD', description: 'Introduction to the Animation and Game Design program, its culture, expectations, and the industry landscape students are preparing for.' },
			{ code: 'ANGD 1312', title: 'Hard Surface Modeling', description: 'Fundamentals of polygonal modeling for mechanical and manufactured objects. Emphasis on clean topology, edge flow, and production-ready geometry.' },
			{ code: 'ANGD 1314', title: 'Organic Modeling', description: 'Introduction to sculpting and modeling organic forms. Covers body proportions, natural shapes, and transitioning between high and low poly workflows.' },
			{ code: 'FYES 1211', title: 'First Year Experience Seminar', description: 'University transition course focused on academic skills, professional development, and building habits for creative careers.' },
		],
	},
	{
		year: 'Sophomore',
		courses: [
			{ code: 'ANGD 2333', title: 'Environment Production I', description: 'Fundamentals of environment art production. Students build modular assets and learn scene composition for real-time engines.' },
			{ code: 'ANGD 2334', title: 'Environment Production II', description: 'Continued environment work with focus on texturing, lighting, and presentation. Students develop a polished environment portfolio piece.' },
			{ code: 'ANGD 2361', title: 'Character Modeling I', description: 'Introduction to character creation. Covers base mesh construction, anatomical landmarks, and the fundamentals of building believable characters.' },
			{ code: 'ANGD 1380', title: 'Anatomy for Animators', description: 'Study of human anatomy as it applies to 3D art and animation. Skeletal structure, musculature, and how the body moves and deforms.' },
		],
	},
	{
		year: 'Junior',
		courses: [
			{ code: 'ANGD 3331', title: 'Environment Production III', description: 'Advanced environment techniques including procedural workflows, trim sheets, and large-scale scene construction.' },
			{ code: 'ANGD 3361', title: 'Character Modeling II', description: 'Intermediate character art. Students tackle facial modeling, clothing, accessories, and begin developing personal style within production constraints.' },
			{ code: 'ANGD 3330', title: 'History of Games', description: 'Survey of the game industry from its origins to today. People, companies, technology, and the cultural forces that shaped interactive entertainment.' },
			{ code: 'ANGD 3332', title: 'Environment Production IV', description: 'Capstone environment course. Students produce a fully realized environment ready for portfolio presentation and industry review.' },
			{ code: 'ANGD 4140', title: 'Senior Thesis Workshop', description: 'Pre-production planning for the senior thesis. Concept development, scope definition, pipeline planning, and milestone scheduling.' },
			{ code: 'ANGD 3362', title: 'Character Modeling III', description: 'Advanced character creation covering hair, cloth, armor systems, and final presentation. Portfolio-ready character pieces are the deliverable.' },
		],
	},
	{
		year: 'Senior',
		courses: [
			{ code: 'ANGD 4350', title: 'Senior Thesis Production I', description: 'First semester of thesis execution. Students produce work against their approved plan with regular critiques, reviews, and milestone check-ins.' },
			{ code: 'ANGD 4360', title: 'Senior Thesis Production II', description: 'Final semester of thesis work. Polish, presentation, and defense of the completed thesis project before faculty and industry reviewers.' },
		],
	},
	{
		year: 'Graduate',
		courses: [
			{ code: 'ANGD 6332', title: 'Graduate Environment Arts IV', description: 'Graduate-level environment art production with emphasis on research-driven process, advanced techniques, and publishable quality work.' },
		],
	},
];

// Student Work Gallery
interface StudentPiece {
	student: string;
	title: string;
	course: string;
	year: string;
	video?: string;       // Path to video in public/ (e.g. '/student-work/file.mp4')
	// image?: ImageMetadata;  // Uncomment and import when adding real images
}

const studentWork: StudentPiece[] = [
	// -------------------------------------------------------------------
	// To add real student work:
	//   Videos: Drop MP4s into public/student-work/ and set video path
	//   Images: Drop into src/assets/learn/student-work/, import, add image prop
	// -------------------------------------------------------------------
	{ student: 'Alvarez', title: 'Space Cat Turnaround', course: 'ANGD 2361', year: '2025', video: '/student-work/Alvarez-Space-Cat-Turnaround.mp4' },
	{ student: 'Alvarez', title: 'Finn Turnaround', course: 'ANGD 2361', year: '2025', video: '/student-work/Alvarez-Finn-Turnaround.mp4' },
	{ student: 'Student Name', title: 'Hard Surface Asset', course: 'ANGD 1312', year: '2025' },
	{ student: 'Student Name', title: 'Sculpt Study', course: 'ANGD 1314', year: '2025' },
	{ student: 'Student Name', title: 'Character Design', course: 'ANGD 3361', year: '2025' },
	{ student: 'Student Name', title: 'Thesis Project', course: 'ANGD 4360', year: '2025' },
	{ student: 'Student Name', title: 'Armor Set', course: 'ANGD 3362', year: '2024' },
	{ student: 'Student Name', title: 'Environment Diorama', course: 'ANGD 3332', year: '2024' },
	{ student: 'Student Name', title: 'Anatomy Study', course: 'ANGD 1380', year: '2024' },
];

// Resources
const resources = [
	{
		category: 'Modeling & Sculpting',
		items: [
			{ name: 'Maya', description: 'Primary DCC for modeling, rigging, and animation' },
			{ name: 'ZBrush', description: 'High-resolution digital sculpting and detailing' },
			{ name: 'Blender', description: 'Open-source 3D creation suite' },
		],
	},
	{
		category: 'Texturing & Materials',
		items: [
			{ name: 'Substance 3D Painter', description: 'PBR texturing and material authoring' },
			{ name: 'Substance 3D Designer', description: 'Procedural material creation' },
			{ name: 'Marmoset Toolbag', description: 'Real-time rendering and baking' },
		],
	},
	{
		category: 'Engine & Real-Time',
		items: [
			{ name: 'Unreal Engine 5', description: 'Real-time rendering, Nanite, Lumen, and MetaHumans' },
			{ name: 'Unity', description: 'Cross-platform real-time engine' },
		],
	},
	{
		category: 'Pipeline & Scripting',
		items: [
			{ name: 'Python', description: 'Scripting for Maya, pipeline tools, and automation' },
			{ name: 'MEL', description: 'Maya Embedded Language for quick automation' },
			{ name: 'Git', description: 'Version control for collaborative projects' },
		],
	},
];
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
	<Header />
	<PageMain class="text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<PageContainer>
				
				<!-- Page Header -->
				<div class="mb-16">
					<Heading level={1} size="4xl" class="mb-4">
						Learn
					</Heading>
					<Text size="lg" variant="secondary" class="mb-4">
						This page is a hub for my academic work, curriculum development, courses I teach, tools and resources my students utilize, and the work they produce. Whether you're a student of mine, a colleague in the field, or someone from industry interested in my academic experience, this is where that lives!
					</Text>
					<Text size="lg" variant="secondary">
						My primary focus is teaching 3D art at the university level, covering everything from introductory modeling, theory and practice of anatomy, the history of games and the people, companies, and titles that got us here, all the way to the senior thesis production. My courses are built around bringing industry to the classroom. Students leave with bespoke portfolio pieces, not just classroom assignments. The goal is always the same, work with and help aspiring artists think critically, work professionally, and adapt to whatever the industry throws at them all sprinkled under the umbrella that is creativity.
					</Text>
				</div>

				<!-- Tab Navigation -->
				<div class="mb-10">
					<div class="flex gap-6 border-b-2 border-foreground-secondary/10">
						<button class="learn-tab pb-3 text-base text-accent border-b-2 border-accent -mb-[2px] transition-colors" data-tab="curriculum" style="font-family: 'Besley', serif !important;">
							Curriculum
						</button>
						<button class="learn-tab pb-3 text-base text-foreground-secondary border-b-2 border-transparent -mb-[2px] hover:text-accent transition-colors" data-tab="student-work" style="font-family: 'Besley', serif !important;">
							Student Work
						</button>
						<button class="learn-tab pb-3 text-base text-foreground-secondary border-b-2 border-transparent -mb-[2px] hover:text-accent transition-colors" data-tab="tools" style="font-family: 'Besley', serif !important;">
							Tools & Resources
						</button>
					</div>
				</div>

				<!-- Tab: Curriculum -->
				<div id="tab-curriculum" class="learn-tab-content">
					<Text variant="secondary" class="mb-8">
						Courses I've developed and taught, organized by year. The sequence builds from foundational 
						modeling skills through advanced production and thesis work.
					</Text>

					<div class="space-y-8">
						{curriculum.map((level) => (
							<div>
								<Heading level={3} size="lg" class="mb-4">
									{level.year}
								</Heading>
								<div class="grid sm:grid-cols-2 gap-3">
									{level.courses.map((course) => (
										<Card variant="bordered" padding="sm">
											<div class="flex items-center gap-3 mb-2">
												<Badge variant="accent" size="sm">{course.code}</Badge>
												<Text variant="primary" size="sm">{course.title}</Text>
											</div>
											<Text variant="muted" size="sm" class="mb-4">
												{course.description}
											</Text>
											{/* Syllabus & Assignment Thumbnails */}
											<div class="flex gap-3 flex-wrap">
												{/* Syllabus placeholder */}
												<div class="flex-shrink-0">
													<div class="learn-lightbox-trigger w-24 h-32 rounded border border-border bg-foreground/5 flex flex-col items-center justify-center cursor-pointer hover:bg-foreground/10 hover:border-accent/40 transition-all" data-label={`${course.code} Syllabus & Outline`}>
														<svg class="w-7 h-7 text-foreground-muted mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
														</svg>
														<span class="text-[10px] text-foreground-muted">Syllabus</span>
													</div>
												</div>
												{/* Assignment placeholders */}
												{[1, 2, 3].map((n) => (
													<div class="flex-shrink-0">
														<div class="learn-lightbox-trigger w-24 h-24 rounded border border-border bg-foreground/5 flex flex-col items-center justify-center cursor-pointer hover:bg-foreground/10 hover:border-accent/40 transition-all" data-label={`${course.code} Assignment ${n}`}>
															<svg class="w-7 h-7 text-foreground-muted mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
																<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
															</svg>
															<span class="text-[10px] text-foreground-muted">Assignment {n}</span>
														</div>
													</div>
												))}
											</div>
										</Card>
									))}
								</div>
							</div>
						))}
					</div>
				</div>

				<!-- Tab: Student Work -->
				<div id="tab-student-work" class="learn-tab-content hidden">
					<Text variant="secondary" class="mb-8">
						Highlights from student work across my courses. These artists came in with curiosity and left 
						with portfolio-ready pieces and a real understanding of production workflows.
					</Text>

					<!-- Year filter -->
					<div class="flex gap-4 mb-8">
						<button class="student-filter text-accent border-b-2 border-accent pb-1 transition-colors" data-year="all" style="font-family: 'Besley', serif !important;">
							All
						</button>
						{[...new Set(studentWork.map(s => s.year))].sort().reverse().map((year) => (
							<button class="student-filter text-foreground-secondary border-b-2 border-transparent pb-1 hover:text-accent transition-colors" data-year={year} style="font-family: 'Besley', serif !important;">
								{year}
							</button>
						))}
					</div>
					
					<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="student-grid">
						{studentWork.map((piece) => (
							<div class="student-item" data-year={piece.year}>
								<Card variant="bordered" padding="none">
									{piece.video ? (
										<!-- Video -->
										<div class="relative bg-black rounded-t-md overflow-hidden">
											<video
												src={piece.video}
												class="w-full h-auto"
												autoplay
												loop
												muted
												playsinline
												preload="auto"
											/>
										</div>
									) : (
										<!-- Placeholder thumbnail -->
										<div class="learn-lightbox-trigger relative aspect-[4/3] bg-foreground/5 flex flex-col items-center justify-center cursor-pointer hover:bg-foreground/10 transition-all" data-label={`${piece.student} — ${piece.title}`}>
											<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
											</svg>
											<span class="text-xs text-foreground-muted">Image Coming Soon</span>
										</div>
									)}
									<!-- Info -->
									<div class="p-4 space-y-2">
										<Text variant="primary" size="sm" class="font-medium">{piece.title}</Text>
										<Text variant="muted" size="sm">{piece.student}</Text>
										<div class="flex gap-2">
											<Badge size="sm" variant="accent">{piece.course}</Badge>
											<Badge size="sm">{piece.year}</Badge>
										</div>
									</div>
								</Card>
							</div>
						))}
					</div>
				</div>

				<!-- Tab: Tools & Resources -->
				<div id="tab-tools" class="learn-tab-content hidden">
					<Text variant="secondary" class="mb-8">
						Software, tools, and technologies used across my courses. This is the stack students work with to 
						build industry-relevant skills.
					</Text>

					<div class="grid sm:grid-cols-2 gap-6">
						{resources.map((group) => (
							<Card variant="bordered" padding="lg">
								<Heading level={3} size="lg" class="mb-4">
									{group.category}
								</Heading>
								<div class="space-y-3">
									{group.items.map((item) => (
										<div>
											<Text variant="primary" size="sm" class="font-medium">
												{item.name}
											</Text>
											<Text variant="muted" size="sm">
												{item.description}
											</Text>
										</div>
									))}
								</div>
							</Card>
						))}
					</div>
				</div>

				<!-- CTA -->
				<section class="pt-8 border-t-2 border-foreground-secondary/10">
					<Text variant="secondary" class="mb-4">
						Interested in collaborating on curriculum, workshops, or guest lectures?
					</Text>
					<div class="flex gap-4">
						<Link href="/about" variant="accent">
							Get in Touch >
						</Link>
						<Link href="/art" variant="accent">
							View My Work >
						</Link>
					</div>
				</section>

			</PageContainer>
		</div>
	</PageMain>
	<Footer />
	<ImageLightbox />
</BaseLayout>

<script>
	// Tab switching logic
	const initTabs = () => {
		const tabs = document.querySelectorAll('.learn-tab');
		const panels = document.querySelectorAll('.learn-tab-content');
		if (!tabs.length) return;

		tabs.forEach((tab) => {
			// Clone & replace to remove any stale listeners
			const fresh = tab.cloneNode(true);
			tab.parentNode?.replaceChild(fresh, tab);
		});

		// Re-query after clone
		const freshTabs = document.querySelectorAll('.learn-tab');
		freshTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const target = (tab as HTMLElement).dataset.tab;
				freshTabs.forEach((t) => {
					t.classList.remove('text-accent', 'border-accent');
					t.classList.add('text-foreground-secondary', 'border-transparent');
				});
				tab.classList.remove('text-foreground-secondary', 'border-transparent');
				tab.classList.add('text-accent', 'border-accent');
				panels.forEach((panel) => {
					if (panel.id === `tab-${target}`) {
						panel.classList.remove('hidden');
					} else {
						panel.classList.add('hidden');
					}
				});
			});
		});
	};

	// Make placeholder thumbnails clickable with a lightbox-style overlay
	const initLearnLightbox = () => {
		const triggers = document.querySelectorAll('.learn-lightbox-trigger');
		const lightbox = document.getElementById('lightbox');
		const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
		const imageWrapper = document.getElementById('image-wrapper');
		if (!triggers.length) return;

		triggers.forEach((trigger) => {
			const fresh = trigger.cloneNode(true);
			trigger.parentNode?.replaceChild(fresh, trigger);
		});

		document.querySelectorAll('.learn-lightbox-trigger').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				if (!lightbox || !lightboxImage || !imageWrapper) return;

				const label = (trigger as HTMLElement).dataset.label || 'Preview';

				const canvas = document.createElement('canvas');
				canvas.width = 800;
				canvas.height = 1000;
				const ctx = canvas.getContext('2d');
				if (ctx) {
					const isDark = document.documentElement.classList.contains('dark');
					ctx.fillStyle = isDark ? '#1a1a1a' : '#f0f0f0';
					ctx.fillRect(0, 0, 800, 1000);
					ctx.strokeStyle = isDark ? '#333' : '#ccc';
					ctx.lineWidth = 2;
					ctx.strokeRect(20, 20, 760, 960);
					ctx.fillStyle = isDark ? '#888' : '#666';
					ctx.font = '24px system-ui, sans-serif';
					ctx.textAlign = 'center';
					ctx.fillText(label, 400, 480);
					ctx.font = '16px system-ui, sans-serif';
					ctx.fillText('Content coming soon', 400, 520);
				}

				lightboxImage.src = canvas.toDataURL();
				lightboxImage.alt = label;

				lightbox.classList.remove('invisible', 'opacity-0');
				lightbox.classList.add('visible', 'opacity-100');

				requestAnimationFrame(() => {
					imageWrapper?.classList.remove('opacity-0', 'scale-90');
					imageWrapper?.classList.add('opacity-100', 'scale-100');
				});

				document.body.style.overflow = 'hidden';
			});
		});
	};

	// Student work year filter
	const initStudentFilter = () => {
		const filters = document.querySelectorAll('.student-filter');
		const items = document.querySelectorAll('.student-item');
		if (!filters.length) return;

		filters.forEach((btn) => {
			const fresh = btn.cloneNode(true);
			btn.parentNode?.replaceChild(fresh, btn);
		});

		const freshFilters = document.querySelectorAll('.student-filter');
		freshFilters.forEach((btn) => {
			btn.addEventListener('click', () => {
				const year = (btn as HTMLElement).dataset.year;
				freshFilters.forEach((b) => {
					b.classList.remove('text-accent', 'border-accent');
					b.classList.add('text-foreground-secondary', 'border-transparent');
				});
				btn.classList.remove('text-foreground-secondary', 'border-transparent');
				btn.classList.add('text-accent', 'border-accent');
				items.forEach((item) => {
					if (year === 'all' || item.getAttribute('data-year') === year) {
						(item as HTMLElement).style.display = '';
					} else {
						(item as HTMLElement).style.display = 'none';
					}
				});
			});
		});
	};

	const initAll = () => {
		initTabs();
		initLearnLightbox();
		initStudentFilter();
	};

	initAll();
	document.addEventListener('astro:after-swap', initAll);
</script>
