---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import { getBlogPageSEO } from '@/config/seo';
import { sanityClient } from '@/lib/sanity/client';
import { logIndexQuery } from '@/lib/sanity/queries';

// Read live from Sanity at request time (instant edits, no rebuild).
export const prerender = false;

interface LogPost {
	_id: string;
	title: string;
	slug: string;
	description?: string;
	pubDate: string;
	tags?: string[];
}

// logIndexQuery filters drafts and orders by pubDate desc.
const posts: LogPost[] = await sanityClient.fetch(logIndexQuery);

const formatDate = (date: string | Date) => {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(new Date(date));
};

const seo = getBlogPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
	<Header />
	<PageMain class="text-foreground">
		<!-- Page Header with Background -->
		<div class="relative w-full py-8 sm:py-10">
			<div class="absolute inset-0 -z-10 overflow-hidden">
				<Image
					src={heroBg}
					alt=""
					class="w-full h-full object-cover object-center"
					loading="eager"
					widths={[800, 1200, 1920]}
				/>
				<div class="absolute inset-0 bg-white/85 dark:bg-black/85"></div>
			</div>
			<PageContainer>
				<Heading level={1} size="4xl" class="mb-4">
					Log
				</Heading>
				<Text size="lg" variant="secondary">
					Thoughts, process notes, and work in progress.
				</Text>
			</PageContainer>
		</div>

		<div class="relative z-10 w-full py-8 sm:py-12">
			<PageContainer>

				<!-- Entry list -->
				<ul class="max-w-3xl mx-auto divide-y divide-foreground-secondary/10">
					{posts.map((post) => (
						<li>
							<a href={`/log/${post.slug}`} class="group block py-8 sm:py-10">
								<div class="flex flex-wrap items-center gap-3 mb-3">
									<Text size="sm" variant="secondary">
										{formatDate(post.pubDate)}
									</Text>
									{post.tags && post.tags.length > 0 && (
										<div class="flex flex-wrap gap-2">
											{post.tags.slice(0, 3).map((tag) => (
												<Badge size="sm" variant="outline">{tag}</Badge>
											))}
										</div>
									)}
								</div>
								<Heading level={2} size="2xl" class="mb-2 group-hover:text-accent transition-colors">
									{post.title}
								</Heading>
								{post.description && (
									<Text size="lg" variant="secondary" class="line-clamp-2">
										{post.description}
									</Text>
								)}
								<span class="mt-4 inline-flex items-center gap-1.5 text-sm text-accent" style="font-family: 'Besley', serif !important;">
									Read entry
									<svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
									</svg>
								</span>
							</a>
						</li>
					))}
				</ul>

			</PageContainer>
		</div>
	</PageMain>
	<Footer />
</BaseLayout>

