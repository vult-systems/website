---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import { getBlogPageSEO } from '@/config/seo';

const logPosts = await getCollection('log', ({ data }) => {
	return data.draft !== true;
});

// Sort posts by date, newest first
const sortedPosts = logPosts.sort((a, b) => {
	const dateA = new Date(a.data.pubDate);
	const dateB = new Date(b.data.pubDate);
	return dateB.getTime() - dateA.getTime();
});

// Render all posts
const renderedPosts = await Promise.all(
	sortedPosts.map(async (post) => {
		const { Content } = await post.render();
		return {
			slug: post.slug,
			title: post.data.title,
			description: post.data.description,
			pubDate: post.data.pubDate,
			tags: post.data.tags,
			Content,
		};
	})
);

const formatDate = (date: Date) => {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(date);
};

const seo = getBlogPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
	<Header />
	<PageMain class="text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<PageContainer>

				<!-- Content with Sidebar -->
				<div class="flex gap-12 lg:gap-16 relative">
					
					<!-- Sidebar Nav -->
					<aside class="hidden lg:block w-56 shrink-0">
						<div class="sticky top-32">
							<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
								Entries
							</Text>
							<nav class="space-y-3 border-l-2 border-foreground-secondary/10 pl-4">
								{renderedPosts.map((post) => (
									<a 
										href={`#${post.slug}`} 
										class="log-nav-link block text-sm text-foreground-secondary hover:text-accent transition-colors leading-snug"
										data-slug={post.slug}
										style="font-family: 'Besley', serif !important;"
									>
										{post.title}
									</a>
								))}
							</nav>
						</div>
					</aside>

					<!-- Posts Feed -->
					<div class="flex-1 min-w-0">
						{renderedPosts.map((post, index) => (
							<article id={post.slug} class="log-entry scroll-mt-32">
								{index > 0 && (
									<div class="border-t-2 border-foreground-secondary/10 my-16"></div>
								)}
								
								<!-- Post Header -->
								<div class="mb-8">
									<div class="flex items-center gap-3 mb-3">
										<Text size="sm" variant="secondary">
											{formatDate(post.pubDate)}
										</Text>
										{post.tags && post.tags.length > 0 && (
											<div class="flex gap-2">
												{post.tags.slice(0, 3).map((tag) => (
													<Badge size="sm" variant="outline">{tag}</Badge>
												))}
											</div>
										)}
									</div>
									<Heading level={2} size="3xl" class="mb-3">
										{post.title}
									</Heading>
									{post.description && (
										<Text size="lg" variant="secondary">
											{post.description}
										</Text>
									)}
								</div>

								<!-- Post Content -->
								<div class="prose prose-lg dark:prose-invert max-w-none">
									<post.Content />
								</div>
							</article>
						))}
					</div>
				</div>

			</PageContainer>
		</div>
	</PageMain>
	<Footer />
</BaseLayout>

<style>
	.log-nav-link.active {
		color: var(--color-accent);
		font-weight: 500;
	}
</style>

<script>
	const initLogNav = () => {
		const navLinks = document.querySelectorAll('.log-nav-link');
		const entries = document.querySelectorAll('.log-entry');
		if (!navLinks.length || !entries.length) return;

		const observer = new IntersectionObserver(
			(observerEntries) => {
				observerEntries.forEach((entry) => {
					if (entry.isIntersecting) {
						const slug = entry.target.id;
						navLinks.forEach((link) => {
							link.classList.toggle('active', (link as HTMLElement).dataset.slug === slug);
						});
					}
				});
			},
			{ rootMargin: '-20% 0px -60% 0px' }
		);

		entries.forEach((entry) => observer.observe(entry));
	};

	initLogNav();
	document.addEventListener('astro:after-swap', initLogNav);
</script>
