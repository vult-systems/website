---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import { Image } from 'astro:assets';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import { getBlogPageSEO } from '@/config/seo';
import { sanityClient } from '@/lib/sanity/client';
import { logListQuery } from '@/lib/sanity/queries';
import PortableText from '@/components/sanity/PortableText.astro';

// Read live from Sanity at request time (instant edits, no rebuild).
export const prerender = false;

interface LogPost {
	_id: string;
	title: string;
	slug: string;
	description?: string;
	pubDate: string;
	tags?: string[];
	body?: any;
}

// logListQuery already filters drafts and orders by pubDate desc.
const renderedPosts: LogPost[] = await sanityClient.fetch(logListQuery);

const formatDate = (date: string | Date) => {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(new Date(date));
};

const seo = getBlogPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
	<Header />
	<PageMain class="text-foreground">
		<!-- Page Header with Background -->
		<div class="relative w-full py-8 sm:py-10">
			<div class="absolute inset-0 -z-10 overflow-hidden">
				<Image
					src={heroBg}
					alt=""
					class="w-full h-full object-cover object-center"
					loading="eager"
					widths={[800, 1200, 1920]}
				/>
				<div class="absolute inset-0 bg-white/85 dark:bg-black/85"></div>
			</div>
			<PageContainer>
				<Heading level={1} size="4xl" class="mb-4">
					Log
				</Heading>
				<Text size="lg" variant="secondary">
					Thoughts, process notes, and work in progress.
				</Text>
			</PageContainer>
		</div>

		<div class="relative z-10 w-full py-8 sm:py-12">
			<PageContainer>

				<!-- Content with Sidebar -->
				<div class="flex gap-12 lg:gap-16 relative">
					
					<!-- Sidebar Nav -->
					<aside class="hidden lg:block w-56 shrink-0">
						<div class="sticky top-32">
							<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
								Entries
							</Text>
							<nav class="space-y-3 border-l-2 border-foreground-secondary/10 pl-4">
								{renderedPosts.map((post) => (
									<a 
										href={`#${post.slug}`} 
										class="log-nav-link block text-sm text-foreground-secondary hover:text-accent transition-colors leading-snug"
										data-slug={post.slug}
										style="font-family: 'Besley', serif !important;"
									>
										{post.title}
									</a>
								))}
							</nav>
						</div>
					</aside>

					<!-- Posts Feed -->
					<div class="flex-1 min-w-0">
						{renderedPosts.map((post, index) => (
							<article id={post.slug} class="log-entry scroll-mt-32">
								{index > 0 && (
									<div class="border-t-2 border-foreground-secondary/10 my-16"></div>
								)}
								
								<!-- Post Header -->
								<div class="mb-8">
									<div class="flex items-center gap-3 mb-3">
										<Text size="sm" variant="secondary">
											{formatDate(post.pubDate)}
										</Text>
										{post.tags && post.tags.length > 0 && (
											<div class="flex gap-2">
												{post.tags.slice(0, 3).map((tag) => (
													<Badge size="sm" variant="outline">{tag}</Badge>
												))}
											</div>
										)}
									</div>
									<Heading level={2} size="3xl" class="mb-3">
										{post.title}
									</Heading>
									{post.description && (
										<Text size="lg" variant="secondary">
											{post.description}
										</Text>
									)}
								</div>

								<!-- Post Content -->
								<div class="prose prose-lg dark:prose-invert max-w-none">
									<PortableText value={post.body} />
								</div>
							</article>
						))}
					</div>
				</div>

			</PageContainer>
		</div>
	</PageMain>
	<Footer />
</BaseLayout>

<style>
	.log-nav-link.active {
		color: var(--color-accent);
		font-weight: 500;
	}
</style>

<script>
	const initLogNav = () => {
		const navLinks = document.querySelectorAll('.log-nav-link');
		const entries = document.querySelectorAll('.log-entry');
		if (!navLinks.length || !entries.length) return;

		const observer = new IntersectionObserver(
			(observerEntries) => {
				observerEntries.forEach((entry) => {
					if (entry.isIntersecting) {
						const slug = entry.target.id;
						navLinks.forEach((link) => {
							link.classList.toggle('active', (link as HTMLElement).dataset.slug === slug);
						});
					}
				});
			},
			{ rootMargin: '-20% 0px -60% 0px' }
		);

		entries.forEach((entry) => observer.observe(entry));
	};

	initLogNav();
	document.addEventListener('astro:after-swap', initLogNav);

	const openProseLinksInNewTab = () => {
		document.querySelectorAll<HTMLAnchorElement>('.prose a[href]').forEach((a) => {
			if (a.hostname !== location.hostname) {
				a.target = '_blank';
				a.rel = 'noopener noreferrer';
			}
		});
	};
	openProseLinksInNewTab();
	document.addEventListener('astro:after-swap', openProseLinksInNewTab);
</script>
