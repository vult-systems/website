---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import ComingSoonSection from '@/components/sections/coming-soon-section.astro';
import { getCodePageSEO } from '@/config/seo';

const seo = getCodePageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<div class="relative z-10">
			<ComingSoonSection 
				title="Code" 
				description="Tools and scripts for Maya workflows and character pipelines."
			/>
		</div>
	</main>
<Footer />
</BaseLayout>
