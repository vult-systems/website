---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageMain from '@/components/layout/page-main.astro';
import PageContainer from '@/components/layout/page-container.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import Link from '@/components/ui/link.astro';
import { getArtPageSEO } from '@/config/seo';
import mayaLogo from '@/assets/logos/software-autodesk-maya-logo-01.png';
import zbrushLogo from '@/assets/logos/software-maxon-zbrush-logo-01.png';
import substanceLogo from '@/assets/logos/software-substance-painter-logo-01.webp';
import marmosetLogo from '@/assets/logos/software-marmoset-toolbag-logo-01.png';
import unityLogoWht from '@/assets/logos/software-unity-wht.png';
import unityLogoBlk from '@/assets/logos/software-unity-blk.png';
import ue4Logo from '@/assets/logos/software-ue4.png';
import ue5Logo from '@/assets/logos/software-ue5.png';
import ue5LogoWht from '@/assets/logos/software-ue5-wht.png';
import arnoldLogo from '@/assets/logos/autodesk-maya-arnold-logo.png';
import marvelousLogo from '@/assets/logos/software-marvelous-designer-logo.png';
import max3dsLogo from '@/assets/logos/software-autodesk-3dsmax.png';
import mariLogo from '@/assets/logos/software-mari-logo.png';
import adobeSuiteLogo from '@/assets/logos/software-adobe-suite-logo.png';
import logo343wht from '@/assets/logos/343i-logo-wht.png';
import logo343blk from '@/assets/logos/343i-logo-blk.png';
import haloInfiniteLogo from '@/assets/logos/halo-infinite-logo-01.png';
import qualcommLogoWht from '@/assets/logos/qualcomm-logo-wht.png';
import qualcommLogoBlk from '@/assets/logos/qualcomm-logo-blk.png';
import qualcommLogoClr from '@/assets/logos/qualcomm-logo-clr.png';
import snapdragonLogo from '@/assets/logos/snapdragon_elite_gaming_badge-cut.png';
import snapdragonLogoWht from '@/assets/logos/snapdragon_elite_gaming_badge-wht.png';
import snapdragonLogoBlk from '@/assets/logos/snapdragon_elite_gaming_badge-blk.png';
import biowareLogoWht from '@/assets/logos/bioware-logo-wht.png';
import biowareLogoBlk from '@/assets/logos/bioware-logo-blk.png';
import uiw3dLogoWht from '@/assets/logos/uiw3d-horiz-logo-wht.png';
import uiw3dLogoBlk from '@/assets/logos/uiw3d-horiz-logo-blk.png';
import swtorLogo from '@/assets/logos/star-wars-the-old-republic-logo-hd-png.png';
import artstationLogo from '@/assets/logos/artstation-logo-white.png';
import vertexSchoolLogoWht from '@/assets/logos/vertex-school-logo-wht.png';
import vertexSchoolLogoBlk from '@/assets/logos/vertex-school-logo-blk.png';
import vultLogoWht from '@/assets/logos/vult-logo-wht.png';
import vultLogoBlk from '@/assets/logos/vult-logo-blk.png';
import monomythLogo from '@/assets/logos/Monomyth_Logo.png';

const toolLogos: Record<string, string | { light: string; dark: string }> = {
  'Maya': mayaLogo.src,
  'ZBrush': zbrushLogo.src,
  'Substance Painter': substanceLogo.src,
  'Marmoset': marmosetLogo.src,
  'Marmoset Toolbag': marmosetLogo.src,
  'Unity': { light: unityLogoBlk.src, dark: unityLogoWht.src },
  'Unreal Engine 4': ue4Logo.src,
  'Unreal Engine 5': { light: ue5Logo.src, dark: ue5LogoWht.src },
  'Arnold': arnoldLogo.src,
  'Marvelous Designer': marvelousLogo.src,
  '3ds Max': max3dsLogo.src,
  'Mari': mariLogo.src,
  'Adobe Suite': adobeSuiteLogo.src,
};

const clientLogos: Record<string, { light: string; dark: string }> = {
  '343 Industries': { light: logo343blk.src, dark: logo343wht.src },
  'Qualcomm': { light: qualcommLogoClr.src, dark: qualcommLogoClr.src },
  'Snapdragon': { light: snapdragonLogoBlk.src, dark: snapdragonLogoWht.src },
  'BioWare': { light: biowareLogoBlk.src, dark: biowareLogoWht.src },
  'UIW3D': { light: uiw3dLogoBlk.src, dark: uiw3dLogoWht.src },
  'Vertex School': { light: vertexSchoolLogoBlk.src, dark: vertexSchoolLogoWht.src },
  'Vult': { light: vultLogoBlk.src, dark: vultLogoWht.src },
};

const projectLogos: Record<string, { light: string; dark: string }> = {
  'Halo Infinite': { light: haloInfiniteLogo.src, dark: haloInfiniteLogo.src },
  'Snapdragon': { light: snapdragonLogoBlk.src, dark: snapdragonLogoWht.src },
  'Star Wars: The Old Republic': { light: swtorLogo.src, dark: swtorLogo.src },
  'Beneath the Waves': { light: artstationLogo.src, dark: artstationLogo.src },
  'Monomyth': { light: monomythLogo.src, dark: monomythLogo.src },
};

const clientLogoSizes: Record<string, string> = {
  '343 Industries': 'w-1/2',
  'BioWare': 'w-3/5',
  'UIW3D': 'w-full',
  'Vult': 'w-2/5',
};

const projectLogoSizes: Record<string, string> = {
  'Halo Infinite': 'w-4/5',
  'Star Wars: The Old Republic': 'w-4/5',
  'Beneath the Waves': 'w-3/4',
  'Monomyth': 'w-4/5',
};

export async function getStaticPaths() {
  const artPieces = await getCollection('art');
  return artPieces.map(art => ({
    params: { slug: art.slug },
    props: { art },
  }));
}

const { art } = Astro.props;
const { Content } = await art.render();

const allArt = await getCollection('art');
const sortedArt = allArt.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const currentIndex = sortedArt.findIndex(a => a.slug === art.slug);
const prevArt = sortedArt[(currentIndex - 1 + sortedArt.length) % sortedArt.length];
const nextArt = sortedArt[(currentIndex + 1) % sortedArt.length];

const heroImageSrc = typeof art.data.heroImage === 'string' ? art.data.heroImage : art.data.heroImage?.src;
const seo = getArtPageSEO(art.data.title);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<BaseLayout
  title={seo.title}
  description={art.data.description}
  image={heroImageSrc}
  type="article"
  keywords={art.data.tags?.join(', ')}
>
  <Header />
  <PageMain class="text-foreground">
    <div class="relative z-10 w-full py-8 sm:py-12">
      <PageContainer>

        <div class="flex gap-12 lg:gap-16 relative">

          <!-- Sticky Sidebar -->
          <aside class="hidden lg:block w-64 shrink-0">
            <div class="sticky top-32 space-y-6">

              <!-- Title & Description -->
              <div>
                <Heading level={1} size="xl" class="mb-2 leading-tight">
                  {art.data.title}
                </Heading>
                {art.data.description && (
                  <Text size="sm" variant="secondary" class="leading-snug !text-foreground-muted">
                    {art.data.description}
                  </Text>
                )}
              </div>

              <div class="border-t border-border"></div>

              <!-- Role -->
              {art.data.role && (
                <div>
                  <Text size="xs" variant="secondary" class="uppercase tracking-widest mb-2 block" style="font-family: 'Besley', serif !important;">
                    Role
                  </Text>
                  <Text size="sm" variant="secondary">{art.data.role}</Text>
                </div>
              )}

              <!-- Company / Client -->
              {art.data.client && (
                <div>
                  <Text size="xs" variant="secondary" class="uppercase tracking-widest mb-3 block" style="font-family: 'Besley', serif !important;">
                    Studio
                  </Text>
                  <div class="flex flex-col gap-4">
                    {(Array.isArray(art.data.client) ? art.data.client : [art.data.client])
                      .filter((client) => clientLogos[client])
                      .map((client) => (
                        <div>
                          <img
                            src={clientLogos[client].light}
                            alt={client}
                            class={`${clientLogoSizes[client] ?? 'w-3/4'} h-auto object-contain opacity-80 dark:hidden`}
                            data-no-lightbox
                          />
                          <img
                            src={clientLogos[client].dark}
                            alt={client}
                            class={`${clientLogoSizes[client] ?? 'w-3/4'} h-auto object-contain opacity-80 hidden dark:block`}
                            data-no-lightbox
                          />
                        </div>
                      ))}
                  </div>
                </div>
              )}

              <!-- Project -->
              {art.data.project && (
                <div>
                  <Text size="xs" variant="secondary" class="uppercase tracking-widest mb-3 block" style="font-family: 'Besley', serif !important;">
                    Project
                  </Text>
                  {projectLogos[art.data.project] ? (
                    <>
                      <img
                        src={projectLogos[art.data.project].light}
                        alt={art.data.project}
                        class={`${projectLogoSizes[art.data.project] ?? 'w-2/3'} h-auto object-contain opacity-80 dark:hidden ${art.data.project === 'Beneath the Waves' ? 'brightness-0' : ''}`}
                        data-no-lightbox
                      />
                      <img
                        src={projectLogos[art.data.project].dark}
                        alt={art.data.project}
                        class={`${projectLogoSizes[art.data.project] ?? 'w-2/3'} h-auto object-contain opacity-80 hidden dark:block`}
                        data-no-lightbox
                      />
                    </>
                  ) : (
                    <Text size="sm" variant="secondary">{art.data.project}</Text>
                  )}
                </div>
              )}

              <!-- Tools -->
              {art.data.tools && art.data.tools.length > 0 && (
                <div>
                  <Text size="xs" variant="secondary" class="uppercase tracking-widest mb-3 block" style="font-family: 'Besley', serif !important;">
                    Tools
                  </Text>
                  <div class="flex flex-col gap-2">
                    {art.data.tools.map((tool) => (
                      <div class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md border border-border bg-card-hover text-sm text-foreground-secondary">
                        {toolLogos[tool] && (
                          typeof toolLogos[tool] === 'string' ? (
                            <img
                              src={toolLogos[tool] as string}
                              alt=""
                              class="h-5 w-auto object-contain shrink-0"
                              data-no-lightbox
                            />
                          ) : (
                            <>
                              <img
                                src={(toolLogos[tool] as { light: string; dark: string }).light}
                                alt=""
                                class="h-5 w-auto object-contain shrink-0 dark:hidden"
                                data-no-lightbox
                              />
                              <img
                                src={(toolLogos[tool] as { light: string; dark: string }).dark}
                                alt=""
                                class="h-5 w-auto object-contain shrink-0 hidden dark:block"
                                data-no-lightbox
                              />
                            </>
                          )
                        )}
                        <span>{tool}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

            </div>
          </aside>

          <!-- Main Content -->
          <div class="flex-1 min-w-0">

            <!-- Mobile header (visible on small screens) -->
            <div class="lg:hidden mb-8 space-y-3">
              <Heading level={1} size="3xl" class="leading-tight">{art.data.title}</Heading>
              {art.data.description && (
                <Text size="lg" variant="secondary" class="!text-foreground-muted">{art.data.description}</Text>
              )}
              <div class="flex flex-wrap gap-2">
                {art.data.category && <Badge size="sm">{art.data.category}</Badge>}
                {art.data.tools?.map((t) => <Badge size="sm" variant="outline">{t}</Badge>)}
              </div>
            </div>

            <!-- Prose Content -->
            <div class="prose prose-lg dark:prose-invert max-w-none">
              <Content />
            </div>

          </div>
        </div>

      </PageContainer>
    </div>
  </PageMain>
  <Footer />

  <!-- Prev/Next Art Navigation -->
  {prevArt && (
    <a
      id="art-nav-prev"
      href={`/art/${prevArt.slug}`}
      class="fixed left-4 top-1/2 -translate-y-1/2 z-50 flex items-center justify-center w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 opacity-100 hover:opacity-100"
      aria-label={`Previous: ${prevArt.data.title}`}
      title={prevArt.data.title}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </a>
  )}
  {nextArt && (
    <a
      id="art-nav-next"
      href={`/art/${nextArt.slug}`}
      class="fixed right-4 top-1/2 -translate-y-1/2 z-50 flex items-center justify-center w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 opacity-100 hover:opacity-100"
      aria-label={`Next: ${nextArt.data.title}`}
      title={nextArt.data.title}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </a>
  )}

  <script>
    import { navigate } from 'astro:transitions/client';
    // Bind once for the session; the handler reads the current page's links live.
    if (!(window as any).__artArrowNav) {
      (window as any).__artArrowNav = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        // Don't hijack arrows while the image lightbox is open.
        const lb = document.getElementById('lightbox');
        if (lb && lb.classList.contains('visible')) return;
        const link = document.getElementById(
          e.key === 'ArrowLeft' ? 'art-nav-prev' : 'art-nav-next'
        ) as HTMLAnchorElement | null;
        const href = link?.getAttribute('href');
        if (href) {
          e.preventDefault();
          navigate(href);
        }
      });
    }
  </script>

  <script>
    // Lazy-load post videos: only load/play when scrolled into view (preload="none"
    // on the markup means they don't download until play() is called).
    let artVideoIO: IntersectionObserver | undefined;
    const setupArtVideos = () => {
      artVideoIO?.disconnect();
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      if (!vids.length) return;
      artVideoIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      }, { threshold: 0.25, rootMargin: '200px 0px' });
      vids.forEach((v) => artVideoIO!.observe(v));
    };
    setupArtVideos();
    document.addEventListener('astro:page-load', setupArtVideos);
  </script>

  <script>
    // Wrap plain content images in the site's spotlight-card glow (see
    // globals.css) so post breakdowns get the same hover treatment as the
    // art grid cards, without hand-editing every post's markup. Skips images
    // already wired up manually (e.g. the sketchbook bento grid) and video
    // previews, which already have their own lightbox hover treatment.
    const initArtSpotlightMedia = () => {
      const prose = document.querySelector('.prose');
      if (!prose) return;
      const images = prose.querySelectorAll<HTMLImageElement>('img:not([data-no-lightbox])');
      images.forEach((img) => {
        if (img.closest('.spotlight-card')) return;
        const card = document.createElement('div');
        card.className = 'spotlight-card group relative block my-8';
        const inner = document.createElement('div');
        inner.className = 'spotlight-inner rounded-md overflow-hidden transition-all duration-300 group-hover:scale-[1.02]';
        img.replaceWith(card);
        card.appendChild(inner);
        inner.appendChild(img);
        img.classList.add('!my-0');
      });
    };
    initArtSpotlightMedia();
    document.addEventListener('astro:page-load', initArtSpotlightMedia);
  </script>
</BaseLayout>

