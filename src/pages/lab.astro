---
/**
 * Visual Lab - Development Playground
 * 
 * A comprehensive showcase of all design system components, UI elements,
 * and design tokens.
 * DEV ONLY: This page is for development purposes only
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import PageContainer from '../components/layout/page-container.astro';
import PageHeader from '../components/layout/page-header.astro';
import PageMain from '../components/layout/page-main.astro';

// UI Components
import Button from '../components/ui/button.astro';
import Card from '../components/ui/card.astro';
import Heading from '../components/ui/heading.astro';
import Text from '../components/ui/text.astro';
import Badge from '../components/ui/badge.astro';
import Link from '../components/ui/link.astro';
import MinimalHero from '../components/ui/minimal-hero.astro';
import FeaturedGrid from '../components/ui/featured-grid.astro';
import DotBackground from '../components/ui/dot-background.astro';

// Layout Components
import Header from '../components/layout/header.astro';
import Footer from '../components/layout/footer.astro';
import HeroSection from '../components/sections/hero-section.astro';
import ContentSection from '../components/sections/content-section.astro';
import ComingSoonSection from '../components/sections/coming-soon-section.astro';

// Theme Components
import { ThemeToggle } from '../components/ui/theme-toggle';

// Get featured art pieces from content collection
const artPieces = await getCollection('art');
const featuredArt = artPieces
  .filter(piece => piece.data.featured)
  .map(piece => ({
    slug: piece.slug,
    title: piece.data.title,
    description: piece.data.description,
    heroImage: (typeof piece.data.heroImage === 'string' ? piece.data.heroImage : piece.data.heroImage?.src) || '',
    category: piece.data.category,
  }));

// Only show in development
const isDev = import.meta.env.DEV;

if (!isDev) {
  return Astro.redirect('/');
}
---

<BaseLayout 
  title="Visual Lab - Design System Playground"
  description="Development playground for testing and iterating on design system components"
>
  <!-- Google Fonts - Besley + Neue Haas Grotesk -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,400..900;1,400..900&family=Neue+Haas+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
  
  <Header />
  <PageMain class="text-foreground">
    <DotBackground />
    
    <div class="relative z-10 w-full py-24 sm:py-16">
      <PageContainer>
        <div class="mb-10">
          <div class="flex items-center justify-between">
            <div>
              <Heading level={1} size="4xl" class="mb-6">Visual Lab</Heading>
              <Text size="lg" class="text-foreground-secondary">
                Design System Playground & Component Showcase
              </Text>
            </div>
          </div>
        </div>
      <!-- Hero Sections -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Hero Components</Heading>
        
        <!-- Minimal Hero -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Minimal Hero</Heading>
          <div>
            <MinimalHero class="py-16" />
          </div>
        </div>

        <!-- Hero Section -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Full Hero Section</Heading>
          <div>
            <div class="relative z-10 py-16">
              <div class="container max-w-7xl mx-auto px-4 text-center">
                <Heading level={1} size="5xl" align="center" class="mb-6">Hero Section Example</Heading>
                <Text size="xl" class="text-foreground-secondary mb-8 max-w-2xl mx-auto">
                  This showcases how the main hero section appears with your current styling and background elements.
                </Text>
                <div class="flex gap-4 justify-center">
                    <Link href="#test" variant="accent">Primary CTA ></Link>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Design Tokens Overview -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Design Tokens</Heading>
        
        <!-- Colors -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Color System</Heading>
          <div class="flex flex-wrap gap-4">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 border border-border rounded" style="background-color: hsl(var(--background))"></div>
              <Text size="sm">Background</Text>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 bg-foreground rounded"></div>
              <Text size="sm">Foreground</Text>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 bg-accent rounded"></div>
              <Text size="sm">Accent</Text>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 bg-card border border-border rounded"></div>
              <Text size="sm">Card</Text>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 bg-border border border-border-hover rounded"></div>
              <Text size="sm">Border</Text>
            </div>
          </div>
        </div>

        <!-- Typography Scale -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Typography Scale</Heading>
          <div class="space-y-2">
            <Heading level={1} size="4xl">Large Heading (4xl)</Heading>
            <Heading level={2} size="2xl">Medium Heading (2xl)</Heading>
            <Heading level={3} size="lg">Small Heading (lg)</Heading>
            <Text size="lg">Large body text for important content</Text>
            <Text>Regular body text for most content</Text>
            <Text size="sm" class="text-foreground-secondary">Small text for captions</Text>
          </div>
        </div>
      </div>

      <!-- All UI Components -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">UI Components</Heading>
        
        <!-- Buttons -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Buttons</Heading>
          <div class="flex flex-wrap gap-3">
            <Button variant="primary">Primary</Button>
            <Button variant="ghost">Ghost</Button>
          </div>
        </div>

        <!-- Cards -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Cards</Heading>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <Card padding="lg">
              <Heading level={4} size="base" class="mb-2">Default Card</Heading>
              <Text size="sm" class="text-foreground-secondary">Standard card styling</Text>
            </Card>
            <Card padding="lg" variant="elevated">
              <Heading level={4} size="base" class="mb-2">Elevated Card</Heading>
              <Text size="sm" class="text-foreground-secondary">With shadow elevation</Text>
            </Card>
            <Card padding="lg" interactive>
              <Heading level={4} size="base" class="mb-2">Interactive Card</Heading>
              <Text size="sm" class="text-foreground-secondary">Hover for effects</Text>
            </Card>
          </div>
        </div>

        <!-- Badges & Links -->
        <div class="mb-8">
          <Heading level={3} size="lg" class="mb-4">Badges & Links</Heading>
          <div class="space-y-4">
            <div>
              <Text size="sm" class="text-foreground-secondary mb-2">Badges:</Text>
              <div class="flex gap-2">
                <Badge>Default</Badge>
                <Badge variant="accent">Accent</Badge>
                <Badge variant="outline">Outline</Badge>
                <Badge variant="ghost">Ghost</Badge>
              </div>
            </div>
            <div>
              <Text size="sm" class="text-foreground-secondary mb-2">Links:</Text>
              <div class="space-x-4">
                <Link href="#test" variant="accent">Accent Link</Link>
                <Link href="#test" variant="ghost">Subtle Link</Link>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Featured Grid Component -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Featured Grid Component</Heading>
        <Card padding="lg">
          <FeaturedGrid 
            title="Featured Work"
            description="Real featured artwork from the website content collection"
            artPieces={featuredArt}
          />
        </Card>
      </div>

      <!-- Content Section Component -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Content Section Component</Heading>
        <ContentSection 
          title="Example Content Section"
          description="This demonstrates how content sections appear with titles and descriptions"
          padding="base"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Card padding="lg">
              <Heading level={4} size="base" class="mb-3">Content Block 1</Heading>
              <Text class="text-foreground-secondary">
                This shows how content appears within a content section component with proper spacing and layout.
              </Text>
            </Card>
            <Card padding="lg">
              <Heading level={4} size="base" class="mb-3">Content Block 2</Heading>
              <Text class="text-foreground-secondary">
                Multiple content blocks demonstrate the section's flexibility and responsive behavior.
              </Text>
            </Card>
          </div>
        </ContentSection>
      </div>

      <!-- Coming Soon Section -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Coming Soon Section</Heading>
        <div class="border border-border rounded-lg overflow-hidden">
          <ComingSoonSection 
            title="Example Coming Soon Page" 
            description="This shows how the coming soon section component appears with your styling"
          />
        </div>
      </div>

      <!-- Complex Layout Example -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Complex Layout Example</Heading>
        <Card padding="lg" class="max-w-4xl">
          <div class="flex items-start justify-between mb-6">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <Heading level={3} size="xl">Multi-Component Layout</Heading>
                <Badge variant="accent">Featured</Badge>
              </div>
              <Text class="text-foreground-secondary">Combining multiple components in realistic layouts</Text>
            </div>
            <Button variant="ghost" size="sm">⋯</Button>
          </div>
          
          <Text class="mb-6">
            This layout demonstrates how typography, spacing, and components work together in complex designs. 
            When you adjust design tokens, you'll see changes reflected across all these elements simultaneously.
          </Text>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div class="space-y-3">
              <Heading level={4} size="base">Key Features</Heading>
              <ul class="space-y-2 text-sm text-foreground-secondary">
                <li>• Consistent spacing system</li>
                <li>• Responsive typography scale</li>
                <li>• Semantic color tokens</li>
                <li>• Component composition</li>
              </ul>
            </div>
            <div class="space-y-3">
              <Heading level={4} size="base">Design Benefits</Heading>
              <ul class="space-y-2 text-sm text-foreground-secondary">
                <li>• Easy theme switching</li>
                <li>• Maintainable codebase</li>
                <li>• Consistent user experience</li>
                <li>• Scalable design system</li>
              </ul>
            </div>
          </div>
          
          <div class="flex items-center justify-between pt-4 border-t border-border">
            <div class="flex gap-2">
              <Badge variant="outline">Design System</Badge>
              <Badge variant="outline">Components</Badge>
            </div>
            <div class="flex gap-3">
              <Button variant="primary" size="sm">View Details</Button>
              <Link href="#example" variant="button">Learn More →</Link>
            </div>
          </div>
        </Card>
      </div>

      <!-- Theme Testing -->
      <div class="mb-12">
        <Heading level={2} size="2xl" class="mb-6">Theme Testing</Heading>
        <Card padding="lg" class="max-w-md">
          <Heading level={4} size="lg" class="mb-4">Live Theme Toggle</Heading>
          <Text class="mb-4 text-foreground-secondary">
            Test how all components respond to theme changes.
          </Text>
          <div class="flex justify-center">
            <ThemeToggle client:visible />
          </div>
        </Card>
      </div>
      </PageContainer>
    </div>
  </PageMain>
  <Footer />
</BaseLayout>

<style>
  /* Font Override - Mixed fonts for Lab Page */
  :root {
    --font-neue-haas: 'Neue Haas Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  
  /* Apply Neue Haas Grotesk to body and most elements on the lab page */
  body {
    font-family: var(--font-neue-haas) !important;
    /* Add dot background that covers full page height - override any solid background */
    background-image: radial-gradient(rgb(230 230 230) 1px, transparent 1px) !important;
    background-size: 20px 20px !important;
    background-attachment: fixed !important;
    background-color: hsl(var(--background)) !important;
    min-height: 100vh;
  }
  
  /* Dark mode dot background */
  :global(.dark) body {
    background-image: radial-gradient(rgb(40 40 40) 1px, transparent 1px) !important;
    background-color: hsl(var(--background)) !important;
  }
  
  /* Apply Neue Haas Grotesk to all text elements (headings will override this) */
  * {
    font-family: var(--font-neue-haas) !important;
  }
  
  /* Additional lab-specific styles */
  .lab-color-swatch {
    @apply w-12 h-12 rounded-lg border border-border flex-shrink-0;
  }
  
  .lab-section {
    @apply mb-16 last:mb-0;
  }
</style>