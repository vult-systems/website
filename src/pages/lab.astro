---
/**
 * Design System Lab
 * 
 * Interactive showcase of the centralized design system.
 * Demonstrates all components, tokens, and patterns from src/config/design.ts
 * 
 * DEV ONLY: Redirects to home in production
 */

import { getCollection } from 'astro:content';
import { sanityClient } from '@/lib/sanity/client';
import { logListQuery } from '@/lib/sanity/queries';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import PageContainer from '@/components/layout/page-container.astro';

// UI Components from design system
import Button from '@/components/ui/button.astro';
import Badge from '@/components/ui/badge.astro';
import Card from '@/components/ui/card.astro';
import Link from '@/components/ui/link.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import FeaturedGrid from '@/components/ui/featured-grid.astro';
import BentoGrid from '@/components/ui/bento-grid.astro';
import BentoGridItem from '@/components/ui/bento-grid-item.astro';

// Import images
import heroImage from '@/assets/foundation-explorer/carlos-garcia-foundation-explorer-01.jpg';
import artImage1 from '@/assets/art-placeholders/digital-sculpture.jpg';
import artImage2 from '@/assets/art-placeholders/character-2.jpg';
import artImage3 from '@/assets/art-placeholders/3d-modeling.jpg';
import artImage4 from '@/assets/art-placeholders/environment-1.jpg';

// Import design tokens for display
import { components, layout, typography, spacing, radius, animation } from '@/config/design';

// Get real content from collections
const artPieces = await getCollection('art');
const featuredArt = artPieces
  .filter(piece => piece.data.featured)
  .slice(0, 3)
  .map(piece => ({
    slug: piece.slug,
    title: piece.data.title,
    description: piece.data.description,
    heroImage: piece.data.heroImage,
    category: piece.data.category,
  }));

const recentPosts = import.meta.env.DEV
  ? ((await sanityClient.fetch(logListQuery)) as any[]).slice(0, 2)
  : [];

// Only show in development
const isDev = import.meta.env.DEV;
if (!isDev) {
  return Astro.redirect('/');
}
---

<BaseLayout 
  title="Design System Lab - carlosgarcia.works"
  description="Component reference and design system documentation"
>
  <Header />
  
  <main class="min-h-screen w-full text-foreground">
    <PageContainer>
      
      <!-- Intro -->
      <section class="py-16 sm:py-24">
        <Badge variant="accent" class="mb-4">Dev Only</Badge>
        <Heading level={1} size="4xl" class="mb-6">Design System Reference</Heading>
        
        <div class="prose-custom max-w-3xl space-y-6 mb-12">
          <Text size="lg" variant="secondary">
            I built this site with a centralized design system. Every component pulls from the same config files, 
            so changing a button style or color palette happens in one place and cascades everywhere.
          </Text>
          
          <Text>
            This page is my reference when I forget what props are available or need to see all the variants 
            side-by-side. It's also useful when I want to test changes to the design tokens before pushing them live.
          </Text>

          <Text variant="secondary">
            Everything here is live code—not static examples. The components you see are the actual ones used 
            across the site.
          </Text>
        </div>
      </section>

      <!-- Colors -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Color System</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Colors are semantic—they adapt to light and dark themes automatically. The actual values live in 
            <code class="text-accent">tailwind.config.mjs</code> using HSL format so I can tweak hue, saturation, 
            and lightness independently.
          </Text>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
          <Card padding="base">
            <div class="w-full h-20 bg-background border border-border rounded-md mb-3"></div>
            <Text size="sm" class="font-medium mb-1">background</Text>
            <Text size="xs" variant="muted" class="font-mono">bg-background</Text>
          </Card>
          <Card padding="base">
            <div class="w-full h-20 bg-foreground rounded-md mb-3"></div>
            <Text size="sm" class="font-medium mb-1">foreground</Text>
            <Text size="xs" variant="muted" class="font-mono">text-foreground</Text>
          </Card>
          <Card padding="base">
            <div class="w-full h-20 bg-accent rounded-md mb-3"></div>
            <Text size="sm" class="font-medium mb-1">accent</Text>
            <Text size="xs" variant="muted" class="font-mono">bg-accent</Text>
          </Card>
          <Card padding="base">
            <div class="w-full h-20 bg-card border border-border rounded-md mb-3"></div>
            <Text size="sm" class="font-medium mb-1">card</Text>
            <Text size="xs" variant="muted" class="font-mono">bg-card</Text>
          </Card>
          <Card padding="base">
            <div class="w-full h-20 bg-border rounded-md mb-3"></div>
            <Text size="sm" class="font-medium mb-1">border</Text>
            <Text size="xs" variant="muted" class="font-mono">border-border</Text>
          </Card>
        </div>

        <Card padding="lg" variant="bordered" class="max-w-2xl">
          <div class="bg-card/50 border border-border rounded-md p-4 font-mono text-sm">
            <div class="text-muted">// tailwind.config.mjs</div>
            <div>colors: {'{'}</div>
            <div class="pl-4">accent: 'hsl(142 71% 45%)',</div>
            <div class="pl-4">foreground: 'hsl(var(--foreground))',</div>
            <div>{'}'}</div>
          </div>
        </Card>
      </section>

      <!-- Typography -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Typography</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            The type scale is in <code class="text-accent">src/config/design.ts</code>. I map semantic size names 
            (like '4xl', '3xl') to Tailwind classes. Makes it easier to maintain consistency without remembering 
            which heading uses which class.
          </Text>
        </div>

        <div class="space-y-8 mb-8">
          <div>
            <Heading level={1} size="4xl" class="mb-2">Heading 4xl</Heading>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Heading level={'{'}1{'}'} size="4xl"{'>'}</Text>
          </div>
          <div>
            <Heading level={2} size="3xl" class="mb-2">Heading 3xl</Heading>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Heading level={'{'}2{'}'} size="3xl"{'>'}</Text>
          </div>
          <div>
            <Heading level={3} size="2xl" class="mb-2">Heading 2xl</Heading>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Heading level={'{'}3{'}'} size="2xl"{'>'}</Text>
          </div>
          <div>
            <Heading level={4} size="xl" class="mb-2">Heading xl</Heading>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Heading level={'{'}4{'}'} size="xl"{'>'}</Text>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <Text size="lg" class="mb-1">Body large - for lead text or emphasis</Text>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Text size="lg"{'>'}</Text>
          </div>
          <div>
            <Text class="mb-1">Body base - default text size</Text>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Text{'>'}</Text>
          </div>
          <div>
            <Text size="sm" variant="secondary" class="mb-1">Body small with secondary color</Text>
            <Text size="sm" variant="muted" class="font-mono">{'<'}Text size="sm" variant="secondary"{'>'}</Text>
          </div>
        </div>
      </section>

      <!-- Buttons -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Buttons</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Four variants, three sizes. The <code class="text-accent">href</code> prop turns them into links 
            automatically. Styles are in <code class="text-accent">src/config/design.ts</code> so I can tweak 
            padding, radius, or hover states globally.
          </Text>
        </div>

        <div class="space-y-8">
          <div>
            <Text size="sm" variant="secondary" class="mb-3">Variants</Text>
            <div class="flex flex-wrap gap-3 mb-4">
              <Button variant="primary">Primary</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="outline">Outline</Button>
              <Button variant="ghost">Ghost</Button>
            </div>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Button variant="primary"{'>'}Text{'<'}/Button{'>'}</Text>
            </Card>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">Sizes</Text>
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <Button variant="primary" size="sm">Small</Button>
              <Button variant="primary" size="base">Base</Button>
              <Button variant="primary" size="lg">Large</Button>
            </div>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Button size="lg"{'>'}Text{'<'}/Button{'>'}</Text>
            </Card>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">States</Text>
            <div class="flex flex-wrap gap-3 mb-4">
              <Button variant="primary" href="/art">As Link</Button>
              <Button variant="secondary" disabled>Disabled</Button>
            </div>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Button href="/path"{'>'}Link Button{'<'}/Button{'>'}</Text>
            </Card>
          </div>
        </div>
      </section>

      <!-- Badges -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Badges</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Small labels for tags, categories, status indicators. I use these everywhere—art pieces, blog posts, 
            project categories.
          </Text>
        </div>

        <div class="space-y-8">
          <div>
            <Text size="sm" variant="secondary" class="mb-3">Variants</Text>
            <div class="flex flex-wrap gap-2 mb-4">
              <Badge variant="default">Default</Badge>
              <Badge variant="accent">Accent</Badge>
              <Badge variant="outline">Outline</Badge>
              <Badge variant="muted">Muted</Badge>
              <Badge variant="ghost">Ghost</Badge>
            </div>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">Sizes</Text>
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <Badge size="sm">Small</Badge>
              <Badge size="base">Base</Badge>
            </div>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Badge variant="accent" size="sm"{'>'}Label{'<'}/Badge{'>'}</Text>
            </Card>
          </div>
        </div>
      </section>

      <!-- Cards -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Cards</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Container components. The <code class="text-accent">interactive</code> prop with <code class="text-accent">href</code> 
            makes the whole card clickable with hover effects—useful for blog post previews or portfolio pieces.
          </Text>
        </div>

        <div class="space-y-8">
          <div>
            <Text size="sm" variant="secondary" class="mb-3">Variants</Text>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
              <Card padding="lg" variant="default">
                <Badge variant="default" class="mb-2">Default</Badge>
                <Text size="sm">Subtle border</Text>
              </Card>
              <Card padding="lg" variant="bordered">
                <Badge variant="accent" class="mb-2">Bordered</Badge>
                <Text size="sm">Thicker border</Text>
              </Card>
              <Card padding="lg" variant="elevated">
                <Badge variant="outline" class="mb-2">Elevated</Badge>
                <Text size="sm">Shadow depth</Text>
              </Card>
            </div>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">Interactive</Text>
            <Card padding="lg" interactive href="#" class="mb-4">
              <div class="flex items-start justify-between">
                <Text>Hover over this card</Text>
                <Badge variant="accent" size="sm">Clickable</Badge>
              </div>
            </Card>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Card interactive href="/path"{'>'}...{'<'}/Card{'>'}</Text>
            </Card>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">Padding</Text>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <Card padding="sm" variant="bordered"><Text size="sm">Small</Text></Card>
              <Card padding="base" variant="bordered"><Text size="sm">Base</Text></Card>
              <Card padding="lg" variant="bordered"><Text size="sm">Large</Text></Card>
            </div>
          </div>
        </div>
      </section>

      <!-- Links -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Links</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Styled anchor tags. Use the <code class="text-accent">external</code> prop for external URLs—it adds 
            the right attributes automatically.
          </Text>
        </div>

        <div class="space-y-8">
          <div>
            <Text size="sm" variant="secondary" class="mb-3">Variants</Text>
            <div class="flex flex-wrap gap-4 mb-4">
              <Link href="#" variant="default">Default</Link>
              <Link href="#" variant="accent">Accent</Link>
              <Link href="#" variant="muted">Muted</Link>
              <Link href="#" variant="ghost">Ghost</Link>
            </div>
          </div>

          <div>
            <Text size="sm" variant="secondary" class="mb-3">Underline styles</Text>
            <div class="flex flex-wrap gap-4 mb-4">
              <Link href="#" underline="always">Always</Link>
              <Link href="#" underline="hover">Hover</Link>
              <Link href="#" underline="none">None</Link>
            </div>
            <Card padding="base" variant="bordered" class="max-w-2xl">
              <Text size="xs" class="font-mono">{'<'}Link underline="hover"{'>'}Text{'<'}/Link{'>'}</Text>
            </Card>
          </div>
        </div>
      </section>

      <!-- Content Collections -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Content Collections</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            All content lives in MDX files. Astro's content collections give me type-safe queries and automatic 
            validation. Art pieces go in <code class="text-accent">src/content/art/</code>, blog posts in 
            <code class="text-accent">src/content/log/</code>.
          </Text>
          <Text variant="secondary">
            The examples below are pulling live data from those collections—not static mockups.
          </Text>
        </div>

        {featuredArt.length > 0 && (
          <div class="mb-12">
            <Heading level={3} size="xl" class="mb-4">Featured Artwork</Heading>
            <Text variant="secondary" class="mb-6">
              Set <code class="text-accent">featured: true</code> in the MDX frontmatter to include a piece here.
            </Text>
            <FeaturedGrid 
              title="Featured Work"
              description="From the art collection"
              artPieces={featuredArt}
            />
          </div>
        )}

        {recentPosts.length > 0 && (
          <div class="mb-12">
            <Heading level={3} size="xl" class="mb-4">Recent Posts</Heading>
            <Text variant="secondary" class="mb-6">
              Blog posts automatically sorted by date. These cards are interactive—hover to see the effect.
            </Text>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {recentPosts.map(post => (
                <Card padding="lg" interactive href={`/log/${post.slug}`}>
                  <div class="flex items-start justify-between mb-3">
                    <Badge variant="outline">{post.category || 'log'}</Badge>
                    <Text size="xs" variant="muted">
                      {new Date(post.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </Text>
                  </div>
                  <Heading level={4} size="lg" class="mb-2">{post.title}</Heading>
                  <Text size="sm" variant="secondary" class="line-clamp-2">
                    {post.description}
                  </Text>
                </Card>
              ))}
            </div>
          </div>
        )}
      </section>

      <!-- Bento Grid Showcase -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Bento Grid Layout</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            A flexible masonry-style grid system for showcasing content with varying sizes. Items can span 
            multiple columns and rows to create visual hierarchy and interest.
          </Text>
          
          <Text size="sm" variant="secondary">
            Used for art portfolios and featured content. Small (1 col), Medium (1 col), and Large (2×2) sizes 
            create a dynamic Pinterest-style layout.
          </Text>
        </div>

        <BentoGrid class="mb-8">
          <BentoGridItem class="md:col-span-2 md:row-span-2" href="#">
            <div class="flex flex-col h-full">
              <!-- Image -->
              <div class="relative flex-1 overflow-hidden min-h-[10rem]">
                <img
                  src={heroImage.src}
                  alt="Large hero example"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="lg" class="line-clamp-2">Large Hero Item</Heading>
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  Large items span 2 columns and 2 rows, perfect for featuring your best work.
                </Text>
                <div>
                  <Badge size="sm">2×2</Badge>
                </div>
              </div>
            </div>
          </BentoGridItem>

          <BentoGridItem class="md:col-span-1" href="#">
            <div class="flex flex-col h-full">
              <!-- Image -->
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={artImage1.src}
                  alt="Medium example"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="lg" class="line-clamp-2">Medium Item</Heading>
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  Standard size for most content pieces.
                </Text>
                <div>
                  <Badge size="sm" variant="outline">1×1</Badge>
                </div>
              </div>
            </div>
          </BentoGridItem>

          <BentoGridItem class="md:col-span-1" href="#">
            <div class="flex flex-col h-full">
              <!-- Image -->
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={artImage2.src}
                  alt="Small example"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="lg" class="line-clamp-2">Small Item</Heading>
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  Compact items fill gaps efficiently.
                </Text>
                <div>
                  <Badge size="sm" variant="outline">1×1</Badge>
                </div>
              </div>
            </div>
          </BentoGridItem>

          <BentoGridItem class="md:col-span-1" href="#">
            <div class="flex flex-col h-full">
              <!-- Image -->
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={artImage3.src}
                  alt="Another example"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="lg" class="line-clamp-2">Another Piece</Heading>
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  Grid flows items automatically with dense packing.
                </Text>
                <div>
                  <Badge size="sm" variant="outline">1×1</Badge>
                </div>
              </div>
            </div>
          </BentoGridItem>

          <BentoGridItem class="md:col-span-2" href="#">
            <div class="flex flex-col h-full">
              <!-- Image -->
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={artImage4.src}
                  alt="Wide example"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="lg" class="line-clamp-2">Wide Format</Heading>
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  Wide items span 2 columns, ideal for panoramic or landscape-oriented work.
                </Text>
                <div>
                  <Badge size="sm" variant="outline">2×1</Badge>
                </div>
              </div>
            </div>
          </BentoGridItem>
        </BentoGrid>

        <Card padding="lg" variant="bordered" class="max-w-3xl">
          <Heading level={4} size="base" class="mb-4">Implementation</Heading>
          <div class="space-y-3 font-mono text-sm">
            <div class="flex gap-4">
              <Text size="sm" class="text-accent min-w-[120px]">Base Grid</Text>
              <Text size="sm" variant="secondary">src/components/ui/bento-grid.astro</Text>
            </div>
            <div class="flex gap-4">
              <Text size="sm" class="text-accent min-w-[120px]">Grid Item</Text>
              <Text size="sm" variant="secondary">src/components/ui/bento-grid-item.astro</Text>
            </div>
          </div>
        </Card>
      </section>

      <!-- Configuration -->
      <section class="py-12 border-t border-border">
        <Heading level={2} size="3xl" class="mb-6">Configuration Files</Heading>
        
        <div class="prose-custom max-w-3xl space-y-4 mb-8">
          <Text>
            Three config files control the entire site. This is the core of the DRY approach—everything pulls 
            from these centralized sources.
          </Text>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <Card padding="lg" variant="elevated">
            <Badge variant="accent" class="mb-3">Design</Badge>
            <Heading level={4} size="base" class="mb-2">design.ts</Heading>
            <Text size="sm" class="font-mono text-accent mb-4">src/config/design.ts</Text>
            <Text size="sm" variant="secondary" class="mb-4">
              Component styles, spacing scales, border radii, animations. Change button padding or card shadows 
              here and it updates everywhere.
            </Text>
            <div class="space-y-1">
              <Text size="xs" variant="muted">• Button variants</Text>
              <Text size="xs" variant="muted">• Badge styles</Text>
              <Text size="xs" variant="muted">• Card variants</Text>
              <Text size="xs" variant="muted">• Typography scale</Text>
            </div>
          </Card>

          <Card padding="lg" variant="elevated">
            <Badge variant="accent" class="mb-3">Content</Badge>
            <Heading level={4} size="base" class="mb-2">site.ts</Heading>
            <Text size="sm" class="font-mono text-accent mb-4">src/config/site.ts</Text>
