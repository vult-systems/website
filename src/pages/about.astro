---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import profileImg from '@/assets/profile/profile.jpg';
import resumeThumb from '@/assets/profile/resume-thumbnail.png';
import { getAboutPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';

const seo = getAboutPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
				
				<!-- Two Column Layout -->
				<div class="grid lg:grid-cols-[1fr_1.5fr] gap-12 lg:gap-16">
					
					<!-- Left Column - Image & Quick Info -->
					<div class="space-y-8">
						<div>
							<Image
								src={profileImg}
								alt={SITE.author.name}
								width={800}
								height={600}
								id="about-profile-image"
								class="w-full object-cover rounded-md"
								style="aspect-ratio: 4/5;"
							/>
						</div>
						
						<div class="space-y-4">
							<div>
								<Text variant="secondary" size="sm" class="mb-1">Location</Text>
								<Text variant="primary" size="base">{SITE.author.location.full}</Text>
							</div>
							
							<div>
								<Text variant="secondary" size="sm" class="mb-1">Focus</Text>
								<div class="flex flex-wrap gap-2 mt-2">
									<Badge>3D Character Art</Badge>
									<Badge>Digital Sculpture</Badge>
									<Badge>Technical Art</Badge>
									<Badge>Education</Badge>
								</div>
							</div>
							
							<div>
								<Text variant="secondary" size="sm" class="mb-2">Connect</Text>
								<div class="space-y-2">
									<div>
										<Link href={SITE.social.github} variant="accent">
											GitHub >
										</Link>
									</div>
									<div>
										<Link href={SITE.social.linkedin} variant="accent">
											LinkedIn >
										</Link>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Right Column - Content -->
					<div class="space-y-12">
						<!-- Header & Bio -->
						<div>
							<Heading level={1} size="4xl" class="mb-6">About</Heading>
							<Text variant="secondary" class="leading-relaxed mb-4">
								I'm a 3D Character Artist and Educator based in {SITE.author.location.full}. I specialize in character modeling 
								and digital sculpture, with experience working at studios like 343 Industries, BioWare, Qualcomm, and Walt 
								Disney Animation. I currently teach at the University of the Incarnate Word where I coordinate the Modeling 
								concentration and develop curriculum that bridges industry practice with academic foundations. Through Vult, 
								I run my private client work across all aspects of the 3D industry, working professionally with various 
								artists, students, and companies.
							</Text>
						</div>

						<!-- Resume -->
						<div>
							<Heading level={2} size="2xl" class="mb-4">Resume</Heading>
							<div class="inline-block">
								<button id="resume-trigger" class="group block rounded-md border-2 border-border hover:border-accent/40 transition-all overflow-hidden cursor-pointer bg-transparent p-0 text-left">
									<Image
										src={resumeThumb}
										alt="Carlos Garcia Resume"
										width={400}
										height={504}
										class="w-full max-w-[280px] object-contain rounded-md transition-transform duration-300 group-hover:scale-[1.02]"
									/>
								</button>
								<div class="mt-2">
									<a href="/CarlosGarcia_Resume_2026.pdf" download class="inline-flex items-center gap-1.5 text-sm text-foreground-secondary hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
										</svg>
										Download PDF
									</a>
								</div>
							</div>
						</div>

						<!-- Resume Drawer/Lightbox -->
						<div id="resume-drawer" class="fixed inset-0 bg-background/95 backdrop-blur-md z-[9999] opacity-0 invisible transition-all duration-200 ease-out flex items-center justify-center p-4 sm:p-8">
							<div class="relative w-full max-w-4xl h-full flex flex-col">
								<!-- Drawer Header -->
								<div class="flex items-center justify-between mb-4 shrink-0">
									<a href="/CarlosGarcia_Resume_2026.pdf" download class="inline-flex items-center gap-1.5 text-sm text-foreground-secondary hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
										</svg>
										Download
									</a>
									<button id="resume-close" class="w-10 h-10 rounded-full bg-card border border-border hover:bg-card-hover transition-colors flex items-center justify-center cursor-pointer">
										<span class="text-xl">×</span>
									</button>
								</div>
								<!-- PDF Embed -->
								<div class="flex-1 rounded-lg border-2 border-foreground-secondary/10 bg-card shadow-2xl overflow-hidden opacity-0 scale-90 transition-all duration-200 ease-out" id="resume-content">
									<iframe src="/CarlosGarcia_Resume_2026.pdf" class="w-full h-full" title="Carlos Garcia Resume"></iframe>
								</div>
							</div>
						</div>

						<!-- CTA -->
						<div class="pt-8 border-t-2 border-foreground-secondary/10">
							<Text variant="secondary" class="mb-4">
								Interested in collaborating or learning more about my work?
							</Text>
							<div class="flex flex-wrap gap-4">
								<Link href="/art" variant="accent">
									View Work >
								</Link>
								<Link href="/learn" variant="accent">
									Teaching >
								</Link>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
<Footer />
</BaseLayout>

<script>
	const trigger = document.getElementById('resume-trigger');
	const drawer = document.getElementById('resume-drawer');
	const content = document.getElementById('resume-content');
	const closeBtn = document.getElementById('resume-close');

	const openDrawer = () => {
		if (!drawer || !content) return;
		drawer.classList.remove('invisible', 'opacity-0');
		drawer.classList.add('visible', 'opacity-100');
		requestAnimationFrame(() => {
			content.classList.remove('opacity-0', 'scale-90');
			content.classList.add('opacity-100', 'scale-100');
		});
		document.body.style.overflow = 'hidden';
	};

	const closeDrawer = () => {
		if (!drawer || !content) return;
		content.classList.remove('opacity-100', 'scale-100');
		content.classList.add('opacity-0', 'scale-90');
		setTimeout(() => {
			drawer.classList.remove('visible', 'opacity-100');
			drawer.classList.add('invisible', 'opacity-0');
			document.body.style.overflow = '';
		}, 200);
	};

	trigger?.addEventListener('click', openDrawer);
	closeBtn?.addEventListener('click', closeDrawer);
	drawer?.addEventListener('click', (e) => {
		if (e.target === drawer) closeDrawer();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeDrawer();
	});
</script>
