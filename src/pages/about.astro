---
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import { getAboutPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';

const seo = getAboutPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<div class="container max-w-4xl mx-auto px-4">
				
				<!-- Header -->
				<div class="mb-16">
					<Heading level={1} size="4xl" class="mb-6">About</Heading>
					<Text size="lg" variant="secondary" class="leading-relaxed">
						{SITE.author.role} based in {SITE.author.location.full}. 3D character art, digital modeling, 
						and education.
					</Text>
				</div>

				<!-- Bio Content -->
				<div class="max-w-none mb-16">
					<Heading level={2} size="2xl" class="mb-4">Focus</Heading>
					<Text variant="secondary" class="leading-relaxed mb-6">
						3D character art and educational content.
					</Text>
					
					<Heading level={2} size="2xl" class="mb-4 mt-12">Background</Heading>
					<Text variant="secondary" class="leading-relaxed mb-6">
						Based in {SITE.author.location.full}. Teaching and creating 3D character art.
					</Text>
				</div>
			</div>
			</div>
		</div>
	</main>
<Footer />
</BaseLayout>
