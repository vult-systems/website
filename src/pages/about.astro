---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import profileImg from '@/assets/profile/profile.jpg';
import { getAboutPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';

const seo = getAboutPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<div class="relative z-10 w-full py-24 sm:py-32">
			<div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
				
				<!-- Two Column Layout -->
				<div class="grid lg:grid-cols-[1fr_1.5fr] gap-12 lg:gap-16">
					
					<!-- Left Column - Image & Quick Info -->
					<div class="space-y-8">
						<div>
							<Image
								src={profileImg}
								alt={SITE.author.name}
								width={800}
								height={600}
								id="about-profile-image"
								class="w-full object-cover rounded-md"
								style="aspect-ratio: 4/5;"
							/>
						</div>
						
						<div class="space-y-4">
							<div>
								<Text variant="secondary" size="sm" class="mb-1">Location</Text>
								<Text variant="primary" size="base">{SITE.author.location.full}</Text>
							</div>
							
							<div>
								<Text variant="secondary" size="sm" class="mb-1">Focus</Text>
								<div class="flex flex-wrap gap-2 mt-2">
									<Badge>3D Character Art</Badge>
									<Badge>Digital Sculpture</Badge>
									<Badge>Technical Art</Badge>
									<Badge>Education</Badge>
								</div>
							</div>
							
							<div>
								<Text variant="secondary" size="sm" class="mb-2">Connect</Text>
								<div class="space-y-2">
									<div>
										<Link href={SITE.social.github} variant="accent">
											GitHub >
										</Link>
									</div>
									<div>
										<Link href={SITE.social.linkedin} variant="accent">
											LinkedIn >
										</Link>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Right Column - Content -->
					<div class="space-y-12">
						<!-- Header & Bio -->
						<div>
							<Heading level={1} size="4xl" class="mb-6">About</Heading>
							<Text variant="secondary" class="leading-relaxed mb-4">
								I'm a 3D Character Artist and Educator based in {SITE.author.location.full}. I specialize in character modeling, 
								digital sculpture, and technical art, with experience shipping work at studios like 343 Industries, BioWare, 
								Qualcomm, and Walt Disney Animation. I currently teach at the University of the Incarnate Word where I 
								coordinate the Modeling concentration and develop curriculum that bridges industry practice with academic 
								foundations. Through VULT, I build pipeline tools and systems that help artists work more efficiently.
							</Text>
						</div>

						<!-- Resume -->
						<div>
							<Heading level={2} size="2xl" class="mb-4">Resume</Heading>
							<a href="/CarlosGarcia_Resume_2026.pdf" target="_blank" class="group block rounded-md border-2 border-border hover:border-accent/40 transition-all overflow-hidden">
								<div class="flex items-center justify-between bg-foreground/5 group-hover:bg-foreground/10 px-4 py-3 transition-colors">
									<div class="flex items-center gap-3">
										<svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
										</svg>
										<div>
											<Text variant="primary" size="sm" class="font-medium">CarlosGarcia_Resume_2026.pdf</Text>
											<Text variant="muted" size="sm">Click to view full resume</Text>
										</div>
									</div>
									<svg class="w-4 h-4 text-foreground-secondary group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
									</svg>
								</div>
							</a>
							<div class="mt-2">
								<a href="/CarlosGarcia_Resume_2026.pdf" download class="inline-flex items-center gap-1.5 text-sm text-foreground-secondary hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
									</svg>
									Download PDF
								</a>
							</div>
						</div>

						<!-- CTA -->
						<div class="pt-8 border-t-2 border-foreground-secondary/10">
							<Text variant="secondary" class="mb-4">
								Interested in collaborating or learning more about my work?
							</Text>
							<div class="flex flex-wrap gap-4">
								<Link href="/art" variant="accent">
									View Work >
								</Link>
								<Link href="/learn" variant="accent">
									Teaching >
								</Link>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
<Footer />
</BaseLayout>
