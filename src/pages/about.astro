---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import profileImg from '@/assets/profile/profile.jpg';
import resumeThumb from '@/assets/profile/resume-thumbnail.png';
import { getAboutPageSEO } from '@/config/seo';
import { SITE } from '@/config/site';
import { layout } from '@/config/design';
import zbrushLogo from '@/assets/logos/software-maxon-zbrush-logo-01.png';
import mayaLogo from '@/assets/logos/software-autodesk-maya-logo-01.png';
import maxLogo from '@/assets/logos/software-autodesk-3dsmax.png';
import substanceLogo from '@/assets/logos/software-substance-painter-logo-01.webp';
import marmosetLogo from '@/assets/logos/software-marmoset-toolbag-logo-01.png';
import marvelousLogo from '@/assets/logos/software-marvelous-designer-logo.png';
import ue5Logo from '@/assets/logos/software-ue5.png';
import ue5LogoWht from '@/assets/logos/software-ue5-wht.png';
import unityLogo from '@/assets/logos/software-unity-blk.png';
import unityLogoWht from '@/assets/logos/software-unity-wht.png';
import arnoldLogo from '@/assets/logos/autodesk-maya-arnold-logo.png';
import mudboxLogo from '@/assets/logos/autodesk-mudbox-logo.png';
import adobeLogo from '@/assets/logos/software-adobe-suite-logo.png';
import mariLogo from '@/assets/logos/software-mari-logo.png';
import redshiftLogo from '@/assets/logos/software-redshift-logo.png';
import sketchupLogo from '@/assets/logos/software-sketchup-logo.png';
import substanceDesignerLogo from '@/assets/logos/software-substance-designer-logo.png';
import vrayLogo from '@/assets/logos/software-vray-logo.png';
import StudioLogoGrid from '@/components/sections/studio-logo-grid.astro';

const software = [
	{ name: 'Maya', logo: mayaLogo },
	{ name: 'ZBrush', logo: zbrushLogo },
	{ name: 'Unreal Engine 5', logo: ue5Logo, logoDark: ue5LogoWht },
	{ name: 'Unity', logo: unityLogo, logoDark: unityLogoWht },
	{ name: 'Marvelous Designer', logo: marvelousLogo },
	{ name: 'Marmoset Toolbag', logo: marmosetLogo },
	{ name: 'Arnold', logo: arnoldLogo },
	{ name: 'V-Ray', logo: vrayLogo },
	{ name: 'Redshift', logo: redshiftLogo },
	{ name: 'Mari', logo: mariLogo },
	{ name: 'Substance Painter', logo: substanceLogo },
	{ name: 'Substance Designer', logo: substanceDesignerLogo },
	{ name: 'Mudbox', logo: mudboxLogo },
	{ name: '3ds Max', logo: maxLogo },
	{ name: 'SketchUp', logo: sketchupLogo },
	{ name: 'Adobe Suite', logo: adobeLogo },
];

const seo = getAboutPageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<div class="relative z-10 w-full py-8 sm:py-12">
			<div class={layout.container}>
				<!-- Two Column Layout -->
				<div class="grid lg:grid-cols-[420px_1fr] gap-8 lg:gap-10">
					
					<!-- Left Column - Image & Quick Info -->
					<div class="space-y-8">
						<div>
							<Image
								src={profileImg}
								alt={SITE.author.name}
								width={800}
								height={600}
								id="about-profile-image"
								data-no-lightbox
								class="w-full max-w-[420px] object-cover rounded-md"
								style="aspect-ratio: 4/5;"
							/>
						</div>
						
						<div class="space-y-4 max-w-[420px]">
							<div>
								<Text variant="secondary" size="sm" class="mb-1">Contact</Text>
								<div class="space-y-0.5">
									<Text variant="primary" class="!text-base">theartofcarlos@gmail.com</Text>
									<Text variant="primary" class="!text-base">(210) 279-5903</Text>
								</div>
							</div>

							<div>
								<Text variant="secondary" size="sm" class="mb-1">Location</Text>
								<Text variant="primary" class="!text-base">{SITE.author.location.full}</Text>
							</div>
							
							<div>
								<Text variant="secondary" size="sm" class="mb-3">Software</Text>
								<div class="grid grid-cols-2 gap-2 mt-2">
									{software.map(s => (
										<div class="flex items-center gap-2 px-2 py-1.5 rounded-md bg-foreground/5">
										{s.logoDark ? (
											<>
												<Image src={s.logo} alt={s.name} width={60} height={24} class="h-5 w-auto object-contain shrink-0 dark:hidden" data-no-lightbox />
												<Image src={s.logoDark} alt={s.name} width={60} height={24} class="h-5 w-auto object-contain shrink-0 hidden dark:block" data-no-lightbox />
											</>
										) : (
											<Image src={s.logo} alt={s.name} width={60} height={24} class="h-5 w-auto object-contain shrink-0" data-no-lightbox />
										)}
											<span class="font-serif text-sm text-foreground-secondary leading-tight">{s.name}</span>
										</div>
									))}
								</div>
							</div>
						</div>
					</div>

					<!-- Right Column - Content -->
					<div class="space-y-12">
						<!-- Header & Bio -->
						<div>
							<Heading level={1} size="4xl" class="mb-6">About</Heading>
						<Text variant="secondary" class="!text-base leading-relaxed mb-4">
							I'm a 3D character artist and educator based in {SITE.author.location.full}. I started my CG journey as
							more of a generalist 13 years ago, but character art quickly became where I felt most at home. That broader
							background still shapes how I work today and influences how I approach everything from the artwork itself
							to the production around it.
						</Text>
						<Text variant="secondary" class="!text-base leading-relaxed mb-4">
								Teaching has become a major part of my life and easily one of the most rewarding parts of my career. At the
								University of the Incarnate Word, I help develop curriculum, work with students through production, and try
								to make the classroom feel as connected to real-world practice as possible.
							</Text>
						<Text variant="secondary" class="!text-base leading-relaxed mb-4">
								Outside of the university, I run Vult for my freelance and collaborative work.
							</Text>
						</div>

						<!-- Experience Logos -->
						<div>

							<StudioLogoGrid />
						</div>

						<!-- Resume -->
						<div>
							<Heading level={2} size="2xl" class="mb-4">Resume</Heading>
							<div class="inline-block">
								<div class="spotlight-card group relative">
									<div class="spotlight-inner rounded-md overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
										<Image
											src={resumeThumb}
											alt="Carlos Garcia Resume"
											width={1836}
											height={2376}
											class="w-full max-w-[420px] object-contain"
										/>
									</div>
								</div>
								<div class="mt-2">
									<a href="/CarlosGarcia_Resume_2026.pdf" download class="font-serif inline-flex items-center gap-1.5 text-sm text-foreground-secondary hover:text-accent transition-colors">
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
										</svg>
										Download PDF
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
<Footer />
</BaseLayout>


