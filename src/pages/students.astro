<BaseLayout
title={seo.title}
description={seo.description}
keywords={seo.keywords}
>
<!-- Preloader prototype (this page only, not persisted — reloads every visit
     so it's easy to re-test while dialing it in). Gated behind SHOW_PRELOADER
     above rather than deleted, so it's a one-line flip to bring back. -->
{SHOW_PRELOADER && (
<div id="preloader" class="fixed inset-0 z-[10000] bg-[#0a0a0c] flex flex-col items-center justify-center cursor-pointer select-none overflow-hidden">
  <div class="preloader-scanlines pointer-events-none absolute inset-0"></div>
  <div class="preloader-vignette pointer-events-none absolute inset-0"></div>
  <svg id="preloader-logo" width="120" height="108" viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg" class="relative">
    <path d="M46.5 59L0 86L49 0L46.5 59Z" fill="#E22B25"/>
    <path d="M52 59L51.0004 1.99994L99.5002 86.5L52 59Z" fill="#2282DF"/>
    <path d="M50.5 61.5L99.3297 89.0673L1.90061 88.8194L50.5 61.5Z" fill="#F2C923"/>
  </svg>
  <p class="preloader-prompt relative mt-8 text-xs tracking-[0.3em] uppercase text-white/70" style="font-family: var(--font-ibm-plex);">
    <span class="text-white/30">[</span> Click to Enter <span class="preloader-cursor">_</span> <span class="text-white/30">]</span>
  </p>
</div>
)}
<Header />
<PageMain class="text-foreground">
<!-- Page Header with Background -->
<div class="relative w-full py-8 sm:py-10">
<div class="absolute inset-0 -z-10 overflow-hidden">
<Image
src={heroBg}
alt=""
class="w-full h-full object-cover object-center !opacity-60 dark:!opacity-[0.12]"
loading="eager"
widths={[800, 1200, 1920]}
/>
<div class="absolute inset-0 bg-white/[0.82] dark:bg-black/[0.62]"></div>
</div>
<PageContainer>
<Heading level={1} size="4xl" class="mb-4">
Student Work
</Heading>
<Text size="lg" variant="secondary" class="mb-4">
One of the most rewarding parts of teaching is watching students grow as artists. This page highlights a selection of work created across a variety of courses over the years. It is by no means a complete archive, but rather a small snapshot of the projects, experiments, and portfolio pieces students have created along the way.
</Text>
</PageContainer>
</div>

<div class="relative z-10 w-full py-8 sm:py-12">
<PageContainer>

<!-- Content with Sidebar -->
<div class="flex gap-12 lg:gap-16 relative">

<!-- Sidebar -->
<aside class="hidden lg:block w-72 shrink-0">
<div>
<Text size="xs" variant="secondary" class="uppercase tracking-widest mb-4 block" style="font-family: 'Besley', serif !important;">
	Artists
</Text>
<nav class="space-y-4 border-l-2 border-foreground-secondary/10 pl-4">
{studentWork.filter((piece, index, arr) => arr.findIndex(p => p.student === piece.student) === index).map((piece) => (
<a
href={`#${studentId(piece)}`}
class="learn-nav-link block leading-snug group"
data-slug={studentId(piece)}
>
<span class="block text-base text-foreground-secondary group-hover:text-accent transition-colors" style="font-family: 'Besley', serif !important;">{piece.student}</span>
</a>
))}
</nav>
</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">

<div class="flex flex-col lg:flex-row gap-4" id="student-grid">
{studentWork.map((piece) => (
<div
class="student-item spotlight-card group w-full relative"
data-year={piece.year}
data-student={piece.student}
data-pin={piece.pin ?? ''}
id={studentId(piece)}
>
<div class="spotlight-inner rounded-lg overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
{piece.video ? (
<div class="video-lightbox-trigger relative bg-foreground/5 overflow-hidden cursor-pointer" data-video={piece.video} style={piece.aspectratio ? `aspect-ratio:${piece.aspectratio}` : undefined}>
<video
src={piece.video}
poster={piece.video.replace(/\.mp4$/, '-poster.jpg')}
class="w-full h-full object-cover pointer-events-none"
loop
muted
playsinline
preload="none"
data-autoplay
></video>
<div class="absolute inset-0 flex items-center justify-center transition-opacity bg-transparent hover:bg-black/20 group">
<svg class="w-12 h-12 text-white/80 opacity-0 hover:opacity-100 transition-opacity drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
<path d="M8 5v14l11-7z" />
</svg>
</div>
</div>
) : piece.image ? (
<div class="learn-lightbox-trigger relative bg-foreground/5 overflow-hidden cursor-pointer" data-label={`${piece.student} — ${piece.title}`}>
<img src={piece.image} alt={`${piece.student} — ${piece.title}`} class="w-full h-auto object-cover" loading="lazy" data-no-lightbox />
</div>
) : (
<div class="aspect-[4/3] bg-foreground/5 flex flex-col items-center justify-center">
<svg class="w-10 h-10 text-foreground-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
</svg>
<span class="text-xs text-foreground-muted">Image Coming Soon</span>
</div>
)}
<div class="p-4 space-y-2">
<Text variant="primary" size="sm" class="font-medium">{piece.student}</Text>
<Text variant="muted" size="sm">{piece.title}</Text>
<div class="flex flex-col gap-1.5">
	{piece.portfolio ? (
		<a href={piece.portfolio} target="_blank" rel="noopener noreferrer">
			<Badge size="sm" variant="accent" class="self-start">Portfolio</Badge>
		</a>
	) : (
		<Badge size="sm" variant="accent" class="self-start">{piece.course}</Badge>
	)}
</div>
</div>
</div>
</div>
))}
</div>

</div>
</div>

</PageContainer>
</div>
</PageMain>
<Footer />
<script is:inline define:vars={{ pinnedStudents }}>
window.__pinnedStudents = pinnedStudents;
</script>
</BaseLayout>

<style>
.learn-nav-link {
	opacity: 0.45;
	transition: opacity 0.15s;
}
.learn-nav-link.active,
.learn-nav-link:hover {
	opacity: 1;
}
.learn-nav-link.active .learn-nav-title {
	color: hsl(var(--accent));
}

/* --- Preloader prototype --- */
#preloader {
	transition: opacity 0.4s ease, filter 0.4s ease;
}
#preloader.preloader-exit {
	opacity: 0;
	filter: brightness(2.5) blur(6px);
	pointer-events: none;
}
.preloader-scanlines {
	background: repeating-linear-gradient(
		to bottom,
		rgba(255, 255, 255, 0.035) 0px,
		rgba(255, 255, 255, 0.035) 1px,
		transparent 1px,
		transparent 3px
	);
	mix-blend-mode: overlay;
}
.preloader-vignette {
	background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.65) 100%);
}
#preloader-logo {
	animation: preloader-flicker 1.1s steps(1) both;
	filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.15));
}
@keyframes preloader-flicker {
	0% { opacity: 0; }
	8% { opacity: 1; }
	12% { opacity: 0.2; }
	20% { opacity: 1; }
	24% { opacity: 0.4; }
	32% { opacity: 1; }
	100% { opacity: 1; }
}
.preloader-prompt {
	opacity: 0;
	animation: preloader-prompt-in 0.3s ease 1.1s both;
}
@keyframes preloader-prompt-in {
	to { opacity: 1; }
}
.preloader-cursor {
	animation: preloader-cursor-blink 1s steps(1) infinite;
}
@keyframes preloader-cursor-blink {
	0%, 49% { opacity: 1; }
	50%, 100% { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
	#preloader-logo,
	.preloader-prompt,
	.preloader-cursor {
		animation: none;
		opacity: 1;
	}
}
</style>

<script>
// --- Preloader prototype (this page only) ---
const initPreloader = () => {
  const pre = document.getElementById('preloader');
  if (!pre || pre.dataset.wired) return;
  pre.dataset.wired = '1';
  const enter = () => {
    if (pre.classList.contains('preloader-exit')) return;
    pre.classList.add('preloader-exit');
    setTimeout(() => {
      (pre as HTMLElement).style.display = 'none';
    }, 450);
  };
  pre.addEventListener('click', enter);
  document.addEventListener(
    'keydown',
    (e) => {
      if (e.key === 'Enter' || e.key === ' ') enter();
    },
    { once: true }
  );
};

const initStudentWork = () => {
initPreloader();

// --- Video autoplay via IntersectionObserver ---
// Pre-warm each video's data well before it's actually visible (600px
// lead), so by the time the play-trigger observer below fires, the browser
// already has data buffered instead of cold-starting a fetch + decode right
// at the exact scroll position it crosses into view. That cold start —
// especially with several videos crossing the threshold in the same scroll
// gesture, in this 2-column layout — is what reads as scroll jank on this
// page. preload stays "none" in the markup (so a page you never scroll
// through doesn't fetch video data it'll never need); this only upgrades it
// to "auto" once a video is about to matter.
const videoPreloadObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (!entry.isIntersecting) return;
    const video = entry.target as HTMLVideoElement;
    video.preload = 'auto';
    videoPreloadObserver.unobserve(video);
  });
}, { rootMargin: '600px 0px', threshold: 0 });

// Chromium syncs page compositing to a playing video's own frame rate
// (these are all 30fps sources) rather than the display's 60Hz while that
// video is actively decoding — regardless of its resolution. Confirmed via
// profiling: forcing all videos to stay paused during a scroll took the
// page from a hard 30fps ceiling back to ~60fps. So instead of just
// play/pause on visibility, also pause everything mid-scroll and resume
// once the scroll gesture settles — visible videos keep autoplaying at
// rest, they just don't fight the scroll compositor while it matters most.
const visibleVideos = new Set<HTMLVideoElement>();
let isScrolling = false;

const videoObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    const video = entry.target as HTMLVideoElement;
    if (entry.isIntersecting) {
      visibleVideos.add(video);
      if (!isScrolling) video.play().catch(() => {});
    } else {
      visibleVideos.delete(video);
      video.pause();
    }
  });
}, { threshold: 0.25 });

document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
  videoPreloadObserver.observe(video);
  videoObserver.observe(video);
});

const scrollAbort = new AbortController();
let scrollEndTimer: ReturnType<typeof setTimeout> | null = null;
window.addEventListener('scroll', () => {
  if (!isScrolling) {
    isScrolling = true;
    visibleVideos.forEach((video) => video.pause());
  }
  if (scrollEndTimer) clearTimeout(scrollEndTimer);
  scrollEndTimer = setTimeout(() => {
    isScrolling = false;
    visibleVideos.forEach((video) => video.play().catch(() => {}));
  }, 150);
}, { passive: true, signal: scrollAbort.signal });

document.addEventListener('astro:before-swap', () => scrollAbort.abort(), { once: true });

// --- Image lightbox triggers ---
document.querySelectorAll('.learn-lightbox-trigger').forEach((trigger) => {
const fresh = trigger.cloneNode(true);
trigger.parentNode?.replaceChild(fresh, trigger);
});
document.querySelectorAll<HTMLElement>('.learn-lightbox-trigger').forEach((trigger) => {
trigger.addEventListener('click', () => {
// Routed through the shared lightbox's gallery hook (image-lightbox.astro)
// instead of opening the #lightbox DOM directly, so arrow keys can step
// through the other student pieces the same way they do everywhere else
// on the site -- these triggers wrap a student/title caption rather than
// just the image's own alt text, which is why this page builds its own
// entry list instead of relying on the generic per-<img> click path.
// Filtered (and index found) against the SAME array so a trigger without
// a valid image src -- shouldn't happen given the template guard, but
// cheap to guard against here too -- can't shift entries out of sync
// with the index.
const triggers = Array.from(document.querySelectorAll<HTMLElement>('.learn-lightbox-trigger'))
	.filter((t) => !!t.querySelector<HTMLImageElement>('img')?.src);
const entries = triggers.map((t) => ({
	src: t.querySelector<HTMLImageElement>('img')!.src,
	alt: t.dataset.label || 'Preview',
}));
const index = triggers.indexOf(trigger);
if (index === -1) return;
window.lightboxGallery?.open(entries, index);
});
});

// --- Shuffle student wall (grouped by artist) ---
const shuffleStudentWall = () => {
  const grid = document.getElementById('student-grid');
  if (!grid) return;
  const pinned: string[] = (window as any).__pinnedStudents ?? [];
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.student-item'));
  const groupMap = new Map<string, HTMLElement[]>();
  items.forEach(item => {
    const key = item.dataset.student!;
    if (!groupMap.has(key)) groupMap.set(key, []);
    groupMap.get(key)!.push(item);
  });
  const pinnedGroups: HTMLElement[][] = pinned
    .map(name => groupMap.get(name))
    .filter((g): g is HTMLElement[] => !!g);
  const unpinned: HTMLElement[][] = Array.from(groupMap.values())
    .filter(g => !pinned.includes(g[0].dataset.student!));
  for (let i = unpinned.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [unpinned[i], unpinned[j]] = [unpinned[j], unpinned[i]];
  }
	const orderedGroups = [...pinnedGroups, ...unpinned];

	// Distribute groups into two flex columns by current load so the wall stays balanced.
	const col0 = document.createElement('div');
	const col1 = document.createElement('div');
	col0.className = 'flex-1 flex flex-col gap-4 min-w-0';
	col1.className = 'flex-1 flex flex-col gap-4 min-w-0';
	const columnLoads = [0, 0];
	orderedGroups.forEach((group) => {
		const targetColumn = columnLoads[0] <= columnLoads[1] ? 0 : 1;
		group.forEach((el) => {
			(targetColumn === 0 ? col0 : col1).appendChild(el);
		});
		columnLoads[targetColumn] += group.length;
	});
  grid.innerHTML = '';
  grid.appendChild(col0);
  grid.appendChild(col1);

  // Moving a still-loading <img loading="lazy"> via appendChild (as just
  // happened above, reordering into balanced columns) orphans any
  // 'load'/'error' listener base-layout's fade-in script already attached
  // to it — the image still loads fine, but nothing is left to mark it
  // .img-loaded, so it sits at the sitewide opacity:0 default forever.
  // Clearing the wired marker lets the fade-in script's MutationObserver
  // (which fires for these appendChild calls) re-wire each image fresh.
  grid.querySelectorAll<HTMLImageElement>('img[data-fade-wired]').forEach((img) => {
    delete img.dataset.fadeWired;
  });
};
shuffleStudentWall();

};

initStudentWork();
document.addEventListener('astro:after-swap', initStudentWork);
</script>
