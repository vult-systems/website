];

const studentId = (piece: StudentPiece) => `student-${piece.student.toLowerCase().replace(/\s+/g, '-')}-${piece.title.toLowerCase().replace(/\s+/g, '-')}`;

// Build pinned order: unique student names in pin order (1-based), then unpinned shuffled after
const pinnedStudents: string[] = [];
const pinMap = new Map<string, number>();
for (const piece of studentWork) {
	if (piece.pin !== undefined && !pinMap.has(piece.student)) {
		pinMap.set(piece.student, piece.pin);
	}
}
const sortedPinned = Array.from(pinMap.entries()).sort((a, b) => a[1] - b[1]);
for (const [name] of sortedPinned) pinnedStudents.push(name);
