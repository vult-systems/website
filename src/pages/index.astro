---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base-layout.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import AnimatedHero from '@/components/ui/animated-hero.astro';
import ExperienceSection from '@/components/sections/experience-section.astro';
import FeaturedCarousel from '@/components/ui/featured-carousel.astro';
import { getHomePageSEO } from '@/config/seo';
import { layout } from '@/config/design';

// Get featured art pieces
const artPieces = await getCollection('art');

// Define the desired order
const desiredOrder = [
  'halo-infinite-character',
  'foundation-explorer',
  'foundation-explorer-female',
  'swtor-valkorian',
  'motorola-razr'
];

const featuredArt = artPieces
  .filter(piece => piece.data.featured)
  .map(piece => ({
    slug: piece.slug,
    title: piece.data.title,
    description: piece.data.description,
    heroImage: piece.data.heroImage,
    category: piece.data.category
  }))
  .sort((a, b) => {
    const indexA = desiredOrder.indexOf(a.slug);
    const indexB = desiredOrder.indexOf(b.slug);
    return indexA - indexB;
  });

const seo = getHomePageSEO();
---

<BaseLayout 
	title={seo.title} 
	description={seo.description}
	keywords={seo.keywords}
>
<Header />
	<main class="min-h-screen w-full text-foreground">
		<!-- Featured Carousel -->
		<FeaturedCarousel artPieces={featuredArt} title="" description="" linkText="" />

		<!-- Hero Section -->
		<AnimatedHero />

		<!-- Divider -->
		<div class={layout.container}>
			<div class="border-b-2 border-foreground-secondary/10"></div>
		</div>

		<!-- Experience Section -->
		<ExperienceSection />
	</main>
<Footer />
</BaseLayout>