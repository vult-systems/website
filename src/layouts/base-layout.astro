---
import { ViewTransitions } from 'astro:transitions';
import "@/styles/globals.css";
import "@/styles/fonts.css";
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import besleyNormalUrl from '@fontsource-variable/besley/files/besley-latin-wght-normal.woff2';
import besleyItalicUrl from '@fontsource-variable/besley/files/besley-latin-wght-italic.woff2';
import figtreeNormalUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2';
import figtreeItalicUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-italic.woff2';
import ibmMono400Url from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2';
import { getImage } from 'astro:assets';
import logoSvg from '@/assets/brand/logo.svg';
import Analytics from '@/components/analytics/Analytics.astro';
import VercelAnalytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ImageLightbox from '@/components/ui/image-lightbox.astro';
import { SITE, getKeywordsString } from '@/config/site';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	keywords?: string;
	author?: string;
}

const { 
	title, 
	description = SITE.seo.defaultDescription, 
	image,
	type = 'website',
	keywords = getKeywordsString(),
	author = SITE.author.name
} = Astro.props;

// Use optimized logo as favicon; default OG image for link previews.
const optimizedLogo = await getImage({ src: logoSvg, format: 'svg' });
const faviconSvg = optimizedLogo.src;
const ogImage = image || '/og-image.png';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.toString() || SITE.url;
---

<!doctype html>
<html lang="en" class="antialiased dark bg-background">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={author} />
		<meta name="robots" content="index, follow" />
		<meta name="language" content="English" />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<link rel="apple-touch-icon" href={faviconSvg} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
		<meta name="twitter:creator" content={SITE.seo.twitterHandle} />
		
		<!-- Additional SEO -->
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={SITE.theme.color} />
		
		<!-- Security: real headers are set in public/_headers; only the meta-valid one is kept here -->
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		
		<!-- Performance: self-hosted fonts preloaded so text paints in Besley/Figtree/IBM Plex Mono without a swap -->
		<link rel="preload" as="font" type="font/woff2" href={besleyNormalUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={besleyItalicUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={figtreeNormalUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={figtreeItalicUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={ibmMono400Url} crossorigin />
		<style is:global set:html={`
			@font-face{font-family:'Besley';font-style:normal;font-weight:400 900;font-display:swap;src:url(${besleyNormalUrl}) format('woff2');}
			@font-face{font-family:'Besley';font-style:italic;font-weight:400 900;font-display:swap;src:url(${besleyItalicUrl}) format('woff2');}
			@font-face{font-family:'Figtree';font-style:normal;font-weight:300 900;font-display:swap;src:url(${figtreeNormalUrl}) format('woff2');}
			@font-face{font-family:'Figtree';font-style:italic;font-weight:300 900;font-display:swap;src:url(${figtreeItalicUrl}) format('woff2');}
		`}></style>
		<link rel="dns-prefetch" href="https://images.unsplash.com" />
		
		<!-- Structured Data - Person Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": SITE.author.name,
			"url": siteUrl,
			"image": new URL(ogImage, Astro.site),
			"jobTitle": SITE.author.role,
			"description": description,
			"knowsAbout": SITE.expertise,
			"sameAs": [
				SITE.social.github,
				SITE.social.linkedin
			],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": SITE.author.location.city,
				"addressRegion": SITE.author.location.stateCode,
				"addressCountry": SITE.author.location.country
			}
		})} />
		
		<!-- Structured Data - Website Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": SITE.title,
			"alternateName": SITE.name,
			"url": siteUrl,
			"description": SITE.seo.defaultDescription,
			"author": {
				"@type": "Person",
				"name": SITE.author.name
			},
			"inLanguage": "en-US",
			"copyrightYear": new Date().getFullYear(),
			"copyrightHolder": {
				"@type": "Person",
				"name": SITE.author.name
			}
		})} />
		
		<!-- Analytics Integration -->
		<Analytics />

		<script is:inline>
			// On page load or when changing themes, best to add inline in `head` to avoid FOUC
			if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark')
			} else {
				document.documentElement.classList.remove('dark')
			}
		</script>
		
		<!-- Persist theme across page transitions -->
		<script is:inline>
			document.addEventListener('astro:before-swap', (event) => {
				// Ensure dark mode persists across navigation
				const theme = localStorage.theme;
				if (theme === 'dark') {
					event.newDocument.documentElement.classList.add('dark');
				} else {
					event.newDocument.documentElement.classList.remove('dark');
				}

				// Every page shares the same main stylesheet href, and Astro's
				// swap already tries to preserve a same-href stylesheet link on
				// its own — but in practice this site still shows it transiently
				// missing during the swap (confirmed: unstyled/browser-default
				// content for ~100-150ms — default blue link color, unconstrained
				// image sizing — every single navigation). Explicitly matching
				// via transition:persist takes Astro's primary matching path
				// (checked before the href-based fallback that isn't holding up
				// here), so the link element is never removed and re-inserted at
				// all, closing whatever timing gap the fallback was hitting.
				const currentSheet = document.querySelector('head link[rel="stylesheet"]');
				const newSheet = event.newDocument.querySelector('head link[rel="stylesheet"]');
				if (currentSheet && newSheet && currentSheet.getAttribute('href') === newSheet.getAttribute('href')) {
					currentSheet.setAttribute('data-astro-transition-persist', 'main-stylesheet');
					newSheet.setAttribute('data-astro-transition-persist', 'main-stylesheet');
				}
			});
		</script>
		
		<ViewTransitions />
	</head>
	<body class="min-h-screen bg-background text-foreground font-light flex flex-col">
		<slot />
		<ImageLightbox />
		<!-- VercelAnalytics/SpeedInsights render <vercel-analytics>/<vercel-speed-insights>
		     custom elements. Custom elements aren't valid head content per the HTML5
		     parsing algorithm — the parser implicitly closes </head> the instant it sees
		     one and reprocesses that element (and everything textually after it in head,
		     including the auto-injected stylesheet <link> and Astro's ViewTransitions
		     setup) as body content instead. That silently broke the stylesheet link's
		     presence in document.head on every single page load, which was the actual
		     reason Astro's swap couldn't find/persist it across navigation (the
		     transition:persist matching below queries 'head link[...]', which never
		     matched while these lived in head). Keeping them in body avoids the whole
		     class of bug. -->
		<VercelAnalytics />
		<SpeedInsights />
	</body>
</html>

<style is:global>
	/* Font System - two typefaces sitewide: Besley (headings/chrome) and
	   Figtree (reading copy/default UI text). IBM Plex Mono is kept only
	   for actual code (see `code, pre, kbd, samp` below) — never a general
	   site typeface. */
	:root {
		--font-ibm-plex: 'IBM Plex Mono', 'Courier New', monospace;
	}

	/* Figtree is the sitewide default for anything not explicitly Besley
	   (headings/nav/chrome via font-serif, or the raw-tag rule below). */
	html, body, body * {
		font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif;
		letter-spacing: 0.02em;
	}

	/* Readable content (paragraphs, list items, headings, quotes) uses the Besley
	   reading serif so raw markup matches the Text/Heading components and prose.
	   Placed after `body *` so it wins at equal specificity; letter-spacing is
	   left untouched so `tracking-*` utilities on labels still apply. */
	p, li, blockquote, figcaption, dt, dd,
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Besley', ui-serif, Georgia, serif;
	}
	/* Inline code and preformatted text remain monospace inside body copy. */
	code, pre, kbd, samp {
		font-family: var(--font-ibm-plex);
	}


	/* Custom view transition animations */
	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes slideDown {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-30px);
		}
	}

	/* This used to hold a much longer delay (180ms) to paper over a real
	   unstyled-content flash — the actual cause (VercelAnalytics/SpeedInsights
	   breaking <head> parsing, see the comment on those above, near <body>) is
	   now fixed at the source, so this only needs a small buffer, not a
	   cover-up. Verified via Playwright against a production build: 0 unstyled
	   samples across 25 navigations at these shorter durations. Old fades out
	   fast; new waits just long enough to avoid a same-frame swap, then fades
	   in quickly. */
	/* The browser's UA stylesheet also puts a ~250ms default animation-duration
	   on ::view-transition-group(root) itself (for size/position morphing) —
	   irrelevant here since root never changes size, but it still holds the
	   transition open that long unless overridden. */
	::view-transition-group(root) {
		animation-duration: 0s;
	}

	::view-transition-old(root) {
		animation: 80ms cubic-bezier(0.4, 0, 1, 1) both fade-out;
	}

	::view-transition-new(root) {
		animation: 100ms cubic-bezier(0, 0, 0.2, 1) 40ms both fade-in;
	}

	@keyframes fade-in {
		from { opacity: 0; }
	}

	@keyframes fade-out {
		to { opacity: 0; }
	}

	/* Global image fade-in — uses animation not transition so it doesn't conflict with hover transitions.
	   data-no-lightbox only opts an image out of the click-to-zoom lightbox
	   (see image-lightbox.astro) — it has nothing to do with fade-in, but
	   used to be excluded here too, which meant nearly every prominent image
	   sitewide (grid thumbnails, hero photos, carousel images all carry
	   data-no-lightbox) skipped the fade and just popped in the instant it
	   decoded. When several finish loading in the same instant — the normal
	   case for a grid of thumbnails — that reads as a synchronized flash
	   instead of a smooth reveal. #lightbox-image (the open lightbox's own
	   image) is still excluded since it has its own scale/opacity transition. */
	img:not(#lightbox-image):not(.img-ready):not(.img-loaded) {
		opacity: 0;
	}

	img.img-loaded:not(#lightbox-image) {
		animation: img-fade-in 0.25s ease-out var(--img-fade-delay, 0ms) both;
	}

	@keyframes img-fade-in {
		from { opacity: 0; }
		to   { opacity: 1; }
	}
</style>

<script>
	// Marks a single image ready-to-fade (or already-ready). Guarded by
	// data-fade-wired so an image discovered by both the bulk scan and the
	// MutationObserver below (e.g. right after a navigation, where both can
	// see the same freshly-swapped-in images) only gets wired once.
	const wireImage = (img: HTMLImageElement, delayMs?: number) => {
		if (img.dataset.fadeWired) return;
		img.dataset.fadeWired = '1';
		if (img.complete && img.naturalWidth > 0) {
			img.classList.add('img-ready');
		} else {
			if (delayMs !== undefined) img.style.setProperty('--img-fade-delay', `${delayMs}ms`);
			img.addEventListener('load', () => img.classList.add('img-loaded'), { once: true });
			img.addEventListener('error', () => img.classList.add('img-loaded'), { once: true });
		}
	};

	const initImageFadeGlobal = () => {
		// A page swap's grid images (thumbnails etc.) all start loading at once
		// and, on a fast connection, finish within a few ms of each other —
		// without staggering, that's a whole grid's worth of images fading
		// from 0 to full opacity in the same instant, which reads as a single
		// flash rather than a smooth reveal. Delaying each by its DOM order
		// (capped) turns that into a brief ripple instead. Only images that
		// actually animate (the 'load' path below) need it — already-complete
		// ones get 'img-ready' with no animation, so no delay to stagger.
		let loadIndex = 0;
		document.querySelectorAll<HTMLImageElement>('img:not(#lightbox-image)').forEach((img) => {
			const needsDelay = !(img.complete && img.naturalWidth > 0);
			wireImage(img, needsDelay ? Math.min(loadIndex++ * 30, 300) : undefined);
		});
	};

	// Run immediately (catches initial page load before astro:page-load fires)
	initImageFadeGlobal();
	// Run again on ViewTransitions navigation
	document.addEventListener('astro:page-load', initImageFadeGlobal);

	// Images inserted dynamically well after the scans above ran — e.g. the
	// generator block's fetched reference photos, added on a button click
	// long after astro:page-load already fired — would otherwise sit at the
	// global `img { opacity: 0 }` default forever, since nothing ever marks
	// them img-ready/img-loaded. Observes documentElement, not body: Astro's
	// ViewTransitions router replaces document.body wholesale on navigation,
	// which would leave an observer on the old body watching a detached
	// node — documentElement persists across swaps, so this one observer,
	// set up once here, keeps working for the page's whole life.
	new MutationObserver((records) => {
		for (const r of records) {
			for (const n of r.addedNodes) {
				if (!(n instanceof HTMLElement)) continue;
				if (n instanceof HTMLImageElement) wireImage(n);
				n.querySelectorAll?.('img').forEach((img) => wireImage(img as HTMLImageElement));
			}
		}
	}).observe(document.documentElement, { childList: true, subtree: true });
</script>