---
import ThemeToggle from '@/components/ui/theme-toggle.astro';
import { SITE } from '@/config/site';
import { layout } from '@/config/design';

const currentPath = Astro.url.pathname;
---

<header class="w-full bg-background/90 backdrop-blur-lg sticky top-0 left-0 right-0 z-50" transition:persist>
    <div class={layout.container}>
        <div class="flex h-16 items-end justify-between pb-4 border-b-2 border-foreground-secondary/10">
        <a href="/" class="flex items-end gap-x-3 hover:scale-105 transition-transform duration-200">
            <svg
                width="22"
                height="20"
                viewBox="0 0 100 90"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="mb-[2px] dark:brightness-[.95]"
                role="img"
                aria-label={`${SITE.author.name} Logo`}
            >
                <path d="M46.5 59L0 86L49 0L46.5 59Z" fill="#E22B25"/>
                <path d="M52 59L51.0004 1.99994L99.5002 86.5L52 59Z" fill="#2282DF"/>
                <path d="M50.5 61.5L99.3297 89.0673L1.90061 88.8194L50.5 61.5Z" fill="#F2C923"/>
            </svg>
            <span class="text-xl font-normal text-foreground hover:text-accent transition-colors leading-none" style="font-family: 'Besley', serif !important;">
                {SITE.name}
            </span>
        </a>
        
        <div class="flex items-end gap-x-8">
            <nav class="hidden md:block">
                <ul class="flex gap-x-6 lg:gap-x-8">
                    <li>
                        <a href="/art" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            Work
                        </a>
                    </li>
                    <li>
                        <a href="/learn" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            Learn
                        </a>
                    </li>
                    <li>
                        <a href="/students" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            Students
                        </a>
                    </li>
                    <li>
                        <a href="/resources" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            Resources
                        </a>
                    </li>
                    <li>
                        <a href="/log" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            Log
                        </a>
                    </li>
                    <li>
                        <a href="/about" data-nav-link class="text-xl inline-block hover:text-accent hover:scale-105 transition-all duration-200 text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                            About
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-[5px] items-center justify-center p-1 -mb-[2px]" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
                <span class="hamburger-line block w-5 h-[2px] bg-foreground transition-all duration-300"></span>
                <span class="hamburger-line block w-5 h-[2px] bg-foreground transition-all duration-300"></span>
                <span class="hamburger-line block w-5 h-[2px] bg-foreground transition-all duration-300"></span>
            </button>
            
            <div transition:persist="theme-toggle">
                <ThemeToggle />
            </div>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="md:hidden fixed left-0 right-0 top-16 z-40 bg-background border-b-2 border-foreground-secondary/10 shadow-lg hidden">
    <nav class={`max-w-[102rem] mx-auto px-6 sm:px-8 3xl:px-16 4xl:px-24 py-6`}>
        <ul class="flex flex-col gap-4">
            <li>
                <a href="/art" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    Work
                </a>
            </li>
            <li>
                <a href="/learn" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    Learn
                </a>
            </li>
            <li>
                <a href="/students" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    Students
                </a>
            </li>
            <li>
                <a href="/resources" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    Resources
                </a>
            </li>
            <li>
                <a href="/log" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    Log
                </a>
            </li>
            <li>
                <a href="/about" data-nav-link class="text-xl inline-block hover:text-accent transition-colors text-foreground-secondary" style="font-family: 'Besley', serif !important;">
                    About
                </a>
            </li>
        </ul>
    </nav>
</div>

<style>
/* Force Besley font for all header text */
header, nav, .header-text, nav a, nav ul, nav li {
    font-family: 'Besley', serif !important;
}

/* Ensure the site title and nav links use Besley */
.text-xl.font-bold,
nav a.text-base {
    font-family: 'Besley', serif !important;
}

/* Hamburger animation */
#mobile-menu-btn.open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}
#mobile-menu-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
}
#mobile-menu-btn.open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}
</style>

<script>
    const initMobileMenu = () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;

        const fresh = btn.cloneNode(true) as HTMLElement;
        btn.parentNode?.replaceChild(fresh, btn);

        const closeMenu = () => {
            fresh.classList.remove('open');
            menu.classList.add('hidden');
            fresh.setAttribute('aria-expanded', 'false');
        };

        fresh.addEventListener('click', () => {
            const isOpen = fresh.classList.toggle('open');
            menu.classList.toggle('hidden');
            fresh.setAttribute('aria-expanded', String(isOpen));
        });

        // Close on link click
        menu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu);
        });
    };

    initMobileMenu();
    document.addEventListener('astro:after-swap', initMobileMenu);

    // Close on Escape — bound once for the session; re-reads the current
    // menu/button live so it stays correct across view-transition navigations
    // instead of accumulating a new listener on every astro:after-swap.
    if (!(window as any).__mobileMenuEscape) {
        (window as any).__mobileMenuEscape = true;
        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            const menu = document.getElementById('mobile-menu');
            const btn = document.getElementById('mobile-menu-btn');
            if (!menu || menu.classList.contains('hidden')) return;
            menu.classList.add('hidden');
            btn?.classList.remove('open');
            btn?.setAttribute('aria-expanded', 'false');
        });
    }

    const updateActiveNav = () => {
        const path = window.location.pathname;
        const links = Array.from(document.querySelectorAll('[data-nav-link]'));

        // Find the most specific (longest) matching href so only one link is active.
        let bestHref = '';
        links.forEach((el) => {
            const href = el.getAttribute('href') ?? '';
            if (href !== '/' && (path === href || path.startsWith(href + '/')) && href.length > bestHref.length) {
                bestHref = href;
            }
        });

        links.forEach((el) => {
            const href = el.getAttribute('href') ?? '';
            const isActive = href === bestHref && bestHref !== '';
            el.classList.toggle('text-accent', isActive);
            el.classList.toggle('scale-105', isActive);
            el.classList.toggle('text-foreground-secondary', !isActive);
        });
    };

    updateActiveNav();
    document.addEventListener('astro:after-swap', updateActiveNav);
</script>
