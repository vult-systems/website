---
import { layout } from '@/config/design';
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 w-full bg-background/80 backdrop-blur-md border-t border-border mt-16">
    <div class:list={[layout.container, 'w-full py-8']}>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <!-- Left side - Copyright -->
            <div class="text-xl text-foreground-secondary">
                © {currentYear} Carlos Garcia. All rights reserved.
            </div>
            
            <!-- Center - Navigation Links -->
            <nav class="flex flex-wrap items-center justify-center gap-6">
                <a href="/art" class="text-xl inline-block text-foreground-secondary hover:text-accent hover:scale-110 transition-all duration-200">
                    Art
                </a>
                <a href="/learn" class="text-xl inline-block text-foreground-secondary hover:text-accent hover:scale-110 transition-all duration-200">
                    Learn
                </a>
                <a href="/log" class="text-xl inline-block text-foreground-secondary hover:text-accent hover:scale-110 transition-all duration-200">
                    Log
                </a>
                <a href="/about" class="text-xl inline-block text-foreground-secondary hover:text-accent hover:scale-110 transition-all duration-200">
                    About
                </a>
            </nav>
            
            <!-- Right side - Social Links -->
            <div class="flex items-center gap-4">
                <a href="https://www.linkedin.com/in/carlosgarcia3d/" target="_blank" rel="noopener noreferrer" class="text-foreground-secondary hover:text-accent hover:scale-110 transition-all duration-200" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>
