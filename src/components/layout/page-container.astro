---
// Consistent page container
interface Props {
  maxWidth?: 'default' | 'wide';
  class?: string;
}

const { maxWidth = 'wide', class: className } = Astro.props;
const maxWidthClass = maxWidth === 'wide' ? 'max-w-[102rem]' : 'max-w-6xl';
const paddingClass = 'px-4 sm:px-6 md:px-8';
---

<div class:list={[maxWidthClass, "mx-auto", paddingClass, className]}>
  <slot />
</div>
