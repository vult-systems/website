---
import type { TocHeading } from '@/lib/sanity/toc';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 1 && (
    <nav class="article-toc" aria-label="Table of contents">
      <p class="toc-title">On this page</p>
      <ul class="toc-list">
        {headings.map((h) => (
          <li class:list={['toc-item', `toc-l${h.level}`]}>
            <a href={`#${h.id}`} data-toc-id={h.id}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .article-toc {
    display: none;
  }

  /* Only show when there's room in the left margin (keeps the article centered) */
  @media (min-width: 1280px) {
    .article-toc {
      display: block;
      grid-column: 1;
      justify-self: end;
      align-self: start;
      position: sticky;
      top: 8rem;
      width: 16rem;
      max-height: calc(100vh - 10rem);
      overflow-y: auto;
      padding-right: 2rem;
    }
  }

  .toc-title {
    font-family: var(--font-ibm-plex);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--foreground-muted));
    margin-bottom: 1rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid hsl(var(--foreground-secondary) / 0.12);
  }

  .toc-item {
    margin: 0;
  }

  .toc-item a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-family: var(--font-ibm-plex);
    font-size: 0.82rem;
    line-height: 1.35;
    color: hsl(var(--foreground-muted));
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc-l3 a {
    padding-left: 1.8rem;
    font-size: 0.78rem;
  }
  .toc-l4 a {
    padding-left: 2.6rem;
    font-size: 0.76rem;
  }

  .toc-item a:hover {
    color: hsl(var(--foreground-secondary));
  }

  .toc-item a.active {
    color: hsl(var(--accent));
    border-left-color: hsl(var(--accent));
  }
</style>

<script>
  const initArticleToc = () => {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.article-toc a[data-toc-id]')
    );
    if (!links.length) return;

    const ids = links.map((l) => l.dataset.tocId!);
    const headingEls = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (!headingEls.length) return;

    const setActive = (id: string) => {
      links.forEach((l) => l.classList.toggle('active', l.dataset.tocId === id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: '-12% 0px -70% 0px' }
    );
    headingEls.forEach((h) => observer.observe(h));

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const el = document.getElementById(link.dataset.tocId!);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${link.dataset.tocId}`);
        }
      });
    });

    setActive(ids[0]);
  };

  initArticleToc();
  document.addEventListener('astro:after-swap', initArticleToc);
</script>
