---
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import { Image } from 'astro:assets';

// Import logo images - white versions (for dark mode)
import vultLogoWht from '@/assets/logos/vult-logo-wht.png';
import uiw3dLogoWht from '@/assets/logos/uiw3d-horiz-logo-wht.png';
import logo343iWht from '@/assets/logos/343i-logo-wht.png';
import biowareLogoWht from '@/assets/logos/bioware-logo-wht.png';
import disneyLogoWht from '@/assets/logos/walt-disney-logo-wht.png';
import newtekLogoWht from '@/assets/logos/newtek-logo-wht.png';

// Import logo images - black versions (for light mode)
import vultLogoBlk from '@/assets/logos/vult-logo-blk.png';
import uiw3dLogoBlk from '@/assets/logos/uiw3d-horiz-logo-blk.png';
import logo343iBlk from '@/assets/logos/343i-logo-blk.png';
import biowareLogoBlk from '@/assets/logos/bioware-logo-blk.png';
import disneyLogoBlk from '@/assets/logos/walt-disney-logo-blk.png';
import newtekLogoBlk from '@/assets/logos/newtek-logo-blk.png';

// Import colored logos (used in both light and dark modes)
import qualcommLogoClr from '@/assets/logos/qualcomm-logo-clr.png';
import mergeVrLogoClr from '@/assets/logos/merge-vr-logo-clr.png';
import usafaLogoClr from '@/assets/logos/usafa-logo-clr.png';
import losAlamosLogoClr from '@/assets/logos/losalamos-logo-clr.png';

interface Logo {
  name: string;
  imageLight: ImageMetadata; // Black logo for light mode
  imageDark: ImageMetadata;  // White logo for dark mode
}

interface Props {
  title?: string;
  description?: string;
  logos?: Logo[];
  class?: string;
}

const defaultLogos: Logo[] = [
  // Row 1
  { name: 'Vult Systems', imageLight: vultLogoBlk, imageDark: vultLogoWht },
  { name: 'UIW 3D', imageLight: uiw3dLogoBlk, imageDark: uiw3dLogoWht },
  { name: '343 Industries', imageLight: logo343iBlk, imageDark: logo343iWht },
  { name: 'BioWare', imageLight: biowareLogoBlk, imageDark: biowareLogoWht },
  { name: 'Qualcomm', imageLight: qualcommLogoClr, imageDark: qualcommLogoClr },
  // Row 2
  { name: 'Walt Disney', imageLight: disneyLogoBlk, imageDark: disneyLogoWht },
  { name: 'Merge VR', imageLight: mergeVrLogoClr, imageDark: mergeVrLogoClr },
  { name: 'US Air Force Academy', imageLight: usafaLogoClr, imageDark: usafaLogoClr },
  { name: 'NewTek', imageLight: newtekLogoBlk, imageDark: newtekLogoWht },
  { name: 'Los Alamos', imageLight: losAlamosLogoClr, imageDark: losAlamosLogoClr },
];

const {
  title = "Studios & Creative Teams I've Worked With",
  description = "I've worked across a lot of different corners of the industry: game studios, defense, national labs, startups, academia. Building characters, assets, and pipelines for AAA games, consumer tech, scientific visualization, and a bit of everything in between. If it involves 3D, chances are I've developed something for it.",
  logos = defaultLogos,
  class: className = ''
} = Astro.props;
---

<section class:list={["relative z-10 py-16 sm:py-20", className]}>
  <div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
    
    <!-- Section Header -->
    <div class="mb-10 sm:mb-12 text-left">
      {title && (
        <Text variant="primary" size="md" class="mb-0 !font-normal leading-tight">
          {title}
        </Text>
      )}
      {description && (
        <Text variant="secondary" size="md" class="mb-2 leading-tight !text-foreground-muted lg:max-w-[50%]">
          {description}
        </Text>
      )}
      <Link variant="accent" href="/about">
        ABOUT ME >
      </Link>
    </div>

    <!-- Logo Grid -->
    <div class="space-y-6">
      <!-- Top Row - 5 logos -->
      <div class="grid grid-cols-3 sm:grid-cols-5 gap-4 items-center">
        {logos.slice(0, 5).map((logo, index) => (
          <div class:list={[
            "flex items-center",
            index === 0 ? "justify-start" : index === 4 ? "justify-end" : "justify-center"
          ]}>
            {/* Light mode logo (black) */}
            <Image 
              src={logo.imageLight} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none dark:hidden",
                index === 0 || index === 3 ? "h-6 sm:h-8 md:h-10" :
                index === 1 ? "h-16 sm:h-20 md:h-24" :
                index === 4 ? "h-10 sm:h-12 md:h-14" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
            {/* Dark mode logo (white) */}
            <Image 
              src={logo.imageDark} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none hidden dark:block",
                index === 0 || index === 3 ? "h-6 sm:h-8 md:h-10" :
                index === 1 ? "h-16 sm:h-20 md:h-24" :
                index === 4 ? "h-10 sm:h-12 md:h-14" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <!-- Bottom Row - 5 columns (4 logos + empty) -->
      <div class="grid grid-cols-3 sm:grid-cols-5 gap-4 items-center">
        {logos.slice(5).map((logo, index) => (
          <div class:list={[
            "flex items-center",
            index === 0 ? "justify-start" : "justify-center"
          ]}>
            {/* Light mode logo (black) */}
            <Image 
              src={logo.imageLight} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none dark:hidden",
                index === 0 ? "h-12 sm:h-14 md:h-16" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
            {/* Dark mode logo (white) */}
            <Image 
              src={logo.imageDark} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none hidden dark:block",
                index === 0 ? "h-12 sm:h-14 md:h-16" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
          </div>
        ))}
        <!-- Empty 5th column -->
        <div></div>
      </div>
    </div>

  </div>
</section>
