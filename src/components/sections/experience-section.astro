---
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import { Image } from 'astro:assets';

// Import logo images
import vultLogo from '@/assets/logos/vult-logo-wht.png';
import uiw3dLogo from '@/assets/logos/uiw3d-horiz-logo-wht.png';
import logo343i from '@/assets/logos/343i-logo-wht.png';
import biowareLogo from '@/assets/logos/bioware-logo-wht.png';
import disneyLogo from '@/assets/logos/walt-disney-logo-wht.png';
import qualcommLogo from '@/assets/logos/qualcomm-logo-clr.png';
import mergeVrLogo from '@/assets/logos/merge-vr-logo-clr.png';
import usafaLogo from '@/assets/logos/usafa-logo-clr.png';
import newtekLogo from '@/assets/logos/newtek-logo-wht.png';
import losAlamosLogo from '@/assets/logos/losalamos-logo-clr.png';

interface Logo {
  name: string;
  image: ImageMetadata;
}

interface Props {
  title?: string;
  description?: string;
  logos?: Logo[];
  class?: string;
}

const defaultLogos: Logo[] = [
  // Row 1
  { name: 'UIW 3D', image: uiw3dLogo },
  { name: 'Vult Systems', image: vultLogo },
  { name: '343 Industries', image: logo343i },
  { name: 'BioWare', image: biowareLogo },
  { name: 'Qualcomm', image: qualcommLogo },
  // Row 2
  { name: 'Walt Disney', image: disneyLogo },
  { name: 'Merge VR', image: mergeVrLogo },
  { name: 'US Air Force Academy', image: usafaLogo },
  { name: 'NewTek', image: newtekLogo },
  { name: 'Los Alamos', image: losAlamosLogo },
];

const {
  title = "Studios & Creative Teams I've Worked With",
  description = "I've worked across a lot of different corners of the industry: game studios, defense, national labs, startups, academia. Building characters, assets, and pipelines for AAA games, consumer tech, scientific visualization, and a bit of everything in between. If it involves 3D, chances are I've developed something for it.",
  logos = defaultLogos,
  class: className = ''
} = Astro.props;
---

<section class:list={["relative z-10 py-16 sm:py-20", className]}>
  <div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
    
    <!-- Section Header -->
    <div class="mb-10 sm:mb-12 text-left">
      {title && (
        <Text variant="primary" size="md" class="mb-0 !font-normal leading-tight">
          {title}
        </Text>
      )}
      {description && (
        <Text variant="secondary" size="md" class="mb-2 leading-tight !text-foreground-muted max-w-[50%]">
          {description}
        </Text>
      )}
      <Link variant="accent" href="/about">
        ABOUT ME >
      </Link>
    </div>

    <!-- Logo Grid -->
    <div class="space-y-6">
      <!-- Top Row - 5 logos -->
      <div class="grid grid-cols-5 items-center">
        {logos.slice(0, 5).map((logo, index) => (
          <div class:list={[
            "flex items-center",
            index === 0 ? "justify-start" : index === 4 ? "justify-end" : "justify-center"
          ]}>
            <Image 
              src={logo.image} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none",
                index === 0 ? "h-16 sm:h-20 md:h-24" :
                index === 1 || index === 3 ? "h-6 sm:h-8 md:h-10" :
                index === 4 ? "h-10 sm:h-12 md:h-14" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <!-- Bottom Row - 5 columns (4 logos + empty) -->
      <div class="grid grid-cols-5 items-center">
        {logos.slice(5).map((logo, index) => (
          <div class:list={[
            "flex items-center",
            index === 0 ? "justify-start" : "justify-center"
          ]}>
            <Image 
              src={logo.image} 
              alt={logo.name}
              class:list={[
                "object-contain pointer-events-none select-none",
                index === 0 ? "h-12 sm:h-14 md:h-16" : "h-8 sm:h-10 md:h-12"
              ]}
              loading="lazy"
            />
          </div>
        ))}
        <!-- Empty 5th column -->
        <div></div>
      </div>
    </div>

  </div>
</section>
