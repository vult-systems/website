---
import { Image } from 'astro:assets';

// White versions (dark mode)
import vultLogoWht from '@/assets/logos/vult-logo-wht.png';
import uiw3dLogoWht from '@/assets/logos/uiw3d-horiz-logo-wht.png';
import logo343iWht from '@/assets/logos/343i-logo-wht.png';
import biowareLogoWht from '@/assets/logos/bioware-logo-wht.png';
import disneyLogoWht from '@/assets/logos/walt-disney-logo-wht.png';
import newtekLogoWht from '@/assets/logos/newtek-logo-wht.png';
// Black versions (light mode)
import vultLogoBlk from '@/assets/logos/vult-logo-blk.png';
import uiw3dLogoBlk from '@/assets/logos/uiw3d-horiz-logo-blk.png';
import logo343iBlk from '@/assets/logos/343i-logo-blk.png';
import biowareLogoBlk from '@/assets/logos/bioware-logo-blk.png';
import disneyLogoBlk from '@/assets/logos/walt-disney-logo-blk.png';
import newtekLogoBlk from '@/assets/logos/newtek-logo-blk.png';
// Colored (both modes)
import qualcommLogoClr from '@/assets/logos/qualcomm-logo-clr.png';
import mergeVrLogoClr from '@/assets/logos/merge-vr-logo-clr.png';
import usafaLogoClr from '@/assets/logos/usafa-logo-clr.png';
import losAlamosLogoClr from '@/assets/logos/losalamos-logo-clr.png';

interface Logo {
  name: string;
  imageLight: ImageMetadata;
  imageDark: ImageMetadata;
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
}

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Single source of truth for the studio logos (shared by home + about).
const studioLogos: Logo[] = [
  // Row 1
  { name: '343 Industries', imageLight: logo343iBlk, imageDark: logo343iWht, size: 'lg' },
  { name: 'BioWare', imageLight: biowareLogoBlk, imageDark: biowareLogoWht, size: 'sm' },
  { name: 'Walt Disney', imageLight: disneyLogoBlk, imageDark: disneyLogoWht, size: 'xl' },
  { name: 'UIW 3D', imageLight: uiw3dLogoBlk, imageDark: uiw3dLogoWht, size: '2xl' },
  { name: 'Merge VR', imageLight: mergeVrLogoClr, imageDark: mergeVrLogoClr, size: 'md' },
  // Row 2
  { name: 'Qualcomm', imageLight: qualcommLogoClr, imageDark: qualcommLogoClr, size: 'lg' },
  { name: 'NewTek', imageLight: newtekLogoBlk, imageDark: newtekLogoWht, size: 'lg' },
  { name: 'Los Alamos', imageLight: losAlamosLogoClr, imageDark: losAlamosLogoClr, size: 'md' },
  { name: 'Vult Systems', imageLight: vultLogoBlk, imageDark: vultLogoWht, size: 'sm' },
  { name: 'US Air Force Academy', imageLight: usafaLogoClr, imageDark: usafaLogoClr, size: 'lg' },
];

// Per-logo heights so reordering never mis-sizes a logo (esp. wordmarks like UIW).
const sizeClass: Record<string, string> = {
  sm: 'h-6 sm:h-8 md:h-10',
  md: 'h-8 sm:h-10 md:h-12',
  lg: 'h-10 sm:h-12 md:h-14',
  xl: 'h-12 sm:h-14 md:h-16',
  '2xl': 'h-16 sm:h-20 md:h-24',
};
---

<div
  class:list={[
    "grid grid-cols-2 sm:grid-cols-5 gap-x-4 gap-y-5 sm:gap-y-2 items-center justify-items-center",
    className,
  ]}
>
  {studioLogos.map((logo) => (
    <div class="flex items-center justify-center">
      <Image
        src={logo.imageLight}
        alt={logo.name}
        class:list={["object-contain pointer-events-none select-none dark:hidden", sizeClass[logo.size ?? 'md']]}
        loading="lazy"
      />
      <Image
        src={logo.imageDark}
        alt={logo.name}
        class:list={["object-contain pointer-events-none select-none hidden dark:block", sizeClass[logo.size ?? 'md']]}
        loading="lazy"
      />
    </div>
  ))}
</div>
