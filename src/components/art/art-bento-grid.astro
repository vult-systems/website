---
import BentoGrid from '../ui/bento-grid.astro';
import BentoGridItem from '../ui/bento-grid-item.astro';
import Heading from '../ui/heading.astro';
import Text from '../ui/text.astro';
import Badge from '../ui/badge.astro';

interface ArtPiece {
  slug: string;
  title: string;
  description?: string;
  heroImage?: string;
  category: string;
  size?: 'small' | 'medium' | 'large' | 'tall';
}

interface Props {
  artPieces: ArtPiece[];
}

const { artPieces } = Astro.props;

// Get unique categories for filtering
const categories = [...new Set(artPieces.map(piece => piece.category))];

// Map size to column span classes
const getSizeClass = (size?: string) => {
  switch(size) {
    case 'small':
      return 'md:col-span-1';
    case 'tall':
      return 'md:col-span-1 md:row-span-2';
    case 'large':
      return 'md:col-span-2 md:row-span-2';
    case 'medium':
    default:
      return 'md:col-span-1';
  }
};
---

<div class="space-y-8">
  <!-- Filter Buttons (if we have categories) -->
  {categories.length > 1 && (
    <>
      <div class="flex flex-wrap gap-6 items-center justify-start">
        <button data-filter="all" class="filter-btn active inline-block text-accent hover:scale-105 transition-all duration-200 cursor-pointer">
          All
        </button>
        {categories.map((category) => (
          <button data-filter={category} class="filter-btn inline-block text-foreground-secondary hover:text-accent hover:scale-105 transition-all duration-200 cursor-pointer">
            {category}
          </button>
        ))}
      </div>
      
      <!-- Divider -->
      <div class="border-t border-border"></div>
    </>
  )}

  <!-- Bento Grid -->
  <BentoGrid>
    {artPieces.map((piece) => (
      <BentoGridItem 
        class={`art-item ${getSizeClass(piece.size)}`}
        href={`/art/${piece.slug}`}
      >
        <div class="flex flex-col h-full">
          <!-- Image -->
          <div class={`relative overflow-hidden ${piece.size === 'large' || piece.size === 'tall' ? 'flex-1 min-h-[10rem]' : 'aspect-[4/3]'}`}>
            {piece.heroImage && (
              <img
                src={piece.heroImage}
                alt={piece.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            )}
          </div>
          
          <!-- Content -->
          <div class="p-6 space-y-3">
            <Heading level={3} size="lg" class="line-clamp-2">
              {piece.title}
            </Heading>
            {piece.description && (
              <Text size="sm" variant="secondary" class="line-clamp-2">
                {piece.description}
              </Text>
            )}
            <!-- Category Badge -->
            <div>
              <Badge size="sm">
                {piece.category}
              </Badge>
            </div>
          </div>
        </div>
      </BentoGridItem>
    ))}
  </BentoGrid>
</div>

<style>
  .filter-btn.active {
    color: hsl(var(--accent));
    transform: scale(1.05);
  }

  .art-item {
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    opacity: 1;
    transform: scale(1);
  }

  .art-item.filtering-out {
    opacity: 0;
    transform: scale(0.96);
  }

  .art-item.hidden {
    display: none;
  }
</style>

<script>
  // Filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const artItems = document.querySelectorAll('.art-item');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      
      // Update active button
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      
      // Step 1: Fade out ALL items first
      artItems.forEach(item => {
        item.classList.add('filtering-out');
      });
      
      // Step 2: After fade out completes, hide filtered items and remove fade class from visible ones
      setTimeout(() => {
        artItems.forEach(item => {
          const category = item.closest('[data-category]')?.getAttribute('data-category');
          
          if (filter === 'all' || category === filter) {
            item.classList.remove('hidden', 'filtering-out');
          } else {
            item.classList.add('hidden');
            item.classList.remove('filtering-out');
          }
        });
      }, 300);
    });
  });
</script>
