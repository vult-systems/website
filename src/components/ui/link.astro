---
/**
 * Link Component
 * 
 * Semantic link element with visual variants.
 * Handles both internal and external links with proper attributes.
 * All styling comes from centralized design tokens in src/config/design.ts
 * 
 * @example
 * <Link href="/about">Internal Link</Link>
 * <Link href="/projects" variant="accent">Accent Link</Link>
 * <Link href="https://github.com" external>External Link</Link>
 */

import { components, cn } from '@/config/design';

interface Props {
  /** Link destination */
  href: string;
  /** Visual style variant */
  variant?: 'default' | 'accent' | 'muted' | 'ghost';
  /** Underline style */
  underline?: 'always' | 'hover' | 'none';
  /** External link (adds target="_blank" and rel) */
  external?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const {
  href,
  variant = 'default',
  underline = 'none',
  external = false,
  class: className = ''
} = Astro.props;

const classes = cn(
  components.link.base,
  components.link.variants[variant],
  components.link.underline[underline],
  'text-xl',
  className
);

const externalAttrs = external 
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};

const style = 'font-family: "Besley", serif !important;';
---

<a href={href} class={classes} style={style} {...externalAttrs}>
  <slot />
</a>
