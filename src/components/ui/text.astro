---
/**
 * Text Component
 * 
 * Body text with semantic color variants and size options.
 * Use for paragraphs, descriptions, and general text content.
 * All styling comes from centralized design tokens in src/config/design.ts
 * 
 * @example
 * <Text>Default body text</Text>
 * <Text variant="secondary">Less prominent text</Text>
 * <Text variant="muted" size="sm">Helper text</Text>
 */

import { components, cn } from '@/config/design';

interface Props {
  /** Color variant for different text hierarchies */
  variant?: 'default' | 'secondary' | 'muted' | 'accent';
  /** Text size */
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';
  /** Text alignment */
  align?: 'left' | 'center' | 'right';
  /** HTML element to render */
  as?: 'p' | 'span' | 'div';
  /** Additional CSS classes */
  class?: string;
  /** Inline styles */
  style?: string;
}

const {
  variant = 'default',
  size = 'base',
  align = 'left',
  as = 'p',
  class: className = '',
  style = ''
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right'
} as const;

const Tag = as;

const classes = cn(
  components.text.base,
  components.text.variants[variant as keyof typeof components.text.variants],
  components.text.sizes[size as keyof typeof components.text.sizes],
  alignClasses[align as keyof typeof alignClasses],
  'leading-relaxed',
  className
);
---

<Tag class={classes} style={style}>
  <slot />
</Tag>
