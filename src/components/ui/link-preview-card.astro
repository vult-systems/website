---
// Experimental hover preview for external links — fetches OG metadata via
// /api/link-preview and shows a small card near the cursor. Mounted only
// on the Log page for now (see log.astro) to see how it reads before
// deciding whether it's worth rolling out sitewide.
---

<div id="link-preview-card" class="link-preview-card" role="tooltip" aria-hidden="true">
  <div class="link-preview-image" data-role="image"></div>
  <div class="link-preview-body">
    <div class="link-preview-site" data-role="site">—</div>
    <div class="link-preview-title" data-role="title">—</div>
    <p class="link-preview-desc" data-role="desc"></p>
  </div>
</div>

<style>
  .link-preview-card {
    position: fixed;
    z-index: 60;
    width: 320px;
    max-width: calc(100vw - 2rem);
    background: hsl(var(--card-bg));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.35);
    overflow: hidden;
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .link-preview-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .link-preview-image {
    aspect-ratio: 16 / 9;
    background: hsl(var(--background));
    border-bottom: 1px solid hsl(var(--border));
  }
  .link-preview-image:empty { display: none; }
  .link-preview-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .link-preview-body {
    padding: 0.75rem 0.9rem;
  }
  .link-preview-site {
    font-family: var(--font-ibm-plex);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--foreground-muted));
    margin-bottom: 0.3rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .link-preview-title {
    font-family: 'Besley', serif;
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.3;
    color: hsl(var(--foreground));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .link-preview-desc {
    margin: 0.3rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: hsl(var(--foreground-secondary));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .link-preview-desc:empty { display: none; }
  .link-preview-card.is-loading .link-preview-title,
  .link-preview-card.is-loading .link-preview-site {
    color: hsl(var(--foreground-muted));
  }
  @media (prefers-reduced-motion: reduce) {
    .link-preview-card { transition: none; }
  }
  @media (hover: none) {
    /* Touch devices have no hover to trigger this with. */
    .link-preview-card { display: none; }
  }
</style>

<script>
  const HOVER_DELAY = 350;
  const HIDE_DELAY = 150;

  const card = document.getElementById('link-preview-card') as HTMLElement | null;
  if (card) {
    const imageEl = card.querySelector<HTMLElement>('[data-role="image"]');
    const siteEl = card.querySelector<HTMLElement>('[data-role="site"]');
    const titleEl = card.querySelector<HTMLElement>('[data-role="title"]');
    const descEl = card.querySelector<HTMLElement>('[data-role="desc"]');

    let showTimer: number | undefined;
    let hideTimer: number | undefined;
    let activeUrl: string | null = null;
    let fetchController: AbortController | null = null;
    const cache = new Map<string, { title: string; description: string; image: string | null; siteName: string }>();

    const clearTimers = () => {
      window.clearTimeout(showTimer);
      window.clearTimeout(hideTimer);
    };

    const position = (link: HTMLElement) => {
      const rect = link.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const margin = 8;
      let top = rect.bottom + margin;
      let left = rect.left;
      if (top + cardRect.height > window.innerHeight - margin) {
        top = rect.top - cardRect.height - margin;
      }
      if (top < margin) top = margin;
      if (left + cardRect.width > window.innerWidth - margin) {
        left = window.innerWidth - cardRect.width - margin;
      }
      if (left < margin) left = margin;
      card.style.top = `${top}px`;
      card.style.left = `${left}px`;
    };

    const hide = () => {
      card.classList.remove('is-visible');
      card.setAttribute('aria-hidden', 'true');
      activeUrl = null;
      fetchController?.abort();
    };

    const populate = (data: { title: string; description: string; image: string | null; siteName: string }) => {
      if (siteEl) siteEl.textContent = data.siteName;
      if (titleEl) titleEl.textContent = data.title;
      if (descEl) descEl.textContent = data.description;
      if (imageEl) {
        imageEl.innerHTML = data.image ? `<img src="${data.image}" alt="" data-no-lightbox loading="lazy">` : '';
      }
      card.classList.remove('is-loading');
    };

    const show = async (link: HTMLAnchorElement) => {
      const url = link.href;
      activeUrl = url;
      card.classList.add('is-visible');
      card.setAttribute('aria-hidden', 'false');

      const cached = cache.get(url);
      if (cached) {
        populate(cached);
        requestAnimationFrame(() => position(link));
        return;
      }

      card.classList.add('is-loading');
      if (siteEl) siteEl.textContent = new URL(url).hostname.replace(/^www\./, '');
      if (titleEl) titleEl.textContent = 'Loading…';
      if (descEl) descEl.textContent = '';
      if (imageEl) imageEl.innerHTML = '';
      requestAnimationFrame(() => position(link));

      fetchController?.abort();
      fetchController = new AbortController();
      try {
        const res = await fetch(`/api/link-preview?url=${encodeURIComponent(url)}`, { signal: fetchController.signal });
        const data = await res.json();
        if (activeUrl !== url) return; // hovered elsewhere before this resolved
        cache.set(url, data);
        populate(data);
        requestAnimationFrame(() => position(link));
      } catch {
        // Aborted (moved to another link) or network failure — leave the
        // hostname-only loading state showing rather than erroring visibly.
      }
    };

    const wireLink = (link: HTMLAnchorElement) => {
      if (link.dataset.previewWired) return;
      link.dataset.previewWired = '1';
      link.addEventListener('mouseenter', () => {
        clearTimers();
        showTimer = window.setTimeout(() => show(link), HOVER_DELAY);
      });
      link.addEventListener('mouseleave', () => {
        window.clearTimeout(showTimer);
        hideTimer = window.setTimeout(hide, HIDE_DELAY);
      });
      link.addEventListener('focus', () => show(link));
      link.addEventListener('blur', () => hide());
    };

    card.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
    card.addEventListener('mouseleave', () => {
      hideTimer = window.setTimeout(hide, HIDE_DELAY);
    });

    const wireAll = () => {
      document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((link) => {
        if (link.hostname && link.hostname !== location.hostname) wireLink(link);
      });
    };

    wireAll();
    document.addEventListener('astro:after-swap', wireAll);
    // Log content is fetched/rendered client-side too (toggled panels) — a
    // light rescan covers links that appear after initial load.
    new MutationObserver(wireAll).observe(document.body, { childList: true, subtree: true });
  }
</script>
