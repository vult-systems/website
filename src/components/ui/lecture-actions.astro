---
// Toolbar shown above a lecture body. Wire-up lives in lecture-presenter.astro.
---

<div class="lecture-actions not-prose mb-6 flex flex-wrap items-center gap-2">
  <button
    type="button"
    class="lecture-present-btn inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground-secondary hover:text-accent hover:border-accent/60 transition-colors"
    style="font-family: 'Besley', serif !important;"
    aria-label="Present this lecture fullscreen"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2" />
      <path d="M8 21h8M12 17v4" />
      <path d="m10 8 4 2.5L10 13z" fill="currentColor" stroke="none" />
    </svg>
    Present
  </button>
  <button
    type="button"
    class="lecture-print-btn inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground-secondary hover:text-accent hover:border-accent/60 transition-colors"
    style="font-family: 'Besley', serif !important;"
    aria-label="Save this lecture as a PDF"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9V2h12v7" />
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
      <rect x="6" y="14" width="12" height="8" rx="1" />
    </svg>
    Save PDF
  </button>
</div>
