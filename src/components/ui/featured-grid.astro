---
import Heading from './heading.astro';
import Text from './text.astro';
import Link from './link.astro';
import Badge from './badge.astro';
import Card from './card.astro';
import type { ImageMetadata } from 'astro';

interface ArtPiece {
  slug: string;
  title: string;
  description: string;
  heroImage: string | ImageMetadata | undefined;
  category: string;
}

interface Props {
  title?: string;
  description?: string;
  artPieces: ArtPiece[];
}

const { 
  title = "Featured Work",
  description = "Recent projects and explorations",
  artPieces 
} = Astro.props;

// Helper to get image src
const getImageSrc = (image: string | ImageMetadata | undefined): string => {
  if (!image) return '';
  if (typeof image === 'string') return image;
  return image.src;
};
---

<section class="relative z-10 py-24 sm:py-16">
  <div class="container max-w-7xl mx-auto px-4">
    
    <!-- Section Header -->
    {(title || description) && (
      <div class="mb-8 text-left">
        {title && (
          <Heading level={2} size="4xl" align="left" class="mb-4">{title}</Heading>
        )}
        {description && (
          <Text size="lg" variant="secondary" align="left" class="max-w-2xl mx-left">{description}</Text>
        )}
      </div>
    )}

    <!-- Art Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {artPieces.map((piece, index) => {
        // Stagger parallax speeds for each card - alternating pattern
        const parallaxSpeed = 0.02 + (index % 3) * 0.015; // 0.02, 0.035, 0.05
        
        return (
          <div data-parallax={parallaxSpeed}>
            <Card padding="none" interactive href={`/art/${piece.slug}`}>
              <!-- Image -->
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={getImageSrc(piece.heroImage)}
                  alt={piece.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <!-- Category Badge -->
                <div class="absolute top-4 left-4">
                  <Badge size="sm" class="bg-background/90 backdrop-blur-sm">
                    {piece.category}
                  </Badge>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-6 space-y-3">
                <Heading level={3} size="xl" class="line-clamp-2">
                  {piece.title}
                </Heading>
                {piece.description && (
                  <Text size="sm" variant="secondary" class="line-clamp-2">
                    {piece.description}
                  </Text>
                )}
              </div>
            </Card>
          </div>
        );
      })}
    </div>

    <!-- View All Link -->
    <div class="mt-16 text-center">
      <Link href="/art" variant="accent">
        View all work >
      </Link>
    </div>
  </div>
</section>
