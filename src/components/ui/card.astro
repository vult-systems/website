---
/**
 * Card Component
 * 
 * Container component for grouped content with hover states.
 * Can be interactive (clickable) or static display container.
 * All styling comes from centralized design tokens in src/config/design.ts
 * 
 * @example
 * <Card>Static content card</Card>
 * <Card interactive href="/post/1">Clickable card</Card>
 * <Card variant="bordered" padding="lg">Large padded card</Card>
 */

import { components, cn } from '@/config/design';

interface Props {
  /** Visual style variant */
  variant?: 'default' | 'bordered' | 'elevated';
  /** Padding size */
  padding?: 'none' | 'sm' | 'base' | 'lg';
  /** If provided, makes card clickable */
  href?: string;
  /** Enable hover effect */
  interactive?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = 'default',
  padding = 'base',
  href,
  interactive = !!href,
  class: className = ''
} = Astro.props;

const Tag = href ? 'a' : 'div';

const classes = cn(
  components.card.base,
  components.card.variants[variant],
  components.card.padding[padding],
  interactive && components.card.interactive,
  className
);

const attrs = href 
  ? { href, class: classes }
  : { class: classes };
---

<Tag {...attrs}>
  <slot />
</Tag>
