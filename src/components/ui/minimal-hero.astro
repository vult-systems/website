---
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile/profile.jpg';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import Badge from '@/components/ui/badge.astro';
import { SITE } from '@/config/site';

interface Props {
  class?: string;
}

const {
  class: className = ""
} = Astro.props;

const sectionClasses = [
  "relative z-10 py-32",
  className
].filter(Boolean).join(' ');
---

<section class={sectionClasses}>
  <div class="container max-w-7xl mx-auto px-4">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      
      <!-- Left Column - Text -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
        <Badge class="mb-6">
          {SITE.author.location.full}
        </Badge>
        
        <Heading level={1} size="4xl" class="mb-6">
          {SITE.author.role}
        </Heading>
        
        <Text variant="secondary" size="lg" class="mb-8 max-w-xl">
          3D character art and digital modeling work.
        </Text>
        
        <div class="flex w-full flex-col justify-center gap-2 sm:flex-row lg:justify-start">
          <Link variant="accent" href="/art">
            View Art >
          </Link>
          <Link variant="accent" href="/about">
            About Me >
          </Link>
        </div>
      </div>
      
      <!-- Right Column - Image -->
      <div class="flex justify-center lg:justify-end">
        <Image
          src={profileImg}
          alt={SITE.author.name}
          width={600}
          height={600}
          loading="eager"
          class="max-h-96 w-full rounded-md object-cover"
        />
      </div>
    </div>
  </div>
</section>
