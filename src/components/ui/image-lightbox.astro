---
/**
 * Image Lightbox Component
 * 
 * Makes images clickable with zoom and pan functionality.
 * Automatically applies to all images with the 'lightbox' class.
 */
---

<!-- Lightbox Overlay -->
<!-- transition-opacity, not transition-all: with -all, the visibility:hidden
     -> visible swap rides the same transition as opacity and doesn't
     actually compute as visible until the transition resolves (~200ms
     later) despite the class changing synchronously. That forced focus()
     calls on open into a setTimeout to work at all, which broke the
     browser's :focus-visible "was this a trusted click?" heuristic and
     showed a focus ring even for mouse clicks. Scoping the transition to
     opacity only makes visibility flip synchronously, like the spec says
     it should for a hidden->visible transition. -->
<div id="lightbox" class="fixed inset-0 bg-background/95 backdrop-blur-md z-[9999] opacity-0 invisible transition-opacity duration-200 ease-out flex items-center justify-center p-8" role="dialog" aria-modal="true" aria-label="Media viewer">
  <div id="lightbox-container" class="relative w-full h-full flex items-center justify-center">
    <!-- Close Button -->
    <button id="close-btn" aria-label="Close" class="absolute top-4 right-4 z-[10] w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition duration-200 flex items-center justify-center cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <!-- Zoom Controls (hidden for video) -->
    <div id="zoom-controls" class="absolute bottom-4 right-4 z-[10] flex gap-2">
      <button id="zoom-out" aria-label="Zoom out" class="w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition duration-200 flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
      </button>
      <button id="zoom-reset" aria-label="Reset zoom" class="px-4 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition duration-200 flex items-center justify-center cursor-pointer text-xs">
        Reset
      </button>
      <button id="zoom-in" aria-label="Zoom in" class="w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition duration-200 flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>
    
    <!-- Image Container: no card/background of its own — just the image
         floating over the lightbox's own blurred backdrop. Sized off the
         img itself (max-w/h) rather than a fixed box, so there's no empty
         frame for a zoomed image to visibly spill past. -->
    <div id="image-wrapper" class="w-full h-full flex items-center justify-center overflow-hidden opacity-0 scale-90 transition duration-200 ease-out">
      <img
        id="lightbox-image"
        alt=""
        class="max-w-[90vw] max-h-[85vh] object-contain transition-transform duration-150 ease-out select-none"
        style="cursor: grab;"
        draggable="false"
        data-no-lightbox
      />
    </div>

    <!-- Video Container -->
    <div id="video-wrapper" class="rounded-lg bg-black border-2 border-foreground-secondary/10 shadow-2xl max-w-full max-h-[calc(100vh-6rem)] flex items-center justify-center opacity-0 scale-90 transition duration-200 ease-out hidden">
      <video
        id="lightbox-video"
        class="max-w-full max-h-[calc(100vh-6rem)] object-contain rounded-lg"
        controls
        loop
        playsinline
      ></video>
    </div>
  </div>
</div>

<style>
  /* See focusWithoutRing() in the script below for why this exists. */
  .no-focus-ring:focus-visible {
    outline: none;
  }
</style>

<script>
  let scale = 1;
  let isDragging = false;
  let hasDragged = false;
  let startX = 0, startY = 0;
  let currentX = 0, currentY = 0;
  let isVideoMode = false;
  let lastFocusedElement: HTMLElement | null = null;

  // Arrow-key gallery navigation. The entry list is captured fresh at the
  // moment something is clicked (not cached across page loads), scoped to
  // whatever page the click happened on. Entries are plain {src, alt} pairs
  // rather than element references, so a page with its own bespoke trigger
  // markup (e.g. students.astro's .learn-lightbox-trigger, which wraps a
  // caption that isn't just the image's own alt text) can build its own
  // list and hand it to openGallery() below instead of being forced through
  // the generic <img> click path.
  interface GalleryEntry { src: string; alt: string }
  let galleryEntries: GalleryEntry[] = [];
  let galleryIndex = -1;

  const collectGalleryImages = (): HTMLImageElement[] =>
    Array.from(
      document.querySelectorAll<HTMLImageElement>(
        'img:not(header img):not(nav img):not(footer img):not([data-no-lightbox])'
      )
    );

  const resolveImageSrc = (img: HTMLImageElement) => img.dataset.full || img.currentSrc || img.src;

  const openGallery = (entries: GalleryEntry[], index: number) => {
    if (entries.length === 0) return;
    galleryEntries = entries;
    galleryIndex = ((index % entries.length) + entries.length) % entries.length;
    const entry = galleryEntries[galleryIndex];
    openLightbox(entry.src, entry.alt);
  };

  const stepGallery = (delta: number) => {
    if (galleryEntries.length <= 1) return;
    galleryIndex = ((galleryIndex + delta) % galleryEntries.length + galleryEntries.length) % galleryEntries.length;
    const entry = galleryEntries[galleryIndex];
    openLightbox(entry.src, entry.alt);
  };

  // Small hook for pages with bespoke lightbox-trigger markup to plug into
  // the same open/gallery/focus/zoom-reset machinery as the generic path.
  declare global {
    interface Window {
      lightboxGallery?: { open: (entries: GalleryEntry[], index: number) => void };
    }
  }
  window.lightboxGallery = { open: openGallery };

  // Focusable controls currently visible inside the lightbox (zoom controls
  // are hidden in video mode, so this is recomputed rather than cached).
  const getFocusable = (): HTMLElement[] => {
    const container = document.getElementById('lightbox-container');
    if (!container) return [];
    return Array.from(
      container.querySelectorAll<HTMLElement>('button, [href], input, [tabindex]:not([tabindex="-1"])')
    ).filter((el) => !el.closest('.hidden') && el.offsetParent !== null);
  };

  // Chromium's :focus-visible heuristic shows a ring for ANY script-driven
  // focus() onto an element that wasn't itself the click/tap target —
  // opening/closing the lightbox always moves focus to a DIFFERENT element
  // (close-btn, or back to whatever triggered it) than what was actually
  // clicked, so it always reads as focus-visible regardless of how the
  // focus() call itself was scheduled. Suppress the ring for these specific
  // programmatic moves via a scoped class rather than the global rule;
  // real Tab navigation afterward is unaffected since it's a fresh focus
  // event with its own (correct) heuristic result.
  const focusWithoutRing = (el: HTMLElement | null) => {
    if (!el) return;
    el.classList.add('no-focus-ring');
    el.focus();
    el.addEventListener('blur', () => el.classList.remove('no-focus-ring'), { once: true });
  };

  const updateTransform = () => {
    const img = document.getElementById('lightbox-image') as HTMLImageElement;
    if (img) {
      img.style.transform = `scale(${scale}) translate(${currentX / scale}px, ${currentY / scale}px)`;
      img.style.cursor = scale > 1 ? 'grab' : 'default';
    }
  };

  const resetZoom = () => {
    scale = 1;
    currentX = 0;
    currentY = 0;
    updateTransform();
  };

  const openLightbox = (src: string, alt: string) => {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-image') as HTMLImageElement;
    const iw = document.getElementById('image-wrapper');
    const vw = document.getElementById('video-wrapper');
    const zc = document.getElementById('zoom-controls');
    if (!lb || !img || !iw) return;

    // Navigating to the next/previous image re-calls this while the
    // lightbox is already open — activeElement at that point is something
    // inside the lightbox itself (focus is trapped there), not the page
    // trigger, so only capture it on a genuine fresh open.
    if (lb.classList.contains('invisible')) {
      lastFocusedElement = document.activeElement as HTMLElement;
    }
    isVideoMode = false;
    img.src = src;
    img.alt = alt;

    iw.classList.remove('hidden');
    vw?.classList.add('hidden');
    zc?.classList.remove('hidden');

    lb.classList.remove('invisible', 'opacity-0');
    lb.classList.add('visible', 'opacity-100');

    requestAnimationFrame(() => {
      iw.classList.remove('opacity-0', 'scale-90');
      iw.classList.add('opacity-100', 'scale-100');
    });
    focusWithoutRing(document.getElementById('close-btn'));

    document.body.style.overflow = 'hidden';
    resetZoom();
  };

  const openVideoLightbox = (src: string) => {
    const lb = document.getElementById('lightbox');
    const vid = document.getElementById('lightbox-video') as HTMLVideoElement;
    const vw = document.getElementById('video-wrapper');
    const iw = document.getElementById('image-wrapper');
    const zc = document.getElementById('zoom-controls');
    if (!lb || !vid || !vw) return;

    lastFocusedElement = document.activeElement as HTMLElement;
    isVideoMode = true;
    vid.src = src;

    vw.classList.remove('hidden');
    iw?.classList.add('hidden');
    zc?.classList.add('hidden');

    lb.classList.remove('invisible', 'opacity-0');
    lb.classList.add('visible', 'opacity-100');

    requestAnimationFrame(() => {
      vw.classList.remove('opacity-0', 'scale-90');
      vw.classList.add('opacity-100', 'scale-100');
      vid.play();
    });
    focusWithoutRing(document.getElementById('close-btn'));

    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    const lb = document.getElementById('lightbox');
    const iw = document.getElementById('image-wrapper');
    const vw = document.getElementById('video-wrapper');
    const vid = document.getElementById('lightbox-video') as HTMLVideoElement;
    if (!lb) return;

    const activeWrapper = isVideoMode ? vw : iw;
    if (!activeWrapper) return;

    activeWrapper.classList.remove('opacity-100', 'scale-100');
    activeWrapper.classList.add('opacity-0', 'scale-90');

    if (isVideoMode && vid) {
      vid.pause();
      // Not vid.src = '' — an empty string is still a URI the browser
      // tries to load, which Firefox flags as "Invalid URI. Load of media
      // resource failed" (Chromium stays quiet about it). Actually
      // removing the attribute avoids that load attempt entirely; load()
      // resets the element the same way vid.src = '' did.
      vid.removeAttribute('src');
      vid.load();
    }

    setTimeout(() => {
      lb.classList.remove('visible', 'opacity-100');
      lb.classList.add('invisible', 'opacity-0');
    }, 200);

    document.body.style.overflow = '';
    resetZoom();

    focusWithoutRing(lastFocusedElement);
    lastFocusedElement = null;
  };

  // Add click listeners to all content images. Guarded with a data attribute
  // (not just a call-site guard) because this legitimately needs to re-scan
  // after every navigation for that page's new images — without the
  // per-element marker, calling it both directly on load and again via
  // astro:page-load (which also fires on the very first load) double-binds
  // every image on that first page.
  const initializeLightbox = () => {
    const lightboxImages = document.querySelectorAll('img:not(header img):not(nav img):not(footer img):not([data-no-lightbox]):not([data-lightbox-bound])');
    lightboxImages.forEach((img) => {
      const imageElement = img as HTMLImageElement;
      imageElement.dataset.lightboxBound = 'true';
      imageElement.style.cursor = 'pointer';
      imageElement.classList.add('hover:scale-[1.02]', 'transition-transform', 'duration-300');
      imageElement.addEventListener('click', () => {
        const imgs = collectGalleryImages();
        // Prefer a full-resolution source so zooming stays crisp.
        const entries = imgs.map((el) => ({ src: resolveImageSrc(el), alt: el.alt }));
        openGallery(entries, imgs.indexOf(imageElement));
      });
    });
  };

  // --- Event listeners using delegation (no stale refs) ---

  // Video lightbox clicks (delegation)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('.video-lightbox-trigger[data-video]');
    if (trigger) {
      const videoSrc = (trigger as HTMLElement).dataset.video;
      if (videoSrc) openVideoLightbox(videoSrc);
    }
  });

  // Close button (delegation)
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#close-btn')) {
      closeLightbox();
    }
  });

  // Click outside content to close
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'lightbox') {
      closeLightbox();
    }
  });

  // Zoom controls (delegation)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#zoom-in')) {
      scale = Math.min(scale + 0.5, 4);
      updateTransform();
    } else if (target.closest('#zoom-out')) {
      scale = Math.max(scale - 0.5, 1);
      if (scale === 1) { currentX = 0; currentY = 0; }
      updateTransform();
    } else if (target.closest('#zoom-reset')) {
      resetZoom();
    }
  });

  // Drag to pan
  document.addEventListener('mousedown', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'lightbox-image' && scale > 1) {
      e.preventDefault();
      isDragging = true;
      hasDragged = false;
      startX = e.clientX - currentX;
      startY = e.clientY - currentY;
      target.style.cursor = 'grabbing';
      target.style.transition = 'none';
    }
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging && scale > 1) {
      e.preventDefault();
      hasDragged = true;
      const img = document.getElementById('lightbox-image') as HTMLImageElement;
      currentX = e.clientX - startX;
      currentY = e.clientY - startY;
      if (img) img.style.transform = `scale(${scale}) translate(${currentX / scale}px, ${currentY / scale}px)`;
    }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      const img = document.getElementById('lightbox-image') as HTMLImageElement;
      if (img) {
        img.style.cursor = scale > 1 ? 'grab' : 'default';
        img.style.transition = '';
      }
    }
  });

  // Suppress click after drag so the lightbox doesn't re-open and reset zoom
  document.addEventListener('click', (e) => {
    if (hasDragged) {
      hasDragged = false;
      e.stopImmediatePropagation();
    }
  }, true);

  // Mouse wheel zoom on image wrapper
  document.addEventListener('wheel', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#image-wrapper')) {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.1 : 0.1;
      scale = Math.max(1, Math.min(4, scale + delta));
      if (scale === 1) { currentX = 0; currentY = 0; }
      updateTransform();
    }
  }, { passive: false });

  // Escape key
  document.addEventListener('keydown', (e) => {
    const lb = document.getElementById('lightbox');
    if (e.key === 'Escape' && lb && !lb.classList.contains('invisible')) {
      closeLightbox();
    }
  });

  // Arrow keys step through the other lightbox-eligible images on the page
  // (wraps around at either end). Image-only -- a video has no "next" to
  // step to, so leave native video keyboard controls alone in that mode.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const lb = document.getElementById('lightbox');
    if (!lb || lb.classList.contains('invisible') || isVideoMode) return;
    if (galleryEntries.length <= 1) return;
    e.preventDefault();
    stepGallery(e.key === 'ArrowRight' ? 1 : -1);
  });

  // Trap Tab focus within the lightbox's visible controls while it's open
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const lb = document.getElementById('lightbox');
    if (!lb || lb.classList.contains('invisible')) return;

    const focusable = getFocusable();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Initialize image listeners
  initializeLightbox();
  document.addEventListener('astro:page-load', () => {
    initializeLightbox();
  });
</script>
