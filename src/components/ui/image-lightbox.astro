---
/**
 * Image Lightbox Component
 * 
 * Makes images clickable with zoom and pan functionality.
 * Automatically applies to all images with the 'lightbox' class.
 */
---

<!-- Lightbox Overlay -->
<div id="lightbox" class="fixed inset-0 bg-background/95 backdrop-blur-md z-[9999] opacity-0 invisible transition-all duration-200 ease-out flex items-center justify-center p-8">
  <div id="lightbox-container" class="relative max-w-7xl w-full h-full flex items-center justify-center">
    <!-- Close Button -->
    <button id="close-btn" class="absolute top-4 right-4 z-[10] w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 flex items-center justify-center cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    
    <!-- Zoom Controls (hidden for video) -->
    <div id="zoom-controls" class="absolute bottom-4 right-4 z-[10] flex gap-2">
      <button id="zoom-out" class="w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
      </button>
      <button id="zoom-reset" class="px-4 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 flex items-center justify-center cursor-pointer text-xs">
        Reset
      </button>
      <button id="zoom-in" class="w-10 h-10 rounded border border-foreground/20 bg-background/90 backdrop-blur-sm text-foreground/60 hover:text-white hover:bg-accent hover:border-accent transition-all duration-200 flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>
    
    <!-- Image Container -->
    <div id="image-wrapper" class="rounded-lg shadow-2xl w-[90vw] h-[85vh] flex items-center justify-center opacity-0 scale-90 transition-all duration-200 ease-out">
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="w-full h-full object-contain transition-transform duration-150 ease-out select-none"
        style="cursor: grab;"
        draggable="false"
        data-no-lightbox
      />
    </div>

    <!-- Video Container -->
    <div id="video-wrapper" class="rounded-lg bg-black border-2 border-foreground-secondary/10 shadow-2xl max-w-full max-h-[calc(100vh-6rem)] flex items-center justify-center opacity-0 scale-90 transition-all duration-200 ease-out hidden">
      <video
        id="lightbox-video"
        src=""
        class="max-w-full max-h-[calc(100vh-6rem)] object-contain rounded-lg"
        controls
        loop
        playsinline
      ></video>
    </div>
  </div>
</div>

<script>
  let scale = 1;
  let isDragging = false;
  let hasDragged = false;
  let startX = 0, startY = 0;
  let currentX = 0, currentY = 0;
  let isVideoMode = false;

  const updateTransform = () => {
    const img = document.getElementById('lightbox-image') as HTMLImageElement;
    if (img) {
      img.style.transform = `scale(${scale}) translate(${currentX / scale}px, ${currentY / scale}px)`;
      img.style.cursor = scale > 1 ? 'grab' : 'default';
    }
  };

  const resetZoom = () => {
    scale = 1;
    currentX = 0;
    currentY = 0;
    updateTransform();
  };

  const openLightbox = (src: string, alt: string) => {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-image') as HTMLImageElement;
    const iw = document.getElementById('image-wrapper');
    const vw = document.getElementById('video-wrapper');
    const zc = document.getElementById('zoom-controls');
    if (!lb || !img || !iw) return;

    isVideoMode = false;
    img.src = src;
    img.alt = alt;

    iw.classList.remove('hidden');
    vw?.classList.add('hidden');
    zc?.classList.remove('hidden');

    lb.classList.remove('invisible', 'opacity-0');
    lb.classList.add('visible', 'opacity-100');

    requestAnimationFrame(() => {
      iw.classList.remove('opacity-0', 'scale-90');
      iw.classList.add('opacity-100', 'scale-100');
    });

    document.body.style.overflow = 'hidden';
    resetZoom();
  };

  const openVideoLightbox = (src: string) => {
    const lb = document.getElementById('lightbox');
    const vid = document.getElementById('lightbox-video') as HTMLVideoElement;
    const vw = document.getElementById('video-wrapper');
    const iw = document.getElementById('image-wrapper');
    const zc = document.getElementById('zoom-controls');
    if (!lb || !vid || !vw) return;

    isVideoMode = true;
    vid.src = src;

    vw.classList.remove('hidden');
    iw?.classList.add('hidden');
    zc?.classList.add('hidden');

    lb.classList.remove('invisible', 'opacity-0');
    lb.classList.add('visible', 'opacity-100');

    requestAnimationFrame(() => {
      vw.classList.remove('opacity-0', 'scale-90');
      vw.classList.add('opacity-100', 'scale-100');
      vid.play();
    });

    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    const lb = document.getElementById('lightbox');
    const iw = document.getElementById('image-wrapper');
    const vw = document.getElementById('video-wrapper');
    const vid = document.getElementById('lightbox-video') as HTMLVideoElement;
    if (!lb) return;

    const activeWrapper = isVideoMode ? vw : iw;
    if (!activeWrapper) return;

    activeWrapper.classList.remove('opacity-100', 'scale-100');
    activeWrapper.classList.add('opacity-0', 'scale-90');

    if (isVideoMode && vid) {
      vid.pause();
      vid.src = '';
    }

    setTimeout(() => {
      lb.classList.remove('visible', 'opacity-100');
      lb.classList.add('invisible', 'opacity-0');
    }, 200);

    document.body.style.overflow = '';
    resetZoom();
  };

  // Add click listeners to all content images
  const initializeLightbox = () => {
    const lightboxImages = document.querySelectorAll('img:not(header img):not(nav img):not(footer img):not([data-no-lightbox])');
    lightboxImages.forEach((img) => {
      const imageElement = img as HTMLImageElement;
      imageElement.style.cursor = 'pointer';
      imageElement.classList.add('hover:scale-[1.02]', 'transition-transform', 'duration-300');
      imageElement.addEventListener('click', () => {
        // Prefer a full-resolution source so zooming stays crisp.
        const fullSrc = imageElement.dataset.full || imageElement.currentSrc || imageElement.src;
        openLightbox(fullSrc, imageElement.alt);
      });
    });
  };

  // --- Event listeners using delegation (no stale refs) ---

  // Video lightbox clicks (delegation)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('.video-lightbox-trigger[data-video]');
    if (trigger) {
      const videoSrc = (trigger as HTMLElement).dataset.video;
      if (videoSrc) openVideoLightbox(videoSrc);
    }
  });

  // Close button (delegation)
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#close-btn')) {
      closeLightbox();
    }
  });

  // Click outside content to close
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'lightbox') {
      closeLightbox();
    }
  });

  // Zoom controls (delegation)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#zoom-in')) {
      scale = Math.min(scale + 0.5, 4);
      updateTransform();
    } else if (target.closest('#zoom-out')) {
      scale = Math.max(scale - 0.5, 1);
      if (scale === 1) { currentX = 0; currentY = 0; }
      updateTransform();
    } else if (target.closest('#zoom-reset')) {
      resetZoom();
    }
  });

  // Drag to pan
  document.addEventListener('mousedown', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'lightbox-image' && scale > 1) {
      e.preventDefault();
      isDragging = true;
      hasDragged = false;
      startX = e.clientX - currentX;
      startY = e.clientY - currentY;
      target.style.cursor = 'grabbing';
      target.style.transition = 'none';
    }
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging && scale > 1) {
      e.preventDefault();
      hasDragged = true;
      const img = document.getElementById('lightbox-image') as HTMLImageElement;
      currentX = e.clientX - startX;
      currentY = e.clientY - startY;
      if (img) img.style.transform = `scale(${scale}) translate(${currentX / scale}px, ${currentY / scale}px)`;
    }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      const img = document.getElementById('lightbox-image') as HTMLImageElement;
      if (img) {
        img.style.cursor = scale > 1 ? 'grab' : 'default';
        img.style.transition = '';
      }
    }
  });

  // Suppress click after drag so the lightbox doesn't re-open and reset zoom
  document.addEventListener('click', (e) => {
    if (hasDragged) {
      hasDragged = false;
      e.stopImmediatePropagation();
    }
  }, true);

  // Mouse wheel zoom on image wrapper
  document.addEventListener('wheel', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#image-wrapper')) {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.1 : 0.1;
      scale = Math.max(1, Math.min(4, scale + delta));
      if (scale === 1) { currentX = 0; currentY = 0; }
      updateTransform();
    }
  }, { passive: false });

  // Escape key
  document.addEventListener('keydown', (e) => {
    const lb = document.getElementById('lightbox');
    if (e.key === 'Escape' && lb && !lb.classList.contains('invisible')) {
      closeLightbox();
    }
  });

  // Initialize image listeners
  initializeLightbox();
  document.addEventListener('astro:page-load', () => {
    initializeLightbox();
  });
</script>
