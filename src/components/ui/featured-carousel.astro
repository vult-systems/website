---
import Text from './text.astro';
import Link from './link.astro';
import Badge from './badge.astro';
import Card from './card.astro';
import type { ImageMetadata } from 'astro';

interface ArtPiece {
  slug: string;
  title: string;
  description: string;
  heroImage: string | ImageMetadata | undefined;
  category: string;
}

interface Props {
  title?: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
  artPieces: ArtPiece[];
  class?: string;
}

const { 
  title = "Featured Work",
  description = "A selection of recent projects spanning character art, product visualization, and real-time assets for games and interactive media.",
  linkText = "VIEW ALL WORK >",
  linkHref = "/art",
  artPieces,
  class: className = ''
} = Astro.props;

// Helper to get image src
const getImageSrc = (image: string | ImageMetadata | undefined): string => {
  if (!image) return '';
  if (typeof image === 'string') return image;
  return image.src;
};

// Limit to 5 pieces for the carousel
const carouselPieces = artPieces.slice(0, 5);
---

<section class:list={["relative z-10 py-16 sm:py-20 overflow-hidden", className]}>
  <div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
    
    <!-- Section Header (Experience section style) -->
    <div class="mb-10 sm:mb-12 text-left">
      {title && (
        <Text variant="primary" size="md" class="mb-0 !font-normal leading-tight">
          {title}
        </Text>
      )}
      {description && (
        <Text variant="secondary" size="md" class="mb-2 leading-tight !text-foreground-muted max-w-[50%]">
          {description}
        </Text>
      )}
      <Link variant="accent" href={linkHref}>
        {linkText}
      </Link>
    </div>
  </div>

  <!-- Carousel Container - Full width overflow -->
  <div class="carousel-container">
    <div class="carousel-track">
      <!-- First set of cards -->
      {carouselPieces.map((piece) => (
        <div class="carousel-item">
          <Card padding="none" interactive href={`/art/${piece.slug}`}>
            <!-- Image -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={getImageSrc(piece.heroImage)}
                alt={piece.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            
            <!-- Content -->
            <div class="p-6 space-y-3">
              <Text variant="primary" size="md" class="!font-medium">
                {piece.title}
              </Text>
              {piece.description && (
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  {piece.description}
                </Text>
              )}
              <!-- Category Badge -->
              <div>
                <Badge size="sm">
                  {piece.category}
                </Badge>
              </div>
            </div>
          </Card>
        </div>
      ))}
      <!-- Duplicate set for seamless loop -->
      {carouselPieces.map((piece) => (
        <div class="carousel-item">
          <Card padding="none" interactive href={`/art/${piece.slug}`}>
            <!-- Image -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={getImageSrc(piece.heroImage)}
                alt={piece.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            
            <!-- Content -->
            <div class="p-6 space-y-3">
              <Text variant="primary" size="md" class="!font-medium">
                {piece.title}
              </Text>
              {piece.description && (
                <Text size="sm" variant="secondary" class="line-clamp-2">
                  {piece.description}
                </Text>
              )}
              <!-- Category Badge -->
              <div>
                <Badge size="sm">
                  {piece.category}
                </Badge>
              </div>
            </div>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-container {
    width: 100%;
    overflow: hidden;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .carousel-container {
      padding: 0 2rem;
    }
  }

  @media (min-width: 768px) {
    .carousel-container {
      padding: 0 3rem;
    }
  }

  @media (min-width: 1024px) {
    .carousel-container {
      padding: 0 4rem;
    }
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    animation: scroll 120s linear infinite;
    width: max-content;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  .carousel-item {
    flex-shrink: 0;
    width: 440px;
  }

  @media (min-width: 640px) {
    .carousel-item {
      width: 520px;
    }
  }

  @media (min-width: 768px) {
    .carousel-item {
      width: 600px;
    }
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }
</style>
