---
import { Image } from 'astro:assets';
import Text from './text.astro';
import Link from './link.astro';
import { layout } from '@/config/design';
import Badge from './badge.astro';
import type { ImageMetadata } from 'astro';

interface ArtPiece {
  slug: string;
  title: string;
  description: string;
  heroImage: string | ImageMetadata | undefined;
  heroImageDark?: string | ImageMetadata;
  category: string;
}

interface Props {
  title?: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
  artPieces: ArtPiece[];
  class?: string;
}

const { 
  title = "Featured Work",
  description = "A selection of recent projects spanning character art, product visualization, and real-time assets for games and interactive media.",
  linkText = "VIEW ALL WORK >",
  linkHref = "/art",
  artPieces,
  class: className = ''
} = Astro.props;

// Helper to get image src
const getImageSrc = (image: string | ImageMetadata | undefined): string => {
  if (!image) return '';
  if (typeof image === 'string') return image;
  return image.src;
};

// Show all provided pieces in the carousel
const carouselPieces = artPieces;
---

<section class:list={["relative z-10 py-3 sm:py-4 overflow-hidden", className]}>
  {(title || description || linkText) && (
    <div class={layout.container}>
      <!-- Section Header (Experience section style) -->
      <div class="mb-10 sm:mb-12 text-left">
        {title && (
          <Text variant="primary" size="md" class="mb-0 !font-normal leading-tight">
            {title}
          </Text>
        )}
        {description && (
          <Text variant="secondary" size="md" class="mb-2 leading-tight !text-foreground-muted lg:max-w-[50%]">
            {description}
          </Text>
        )}
        <Link variant="accent" href={linkHref}>
          {linkText}
        </Link>
      </div>
    </div>
  )}

  <!-- Carousel Container - Full width overflow -->
  <div class="carousel-container" id="carouselContainer">
    <div class="carousel-track" id="carouselTrack">
      <!-- First set of cards -->
      {carouselPieces.map((piece) => (
        <a href={`/art/${piece.slug}`} class="carousel-item spotlight-card group relative block">
          <div class="spotlight-inner rounded-md overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
            <!-- Image -->
            <div class="relative aspect-square overflow-hidden">
              {typeof piece.heroImage === 'object' && piece.heroImage ? (
                <Image
                  src={piece.heroImage}
                  alt={piece.title}
                  width={1500}
                  height={1500}
                  format="webp"
                  quality={90}
                  fit="cover"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                />
              ) : (
                <img
                  src={getImageSrc(piece.heroImage)}
                  alt={piece.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                />
              )}
              {piece.heroImageDark && typeof piece.heroImageDark === 'object' && (
                <Image
                  src={piece.heroImageDark}
                  alt={piece.title}
                  width={1500}
                  height={1500}
                  format="webp"
                  quality={90}
                  fit="cover"
                  class="hidden dark:block absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="eager"
                  decoding="async"
                  draggable="false"
                />
              )}
            </div>
          </div>
        </a>
      ))}
      <!-- Duplicate set for seamless loop -->

      {carouselPieces.map((piece) => (
        <a href={`/art/${piece.slug}`} class="carousel-item spotlight-card group relative block">
          <div class="spotlight-inner rounded-md overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
            <!-- Image -->
            <div class="relative aspect-square overflow-hidden">
              {typeof piece.heroImage === 'object' && piece.heroImage ? (
                <Image
                  src={piece.heroImage}
                  alt={piece.title}
                  width={1500}
                  height={1500}
                  format="webp"
                  quality={90}
                  fit="cover"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="lazy"
                  draggable="false"
                />
              ) : (
                <img
                  src={getImageSrc(piece.heroImage)}
                  alt={piece.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="lazy"
                  draggable="false"
                />
              )}
              {piece.heroImageDark && typeof piece.heroImageDark === 'object' && (
                <Image
                  src={piece.heroImageDark}
                  alt={piece.title}
                  width={1500}
                  height={1500}
                  format="webp"
                  quality={90}
                  fit="cover"
                  class="hidden dark:block absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  data-no-lightbox
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-container {
    width: 100%;
    /* overflow-x: hidden paired with overflow-y: visible doesn't actually
       stay "visible" — per spec, browsers coerce it to auto whenever the
       other axis isn't visible too, which still clips (just with a
       scrollbar instead of a hard cut). So: plain overflow: hidden on both
       axes as before (still needed horizontally, to hide the looping
       duplicate set), but with vertical padding added as headroom for the
       hover-scale glow effect (group-hover:scale-[1.02]) to grow into
       without touching the clip boundary, offset by an equal negative
       margin so that headroom doesn't push the rest of the page down. */
    overflow: hidden;
    /* padding-top/bottom (headroom for the hover-scale glow, offset by the
       matching negative margin below) set separately from left/right so
       the responsive breakpoints changing horizontal padding, further
       down, never touch it — using the `padding` shorthand there would
       reset these back to 0 at each breakpoint. */
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-block: -20px;
    cursor: grab;
    user-select: none;
  }

  .carousel-container.dragging {
    cursor: grabbing;
  }

  @media (min-width: 640px) {
    .carousel-container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  @media (min-width: 768px) {
    .carousel-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .carousel-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .carousel-track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    will-change: transform;
  }

  .carousel-item {
    flex-shrink: 0;
    width: min(clamp(300px, 94vw, 560px), calc(100vh - 184px));
  }

  @media (min-width: 640px) {
    .carousel-item {
      width: min(clamp(460px, 88vw, 800px), calc(100vh - 184px));
    }
  }

  @media (min-width: 768px) {
    .carousel-item {
      width: min(clamp(560px, 80vw, 980px), calc(100vh - 184px));
    }
  }

  @media (min-width: 1024px) {
    .carousel-item {
      width: min(clamp(660px, 74vw, 1140px), calc(100vh - 184px));
    }
  }

  @media (min-width: 1920px) {
    .carousel-item {
      width: min(clamp(800px, 68vw, 1480px), calc(100vh - 184px));
    }
  }

</style>

<script>
  // mousemove/mouseup below are bound to window (a drag can carry the
  // pointer outside the container), which — unlike container itself —
  // survives every navigation. Without unbinding the previous run's pair
  // first, every homepage visit stacked another set of these permanently:
  // stale listeners from earlier visits kept firing on every mouse move
  // anywhere on the site, not just the homepage, for the rest of the
  // session.
  let currentMouseMove: ((e: MouseEvent) => void) | null = null;
  let currentMouseUp: (() => void) | null = null;
  // Same reasoning as above, for the tick() rAF loop: it was stored on the
  // container element itself (container.__carouselRaf), but the container
  // is a brand new element every navigation — a fresh element never has
  // that property set, so the cancellation check always no-ops against the
  // wrong (or no) previous loop. The truly previous loop, bound via closure
  // to the old (now-detached) container/track, just kept running forever,
  // one more requestAnimationFrame recursion added per homepage visit.
  let currentRafId: number | null = null;

  function initCarousel() {
    const container = document.getElementById('carouselContainer') as HTMLElement;
    const track = document.getElementById('carouselTrack') as HTMLElement;
    if (!container || !track) return;

    if (currentMouseMove) window.removeEventListener('mousemove', currentMouseMove);
    if (currentMouseUp) window.removeEventListener('mouseup', currentMouseUp);
    if (currentRafId !== null) cancelAnimationFrame(currentRafId);

    const AUTO_SPEED = 0.4;
    const FRICTION = 0.92;
    const MIN_VELOCITY = 0.05;
    // Perpetual auto-scroll is exactly the kind of motion prefers-reduced-motion
    // exists to suppress; user-initiated drag/momentum below is unaffected.
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let pos = 0;
    let isDragging = false;
    let hasDragged = false;
    let dragStartX = 0;
    let dragStartPos = 0;
    let velocity = 0;
    let isMomentum = false;
    let lastX = 0;
    let lastTime = 0;

    const halfWidth = () => track.scrollWidth / 2;

    const wrap = () => {
      const hw = halfWidth();
      if (hw <= 0) return;
      while (pos <= -hw) pos += hw;
      while (pos > 0) pos -= hw;
    };

    let rafId: number;
    const tick = () => {
      if (isDragging) {
        // position set directly by handlers
      } else if (isMomentum) {
        velocity *= FRICTION;
        pos += velocity;
        wrap();
        track.style.transform = `translateX(${pos}px)`;
        if (Math.abs(velocity) < MIN_VELOCITY) {
          isMomentum = false;
          velocity = 0;
        }
      } else if (!reducedMotionQuery.matches) {
        pos -= AUTO_SPEED;
        wrap();
        track.style.transform = `translateX(${pos}px)`;
      }
      rafId = requestAnimationFrame(tick);
      currentRafId = rafId;
    };

    // Start centered on the second card using layout offsets (not the live
    // transform) so re-inits are idempotent and don't jump. Which piece that
    // is comes from the order artPieces is passed in (see index.astro).
    const centerItems = track.querySelectorAll<HTMLElement>('.carousel-item');
    if (centerItems.length > 1) {
      const padLeft = parseFloat(getComputedStyle(container).paddingLeft) || 0;
      const item = centerItems[1];
      const target = container.clientWidth / 2 - padLeft - (item.offsetLeft + item.offsetWidth / 2);
      pos = target > 0 ? target - halfWidth() : target;
    }
    wrap();
    track.style.transform = `translateX(${pos}px)`;

    rafId = requestAnimationFrame(tick);
    currentRafId = rafId;

    container.addEventListener('dragstart', (e: DragEvent) => e.preventDefault());

    // ── Mouse ──
    const onMouseDown = (e: MouseEvent) => {
      isDragging = true;
      isMomentum = false;
      hasDragged = false;
      velocity = 0;
      dragStartX = e.clientX;
      dragStartPos = pos;
      lastX = e.clientX;
      lastTime = performance.now();
      container.classList.add('dragging');
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isDragging) return;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 4) hasDragged = true;
      pos = dragStartPos + delta;
      wrap();
      track.style.transform = `translateX(${pos}px)`;
      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 0) velocity = (e.clientX - lastX) / dt * 16;
      lastX = e.clientX;
      lastTime = now;
    };

    const onMouseUp = () => {
      if (!isDragging) return;
      isDragging = false;
      container.classList.remove('dragging');
      if (hasDragged) {
        isMomentum = Math.abs(velocity) > MIN_VELOCITY;
        const suppress = (ev: Event) => {
          ev.preventDefault();
          ev.stopPropagation();
          container.removeEventListener('click', suppress, true);
        };
        container.addEventListener('click', suppress, true);
      }
    };

    container.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);
    currentMouseMove = onMouseMove;
    currentMouseUp = onMouseUp;

    // ── Touch ──
    container.addEventListener('touchstart', (e: TouchEvent) => {
      isDragging = true;
      isMomentum = false;
      hasDragged = false;
      velocity = 0;
      dragStartX = e.touches[0].clientX;
      dragStartPos = pos;
      lastX = e.touches[0].clientX;
      lastTime = performance.now();
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging) return;
      const delta = e.touches[0].clientX - dragStartX;
      if (Math.abs(delta) > 4) hasDragged = true;
      pos = dragStartPos + delta;
      wrap();
      track.style.transform = `translateX(${pos}px)`;
      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 0) velocity = (e.touches[0].clientX - lastX) / dt * 16;
      lastX = e.touches[0].clientX;
      lastTime = now;
    }, { passive: true });

    container.addEventListener('touchend', () => {
      isDragging = false;
      isMomentum = Math.abs(velocity) > MIN_VELOCITY;
    });
  }

  // Run on first load and every subsequent View Transition navigation
  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>
