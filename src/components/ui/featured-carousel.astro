---
import { Image } from 'astro:assets';
import Text from './text.astro';
import Link from './link.astro';
import { layout } from '@/config/design';
import Badge from './badge.astro';
import Card from './card.astro';
import type { ImageMetadata } from 'astro';

interface ArtPiece {
  slug: string;
  title: string;
  description: string;
  heroImage: string | ImageMetadata | undefined;
  category: string;
}

interface Props {
  title?: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
  artPieces: ArtPiece[];
  class?: string;
}

const { 
  title = "Featured Work",
  description = "A selection of recent projects spanning character art, product visualization, and real-time assets for games and interactive media.",
  linkText = "VIEW ALL WORK >",
  linkHref = "/art",
  artPieces,
  class: className = ''
} = Astro.props;

// Helper to get image src
const getImageSrc = (image: string | ImageMetadata | undefined): string => {
  if (!image) return '';
  if (typeof image === 'string') return image;
  return image.src;
};

// Limit to 5 pieces for the carousel
const carouselPieces = artPieces.slice(0, 5);
---

<section class:list={["relative z-10 py-8 sm:py-10 overflow-hidden", className]}>
  {(title || description || linkText) && (
    <div class={layout.container}>
      <!-- Section Header (Experience section style) -->
      <div class="mb-10 sm:mb-12 text-left">
        {title && (
          <Text variant="primary" size="md" class="mb-0 !font-normal leading-tight">
            {title}
          </Text>
        )}
        {description && (
          <Text variant="secondary" size="md" class="mb-2 leading-tight !text-foreground-muted lg:max-w-[50%]">
            {description}
          </Text>
        )}
        <Link variant="accent" href={linkHref}>
          {linkText}
        </Link>
      </div>
    </div>
  )}

  <!-- Carousel Container - Full width overflow -->
  <div class="carousel-container" id="carouselContainer">
    <div class="carousel-track" id="carouselTrack">
      <!-- First set of cards -->
      {carouselPieces.map((piece) => (
        <div class="carousel-item">
          <Card padding="none" interactive href={`/art/${piece.slug}`}>
            <!-- Image -->
            <div class="relative aspect-square overflow-hidden">
              {typeof piece.heroImage === 'object' && piece.heroImage ? (
                <Image
                  src={piece.heroImage}
                  alt={piece.title}
                  width={600}
                  height={600}
                  format="webp"
                  quality={82}
                  fit="cover"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                />
              ) : (
                <img
                  src={getImageSrc(piece.heroImage)}
                  alt={piece.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                />
              )}
            </div>
            
            <!-- Content -->
            <div class="p-6 space-y-0">
              <Text variant="primary" size="lg" class="!font-medium mb-0 leading-tight">
                {piece.title}
              </Text>
              {piece.description && (
                <Text size="base" variant="secondary" class="line-clamp-1 leading-tight !text-foreground-muted">
                  {piece.description}
                </Text>
              )}
            </div>
          </Card>
        </div>
      ))}
      <!-- Duplicate set for seamless loop -->

      {carouselPieces.map((piece) => (
        <div class="carousel-item">
          <Card padding="none" interactive href={`/art/${piece.slug}`}>
            <!-- Image -->
            <div class="relative aspect-square overflow-hidden">
              {typeof piece.heroImage === 'object' && piece.heroImage ? (
                <Image
                  src={piece.heroImage}
                  alt={piece.title}
                  width={600}
                  height={600}
                  format="webp"
                  quality={82}
                  fit="cover"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  draggable="false"
                />
              ) : (
                <img
                  src={getImageSrc(piece.heroImage)}
                  alt={piece.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  draggable="false"
                />
              )}
            </div>
            
            <!-- Content -->
            <div class="p-6 space-y-3">
              <Text variant="primary" size="lg" class="!font-medium mb-0 leading-tight">
                {piece.title}
              </Text>
              {piece.description && (
                <Text size="base" variant="secondary" class="line-clamp-1 leading-tight !text-foreground-muted">
                  {piece.description}
                </Text>
              )}
            </div>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-container {
    width: 100%;
    overflow: hidden;
    padding: 0 1.5rem;
    cursor: grab;
    user-select: none;
  }

  .carousel-container.dragging {
    cursor: grabbing;
  }

  @media (min-width: 640px) {
    .carousel-container {
      padding: 0 2rem;
    }
  }

  @media (min-width: 768px) {
    .carousel-container {
      padding: 0 3rem;
    }
  }

  @media (min-width: 1024px) {
    .carousel-container {
      padding: 0 4rem;
    }
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    will-change: transform;
  }

  .carousel-item {
    flex-shrink: 0;
    width: clamp(280px, 88vw, 460px);
  }

  @media (min-width: 640px) {
    .carousel-item {
      width: clamp(420px, 78vw, 680px);
    }
  }

  @media (min-width: 768px) {
    .carousel-item {
      width: clamp(540px, 70vw, 820px);
    }
  }

  @media (min-width: 1024px) {
    .carousel-item {
      /*
       * min() ensures the card (which is square) never overflows vertically.
       * 220px = header (64) + section padding (40) + card text area (80) + buffer (36).
       * So image height = card width ≤ viewport height − 220px.
       */
      width: min(clamp(500px, 60vw, 960px), calc(100vh - 220px));
    }
  }

  @media (min-width: 1920px) {
    .carousel-item {
      width: min(clamp(600px, 52vw, 1100px), calc(100vh - 220px));
    }
  }

</style>

<script>
  function initCarousel() {
    const container = document.getElementById('carouselContainer') as HTMLElement;
    const track = document.getElementById('carouselTrack') as HTMLElement;
    if (!container || !track) return;

    // Kill any previous loop attached to this container
    const prevRaf = (container as any).__carouselRaf;
    if (prevRaf) cancelAnimationFrame(prevRaf);

    const AUTO_SPEED = 0.4;
    const FRICTION = 0.92;
    const MIN_VELOCITY = 0.05;

    // Start with Foundation Explorer (index 1) and Foundation Explorer Female (index 2)
    // centered by offsetting one card width + gap to the left
    const firstItem = track.querySelector('.carousel-item') as HTMLElement;
    const gapSize = parseInt(getComputedStyle(track).gap) || 24;
    let pos = firstItem ? -(firstItem.offsetWidth + gapSize) : 0;
    let isDragging = false;
    let hasDragged = false;
    let dragStartX = 0;
    let dragStartPos = 0;
    let velocity = 0;
    let isMomentum = false;
    let lastX = 0;
    let lastTime = 0;

    const halfWidth = () => track.scrollWidth / 2;

    const wrap = () => {
      const hw = halfWidth();
      if (hw <= 0) return;
      while (pos <= -hw) pos += hw;
      while (pos > 0) pos -= hw;
    };

    let rafId: number;
    const tick = () => {
      if (isDragging) {
        // position set directly by handlers
      } else if (isMomentum) {
        velocity *= FRICTION;
        pos += velocity;
        wrap();
        track.style.transform = `translateX(${pos}px)`;
        if (Math.abs(velocity) < MIN_VELOCITY) {
          isMomentum = false;
          velocity = 0;
        }
      } else {
        pos -= AUTO_SPEED;
        wrap();
        track.style.transform = `translateX(${pos}px)`;
      }
      rafId = requestAnimationFrame(tick);
      (container as any).__carouselRaf = rafId;
    };

    rafId = requestAnimationFrame(tick);
    (container as any).__carouselRaf = rafId;

    container.addEventListener('dragstart', (e: DragEvent) => e.preventDefault());

    // ── Mouse ──
    const onMouseDown = (e: MouseEvent) => {
      isDragging = true;
      isMomentum = false;
      hasDragged = false;
      velocity = 0;
      dragStartX = e.clientX;
      dragStartPos = pos;
      lastX = e.clientX;
      lastTime = performance.now();
      container.classList.add('dragging');
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isDragging) return;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 4) hasDragged = true;
      pos = dragStartPos + delta;
      wrap();
      track.style.transform = `translateX(${pos}px)`;
      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 0) velocity = (e.clientX - lastX) / dt * 16;
      lastX = e.clientX;
      lastTime = now;
    };

    const onMouseUp = () => {
      if (!isDragging) return;
      isDragging = false;
      container.classList.remove('dragging');
      if (hasDragged) {
        isMomentum = Math.abs(velocity) > MIN_VELOCITY;
        const suppress = (ev: Event) => {
          ev.preventDefault();
          ev.stopPropagation();
          container.removeEventListener('click', suppress, true);
        };
        container.addEventListener('click', suppress, true);
      }
    };

    container.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);

    // ── Touch ──
    container.addEventListener('touchstart', (e: TouchEvent) => {
      isDragging = true;
      isMomentum = false;
      hasDragged = false;
      velocity = 0;
      dragStartX = e.touches[0].clientX;
      dragStartPos = pos;
      lastX = e.touches[0].clientX;
      lastTime = performance.now();
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging) return;
      const delta = e.touches[0].clientX - dragStartX;
      if (Math.abs(delta) > 4) hasDragged = true;
      pos = dragStartPos + delta;
      wrap();
      track.style.transform = `translateX(${pos}px)`;
      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 0) velocity = (e.touches[0].clientX - lastX) / dt * 16;
      lastX = e.touches[0].clientX;
      lastTime = now;
    }, { passive: true });

    container.addEventListener('touchend', () => {
      isDragging = false;
      isMomentum = Math.abs(velocity) > MIN_VELOCITY;
    });
  }

  // Run on first load and every subsequent View Transition navigation
  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>
