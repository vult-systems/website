---
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile/profile.jpg';
import heroBg from '@/assets/mindflayer/MindFlayer_BG.png';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import { SITE } from '@/config/site';
import { layout } from '@/config/design';

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Define the rotating content for different pages
const rotatingContent = [
  {
    text: "Portfolio Works",
    icon: "🎨",
    link: "/art",
    linkText: "Art"
  },
  {
    text: "Creative Education",
    icon: "📚",
    link: "/learn",
    linkText: "Learn"
  },
  {
    text: "Rambling Thoughts",
    icon: "📝",
    link: "/log",
    linkText: "Log"
  }
];

const sectionClasses = [
  "relative z-10 py-20",
  className
].filter(Boolean).join(' ');
---

<section class={sectionClasses} id="animated-hero-section">
  <!-- Background Image -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <Image
      src={heroBg}
      alt=""
      class="w-full h-full object-cover object-center !opacity-60 dark:!opacity-[0.12]"
      loading="eager"
      widths={[800, 1200, 1920]}
    />
    <div class="absolute inset-0 bg-white/[0.82] dark:bg-black/[0.62]"></div>
  </div>
  <div class={layout.container}>
    <div class="grid items-center gap-12 lg:grid-cols-[1.5fr_1.1fr]">
      
      <!-- Left Column - Animated Text (hidden on mobile) -->
      <div class="hidden lg:flex flex-col items-start text-left order-1 -mt-12">
        <div class="mb-4">
          <Heading level={1} size="3xl" class="mb-0 text-foreground-muted !font-extralight leading-none text-fluid-3xl">
            This is my<br />workspace for
          </Heading>
        </div>
        <div class="relative mb-8 w-full" style="min-height: 10rem;">
          <div id="rotating-text" class="absolute inset-0">
            {rotatingContent.map((item, index) => (
              <div 
                class={`rotating-item ${index === 0 ? 'active' : ''}`}
                data-index={index}
              >
                <Heading level={2} size="5xl" class="text-foreground !font-extralight mb-4 text-fluid-5xl">
                  {item.text}
                </Heading>
                <Link
                  variant="accent"
                  href={item.link}
                >
                  {item.linkText}
                </Link>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Right Column - Profile Photo + Info -->
      <div class="flex flex-col order-1 lg:order-2">
        <div>
          <a href="/about" class="spotlight-card group relative block mb-6">
            <div class="spotlight-inner rounded-lg overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
              <Image
                src={profileImg}
                alt={SITE.author.name}
                width={1600}
                height={900}
                loading="eager"
                id="profile-image"
                data-no-lightbox
                class="w-full"
              />
            </div>
          </a>
        </div>
        
        <div class="text-left">
            <Text variant="primary" size="xl" class="mb-0 !font-normal text-left sm:text-justify leading-tight">
              Creating Art and Educational Content.
            </Text>

            <Text variant="secondary" size="xl" class="mb-2 text-left sm:text-justify leading-tight !text-foreground-secondary">
              I'm a 3D artist and educator based in San Antonio, Texas, working across real-time and offline productions while striving to create thoughtful and impactful creative instruction.
            </Text>

          <Link variant="accent" href="/about">
            About Me
          </Link>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rotating-item {
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    position: absolute;
    pointer-events: none;
    width: 100%;
  }

  .rotating-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .rotating-item.exiting {
    opacity: 0;
    transform: translateY(20px);
  }
</style>

<script>
  let heroInterval: ReturnType<typeof setInterval> | null = null;

  function initAnimatedHero() {
    // Clear any existing interval
    if (heroInterval) {
      clearInterval(heroInterval);
      heroInterval = null;
    }

    const rotatingTextContainer = document.getElementById('rotating-text');
    if (!rotatingTextContainer) return;

    const items = rotatingTextContainer.querySelectorAll('.rotating-item');
    let currentIndex = 0;
    const displayDuration = 4000;
    const transitionDuration = 400;

    // Reset to first item
    items.forEach((item, i) => {
      item.classList.remove('active', 'exiting');
      if (i === 0) item.classList.add('active');
    });

    function rotateContent() {
      const currentItem = items[currentIndex];
      currentItem.classList.add('exiting');

      setTimeout(() => {
        currentItem.classList.remove('active', 'exiting');
        currentIndex = (currentIndex + 1) % items.length;
        items[currentIndex].classList.add('active');
      }, transitionDuration);
    }

    heroInterval = setInterval(rotateContent, displayDuration);
  }

  document.addEventListener('astro:page-load', initAnimatedHero);
  document.addEventListener('astro:before-swap', () => {
    if (heroInterval) {
      clearInterval(heroInterval);
      heroInterval = null;
    }
  });
</script>
