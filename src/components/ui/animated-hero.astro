---
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile/profile.jpg';
import Heading from '@/components/ui/heading.astro';
import Text from '@/components/ui/text.astro';
import Link from '@/components/ui/link.astro';
import { SITE } from '@/config/site';

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Define the rotating content for different pages
const rotatingContent = [
  {
    text: "digital craftmanship",
    icon: "🎨",
    link: "/art",
    linkText: "ART"
  },
  {
    text: "studio practice",
    icon: "⚡",
    link: "/vult",
    linkText: "VULT"
  },
  {
    text: "creative education",
    icon: "📚",
    link: "/learn",
    linkText: "LEARN"
  },
  {
    text: "documenting process",
    icon: "📝",
    link: "/log",
    linkText: "LOG"
  }
];

const sectionClasses = [
  "relative z-10 py-20",
  className
].filter(Boolean).join(' ');
---

<section class={sectionClasses} id="animated-hero-section">
  <div class="max-w-[102rem] mx-auto px-6 sm:px-8 md:px-12 lg:px-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.5fr_1.1fr]">
      
      <!-- Left Column - Animated Text -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left order-2 lg:order-1 -mt-12">
        <div class="mb-0">
          <Heading level={1} size="4.5xl" class="mb-0 text-foreground-muted !font-extralight leading-none">
            This is my<br />workspace for
          </Heading>
        </div>
        <div class="relative mb-16 w-full" style="min-height: 6rem;">
          <div id="rotating-text" class="absolute inset-0">
            {rotatingContent.map((item, index) => (
              <div 
                class={`rotating-item ${index === 0 ? 'active' : ''}`}
                data-index={index}
              >
                <Heading level={2} size="4.5xl" class="text-foreground !font-extralight mb-6">
                  {item.text}
                </Heading>
                <div class="flex items-center gap-3 mb-6">
                  <span class="text-4xl" role="img" aria-label="icon">
                    {item.icon}
                  </span>
                </div>
                <Link
                  variant="accent"
                  href={item.link}
                >
                  {item.linkText} >
                </Link>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Right Column - Profile Photo + Info -->
      <div class="flex flex-col order-1 lg:order-2">
        <div>
          <Image
            src={profileImg}
            alt={SITE.author.name}
            width={1600}
            height={900}
            loading="eager"
            id="profile-image"
            class="w-full mb-6 rounded-lg"
          />
        </div>
        
        <div class="text-left">
            <Text variant="primary" size="md" class="mb-0 !font-normal text-justify leading-tight">
              Creating art, tools, and learning systems.
            </Text>

            <Text variant="secondary" size="md" class="mb-2 text-justify leading-tight !text-foreground-muted">
              I'm a 3D artist and educator based in San Antonio, working across digital media, pipeline development, and creative instruction. 
              I love creating and sharing what I learn along the way.
            </Text>

          <Link variant="accent" href="/about">
            ABOUT ME >
          </Link>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rotating-item {
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    position: absolute;
    pointer-events: none;
    width: 100%;
  }

  .rotating-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .rotating-item.exiting {
    opacity: 0;
    transform: translateY(20px);
  }
</style>

<script>
  // Text rotation logic
  const rotatingTextContainer = document.getElementById('rotating-text');
  
  if (rotatingTextContainer) {
    const items = rotatingTextContainer.querySelectorAll('.rotating-item');
    let currentIndex = 0;
    const displayDuration = 4000;
    const transitionDuration = 400;

    function rotateContent() {
      const currentItem = items[currentIndex];
      currentItem.classList.add('exiting');
      
      setTimeout(() => {
        currentItem.classList.remove('active', 'exiting');
        currentIndex = (currentIndex + 1) % items.length;
        items[currentIndex].classList.add('active');
      }, transitionDuration);
    }

    setInterval(rotateContent, displayDuration);
  }
</script>
