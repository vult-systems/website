---
import Card from './card.astro';

interface Props {
  class?: string;
  href?: string;
}

const { class: className, href } = Astro.props;
---

<div class={`row-span-1 ${className || ''}`}>
  <Card 
    padding="none" 
    interactive={!!href}
    href={href}
    class="h-full"
  >
    <slot />
  </Card>
</div>
