---
/**
 * Heading Component
 * 
 * Semantic heading element with size variants and semantic levels.
 * Automatically handles responsive sizing and consistent styling.
 * All styling comes from centralized design tokens in src/config/design.ts
 * 
 * @example
 * <Heading level={1} size="4xl">Page Title</Heading>
 * <Heading level={2} size="2xl">Section Title</Heading>
 * <Heading level={3}>Card Title</Heading>
 */

import { components, cn } from '@/config/design';

interface Props {
  /** Semantic heading level (h1-h6) for accessibility */
  level: 1 | 2 | 3 | 4 | 5 | 6;
  /** Visual size variant (independent of semantic level) */
  size?: 'sm' | 'base' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '4.5xl' | '5xl';
  /** Text alignment */
  align?: 'left' | 'center' | 'right';
  /** Additional CSS classes */
  class?: string;
}

const {
  level,
  size,
  align = 'left',
  class: className = ''
} = Astro.props;

// Default sizes based on semantic level
const defaultSizes = {
  1: '4xl',
  2: '3xl',
  3: 'xl',
  4: 'lg',
  5: 'base',
  6: 'sm'
} as const;

const visualSize = size || defaultSizes[level];

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right'
} as const;

const Tag = `h${level}` as any;

const classes = cn(
  components.heading.base,
  components.heading.sizes[visualSize],
  alignClasses[align],
  'text-foreground',
  'font-serif',
  className
);
---

<Tag class={classes}>
  <slot />
</Tag>
