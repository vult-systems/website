---
/**
 * Badge Component
 * 
 * Small label for tags, categories, and status indicators.
 * Uses semantic colors with variants for different contexts.
 * All styling comes from centralized design tokens in src/config/design.ts
 * 
 * @example
 * <Badge>Default</Badge>
 * <Badge variant="accent">Featured</Badge>
 * <Badge variant="outline" size="sm">Tag</Badge>
 */

import { components, cn } from '@/config/design';

interface Props {
  /** Visual style variant */
  variant?: 'default' | 'accent' | 'outline' | 'muted' | 'ghost';
  /** Badge size */
  size?: 'sm' | 'base';
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = 'default',
  size = 'base',
  class: className = ''
} = Astro.props;

const classes = cn(
  components.badge.base,
  components.badge.variants[variant],
  components.badge.sizes[size],
  className
);
---

<span class={classes}>
  <slot />
</span>
