---
/**
 * Lecture Presenter
 *
 * Turns any `.lecture-block` (a lecture body authored in Sanity) into a
 * fullscreen, keyboard-driven slide deck for teaching in class, plus a
 * clean print-to-PDF of the same content. Mount once per page.
 */
---

<div id="lecture-presenter" class="fixed inset-0 z-[9998] hidden bg-background text-foreground">
  <div class="absolute inset-0 flex flex-col">
    <!-- Top bar -->
    <div class="flex items-center justify-between gap-4 px-6 py-3 border-b border-foreground-secondary/10">
      <span id="lp-title" class="truncate text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;"></span>
      <button id="lp-exit" class="rounded-md border border-foreground/20 bg-background/90 px-3 h-9 text-xs text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" style="font-family: 'Besley', serif !important;">Exit&nbsp;(Esc)</button>
    </div>

    <!-- Slide stage -->
    <div id="lp-stage" class="relative flex-1 overflow-hidden flex items-center justify-center p-4 sm:p-6">
      <!-- 16:9 slide frame, centered / letterboxed like a slide deck -->
      <div id="lp-frame" class="relative overflow-hidden rounded-lg">
        <div id="lp-slide" class="absolute inset-0 overflow-auto"></div>
        <!-- Slide master: course code + name (top-right), project in accent, logo mark (bottom-left) -->
        <div id="lp-context" class="pointer-events-none absolute top-3 right-4 max-w-[72%] truncate text-[0.65rem] sm:text-xs uppercase tracking-[0.15em]" style="font-family: 'Besley', serif !important;">
          <span id="lp-ctx-course" class="text-foreground-secondary/45"></span><span id="lp-ctx-sep" class="text-foreground-secondary/30"> &middot; </span><span id="lp-ctx-project" class="text-accent/80"></span>
        </div>
        <div class="pointer-events-none absolute bottom-3 left-4 opacity-60">
          <svg width="26" height="23" viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M46.5 59L0 86L49 0L46.5 59Z" fill="#E22B25"/>
            <path d="M52 59L51.0004 1.99994L99.5002 86.5L52 59Z" fill="#2282DF"/>
            <path d="M50.5 61.5L99.3297 89.0673L1.90061 88.8194L50.5 61.5Z" fill="#F2C923"/>
          </svg>
        </div>
        <!-- Click zones (edges only, so video controls stay reachable) -->
        <button id="lp-zone-prev" class="absolute left-0 top-0 h-full w-1/5 cursor-w-resize opacity-0" aria-label="Previous slide"></button>
        <button id="lp-zone-next" class="absolute right-0 top-0 h-full w-2/5 cursor-e-resize opacity-0" aria-label="Next slide"></button>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-4 px-6 py-3 border-t border-foreground-secondary/10">
      <button id="lp-prev" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Previous slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <div class="flex-1 h-1 rounded bg-foreground/10 overflow-hidden">
        <div id="lp-progress" class="h-full bg-accent transition-[width] duration-200" style="width: 0%"></div>
      </div>
      <span id="lp-counter" class="text-xs tabular-nums text-foreground-secondary" style="font-family: 'Besley', serif !important;">1 / 1</span>
      <button id="lp-next" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Next slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* --- 16:9 slide frame, centered in the stage (letterboxed like PowerPoint) --- */
  #lecture-presenter #lp-stage { container-type: size; }
  #lecture-presenter #lp-frame {
    aspect-ratio: 16 / 9;
    width: min(100cqw, calc(100cqh * 16 / 9));
    max-height: 100cqh;
    border: 1px solid hsl(var(--foreground-secondary) / 0.12);
    background: hsl(var(--background));
  }

  /* --- Presenter slide layout & typography --- */
  #lecture-presenter #lp-slide {
    --lp-px: clamp(3.25rem, 6cqw, 6.5rem);
    --lp-py: clamp(2.25rem, 5.5cqh, 3.5rem);
    padding: var(--lp-py) var(--lp-px);
    display: flex;
    flex-direction: column;
    justify-content: safe center;
  }
  #lecture-presenter #lp-slide,
  #lecture-presenter #lp-slide * {
    font-family: 'Besley', ui-serif, Georgia, serif; /* beat the global monospace default */
  }
  #lecture-presenter #lp-slide .lp-deck {
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }
  /* Comfortable text measure; figures/images stay full width. */
  #lecture-presenter #lp-slide .lp-head,
  #lecture-presenter #lp-slide .lp-body > :is(p, ul, ol, blockquote, table) { max-width: 66rem; }
  #lecture-presenter #lp-slide .lp-head-center,
  #lecture-presenter #lp-slide .lp-body-center > :is(p, ul, ol, blockquote) { margin-inline: auto; }
  /* Thin, unobtrusive scrollbar so long slides don't clip the header */
  #lecture-presenter #lp-slide { scrollbar-width: thin; scrollbar-color: hsl(var(--foreground-secondary) / 0.3) transparent; }
  #lecture-presenter #lp-slide::-webkit-scrollbar { width: 8px; }
  #lecture-presenter #lp-slide::-webkit-scrollbar-thumb { background: hsl(var(--foreground-secondary) / 0.3); border-radius: 4px; }
  /* Title slide: centered */
  #lecture-presenter #lp-slide .lp-title-slide {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  /* Left-aligned section variant: same vertical centering, full-width divider */
  #lecture-presenter #lp-slide .lp-title-slide-left {
    align-items: stretch;
    text-align: left;
  }
  /* Slide header (Title + subtle divider) — uniform across every layout */
  #lecture-presenter #lp-slide .lp-head {
    margin-bottom: clamp(1.25rem, 2.5cqh, 2rem);
    padding-bottom: clamp(0.6rem, 1.2cqh, 1rem);
    border-bottom: 1px solid hsl(var(--foreground-secondary) / 0.18);
  }
  #lecture-presenter #lp-slide .lp-head-center { width: 100%; text-align: center; }
  #lecture-presenter #lp-slide .lp-title-main {
    line-height: 1.08;
    font-size: clamp(2.3rem, 4.8vw, 4.5rem);
    font-weight: 400;
  }
  #lecture-presenter #lp-slide .lp-title-sub {
    opacity: 0.65;
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    margin-top: 0.25rem;
  }
  /* Body */
  #lecture-presenter #lp-slide :is(h2, h3) { line-height: 1.15; }
  #lecture-presenter #lp-slide h2 { font-size: clamp(1.5rem, 3vw, 2.3rem); margin: 0.75rem 0 0.6rem; }
  #lecture-presenter #lp-slide h3 { font-size: clamp(1.2rem, 2.4vw, 1.75rem); margin: 0.6rem 0 0.4rem; }
  #lecture-presenter #lp-slide p,
  #lecture-presenter #lp-slide li { font-size: clamp(1rem, 1.7vw, 1.45rem); line-height: 1.5; }
  #lecture-presenter #lp-slide p { margin-block: 0.5em; }
  #lecture-presenter #lp-slide .lp-body blockquote {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    line-height: 1.4;
    font-style: italic;
    color: hsl(var(--foreground-secondary));
    border-inline-start: 3px solid hsl(var(--accent));
    padding-inline-start: clamp(1rem, 2cqw, 1.75rem);
    margin-block: 1rem;
  }
  #lecture-presenter #lp-slide .lp-body blockquote p { font-size: inherit; line-height: inherit; margin-block: 0.3em; }
  /* Restore list markers (Tailwind Preflight strips them) */
  #lecture-presenter #lp-slide .lp-body ul { list-style: disc outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body ol { list-style: decimal outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body li { display: list-item; margin-block: 0.4em; }
  #lecture-presenter #lp-slide .lp-body :is(ul, ol) :is(ul, ol) { margin-block: 0.2em; }
  #lecture-presenter #lp-slide .lp-body ol ol { list-style-type: disc; }
  #lecture-presenter #lp-slide img,
  #lecture-presenter #lp-slide video {
    max-height: 46cqh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    border-radius: 0.5rem;
  }
  /* 3D viewer: size the frame to the slide (cqh) so it never overflows like
     it would with vh. <model-viewer> itself always absolutely fills
     whatever size .model-viewer-frame computes to (see
     PortableTextModel.astro) — sizing here only ever targets the frame.
     padding-top is reset to 0 in every rule because the frame's own base
     styles size non-auto aspects via a padding-top percentage (width
     drives height); here it's the opposite (an explicit cqh height drives
     width via aspect-ratio on a plain div, which — unlike on <model-viewer>
     itself — resolves correctly), so any leftover padding would stack on
     top of the explicit height instead of being replaced by it. */
  #lecture-presenter #lp-slide .model-viewer-frame {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 58cqh;
    padding-top: 0;
    margin-inline: auto;
    border-radius: 0.5rem;
    /* Sit above the invisible prev/next click zones so it stays interactive. */
    position: relative;
    z-index: 5;
  }
  #lecture-presenter #lp-slide .model-viewer-frame[data-aspect='square'] {
    width: auto;
    height: 58cqh;
    padding-top: 0;
    aspect-ratio: 1 / 1;
  }
  #lecture-presenter #lp-slide .model-viewer-frame[data-aspect='portrait'] {
    width: auto;
    height: 66cqh;
    padding-top: 0;
    aspect-ratio: 3 / 4;
  }
  #lecture-presenter #lp-slide .model-viewer-frame[data-aspect='wide'] {
    width: 100%;
    height: auto;
    padding-top: 0;
    aspect-ratio: 16 / 9;
    max-height: 58cqh;
  }
  #lecture-presenter #lp-slide figure { margin-block: 1rem; text-align: center; }
  #lecture-presenter #lp-slide strong { font-weight: 700; }

  /* The wireframe toggle and camera cube are positioned relative to
     model-viewer itself (top: 10px), which in a full/bleed layout can sit
     flush with the top of the slide — right where #lp-context (top: 12px)
     runs. Push both down clear of it here rather than in the component,
     since only Present mode has that context bar to clip. */
  #lecture-presenter #lp-slide .mv-cube,
  #lecture-presenter #lp-slide .mv-wireframe-toggle,
  #lecture-presenter #lp-slide .mv-hdri-control {
    top: 40px;
  }

  /* Smooth entrances: text eases up in a gentle stagger, photos fade in. */
  @keyframes lp-rise-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  #lecture-presenter #lp-slide .lp-head,
  #lecture-presenter #lp-slide .lp-body > :is(h2, h3, h4, p, ul, ol, blockquote, table, .lp-head) {
    animation: lp-rise-in 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  #lecture-presenter #lp-slide .lp-head { animation-delay: 0.04s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(1) { animation-delay: 0.12s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(2) { animation-delay: 0.2s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(3) { animation-delay: 0.28s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(4) { animation-delay: 0.36s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(5) { animation-delay: 0.44s; }
  #lecture-presenter #lp-slide .lp-body > *:nth-child(n + 6) { animation-delay: 0.52s; }
  #lecture-presenter #lp-slide img { opacity: 0; transition: opacity 0.45s ease; }
  #lecture-presenter #lp-slide img.lp-loaded { opacity: 1; }
  /* 3D models settle their camera framing asynchronously (see model-ready
     in PortableTextModel.astro); hold them invisible until then so what
     fades in is already correctly framed, instead of visibly snapping
     into place after appearing. */
  #lecture-presenter #lp-slide .model-viewer-frame { opacity: 0; transition: opacity 0.45s ease; }
  #lecture-presenter #lp-slide .model-viewer-frame.lp-loaded { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    #lecture-presenter #lp-slide .lp-head,
    #lecture-presenter #lp-slide .lp-body > * { animation: none; }
    #lecture-presenter #lp-slide img { opacity: 1; transition: none; }
    #lecture-presenter #lp-slide .model-viewer-frame { opacity: 1; transition: none; }
  }

  /* Image alignment (figure[data-align]) */
  #lecture-presenter #lp-slide figure[data-align='left'] { margin-inline: 0 auto; max-width: 70%; }
  #lecture-presenter #lp-slide figure[data-align='right'] { margin-inline: auto 0; max-width: 70%; }
  #lecture-presenter #lp-slide figure[data-align='center'] { margin-inline: auto; }
  #lecture-presenter #lp-slide figure[data-align='full'] { max-width: none; }
  #lecture-presenter #lp-slide figure[data-align='full'] img,
  #lecture-presenter #lp-slide figure[data-align='full'] video { max-height: 70cqh; }
  #lecture-presenter #lp-slide figure[data-align='full'] .model-viewer-frame { width: 100%; height: 70cqh; padding-top: 0; }

  /* Bottom full-bleed: pin the image to the slide's bottom edge (e.g. character busts). */
  #lecture-presenter #lp-slide:has(figure[data-align='bottom']) { overflow: hidden; padding-bottom: 0; }
  #lecture-presenter #lp-slide .lp-deck:has(figure[data-align='bottom']) {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch; /* let the image fill width even in centered/section layouts */
  }
  #lecture-presenter #lp-slide .lp-deck:has(figure[data-align='bottom']) .lp-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }
  #lecture-presenter #lp-slide figure[data-align='bottom'] {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin: 0.75rem calc(-1 * var(--lp-px)) 0;
    width: calc(100% + 2 * var(--lp-px));
    max-width: none;
    overflow: hidden;
  }
  #lecture-presenter #lp-slide figure[data-align='bottom'] img {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    max-height: none;
    object-fit: cover;
    object-position: top center;
    border-radius: 0;
    display: block;
  }
  #lecture-presenter #lp-slide figure[data-align='bottom'] figcaption { display: none; }

  /* Layout presets */
  #lecture-presenter #lp-slide .lp-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3cqw, 3rem);
    align-items: center;
  }
  #lecture-presenter #lp-slide .lp-cols.image-right .lp-col-media { order: 2; }
  #lecture-presenter #lp-slide .lp-cols .lp-col-media figure { margin: 0; max-width: none; }
  #lecture-presenter #lp-slide .lp-cols .lp-col-media img,
  #lecture-presenter #lp-slide .lp-cols .lp-col-media video { max-height: 66cqh; }
  #lecture-presenter #lp-slide .lp-cols .lp-col-media .model-viewer-frame { width: 100%; height: 66cqh; padding-top: 0; }

  /* Full-bleed side image: the media runs edge-to-edge; text keeps its padding. */
  #lecture-presenter #lp-slide:has(.lp-cols.bleed) { padding: 0; overflow: hidden; }
  #lecture-presenter #lp-slide .lp-deck:has(.lp-cols.bleed) { height: 100%; min-height: 0; display: flex; }
  #lecture-presenter #lp-slide .lp-cols.bleed { flex: 1; min-height: 0; gap: 0; align-items: stretch; }
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media { min-height: 0; }
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media figure { margin: 0; width: 100%; height: 100%; }
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media img,
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media video {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media .model-viewer-frame {
    width: 100%;
    height: 100%;
    max-height: none;
    padding-top: 0;
    border-radius: 0;
    display: block;
  }
  #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-text {
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    min-height: 0;
    overflow-y: auto;
    padding-block: var(--lp-py);
    max-width: none;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--foreground-secondary) / 0.3) transparent;
  }
  #lecture-presenter #lp-slide .lp-cols.image-right.bleed .lp-col-text {
    padding-left: var(--lp-px);
    padding-right: clamp(1.5rem, 3cqw, 3rem);
  }
  #lecture-presenter #lp-slide .lp-cols.image-left.bleed .lp-col-text {
    padding-right: var(--lp-px);
    padding-left: clamp(1.5rem, 3cqw, 3rem);
  }

  /* Full-bleed background image with the text laid over it. */
  #lecture-presenter #lp-slide:has(.lp-bg-slide) { padding: 0; overflow: hidden; }
  #lecture-presenter #lp-slide .lp-bg-slide {
    position: relative;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--lp-py) var(--lp-px);
    overflow: hidden;
  }
  #lecture-presenter #lp-slide .lp-bg-media { position: absolute; inset: 0; z-index: 0; }
  #lecture-presenter #lp-slide .lp-bg-media figure { margin: 0; width: 100%; height: 100%; }
  #lecture-presenter #lp-slide .lp-bg-media img,
  #lecture-presenter #lp-slide .lp-bg-media video {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  #lecture-presenter #lp-slide .lp-bg-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--foreground-secondary) / 0.3) transparent;
  }
  /* Side-anchored background: image keeps its aspect (no zoom) and hugs that edge. */
  #lecture-presenter #lp-slide .lp-bg-slide.bg-right .lp-bg-media img,
  #lecture-presenter #lp-slide .lp-bg-slide.bg-right .lp-bg-media video {
    object-fit: contain;
    object-position: right center;
  }
  #lecture-presenter #lp-slide .lp-bg-slide.bg-left .lp-bg-media img,
  #lecture-presenter #lp-slide .lp-bg-slide.bg-left .lp-bg-media video {
    object-fit: contain;
    object-position: left center;
  }
  #lecture-presenter #lp-slide .lp-bg-slide.bg-left .lp-bg-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  #lecture-presenter #lp-slide .lp-two-col { column-count: 2; column-gap: clamp(1.75rem, 3cqw, 3rem); }
  #lecture-presenter #lp-slide .lp-two-col :is(h2, h3) { column-span: all; }
  #lecture-presenter #lp-slide .lp-body-center { text-align: center; }

  /* Small screens / heavy browser zoom-in: drop the fixed 16:9 frame and fall
     back to a simple scrollable stacked view so nothing collapses or overlaps. */
  @media (max-width: 720px), (max-height: 520px) {
    #lecture-presenter #lp-stage { display: block; padding: 0; overflow-y: auto; }
    #lecture-presenter #lp-frame {
      aspect-ratio: auto;
      width: 100%;
      height: auto;
      min-height: 100%;
      border: 0;
      border-radius: 0;
      overflow: visible;
    }
    #lecture-presenter #lp-slide {
      position: static;
      inset: auto;
      display: block;
      overflow: visible;
      min-height: 100%;
      padding: 1.5rem 1.25rem 2rem;
    }
    #lecture-presenter #lp-zone-prev,
    #lecture-presenter #lp-zone-next { display: none; }
    #lecture-presenter #lp-context {
      position: static;
      max-width: none;
      text-align: left;
      margin-bottom: 0.75rem;
    }
    /* Un-flex the deck/body so the bottom image gets a real box instead of collapsing */
    #lecture-presenter #lp-slide .lp-deck,
    #lecture-presenter #lp-slide .lp-deck:has(figure[data-align='bottom']),
    #lecture-presenter #lp-slide .lp-title-slide {
      display: block;
      min-height: 0;
    }
    /* Cover / title-only slide stays centered so it doesn't look blank */
    #lecture-presenter #lp-slide .lp-title-slide:not(:has(.lp-body)) {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: calc(100dvh - 8.5rem);
    }
    #lecture-presenter #lp-slide .lp-deck:has(figure[data-align='bottom']) .lp-body { display: block; }
    #lecture-presenter #lp-slide figure[data-align='bottom'] {
      flex: none;
      display: block;
      aspect-ratio: 16 / 10;
      width: 100%;
      margin: 1rem 0 0;
    }
    #lecture-presenter #lp-slide figure[data-align='bottom'] img { height: 100%; }
    /* Two-column and side-by-side collapse to one column */
    #lecture-presenter #lp-slide .lp-cols { grid-template-columns: 1fr; }
    #lecture-presenter #lp-slide .lp-two-col { column-count: 1; }
    /* Bleed side image stacks under the text with a fixed ratio */
    #lecture-presenter #lp-slide:has(.lp-cols.bleed) { padding: 1.5rem 1.25rem 2rem; overflow: visible; }
    #lecture-presenter #lp-slide .lp-deck:has(.lp-cols.bleed) { display: block; height: auto; min-height: 0; }
    #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-text {
      display: block;
      overflow: visible;
      padding: 1.25rem 0 0;
    }
    #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media { aspect-ratio: 16 / 10; min-height: 0; }
    #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media img,
    #lecture-presenter #lp-slide .lp-cols.bleed .lp-col-media video { height: 100%; }
    /* Background image keeps covering the slide with text over it */
    #lecture-presenter #lp-slide:has(.lp-bg-slide) { padding: 0; overflow: visible; }
    #lecture-presenter #lp-slide .lp-bg-slide {
      display: flex;
      height: auto;
      min-height: calc(100dvh - 7rem);
      padding: 1.5rem 1.25rem;
    }
    #lecture-presenter #lp-slide .lp-bg-media { position: absolute; }
    #lecture-presenter #lp-slide .lp-bg-content { max-height: none; overflow: visible; }
    /* Compact, fixed type */
    #lecture-presenter #lp-slide .lp-title-main { font-size: clamp(1.5rem, 6vw, 2.1rem); }
    #lecture-presenter #lp-slide .lp-title-sub { font-size: 1.05rem; }
    #lecture-presenter #lp-slide h2 { font-size: 1.5rem; }
    #lecture-presenter #lp-slide h3 { font-size: 1.25rem; }
    #lecture-presenter #lp-slide p,
    #lecture-presenter #lp-slide li { font-size: 1rem; }
    #lecture-presenter #lp-slide img,
    #lecture-presenter #lp-slide video { max-height: none; }
  }
</style>

<script>
  const initLecturePresenter = () => {
    if ((window as any).__lecturePresenterBound) return;
    (window as any).__lecturePresenterBound = true;

    const $ = (id: string) => document.getElementById(id);

    let slides: string[] = [];
    let index = 0;

    // Warm the browser cache with slide images so large photos are ready before
    // you reach them (they download in the background while you talk).
    const preloaded = new Set<string>();
    const preload = (src: string) => {
      if (!src || preloaded.has(src)) return;
      preloaded.add(src);
      const img = new Image();
      img.decoding = 'async';
      // Background warming must never outrank the image you're actually viewing.
      (img as any).fetchPriority = 'low';
      img.src = src;
    };
    const preloadSlide = (i: number) => {
      if (i < 0 || i >= slides.length) return;
      const tmp = document.createElement('div');
      tmp.innerHTML = slides[i];
      tmp.querySelectorAll('img').forEach((im) => preload(im.getAttribute('src') || ''));
    };
    // Reveal an image as soon as it's ready, with fallbacks so it can never stay hidden.
    const revealImage = (im: HTMLImageElement) => {
      const reveal = () => im.classList.add('lp-loaded');
      if (im.complete && im.naturalWidth > 0) { reveal(); return; }
      im.addEventListener('load', reveal, { once: true });
      im.addEventListener('error', reveal, { once: true });
      im.decode?.().then(reveal).catch(() => {});
      window.setTimeout(reveal, 4000);
    };
    // Same idea for 3D models: PortableTextModel.astro fires 'model-ready'
    // once it has finished loading *and* settled its camera framing, so
    // the reveal never shows the "auto"-framed pose right before it snaps
    // to the padded one.
    const revealModel = (mv: HTMLElement) => {
      const frame = mv.closest('.model-viewer-frame');
      if (!frame) return;
      const reveal = () => frame.classList.add('lp-loaded');
      mv.addEventListener('model-ready', reveal, { once: true });
      mv.addEventListener('error', reveal, { once: true });
      window.setTimeout(reveal, 4000);
    };

    const esc = (s: string) =>
      (s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    // Present shows images large; swap in the high-res `data-full` source so they stay sharp.
    const upgradeImages = (el: HTMLElement) => {
      const imgs = el.tagName === 'IMG' ? [el as HTMLImageElement] : Array.from(el.querySelectorAll('img'));
      imgs.forEach((img) => {
        const full = img.getAttribute('data-full');
        if (full) {
          img.setAttribute('src', full);
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
        }
        img.setAttribute('loading', 'eager');
      });
    };

    type Group = { title: string; subtitle: string; layout: string; nodes: HTMLElement[] };

    const headHtml = (title: string, subtitle: string, center: boolean) =>
      title || subtitle
        ? `<div class="lp-head${center ? ' lp-head-center' : ''}">` +
            (title ? `<h2 class="lp-title-main">${esc(title)}</h2>` : '') +
            (subtitle ? `<p class="lp-title-sub">${esc(subtitle)}</p>` : '') +
          `</div>`
        : '';

    const titleSlide = (title: string, subtitle: string) =>
      `<div class="lp-deck lp-title-slide">${headHtml(title || 'Lecture', subtitle, true)}</div>`;

    const contentSlide = (g: Group) => {
      const cloneHtml = (nodes: HTMLElement[]) => {
        const wrap = document.createElement('div');
        nodes.forEach((n) => wrap.appendChild(n.cloneNode(true)));
        upgradeImages(wrap);
        return wrap.innerHTML;
      };

      // Section: large title + divider, vertically centered. Centered or left.
      if (g.layout === 'section' || g.layout === 'section-left') {
        const centered = g.layout === 'section';
        const body = cloneHtml(g.nodes);
        return (
          `<div class="lp-deck lp-title-slide${centered ? '' : ' lp-title-slide-left'}">` +
            headHtml(g.title, g.subtitle, centered) +
            (body ? `<div class="lp-body${centered ? ' lp-body-center' : ''}">${body}</div>` : '') +
          `</div>`
        );
      }

      const head = headHtml(g.title, g.subtitle, false);

      // The first image/figure in the group is the "media".
      const media = g.nodes.find(
        (n) => n.tagName === 'FIGURE' || !!n.querySelector?.('img, video')
      );
      const mediaAlign = (() => {
        if (!media) return '';
        const fig = media.tagName === 'FIGURE' ? media : media.querySelector?.('figure');
        return fig?.getAttribute('data-align') || '';
      })();
      const bleed = mediaAlign === 'left-bleed' || mediaAlign === 'right-bleed';

      // Full-bleed background image with the slide text laid over it. `background`
      // fills the slide; the side variants hug one edge at their natural aspect.
      const bgPos =
        mediaAlign === 'background' ? ' ' :
        mediaAlign === 'background-right' ? ' bg-right' :
        mediaAlign === 'background-left' ? ' bg-left' : '';
      if (bgPos && media) {
        const rest = g.nodes.filter((n) => n !== media);
        const mediaEl = media.cloneNode(true) as HTMLElement;
        upgradeImages(mediaEl);
        return (
          `<div class="lp-deck lp-content-slide lp-bg-slide${bgPos.trimEnd()}">` +
            `<div class="lp-bg-media">${mediaEl.outerHTML}</div>` +
            `<div class="lp-bg-content">${head}<div class="lp-body">${cloneHtml(rest)}</div></div>` +
          `</div>`
        );
      }

      // A bleed-aligned image turns any slide into a side-by-side where the
      // image runs edge-to-edge; otherwise honor an explicit image layout.
      let colLayout = g.layout === 'image-left' || g.layout === 'image-right' ? g.layout : '';
      if (bleed && !colLayout) colLayout = mediaAlign === 'left-bleed' ? 'image-left' : 'image-right';

      // Image on one side, text on the other.
      if (colLayout && media) {
        const rest = g.nodes.filter((n) => n !== media);
        const mediaEl = media.cloneNode(true) as HTMLElement;
        upgradeImages(mediaEl);
        const bleedCls = bleed ? ' bleed' : '';
        // Bleed slides fill the frame, so the title sits inside the text column.
        const textInner = (bleed ? head : '') + cloneHtml(rest);
        return (
          `<div class="lp-deck lp-content-slide">${bleed ? '' : head}` +
            `<div class="lp-cols ${colLayout}${bleedCls}">` +
              `<div class="lp-col-media">${mediaEl.outerHTML}</div>` +
              `<div class="lp-col-text lp-body">${textInner}</div>` +
            `</div>` +
          `</div>`
        );
      }

      // Two-column body.
      if (g.layout === 'two-col') {
        return `<div class="lp-deck lp-content-slide">${head}<div class="lp-body lp-two-col">${cloneHtml(g.nodes)}</div></div>`;
      }

      // Default: title + divider + stacked body.
      return `<div class="lp-deck lp-content-slide">${head}<div class="lp-body">${cloneHtml(g.nodes)}</div></div>`;
    };

    const buildSlides = (body: HTMLElement, title: string, subtitle: string): string[] => {
      const out: string[] = [titleSlide(title, subtitle)];

      const children = Array.from(body.children) as HTMLElement[];
      // Author-controlled breaks take priority; otherwise auto-split by heading.
      const hasManualBreaks = children.some((n) => n.hasAttribute('data-slide-break'));

      const groups: Group[] = [];
      let cur: Group | null = null;
      const startGroup = (t: string, s: string, layout: string): Group => {
        const g: Group = { title: t || '', subtitle: s || '', layout: layout || 'default', nodes: [] };
        groups.push(g);
        cur = g;
        return g;
      };

      children.forEach((node) => {
        if (hasManualBreaks) {
          if (node.hasAttribute('data-slide-break')) {
            startGroup(
              node.dataset.slideTitle || '',
              node.dataset.slideSubtitle || '',
              node.dataset.slideLayout || 'default'
            );
            return; // the marker itself is not rendered
          }
        } else {
          const tag = node.tagName;
          if (tag === 'H1' || tag === 'H2' || tag === 'H3') {
            startGroup(node.textContent || '', '', 'default'); // heading becomes the slide title
            return; // exclude the heading from the body
          }
        }
        (cur ?? startGroup('', '', 'default')).nodes.push(node);
      });

      groups.forEach((g) => {
        // A leading heading serves as the slide title so authors can keep it
        // visible on the website without doubling it in Present: promote it when
        // no break title is set, or drop it when it just repeats the break title.
        const first = g.nodes[0] as HTMLElement | undefined;
        if (first && /^H[1-3]$/.test(first.tagName)) {
          const text = (first.textContent || '').trim();
          if (!g.title) {
            g.title = text;
            g.nodes = g.nodes.slice(1);
          } else if (text === g.title.trim()) {
            g.nodes = g.nodes.slice(1);
          }
        }
        if (!g.title && !g.subtitle && g.nodes.length === 0) return;
        out.push(contentSlide(g));
      });
      return out;
    };

    const render = () => {
      const slide = $('lp-slide');
      const total = slides.length;
      if (!slide || !total) return;
      index = Math.max(0, Math.min(index, total - 1));
      slide.innerHTML = slides[index];
      slide.scrollTop = 0;
      // Fade each image in as it decodes; already-cached images appear instantly.
      slide.querySelectorAll('img').forEach((el) => {
        const im = el as HTMLImageElement;
        im.setAttribute('fetchpriority', 'high');
        revealImage(im);
      });
      // Same fade-in treatment for embedded 3D models.
      slide.querySelectorAll('model-viewer').forEach((el) => revealModel(el as HTMLElement));
      // Warm only the immediate neighbours so we never flood the connection pool.
      preloadSlide(index + 1);
      preloadSlide(index + 2);
      preloadSlide(index - 1);
      const counter = $('lp-counter');
      if (counter) counter.textContent = `${index + 1} / ${total}`;
      const progress = $('lp-progress');
      if (progress) progress.style.width = `${((index + 1) / total) * 100}%`;
    };

    const go = (delta: number) => { index += delta; render(); };

    const open = (body: HTMLElement, title: string, subtitle: string, course: string, project: string) => {
      slides = buildSlides(body, title, subtitle);
      index = 0;
      const titleEl = $('lp-title');
      if (titleEl) titleEl.textContent = title;
      const courseEl = $('lp-ctx-course');
      if (courseEl) courseEl.textContent = course || '';
      const projectEl = $('lp-ctx-project');
      if (projectEl) projectEl.textContent = project || '';
      const sepEl = $('lp-ctx-sep');
      if (sepEl) sepEl.style.display = project ? '' : 'none';
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      render();
      p.requestFullscreen?.().catch(() => {});
    };

    const close = () => {
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.add('hidden');
      document.body.style.overflow = '';
      if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
    };

    const isOpen = () => {
      const p = $('lecture-presenter');
      return p && !p.classList.contains('hidden');
    };

    // --- Delegated triggers (survive View Transitions) ---
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const presentBtn = target.closest('.lecture-present-btn');
      if (presentBtn) {
        const block = presentBtn.closest('.lecture-block') as HTMLElement | null;
        const bodyEl = block?.querySelector('.lecture-body') as HTMLElement | null;
        if (block && bodyEl) {
          open(
            bodyEl,
            block.dataset.lectureTitle || document.title,
            block.dataset.lectureSubtitle || '',
            block.dataset.lectureContext || '',
            block.dataset.lectureContextAccent || ''
          );
        }
        return;
      }

      if (!isOpen()) return;
      if (target.closest('#lp-exit')) return close();
      if (target.closest('#lp-next') || target.closest('#lp-zone-next')) return go(1);
      if (target.closest('#lp-prev') || target.closest('#lp-zone-prev')) return go(-1);
    });

    // Fullscreen is the default; leaving it (Esc or otherwise) closes the presenter.
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && isOpen()) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      switch (e.key) {
        case 'ArrowRight':
        case 'PageDown':
        case ' ':
          e.preventDefault(); go(1); break;
        case 'ArrowLeft':
        case 'PageUp':
          e.preventDefault(); go(-1); break;
        case 'Home':
          e.preventDefault(); index = 0; render(); break;
        case 'End':
          e.preventDefault(); index = slides.length - 1; render(); break;
        case 'Escape':
          e.preventDefault(); close(); break;
      }
    });
  };

  initLecturePresenter();
  document.addEventListener('astro:page-load', initLecturePresenter);
</script>
