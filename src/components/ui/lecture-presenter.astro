---
/**
 * Lecture Presenter
 *
 * Turns any `.lecture-block` (a lecture body authored in Sanity) into a
 * fullscreen, keyboard-driven slide deck for teaching in class, plus a
 * clean print-to-PDF of the same content. Mount once per page.
 */
---

<div id="lecture-presenter" class="fixed inset-0 z-[9998] hidden bg-background text-foreground">
  <div class="absolute inset-0 flex flex-col">
    <!-- Top bar -->
    <div class="flex items-center justify-between gap-4 px-6 py-3 border-b border-foreground-secondary/10">
      <span id="lp-title" class="truncate text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;"></span>
      <div class="flex items-center gap-2">
        <button id="lp-fs" class="rounded-md border border-foreground/20 bg-background/90 px-3 h-9 text-xs text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" style="font-family: 'Besley', serif !important;">Fullscreen</button>
        <button id="lp-exit" class="rounded-md border border-foreground/20 bg-background/90 px-3 h-9 text-xs text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" style="font-family: 'Besley', serif !important;">Exit&nbsp;(Esc)</button>
      </div>
    </div>

    <!-- Slide stage -->
    <div id="lp-stage" class="relative flex-1 overflow-hidden flex items-center justify-center p-4 sm:p-6">
      <!-- 16:9 slide frame, centered / letterboxed like a slide deck -->
      <div id="lp-frame" class="relative overflow-hidden rounded-lg">
        <div id="lp-slide" class="absolute inset-0 overflow-auto"></div>
        <!-- Slide master: course code + name (top-right), project in accent, logo mark (bottom-left) -->
        <div id="lp-context" class="pointer-events-none absolute top-3 right-4 max-w-[72%] truncate text-[0.65rem] sm:text-xs uppercase tracking-[0.15em]" style="font-family: 'Besley', serif !important;">
          <span id="lp-ctx-course" class="text-foreground-secondary/45"></span><span id="lp-ctx-sep" class="text-foreground-secondary/30"> &middot; </span><span id="lp-ctx-project" class="text-accent/80"></span>
        </div>
        <div class="pointer-events-none absolute bottom-3 left-4 opacity-60">
          <svg width="26" height="23" viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M46.5 59L0 86L49 0L46.5 59Z" fill="#E22B25"/>
            <path d="M52 59L51.0004 1.99994L99.5002 86.5L52 59Z" fill="#2282DF"/>
            <path d="M50.5 61.5L99.3297 89.0673L1.90061 88.8194L50.5 61.5Z" fill="#F2C923"/>
          </svg>
        </div>
        <!-- Click zones (edges only, so video controls stay reachable) -->
        <button id="lp-zone-prev" class="absolute left-0 top-0 h-full w-1/5 cursor-w-resize opacity-0" aria-label="Previous slide"></button>
        <button id="lp-zone-next" class="absolute right-0 top-0 h-full w-2/5 cursor-e-resize opacity-0" aria-label="Next slide"></button>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-4 px-6 py-3 border-t border-foreground-secondary/10">
      <button id="lp-prev" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Previous slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <div class="flex-1 h-1 rounded bg-foreground/10 overflow-hidden">
        <div id="lp-progress" class="h-full bg-accent transition-[width] duration-200" style="width: 0%"></div>
      </div>
      <span id="lp-counter" class="text-xs tabular-nums text-foreground-secondary" style="font-family: 'Besley', serif !important;">1 / 1</span>
      <button id="lp-next" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Next slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* --- 16:9 slide frame, centered in the stage (letterboxed like PowerPoint) --- */
  #lecture-presenter #lp-stage { container-type: size; }
  #lecture-presenter #lp-frame {
    aspect-ratio: 16 / 9;
    width: min(100cqw, calc(100cqh * 16 / 9));
    max-height: 100cqh;
    border: 1px solid hsl(var(--foreground-secondary) / 0.12);
    background: hsl(var(--background));
  }

  /* --- Presenter slide layout & typography --- */
  #lecture-presenter #lp-slide {
    padding: clamp(2.25rem, 5.5cqh, 3.5rem) clamp(2.75rem, 5cqw, 5.5rem);
    display: flex;
    flex-direction: column;
    justify-content: safe center;
  }
  #lecture-presenter #lp-slide,
  #lecture-presenter #lp-slide * {
    font-family: 'Besley', ui-serif, Georgia, serif; /* beat the global monospace default */
  }
  #lecture-presenter #lp-slide .lp-deck {
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }
  /* Thin, unobtrusive scrollbar so long slides don't clip the header */
  #lecture-presenter #lp-slide { scrollbar-width: thin; scrollbar-color: hsl(var(--foreground-secondary) / 0.3) transparent; }
  #lecture-presenter #lp-slide::-webkit-scrollbar { width: 8px; }
  #lecture-presenter #lp-slide::-webkit-scrollbar-thumb { background: hsl(var(--foreground-secondary) / 0.3); border-radius: 4px; }
  /* Title slide: centered */
  #lecture-presenter #lp-slide .lp-title-slide {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  /* Slide header (Title + subtle divider) — uniform across every layout */
  #lecture-presenter #lp-slide .lp-head {
    margin-bottom: clamp(1.25rem, 2.5cqh, 2rem);
    padding-bottom: clamp(0.6rem, 1.2cqh, 1rem);
    border-bottom: 1px solid hsl(var(--foreground-secondary) / 0.18);
  }
  #lecture-presenter #lp-slide .lp-head-center { width: 100%; text-align: center; }
  #lecture-presenter #lp-slide .lp-title-main {
    line-height: 1.08;
    font-size: clamp(2.3rem, 4.8vw, 4.5rem);
    font-weight: 400;
  }
  #lecture-presenter #lp-slide .lp-title-sub {
    opacity: 0.65;
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    margin-top: 0.25rem;
  }
  /* Body */
  #lecture-presenter #lp-slide :is(h2, h3) { line-height: 1.15; }
  #lecture-presenter #lp-slide h2 { font-size: clamp(1.5rem, 3vw, 2.3rem); margin: 0.75rem 0 0.6rem; }
  #lecture-presenter #lp-slide h3 { font-size: clamp(1.2rem, 2.4vw, 1.75rem); margin: 0.6rem 0 0.4rem; }
  #lecture-presenter #lp-slide p,
  #lecture-presenter #lp-slide li { font-size: clamp(1rem, 1.7vw, 1.45rem); line-height: 1.5; }
  #lecture-presenter #lp-slide p { margin-block: 0.5em; }
  /* Restore list markers (Tailwind Preflight strips them) */
  #lecture-presenter #lp-slide .lp-body ul { list-style: disc outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body ol { list-style: decimal outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body li { display: list-item; margin-block: 0.4em; }
  #lecture-presenter #lp-slide .lp-body :is(ul, ol) :is(ul, ol) { margin-block: 0.2em; }
  #lecture-presenter #lp-slide img,
  #lecture-presenter #lp-slide video {
    max-height: 46cqh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    border-radius: 0.5rem;
  }
  #lecture-presenter #lp-slide figure { margin-block: 1rem; text-align: center; }
  #lecture-presenter #lp-slide strong { font-weight: 700; }

  /* Image alignment (figure[data-align]) */
  #lecture-presenter #lp-slide figure[data-align='left'] { margin-inline: 0 auto; max-width: 70%; }
  #lecture-presenter #lp-slide figure[data-align='right'] { margin-inline: auto 0; max-width: 70%; }
  #lecture-presenter #lp-slide figure[data-align='center'] { margin-inline: auto; }
  #lecture-presenter #lp-slide figure[data-align='full'] { max-width: none; }
  #lecture-presenter #lp-slide figure[data-align='full'] img,
  #lecture-presenter #lp-slide figure[data-align='full'] video { max-height: 70cqh; }

  /* Layout presets */
  #lecture-presenter #lp-slide .lp-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3cqw, 3rem);
    align-items: center;
  }
  #lecture-presenter #lp-slide .lp-cols.image-right .lp-col-media { order: 2; }
  #lecture-presenter #lp-slide .lp-cols .lp-col-media figure { margin: 0; max-width: none; }
  #lecture-presenter #lp-slide .lp-cols .lp-col-media img,
  #lecture-presenter #lp-slide .lp-cols .lp-col-media video { max-height: 66cqh; }
  #lecture-presenter #lp-slide .lp-two-col { column-count: 2; column-gap: clamp(1.75rem, 3cqw, 3rem); }
  #lecture-presenter #lp-slide .lp-two-col :is(h2, h3) { column-span: all; }
  #lecture-presenter #lp-slide .lp-body-center { text-align: center; }
</style>

<script>
  const initLecturePresenter = () => {
    if ((window as any).__lecturePresenterBound) return;
    (window as any).__lecturePresenterBound = true;

    const $ = (id: string) => document.getElementById(id);

    let slides: string[] = [];
    let index = 0;

    const esc = (s: string) =>
      (s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    type Group = { title: string; subtitle: string; layout: string; nodes: HTMLElement[] };

    const headHtml = (title: string, subtitle: string, center: boolean) =>
      title || subtitle
        ? `<div class="lp-head${center ? ' lp-head-center' : ''}">` +
            (title ? `<h2 class="lp-title-main">${esc(title)}</h2>` : '') +
            (subtitle ? `<p class="lp-title-sub">${esc(subtitle)}</p>` : '') +
          `</div>`
        : '';

    const titleSlide = (title: string, subtitle: string) =>
      `<div class="lp-deck lp-title-slide">${headHtml(title || 'Lecture', subtitle, true)}</div>`;

    const contentSlide = (g: Group) => {
      const cloneHtml = (nodes: HTMLElement[]) => {
        const wrap = document.createElement('div');
        nodes.forEach((n) => wrap.appendChild(n.cloneNode(true)));
        return wrap.innerHTML;
      };

      // Section: same title + divider, centered, with optional centered body.
      if (g.layout === 'section') {
        const body = cloneHtml(g.nodes);
        return (
          `<div class="lp-deck lp-title-slide">${headHtml(g.title, g.subtitle, true)}` +
          (body ? `<div class="lp-body lp-body-center">${body}</div>` : '') +
          `</div>`
        );
      }

      const head = headHtml(g.title, g.subtitle, false);

      // Image on one side, text on the other.
      if (g.layout === 'image-left' || g.layout === 'image-right') {
        const media = g.nodes.find(
          (n) => n.tagName === 'FIGURE' || !!n.querySelector?.('img, video')
        );
        const rest = g.nodes.filter((n) => n !== media);
        const mediaHtml = media ? (media.cloneNode(true) as HTMLElement).outerHTML : '';
        return (
          `<div class="lp-deck lp-content-slide">${head}` +
            `<div class="lp-cols ${g.layout}">` +
              `<div class="lp-col-media">${mediaHtml}</div>` +
              `<div class="lp-col-text lp-body">${cloneHtml(rest)}</div>` +
            `</div>` +
          `</div>`
        );
      }

      // Two-column body.
      if (g.layout === 'two-col') {
        return `<div class="lp-deck lp-content-slide">${head}<div class="lp-body lp-two-col">${cloneHtml(g.nodes)}</div></div>`;
      }

      // Default: title + divider + stacked body.
      return `<div class="lp-deck lp-content-slide">${head}<div class="lp-body">${cloneHtml(g.nodes)}</div></div>`;
    };

    const buildSlides = (body: HTMLElement, title: string, subtitle: string): string[] => {
      const out: string[] = [titleSlide(title, subtitle)];

      const children = Array.from(body.children) as HTMLElement[];
      // Author-controlled breaks take priority; otherwise auto-split by heading.
      const hasManualBreaks = children.some((n) => n.hasAttribute('data-slide-break'));

      const groups: Group[] = [];
      let cur: Group | null = null;
      const startGroup = (t: string, s: string, layout: string): Group => {
        const g: Group = { title: t || '', subtitle: s || '', layout: layout || 'default', nodes: [] };
        groups.push(g);
        cur = g;
        return g;
      };

      children.forEach((node) => {
        if (hasManualBreaks) {
          if (node.hasAttribute('data-slide-break')) {
            startGroup(
              node.dataset.slideTitle || '',
              node.dataset.slideSubtitle || '',
              node.dataset.slideLayout || 'default'
            );
            return; // the marker itself is not rendered
          }
        } else {
          const tag = node.tagName;
          if (tag === 'H1' || tag === 'H2' || tag === 'H3') {
            startGroup(node.textContent || '', '', 'default'); // heading becomes the slide title
            return; // exclude the heading from the body
          }
        }
        (cur ?? startGroup('', '', 'default')).nodes.push(node);
      });

      groups.forEach((g) => {
        // A leading heading serves as the slide title so authors can keep it
        // visible on the website without doubling it in Present: promote it when
        // no break title is set, or drop it when it just repeats the break title.
        const first = g.nodes[0] as HTMLElement | undefined;
        if (first && /^H[1-3]$/.test(first.tagName)) {
          const text = (first.textContent || '').trim();
          if (!g.title) {
            g.title = text;
            g.nodes = g.nodes.slice(1);
          } else if (text === g.title.trim()) {
            g.nodes = g.nodes.slice(1);
          }
        }
        if (!g.title && !g.subtitle && g.nodes.length === 0) return;
        out.push(contentSlide(g));
      });
      return out;
    };

    const render = () => {
      const slide = $('lp-slide');
      const total = slides.length;
      if (!slide || !total) return;
      index = Math.max(0, Math.min(index, total - 1));
      slide.innerHTML = slides[index];
      slide.scrollTop = 0;
      const counter = $('lp-counter');
      if (counter) counter.textContent = `${index + 1} / ${total}`;
      const progress = $('lp-progress');
      if (progress) progress.style.width = `${((index + 1) / total) * 100}%`;
    };

    const go = (delta: number) => { index += delta; render(); };

    const open = (body: HTMLElement, title: string, subtitle: string, course: string, project: string) => {
      slides = buildSlides(body, title, subtitle);
      index = 0;
      const titleEl = $('lp-title');
      if (titleEl) titleEl.textContent = title;
      const courseEl = $('lp-ctx-course');
      if (courseEl) courseEl.textContent = course || '';
      const projectEl = $('lp-ctx-project');
      if (projectEl) projectEl.textContent = project || '';
      const sepEl = $('lp-ctx-sep');
      if (sepEl) sepEl.style.display = project ? '' : 'none';
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      render();
      p.requestFullscreen?.().catch(() => {});
    };

    const close = () => {
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.add('hidden');
      document.body.style.overflow = '';
      if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
    };

    const isOpen = () => {
      const p = $('lecture-presenter');
      return p && !p.classList.contains('hidden');
    };

    // --- Delegated triggers (survive View Transitions) ---
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const presentBtn = target.closest('.lecture-present-btn');
      if (presentBtn) {
        const block = presentBtn.closest('.lecture-block') as HTMLElement | null;
        const bodyEl = block?.querySelector('.lecture-body') as HTMLElement | null;
        if (block && bodyEl) {
          open(
            bodyEl,
            block.dataset.lectureTitle || document.title,
            block.dataset.lectureSubtitle || '',
            block.dataset.lectureContext || '',
            block.dataset.lectureContextAccent || ''
          );
        }
        return;
      }

      if (!isOpen()) return;
      if (target.closest('#lp-exit')) return close();
      if (target.closest('#lp-next') || target.closest('#lp-zone-next')) return go(1);
      if (target.closest('#lp-prev') || target.closest('#lp-zone-prev')) return go(-1);
      if (target.closest('#lp-fs')) {
        const p = $('lecture-presenter');
        if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
        else p?.requestFullscreen?.().catch(() => {});
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      switch (e.key) {
        case 'ArrowRight':
        case 'PageDown':
        case ' ':
          e.preventDefault(); go(1); break;
        case 'ArrowLeft':
        case 'PageUp':
          e.preventDefault(); go(-1); break;
        case 'Home':
          e.preventDefault(); index = 0; render(); break;
        case 'End':
          e.preventDefault(); index = slides.length - 1; render(); break;
        case 'Escape':
          e.preventDefault(); close(); break;
        case 'f':
        case 'F':
          e.preventDefault();
          if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
          else $('lecture-presenter')?.requestFullscreen?.().catch(() => {});
          break;
      }
    });
  };

  initLecturePresenter();
  document.addEventListener('astro:page-load', initLecturePresenter);
</script>
