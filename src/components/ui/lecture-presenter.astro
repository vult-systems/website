---
/**
 * Lecture Presenter
 *
 * Turns any `.lecture-block` (a lecture body authored in Sanity) into a
 * fullscreen, keyboard-driven slide deck for teaching in class, plus a
 * clean print-to-PDF of the same content. Mount once per page.
 */
import vultLogoWht from '@/assets/logos/vult-logo-wht.png';
import vultLogoBlk from '@/assets/logos/vult-logo-blk.png';
---

<div id="lecture-presenter" class="fixed inset-0 z-[9998] hidden bg-background text-foreground">
  <div class="absolute inset-0 flex flex-col">
    <!-- Top bar -->
    <div class="flex items-center justify-between gap-4 px-6 py-3 border-b border-foreground-secondary/10">
      <span id="lp-title" class="truncate text-sm text-foreground-secondary" style="font-family: 'Besley', serif !important;"></span>
      <div class="flex items-center gap-2">
        <button id="lp-fs" class="rounded-md border border-foreground/20 bg-background/90 px-3 h-9 text-xs text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" style="font-family: 'Besley', serif !important;">Fullscreen</button>
        <button id="lp-exit" class="rounded-md border border-foreground/20 bg-background/90 px-3 h-9 text-xs text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" style="font-family: 'Besley', serif !important;">Exit&nbsp;(Esc)</button>
      </div>
    </div>

    <!-- Slide stage -->
    <div class="relative flex-1 overflow-hidden">
      <div id="lp-slide" class="absolute inset-0 overflow-auto px-6 sm:px-12 lg:px-24 pt-14 pb-16 flex flex-col"></div>
      <!-- Slide master: class/project (top-right) + Vult mark (bottom-left) -->
      <div id="lp-context" class="pointer-events-none absolute top-4 right-6 max-w-[55%] truncate text-xs sm:text-sm uppercase tracking-widest text-foreground-secondary" style="font-family: 'Besley', serif !important;"></div>
      <div class="pointer-events-none absolute bottom-4 left-6 flex items-center opacity-70">
        <img src={vultLogoBlk.src} alt="Vult" class="h-5 w-auto dark:hidden" data-no-lightbox />
        <img src={vultLogoWht.src} alt="Vult" class="hidden h-5 w-auto dark:block" data-no-lightbox />
      </div>
      <!-- Click zones for prev/next (edges only, so video controls stay reachable) -->
      <button id="lp-zone-prev" class="absolute left-0 top-14 bottom-16 w-1/5 cursor-w-resize opacity-0" aria-label="Previous slide"></button>
      <button id="lp-zone-next" class="absolute right-0 top-14 bottom-16 w-2/5 cursor-e-resize opacity-0" aria-label="Next slide"></button>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-4 px-6 py-3 border-t border-foreground-secondary/10">
      <button id="lp-prev" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Previous slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <div class="flex-1 h-1 rounded bg-foreground/10 overflow-hidden">
        <div id="lp-progress" class="h-full bg-accent transition-[width] duration-200" style="width: 0%"></div>
      </div>
      <span id="lp-counter" class="text-xs tabular-nums text-foreground-secondary" style="font-family: 'Besley', serif !important;">1 / 1</span>
      <button id="lp-next" class="rounded-md border border-foreground/20 bg-background/90 w-9 h-9 flex items-center justify-center text-foreground/70 hover:text-white hover:bg-accent hover:border-accent transition-colors" aria-label="Next slide">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* --- Presenter slide layout & typography --- */
  #lecture-presenter #lp-slide,
  #lecture-presenter #lp-slide * {
    font-family: 'Besley', ui-serif, Georgia, serif; /* beat the global monospace default */
  }
  #lecture-presenter #lp-slide .lp-deck {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }
  /* Title slide: centered */
  #lecture-presenter #lp-slide .lp-title-slide {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  /* Slide header (Title + optional subtitle) */
  #lecture-presenter #lp-slide .lp-head {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(var(--foreground-secondary) / 0.15);
  }
  #lecture-presenter #lp-slide .lp-title-main {
    line-height: 1.1;
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    font-weight: 400;
  }
  #lecture-presenter #lp-slide .lp-title-slide .lp-title-main {
    font-size: clamp(2.5rem, 6vw, 5rem);
  }
  #lecture-presenter #lp-slide .lp-title-sub {
    opacity: 0.7;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
  }
  /* Body */
  #lecture-presenter #lp-slide :is(h2, h3) { line-height: 1.15; }
  #lecture-presenter #lp-slide h2 { font-size: clamp(1.6rem, 3.4vw, 2.6rem); margin: 1rem 0 0.75rem; }
  #lecture-presenter #lp-slide h3 { font-size: clamp(1.3rem, 2.6vw, 2rem); margin: 0.75rem 0 0.5rem; }
  #lecture-presenter #lp-slide p,
  #lecture-presenter #lp-slide li { font-size: clamp(1.05rem, 1.9vw, 1.65rem); line-height: 1.55; }
  #lecture-presenter #lp-slide p { margin-block: 0.6em; }
  /* Restore list markers (Tailwind Preflight strips them) */
  #lecture-presenter #lp-slide .lp-body ul { list-style: disc outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body ol { list-style: decimal outside; padding-left: 1.5em; margin-block: 0.6em; }
  #lecture-presenter #lp-slide .lp-body li { display: list-item; margin-block: 0.4em; }
  #lecture-presenter #lp-slide .lp-body :is(ul, ol) :is(ul, ol) { margin-block: 0.2em; }
  #lecture-presenter #lp-slide img,
  #lecture-presenter #lp-slide video {
    max-height: 58vh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    border-radius: 0.5rem;
  }
  #lecture-presenter #lp-slide figure { margin-block: 1rem; text-align: center; }
  #lecture-presenter #lp-slide strong { font-weight: 700; }

  /* --- Print to PDF: show only the active lecture --- */
  @media print {
    body.printing-lecture #lecture-presenter,
    body.printing-lecture .lecture-actions { display: none !important; }
    body.printing-lecture * { visibility: hidden !important; }
    body.printing-lecture .print-target,
    body.printing-lecture .print-target * { visibility: visible !important; }
    body.printing-lecture .print-target {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      color: #111 !important;
      background: #fff !important;
    }
    body.printing-lecture .print-target :is(h1, h2, h3, h4, p, li, span, td, th, figcaption) {
      color: #111 !important;
    }
    body.printing-lecture .print-target img { break-inside: avoid; }
  }
</style>

<script>
  const initLecturePresenter = () => {
    if ((window as any).__lecturePresenterBound) return;
    (window as any).__lecturePresenterBound = true;

    const $ = (id: string) => document.getElementById(id);

    let slides: string[] = [];
    let index = 0;

    const esc = (s: string) =>
      (s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    type Group = { title: string; subtitle: string; nodes: HTMLElement[] };

    const titleSlide = (title: string, subtitle: string) =>
      `<div class="lp-deck lp-title-slide">` +
        `<h1 class="lp-title-main">${esc(title || 'Lecture')}</h1>` +
        (subtitle ? `<p class="lp-title-sub">${esc(subtitle)}</p>` : '') +
      `</div>`;

    const contentSlide = (g: Group) => {
      const bodyWrap = document.createElement('div');
      bodyWrap.className = 'lp-body';
      g.nodes.forEach((n) => bodyWrap.appendChild(n.cloneNode(true)));
      const head =
        g.title || g.subtitle
          ? `<div class="lp-head">` +
              (g.title ? `<h2 class="lp-title-main">${esc(g.title)}</h2>` : '') +
              (g.subtitle ? `<p class="lp-title-sub">${esc(g.subtitle)}</p>` : '') +
            `</div>`
          : '';
      return `<div class="lp-deck lp-content-slide">${head}${bodyWrap.outerHTML}</div>`;
    };

    const buildSlides = (body: HTMLElement, title: string, subtitle: string): string[] => {
      const out: string[] = [titleSlide(title, subtitle)];

      const children = Array.from(body.children) as HTMLElement[];
      // Author-controlled breaks take priority; otherwise auto-split by heading.
      const hasManualBreaks = children.some((n) => n.hasAttribute('data-slide-break'));

      const groups: Group[] = [];
      let cur: Group | null = null;
      const startGroup = (t: string, s: string): Group => {
        const g: Group = { title: t || '', subtitle: s || '', nodes: [] };
        groups.push(g);
        cur = g;
        return g;
      };

      children.forEach((node) => {
        if (hasManualBreaks) {
          if (node.hasAttribute('data-slide-break')) {
            startGroup(node.dataset.slideTitle || '', node.dataset.slideSubtitle || '');
            return; // the marker itself is not rendered
          }
        } else {
          const tag = node.tagName;
          if (tag === 'H1' || tag === 'H2' || tag === 'H3') {
            startGroup(node.textContent || '', ''); // heading becomes the slide title
            return; // exclude the heading from the body
          }
        }
        (cur ?? startGroup('', '')).nodes.push(node);
      });

      groups.forEach((g) => {
        if (!g.title && !g.subtitle && g.nodes.length === 0) return;
        out.push(contentSlide(g));
      });
      return out;
    };

    const render = () => {
      const slide = $('lp-slide');
      const total = slides.length;
      if (!slide || !total) return;
      index = Math.max(0, Math.min(index, total - 1));
      slide.innerHTML = slides[index];
      slide.scrollTop = 0;
      const counter = $('lp-counter');
      if (counter) counter.textContent = `${index + 1} / ${total}`;
      const progress = $('lp-progress');
      if (progress) progress.style.width = `${((index + 1) / total) * 100}%`;
    };

    const go = (delta: number) => { index += delta; render(); };

    const open = (body: HTMLElement, title: string, subtitle: string, context: string) => {
      slides = buildSlides(body, title, subtitle);
      index = 0;
      const titleEl = $('lp-title');
      if (titleEl) titleEl.textContent = title;
      const ctxEl = $('lp-context');
      if (ctxEl) ctxEl.textContent = context || '';
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      render();
      p.requestFullscreen?.().catch(() => {});
    };

    const close = () => {
      const p = $('lecture-presenter');
      if (!p) return;
      p.classList.add('hidden');
      document.body.style.overflow = '';
      if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
    };

    const isOpen = () => {
      const p = $('lecture-presenter');
      return p && !p.classList.contains('hidden');
    };

    // --- Delegated triggers (survive View Transitions) ---
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const presentBtn = target.closest('.lecture-present-btn');
      if (presentBtn) {
        const block = presentBtn.closest('.lecture-block') as HTMLElement | null;
        const bodyEl = block?.querySelector('.lecture-body') as HTMLElement | null;
        if (block && bodyEl) {
          open(
            bodyEl,
            block.dataset.lectureTitle || document.title,
            block.dataset.lectureSubtitle || '',
            block.dataset.lectureContext || ''
          );
        }
        return;
      }

      const printBtn = target.closest('.lecture-print-btn');
      if (printBtn) {
        const block = printBtn.closest('.lecture-block') as HTMLElement | null;
        if (!block) return;
        document.body.classList.add('printing-lecture');
        block.classList.add('print-target');
        const cleanup = () => {
          document.body.classList.remove('printing-lecture');
          block.classList.remove('print-target');
          window.removeEventListener('afterprint', cleanup);
        };
        window.addEventListener('afterprint', cleanup);
        window.print();
        return;
      }

      if (!isOpen()) return;
      if (target.closest('#lp-exit')) return close();
      if (target.closest('#lp-next') || target.closest('#lp-zone-next')) return go(1);
      if (target.closest('#lp-prev') || target.closest('#lp-zone-prev')) return go(-1);
      if (target.closest('#lp-fs')) {
        const p = $('lecture-presenter');
        if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
        else p?.requestFullscreen?.().catch(() => {});
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      switch (e.key) {
        case 'ArrowRight':
        case 'PageDown':
        case ' ':
          e.preventDefault(); go(1); break;
        case 'ArrowLeft':
        case 'PageUp':
          e.preventDefault(); go(-1); break;
        case 'Home':
          e.preventDefault(); index = 0; render(); break;
        case 'End':
          e.preventDefault(); index = slides.length - 1; render(); break;
        case 'Escape':
          e.preventDefault(); close(); break;
        case 'f':
        case 'F':
          e.preventDefault();
          if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
          else $('lecture-presenter')?.requestFullscreen?.().catch(() => {});
          break;
      }
    });
  };

  initLecturePresenter();
  document.addEventListener('astro:page-load', initLecturePresenter);
</script>
