---
const { node } = Astro.props;
const variant = node?.variant ?? 'line';
---

{
  variant === 'dots' ? (
    <div class="my-10 flex justify-center gap-3 text-foreground-muted" aria-hidden="true">
      <span>&bull;</span>
      <span>&bull;</span>
      <span>&bull;</span>
    </div>
  ) : (
    <hr class="my-10 border-t border-border" />
  )
}
