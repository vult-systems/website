---
import { urlFor, fileUrlFor } from '@/lib/sanity/image';

const { node } = Astro.props;

// Prefer an uploaded Sanity file; fall back to an external direct-model URL.
const src = fileUrlFor(node?.file?.asset?._ref) ?? node?.url;
const poster = node?.poster
  ? urlFor(node.poster).width(1600).auto('format').url()
  : undefined;
const alt = node?.alt ?? node?.caption ?? '3D model';
const cameraControls = node?.cameraControls !== false;
const aspect = node?.aspect ?? 'auto';
const align = node?.align ?? 'center';
const startOrbit = node?.startOrbit as string | undefined;

const autoLabel = node?.autoLabelParts === true;
// Spinning labels are hard to read, so auto-labelled models don't auto-rotate.
const autoRotate = node?.autoRotate !== false && !autoLabel;

// Live Loop-subdivision smoothing, in place of pre-smoothing before export.
const subdivRaw = node?.subdivisionLevel as string | undefined;
const subdivLevel = subdivRaw && subdivRaw !== 'off' ? Number(subdivRaw) : 0;

interface LabelOverride {
  mesh?: string;
  label?: string;
  description?: string;
  hide?: boolean;
}
// Keyed by lowercase mesh name for the runtime labeller.
const overrides: Record<string, { label?: string; description?: string; hide?: boolean }> = {};
for (const o of (node?.labelOverrides ?? []) as LabelOverride[]) {
  if (o?.mesh) overrides[o.mesh.trim().toLowerCase()] = { label: o.label, description: o.description, hide: o.hide };
}
const overridesJson = JSON.stringify(overrides);
---

{
  src && (
    <figure class="my-8" data-align={align}>
      <div class="model-viewer-frame" data-aspect={aspect}>
        <model-viewer
          src={src}
          poster={poster}
          alt={alt}
          data-autolabel={autoLabel ? '' : undefined}
          data-overrides={autoLabel ? overridesJson : undefined}
          data-subdiv={subdivLevel > 0 ? subdivLevel : undefined}
          camera-orbit={startOrbit}
          camera-controls={cameraControls ? '' : undefined}
          auto-rotate={autoRotate ? '' : undefined}
          touch-action="pan-y"
          loading="eager"
          reveal="auto"
          shadow-intensity="1"
          exposure="1.1"
          interaction-prompt="none"
          class="model-viewer rounded-lg bg-black/[0.04] dark:bg-white/[0.04]"
        >
          <div slot="poster" class="model-viewer-loading">Loading 3D model…</div>
          <div class="mv-cube" role="group" aria-label="Camera views">
            <div class="mv-cube__box">
              <button type="button" class="mv-cube__face mv-cube__face--front" data-orbit="0deg 90deg auto" aria-label="Front view">Front</button>
              <button type="button" class="mv-cube__face mv-cube__face--back" data-orbit="180deg 90deg auto" aria-label="Back view">Back</button>
              <button type="button" class="mv-cube__face mv-cube__face--right" data-orbit="90deg 90deg auto" aria-label="Right view">Right</button>
              <button type="button" class="mv-cube__face mv-cube__face--left" data-orbit="-90deg 90deg auto" aria-label="Left view">Left</button>
              <button type="button" class="mv-cube__face mv-cube__face--top" data-orbit="0deg 2deg auto" aria-label="Top view">Top</button>
              <button type="button" class="mv-cube__face mv-cube__face--bottom" data-orbit="0deg 178deg auto" aria-label="Bottom view">Bottom</button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fr" data-orbit="45deg 60deg auto" aria-label="Front-right-top view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fl" data-orbit="-45deg 60deg auto" aria-label="Front-left-top view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--br" data-orbit="135deg 60deg auto" aria-label="Back-right-top view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--bl" data-orbit="-135deg 60deg auto" aria-label="Back-left-top view"></button>
            </div>
          </div>
        </model-viewer>
      </div>
      {node?.caption && (
        <figcaption class="mt-3 text-sm text-foreground-secondary text-center">
          {node.caption}
        </figcaption>
      )}
    </figure>
  )
}

<style>
  /* Sizing frame: fills the full width of whatever column it's in ("edge to
     edge") for every aspect, including square/portrait. Ratios are locked
     with the padding-top trick rather than the CSS `aspect-ratio` property —
     <model-viewer> is a custom element, and on it `aspect-ratio` only
     resolves correctly when deriving *width* from an explicit height; going
     the other way (explicit width, auto height) silently collapses to the
     browser's ~150px replaced-element fallback instead of the real ratio.
     Padding-top is plain percentage-of-width math, so it isn't affected. */
  .model-viewer-frame {
    position: relative;
    width: 100%;
  }
  .model-viewer-frame[data-aspect='auto'] {
    height: min(70vh, 640px);
  }
  .model-viewer-frame[data-aspect='square'] {
    height: 0;
    padding-top: 100%;
    max-height: 85vh;
  }
  .model-viewer-frame[data-aspect='portrait'] {
    height: 0;
    padding-top: 133.333%; /* 3:4 */
    max-height: 85vh;
  }
  .model-viewer-frame[data-aspect='wide'] {
    height: 0;
    padding-top: 56.25%; /* 16:9 */
  }
  .model-viewer {
    display: block;
    --poster-color: transparent;
  }
  .model-viewer-frame[data-aspect='auto'] > .model-viewer {
    width: 100%;
    height: 100%;
  }
  .model-viewer-frame:not([data-aspect='auto']) > .model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .model-viewer-loading {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 0.875rem;
    color: var(--color-foreground-secondary, #888);
  }

  /* --- Orientation cube (Maya-style ViewCube): a real CSS-3D cube whose
     rotation is kept in sync with the model's camera orbit (see the
     camera-change listener in the script below), so it always shows which
     side of the model you're looking at. Faces/corners set the camera on
     click; the box itself is never the click target. --- */
  .mv-cube {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 64px;
    height: 64px;
    perspective: 280px;
  }
  .mv-cube__box {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.1s linear;
  }
  .mv-cube__face {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: inherit;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(30, 30, 30, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.28);
    cursor: pointer;
    backface-visibility: hidden;
  }
  .mv-cube__face:hover {
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .mv-cube__face--front {
    transform: translateZ(22px);
  }
  .mv-cube__face--back {
    transform: rotateY(180deg) translateZ(22px);
  }
  .mv-cube__face--right {
    transform: rotateY(90deg) translateZ(22px);
  }
  .mv-cube__face--left {
    transform: rotateY(-90deg) translateZ(22px);
  }
  .mv-cube__face--top {
    transform: rotateX(90deg) translateZ(22px);
  }
  .mv-cube__face--bottom {
    transform: rotateX(-90deg) translateZ(22px);
  }
  /* Top-corner shortcuts for quick 3/4 (isometric-ish) views. */
  .mv-cube__corner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 2px;
    padding: 0;
    background: rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.45);
    cursor: pointer;
  }
  .mv-cube__corner:hover {
    background: rgba(255, 255, 255, 0.6);
  }
  .mv-cube__corner--fr {
    transform: translate3d(22px, -22px, 22px);
  }
  .mv-cube__corner--fl {
    transform: translate3d(-22px, -22px, 22px);
  }
  .mv-cube__corner--br {
    transform: translate3d(22px, -22px, -22px);
  }
  .mv-cube__corner--bl {
    transform: translate3d(-22px, -22px, -22px);
  }

  /* --- Anatomy callouts: a dot at the part's center, a leader line at
     --mv-angle running out to length --mv-radius, and a name/description
     tag at the far end. Both custom properties are set per-hotspot in JS so
     labels fan out around the model instead of overlapping.
     :global() because these elements are created by the client script
     (document.createElement), so they never carry Astro's scoping
     attribute and a scoped selector would silently never match them. --- */
  :global(.mv-callout) {
    position: relative;
    width: 0;
    height: 0;
    border: 0;
    padding: 0;
    background: transparent;
    font-family: inherit;
    pointer-events: auto;
    cursor: default;
  }
  :global(.mv-callout__dot) {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #e11d48;
    box-shadow: 0 0 0 2px #fff, 0 0 4px rgba(0, 0, 0, 0.6);
    z-index: 1;
  }
  :global(.mv-callout__leader) {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--mv-radius, 80px);
    height: 0;
    border-top: 1.5px solid rgba(255, 255, 255, 0.9);
    transform-origin: left center;
    transform: rotate(var(--mv-angle, -38deg));
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  /* Positioned by rotating to --mv-angle, translating out along that ray,
     then un-rotating — moves the tag to the leader's endpoint while keeping
     its own text upright. The trailing translateY(-50%) centers it on that
     point regardless of angle. */
  :global(.mv-callout__tag) {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: rotate(var(--mv-angle, -38deg)) translate(calc(var(--mv-radius, 80px) + 8px))
      rotate(calc(-1 * var(--mv-angle, -38deg))) translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    max-width: 150px;
    background: rgba(17, 17, 17, 0.9);
    color: #fff;
    padding: 3px 9px;
    border-radius: 4px;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.45);
  }
  /* Labels on the model's left half anchor from their right edge so they
     read away from the leader line instead of running back over it. */
  :global(.mv-callout[data-side='left'] .mv-callout__tag) {
    align-items: flex-end;
    text-align: right;
    transform: rotate(var(--mv-angle, -38deg)) translate(calc(var(--mv-radius, 80px) + 8px))
      rotate(calc(-1 * var(--mv-angle, -38deg))) translate(-100%, -50%);
  }
  :global(.mv-callout__name) {
    white-space: nowrap;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  :global(.mv-callout__desc) {
    white-space: normal;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.3;
    opacity: 0.8;
  }
</style>

<script>
  // Registers the <model-viewer> custom element (self-contained, no CDN).
  import '@google/model-viewer';

  // Orientation cube: snap the camera to a preset view.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.mv-cube [data-orbit]');
    if (!btn) return;
    const mv = btn.closest('model-viewer') as any;
    const orbit = btn.getAttribute('data-orbit');
    if (mv && orbit) {
      mv.cameraOrbit = orbit;
      mv.jumpCameraToGoal?.();
    }
  });

  // Keep the cube's own rotation mirroring the model's camera orbit, so it
  // always reads as "which side am I looking at" rather than a static icon.
  function syncCube(mv: any) {
    const box = mv.querySelector('.mv-cube__box') as HTMLElement | null;
    if (!box || typeof mv.getCameraOrbit !== 'function') return;
    const { theta, phi } = mv.getCameraOrbit();
    const thetaDeg = (theta * 180) / Math.PI;
    const phiDeg = (phi * 180) / Math.PI;
    box.style.transform = `rotateX(${phiDeg - 90}deg) rotateY(${-thetaDeg}deg)`;
  }

  function wireCube(mv: any) {
    // A plain JS property, not a dataset attribute: Present mode clones
    // model-viewers with cloneNode(), which copies attributes but never
    // live event listeners — a dataset flag would wrongly tell a fresh
    // clone "already wired" and leave its cube dead with no camera sync.
    if (mv.__cubeWired) return;
    mv.__cubeWired = true;
    syncCube(mv);
    mv.addEventListener('camera-change', () => syncCube(mv));
    mv.addEventListener('load', () => syncCube(mv), { once: true });
  }

  // --- Live subdivision smoothing (replaces pre-smoothing before export) ---
  async function applySubdivision(mv: any) {
    const level = parseInt(mv.dataset.subdiv || '0', 10);
    if (!level || mv.__subdivided) return;
    const scene = findScene(mv);
    if (!scene?.target) return;
    // Instance property, not a dataset attribute — see the comment in
    // wireCube(). A cloned model-viewer loads its own fresh (unsubdivided)
    // Three.js scene and must go through this again independently.
    mv.__subdivided = true;

    // model-viewer finishes assigning each material's real color slightly
    // after the public 'load' event fires; swapping geometry before that
    // settles can leave the mesh stuck on an interim neutral-grey material.
    // Two animation frames reliably clears that window without a guessed
    // fixed delay.
    await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

    const { LoopSubdivision } = await import('three-subdivide');
    scene.target.traverse((obj: any) => {
      // model-viewer's own internal helpers (shadow catcher, camera gizmo)
      // live as unnamed siblings of the actual glTF scene under `target`;
      // real exported meshes are essentially always named, so skip anonymous
      // ones rather than subdividing engine internals.
      if (!obj.isMesh || !obj.geometry || !obj.name) return;
      try {
        const smoothed = LoopSubdivision.modify(obj.geometry, level, {
          split: true,
          // Skip meshes that are already dense (e.g. a raw sculpt export)
          // rather than exploding into millions of triangles.
          maxTriangles: 20000,
        });
        obj.geometry.dispose();
        obj.geometry = smoothed;
      } catch {
        // Leave this mesh's original geometry if subdivision fails on it.
      }
    });
    scene.queueRender?.();
  }

  // --- Runtime auto-labelling from the model's own named meshes ---
  const SKIP = /^(scene|rootnode|armature|root|node\d*|mesh\d*|object\d*|group\d*|primitive\d*)$/i;
  const clean = (n: string) => n.replace(/[_.]+/g, ' ').replace(/\s+/g, ' ').trim();
  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // model-viewer keeps its three.js scene on a private symbol; find it.
  function findScene(mv: any) {
    for (const s of Object.getOwnPropertySymbols(mv)) {
      const v = mv[s];
      if (v && typeof v.forHotspots === 'function' && v.target) return v;
    }
    return null;
  }

  async function labelModel(mv: any) {
    if (mv.dataset.autolabelled) return;
    const scene = findScene(mv);
    if (!scene?.target) return;
    mv.dataset.autolabelled = '1';

    // three is loaded lazily so it can never block model-viewer from loading.
    const THREE = await import('three');
    const target = scene.target;
    target.updateWorldMatrix(true, true);
    const inv = new THREE.Matrix4().copy(target.matrixWorld).invert();
    const toLocal = (v: any) => v.clone().applyMatrix4(inv);
    const center = toLocal(new THREE.Box3().setFromObject(target).getCenter(new THREE.Vector3()));

    let overrides: Record<string, any> = {};
    try {
      overrides = JSON.parse(mv.dataset.overrides || '{}');
    } catch {}

    const seen = new Set<string>();
    const parts: { name: string; c: any }[] = [];
    target.traverse((obj: any) => {
      if (obj === target) return;
      const name = (obj.name || '').trim();
      if (!name || SKIP.test(name) || seen.has(name)) return;
      const meshyChildren = (obj.children || []).filter(
        (c: any) => c.isMesh || (c.children || []).some((g: any) => g.isMesh)
      );
      if (!obj.isMesh && meshyChildren.length === 0) return; // no mesh content at all
      // A group wrapping several independent meshy children is an umbrella
      // (e.g. the exporter's own root node) rather than a single named part.
      if (!obj.isMesh && meshyChildren.length > 1) return;
      const box = new THREE.Box3().setFromObject(obj);
      if (box.isEmpty()) return;
      seen.add(name);
      parts.push({ name, c: toLocal(box.getCenter(new THREE.Vector3())) });
    });

    const visible = parts
      .slice(0, 80)
      .map((p) => ({ ...p, ov: overrides[p.name.toLowerCase()] || {} }))
      .filter((p) => !p.ov.hide);
    if (!visible.length) return;

    // Direction from the model's center to each part, flattened to screen
    // space (3D up is screen -y; depth is dropped). Auto-labelled models
    // hold a fixed camera angle instead of auto-rotating, so this is a
    // reasonable stand-in for a true camera-space projection.
    const angleOf = (p: (typeof visible)[number]) => {
      const dx = p.c.x - center.x;
      const dy = p.c.y - center.y;
      const a = (Math.atan2(-dy, dx) * 180) / Math.PI;
      return a < 0 ? a + 360 : a;
    };
    const angDist = (a: number, b: number) => {
      const d = Math.abs(a - b) % 360;
      return d > 180 ? 360 - d : d;
    };

    // Fan labels out to evenly-spaced slots around the model so nearby
    // parts never stack their tags on top of each other, assigning each
    // part the free slot closest to its own natural direction.
    const n = visible.length;
    const slotOffset = 360 / n / 2;
    const slots = Array.from({ length: n }, (_, i) => (360 / n) * i + slotOffset);
    const slotUsed = new Array(n).fill(false);
    const finalAngle: number[] = new Array(n);
    visible
      .map((p, idx) => ({ idx, angle: angleOf(p) }))
      .sort((a, b) => a.angle - b.angle)
      .forEach(({ idx, angle }) => {
        let best = 0;
        let bestDist = Infinity;
        for (let s = 0; s < n; s++) {
          if (slotUsed[s]) continue;
          const d = angDist(angle, slots[s]);
          if (d < bestDist) {
            bestDist = d;
            best = s;
          }
        }
        slotUsed[best] = true;
        finalAngle[idx] = slots[best];
      });

    const rect = mv.getBoundingClientRect();
    // Leave room for the tag itself (~150px wide) plus the leader's own gap,
    // so labels land inside the viewer instead of running off its edge.
    const radius = Math.round(Math.max(40, Math.min(rect.width, rect.height) * 0.32 - 110));

    visible.forEach((p, idx) => {
      const dx = p.c.x - center.x;
      const dy = p.c.y - center.y;
      const dz = p.c.z - center.z;
      const len = Math.hypot(dx, dy, dz) || 1;
      const angle = finalAngle[idx];
      const side = Math.cos((angle * Math.PI) / 180) >= 0 ? 'right' : 'left';

      const btn = document.createElement('button');
      btn.slot = `hotspot-auto-${idx + 1}`;
      btn.className = 'mv-callout';
      btn.dataset.side = side;
      btn.style.setProperty('--mv-angle', `${angle}deg`);
      btn.style.setProperty('--mv-radius', `${radius}px`);
      btn.dataset.position = `${p.c.x}m ${p.c.y}m ${p.c.z}m`;
      btn.dataset.normal = `${dx / len} ${dy / len} ${dz / len}`;

      const label = esc(p.ov.label || clean(p.name));
      const desc = p.ov.description ? esc(p.ov.description) : '';
      if (p.ov.description) btn.title = p.ov.description;
      btn.innerHTML =
        '<span class="mv-callout__dot"></span><span class="mv-callout__leader"></span>' +
        '<span class="mv-callout__tag">' +
        `<span class="mv-callout__name">${label}</span>` +
        (desc ? `<span class="mv-callout__desc">${desc}</span>` : '') +
        '</span>';
      mv.appendChild(btn);
    });
  }

  // Subdivision runs first since labelling measures mesh bounding boxes —
  // keeping the order means labels land on the final, smoothed geometry.
  async function onModelLoad(mv: any) {
    await applySubdivision(mv);
    if (mv.matches('[data-autolabel]')) await labelModel(mv);
  }

  function wireModel(mv: any) {
    if (mv.__modelWired) return;
    mv.__modelWired = true;
    wireCube(mv);
    if (mv.loaded) onModelLoad(mv);
    else mv.addEventListener('load', () => onModelLoad(mv), { once: true });
  }

  document.querySelectorAll('model-viewer').forEach((mv) => wireModel(mv as any));

  // Present mode (and other dynamic inserts) clone model-viewers in later.
  new MutationObserver((records) => {
    for (const r of records) {
      for (const n of r.addedNodes) {
        if (!(n instanceof HTMLElement)) continue;
        const added = n.matches?.('model-viewer') ? [n] : Array.from(n.querySelectorAll?.('model-viewer') ?? []);
        for (const mv of added) wireModel(mv);
      }
    }
  }).observe(document.body, { childList: true, subtree: true });
</script>
