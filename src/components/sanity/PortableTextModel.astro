---
import { urlFor, fileUrlFor } from '@/lib/sanity/image';

const { node } = Astro.props;

// Prefer an uploaded Sanity file; fall back to an external direct-model URL.
const src = fileUrlFor(node?.file?.asset?._ref) ?? node?.url;
const poster = node?.poster
  ? urlFor(node.poster).width(1600).auto('format').url()
  : undefined;
const alt = node?.alt ?? node?.caption ?? '3D model';
const cameraControls = node?.cameraControls !== false;
const aspect = node?.aspect ?? 'auto';
const align = node?.align ?? 'center';
// A preset dropdown in Sanity now; only ever "" (default) or a real
// "Ndeg Ndeg auto"-style value. The trimmed-string check also guards against
// stray free-text left over from before it was a dropdown (an invalid
// camera-orbit string breaks the whole viewer, not just the start angle).
const startOrbitRaw = (node?.startOrbit as string | undefined)?.trim();
const startOrbit = startOrbitRaw && /^-?\d+(\.\d+)?deg\s+-?\d+(\.\d+)?deg\s+\S+$/.test(startOrbitRaw)
  ? startOrbitRaw
  : undefined;

const autoLabel = node?.autoLabelParts === true;
// Spinning labels are hard to read, so auto-labelled models don't auto-rotate.
const autoRotate = node?.autoRotate !== false && !autoLabel;

// glTF has no hemisphere-light concept; a custom HDR drives IBL instead.
const envImage = fileUrlFor(node?.environmentImage?.asset?._ref);
const wireframeDefault = node?.wireframeDefault === true;

// Matches the rich-text editor's color palette (src/styles/globals.css
// .lecture-clr-*) so callouts read as part of the same color system.
const CALLOUT_COLORS: Record<string, string> = {
  accent: 'hsl(var(--accent))',
  blue: '#2f6fed',
  red: '#d92d20',
  gold: '#c98a00',
  green: '#2e9e4f',
  muted: 'hsl(var(--foreground-secondary))',
};
const calloutColor = CALLOUT_COLORS[node?.calloutColor as string] ?? CALLOUT_COLORS.blue;

interface LabelOverride {
  mesh?: string;
  label?: string;
  description?: string;
  hide?: boolean;
}
// Keyed by lowercase mesh name for the runtime labeller.
const overrides: Record<string, { label?: string; description?: string; hide?: boolean }> = {};
for (const o of (node?.labelOverrides ?? []) as LabelOverride[]) {
  if (o?.mesh) overrides[o.mesh.trim().toLowerCase()] = { label: o.label, description: o.description, hide: o.hide };
}
const overridesJson = JSON.stringify(overrides);
---

{
  src && (
    <figure id={node?._key ? `pt-${node._key}` : undefined} class="my-8" data-align={align}>
      <div class="model-viewer-frame" data-aspect={aspect}>
        <model-viewer
          src={src}
          poster={poster}
          alt={alt}
          data-autolabel={autoLabel ? '' : undefined}
          data-overrides={autoLabel ? overridesJson : undefined}
          environment-image={envImage}
          camera-orbit={startOrbit}
          max-camera-orbit="auto auto 300%"
          camera-controls={cameraControls ? '' : undefined}
          auto-rotate={autoRotate ? '' : undefined}
          touch-action="pan-y"
          loading="eager"
          reveal="auto"
          shadow-intensity="1"
          exposure="1.1"
          interaction-prompt="none"
          class="model-viewer rounded-lg bg-background"
          style={`--mv-callout-color:${calloutColor}`}
        >
          <div slot="poster" class="model-viewer-loading">Loading 3D model…</div>
          <button
            type="button"
            class="mv-wireframe-toggle"
            aria-pressed={wireframeDefault ? 'true' : 'false'}
            aria-label="Toggle wireframe overlay"
            title="Toggle wireframe"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
              <path d="M12 2v20M3 7l9 5 9-5M3 17l9-5 9 5" />
            </svg>
          </button>
          <div class="mv-hdri-control">
            <label class="mv-hdri-row" title="Environment light intensity">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77" />
              </svg>
              <input
                type="range"
                class="mv-hdri-exposure"
                min="0"
                max="2"
                step="0.05"
                value="1.1"
                aria-label="Environment light intensity"
              />
            </label>
            <span class="mv-hdri-divider"></span>
            <label class="mv-hdri-row" title="Environment rotation">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 1 3.5 7.14" />
                <path d="M3 5v6h6" />
              </svg>
              <input
                type="range"
                class="mv-hdri-rotation"
                min="0"
                max="360"
                step="1"
                value="0"
                aria-label="Environment rotation"
              />
            </label>
          </div>
          <div class="mv-cube" role="group" aria-label="Camera views">
            <div class="mv-cube__box">
              <button type="button" class="mv-cube__face mv-cube__face--front" data-orbit="0deg 90deg auto" aria-label="Front view">Front</button>
              <button type="button" class="mv-cube__face mv-cube__face--back" data-orbit="180deg 90deg auto" aria-label="Back view">Back</button>
              <button type="button" class="mv-cube__face mv-cube__face--right" data-orbit="90deg 90deg auto" aria-label="Right view">Right</button>
              <button type="button" class="mv-cube__face mv-cube__face--left" data-orbit="-90deg 90deg auto" aria-label="Left view">Left</button>
              <button type="button" class="mv-cube__face mv-cube__face--top" data-orbit="0deg 2deg auto" aria-label="Top view">Top</button>
              <button type="button" class="mv-cube__face mv-cube__face--bottom" data-orbit="0deg 178deg auto" aria-label="Bottom view">Bottom</button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fr" data-orbit="45deg 60deg auto" aria-label="Front-right, upper view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fl" data-orbit="-45deg 60deg auto" aria-label="Front-left, upper view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--br" data-orbit="135deg 60deg auto" aria-label="Back-right, upper view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--bl" data-orbit="-135deg 60deg auto" aria-label="Back-left, upper view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fr-mid" data-orbit="45deg 90deg auto" aria-label="Front-right view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fl-mid" data-orbit="-45deg 90deg auto" aria-label="Front-left view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--br-mid" data-orbit="135deg 90deg auto" aria-label="Back-right view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--bl-mid" data-orbit="-135deg 90deg auto" aria-label="Back-left view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fr-bot" data-orbit="45deg 120deg auto" aria-label="Front-right, lower view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--fl-bot" data-orbit="-45deg 120deg auto" aria-label="Front-left, lower view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--br-bot" data-orbit="135deg 120deg auto" aria-label="Back-right, lower view"></button>
              <button type="button" class="mv-cube__corner mv-cube__corner--bl-bot" data-orbit="-135deg 120deg auto" aria-label="Back-left, lower view"></button>
            </div>
          </div>
          <svg class="mv-logo" width="26" height="23" viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M46.5 59L0 86L49 0L46.5 59Z" fill="#E22B25" />
            <path d="M52 59L51.0004 1.99994L99.5002 86.5L52 59Z" fill="#2282DF" />
            <path d="M50.5 61.5L99.3297 89.0673L1.90061 88.8194L50.5 61.5Z" fill="#F2C923" />
          </svg>
          <button type="button" class="mv-fullscreen-toggle" aria-pressed="false" aria-label="Toggle fullscreen" title="Fullscreen">
            <svg class="mv-fs-icon-expand" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3" />
            </svg>
            <svg class="mv-fs-icon-compress" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M9 3v3a2 2 0 0 1-2 2H4M15 3v3a2 2 0 0 0 2 2h3M21 15h-3a2 2 0 0 0-2 2v3M3 15h3a2 2 0 0 1 2 2v3" />
            </svg>
          </button>
        </model-viewer>
      </div>
      {node?.caption && (
        <figcaption class="mt-3 text-sm text-foreground-secondary text-center">
          {node.caption}
        </figcaption>
      )}
    </figure>
  )
}

<style>
  /* Sizing frame: fills the full width of whatever column it's in ("edge to
     edge") for every aspect, including square/portrait. Ratios are locked
     with the padding-top trick rather than the CSS `aspect-ratio` property —
     <model-viewer> is a custom element, and on it `aspect-ratio` only
     resolves correctly when deriving *width* from an explicit height; going
     the other way (explicit width, auto height) silently collapses to the
     browser's ~150px replaced-element fallback instead of the real ratio.
     Padding-top is plain percentage-of-width math, so it isn't affected. */
  .model-viewer-frame {
    position: relative;
    width: 100%;
  }
  .model-viewer-frame[data-aspect='auto'] {
    height: min(70vh, 640px);
  }
  .model-viewer-frame[data-aspect='square'] {
    height: 0;
    padding-top: 100%;
    max-height: 85vh;
  }
  .model-viewer-frame[data-aspect='portrait'] {
    height: 0;
    padding-top: 133.333%; /* 3:4 */
    max-height: 85vh;
  }
  .model-viewer-frame[data-aspect='wide'] {
    height: 0;
    padding-top: 56.25%; /* 16:9 */
  }
  .model-viewer {
    display: block;
    --poster-color: transparent;
  }
  /* Always absolutely fills its frame — same rule for every aspect,
     including auto, so anything overriding .model-viewer-frame's own size
     (e.g. Present mode) only has to change the frame, not this too. */
  .model-viewer-frame > .model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .model-viewer-loading {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 0.875rem;
    color: var(--color-foreground-secondary, #888);
  }

  /* --- Orientation cube (Maya-style ViewCube): a real CSS-3D cube whose
     rotation is kept in sync with the model's camera orbit (see the
     camera-change listener in the script below), so it always shows which
     side of the model you're looking at. Faces/corners set the camera on
     click; the box itself is never the click target. --- */
  .mv-cube {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 64px;
    height: 64px;
    perspective: 280px;
    /* Hidden until syncCube() has real camera data to draw (see the script
       below) — otherwise it flashes its default, meaningless orientation
       for however long the model takes to load before snapping to the
       real one, which reads as a glitch rather than a load state. */
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mv-cube--ready {
    opacity: 1;
  }
  .mv-cube__box {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.1s linear;
  }
  .mv-cube__face {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: inherit;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(30, 30, 30, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.28);
    cursor: pointer;
    backface-visibility: hidden;
  }
  .mv-cube__face:hover {
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .mv-cube__face--front {
    transform: translateZ(22px);
  }
  .mv-cube__face--back {
    transform: rotateY(180deg) translateZ(22px);
  }
  .mv-cube__face--right {
    transform: rotateY(90deg) translateZ(22px);
  }
  .mv-cube__face--left {
    transform: rotateY(-90deg) translateZ(22px);
  }
  .mv-cube__face--top {
    transform: rotateX(90deg) translateZ(22px);
  }
  .mv-cube__face--bottom {
    transform: rotateX(-90deg) translateZ(22px);
  }
  /* Corner/edge shortcuts: 4 upper, 4 mid-height, 4 lower — a fuller ring of
     3/4 views around the cube than just the top corners. */
  .mv-cube__corner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 2px;
    padding: 0;
    /* Same dark-chip treatment as the faces, not translucent white — white
       on white/light backgrounds (light mode canvas) was nearly invisible. */
    background: rgba(30, 30, 30, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.55);
    cursor: pointer;
  }
  .mv-cube__corner:hover {
    background: rgba(0, 0, 0, 0.9);
    border-color: #fff;
  }
  .mv-cube__corner--fr {
    transform: translate3d(22px, -22px, 22px);
  }
  .mv-cube__corner--fl {
    transform: translate3d(-22px, -22px, 22px);
  }
  .mv-cube__corner--br {
    transform: translate3d(22px, -22px, -22px);
  }
  .mv-cube__corner--bl {
    transform: translate3d(-22px, -22px, -22px);
  }
  .mv-cube__corner--fr-mid {
    transform: translate3d(22px, 0, 22px);
  }
  .mv-cube__corner--fl-mid {
    transform: translate3d(-22px, 0, 22px);
  }
  .mv-cube__corner--br-mid {
    transform: translate3d(22px, 0, -22px);
  }
  .mv-cube__corner--bl-mid {
    transform: translate3d(-22px, 0, -22px);
  }
  .mv-cube__corner--fr-bot {
    transform: translate3d(22px, 22px, 22px);
  }
  .mv-cube__corner--fl-bot {
    transform: translate3d(-22px, 22px, 22px);
  }
  .mv-cube__corner--br-bot {
    transform: translate3d(22px, 22px, -22px);
  }
  .mv-cube__corner--bl-bot {
    transform: translate3d(-22px, 22px, -22px);
  }

  /* --- Wireframe toggle: mirrors the cube's corner (top-left instead of
     top-right) so the two controls don't crowd each other. --- */
  .mv-wireframe-toggle {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(30, 30, 30, 0.82);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
  }
  .mv-wireframe-toggle:hover {
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .mv-wireframe-toggle[aria-pressed='true'] {
    background: hsl(var(--accent));
    border-color: hsl(var(--accent));
    color: #fff;
  }

  /* --- HDRI controls (intensity + rotation), sitting right next to the
     wireframe toggle. Side-by-side in one row rather than stacked — that
     gave each control so little width the icon and thumb had to be tiny
     to fit; one row trades unused vertical space for room to size both
     properly. --- */
  .mv-hdri-control {
    position: absolute;
    top: 10px;
    left: 44px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 9px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(30, 30, 30, 0.82);
  }
  .mv-hdri-row {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }
  .mv-hdri-row svg {
    flex: none;
  }
  .mv-hdri-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.22);
  }
  /* Fully custom track + thumb rather than relying on accent-color, which
     only recolors the browser's default thumb — on most platforms that
     default is quite large and looked out of place in this compact chip. */
  .mv-hdri-exposure,
  .mv-hdri-rotation {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 44px;
    height: 10px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .mv-hdri-exposure::-webkit-slider-runnable-track,
  .mv-hdri-rotation::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
  }
  .mv-hdri-exposure::-moz-range-track,
  .mv-hdri-rotation::-moz-range-track {
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
  }
  .mv-hdri-exposure::-webkit-slider-thumb,
  .mv-hdri-rotation::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid rgba(0, 0, 0, 0.45);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  .mv-hdri-exposure::-moz-range-thumb,
  .mv-hdri-rotation::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 1.5px solid rgba(0, 0, 0, 0.45);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  /* --- Brand mark, bottom-left (matches the Present-mode slide master) --- */
  .mv-logo {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    opacity: 0.6;
    pointer-events: none;
  }

  /* --- Fullscreen toggle, bottom-right --- */
  .mv-fullscreen-toggle {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(30, 30, 30, 0.82);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
  }
  .mv-fullscreen-toggle:hover {
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .mv-fullscreen-toggle .mv-fs-icon-compress {
    display: none;
  }
  .mv-fullscreen-toggle[aria-pressed='true'] .mv-fs-icon-expand {
    display: none;
  }
  .mv-fullscreen-toggle[aria-pressed='true'] .mv-fs-icon-compress {
    display: block;
  }

  /* --- Anatomy callouts: a dot at the part's center, a leader line at
     --mv-angle running out to length --mv-radius, and a name/description
     tag at the far end. Both custom properties are set per-hotspot in JS so
     labels fan out around the model instead of overlapping.
     :global() because these elements are created by the client script
     (document.createElement), so they never carry Astro's scoping
     attribute and a scoped selector would silently never match them. --- */
  :global(.mv-callout) {
    position: relative;
    width: 0;
    height: 0;
    border: 0;
    padding: 0;
    background: transparent;
    font-family: inherit;
    pointer-events: auto;
    cursor: default;
  }
  :global(.mv-callout__dot) {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--mv-callout-color, #2f6fed);
    box-shadow: 0 0 0 2px #fff, 0 0 4px rgba(0, 0, 0, 0.6);
    z-index: 1;
  }
  :global(.mv-callout__leader) {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--mv-radius, 80px);
    height: 0;
    border-top: 1px solid var(--mv-callout-color, #2f6fed);
    transform-origin: left center;
    transform: rotate(var(--mv-angle, -38deg));
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  /* Positioned by rotating to --mv-angle, translating out along that ray,
     then un-rotating — moves the tag to the leader's endpoint while keeping
     its own text upright. The trailing translateY(-50%) centers it on that
     point regardless of angle. */
  :global(.mv-callout__tag) {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: rotate(var(--mv-angle, -38deg)) translate(calc(var(--mv-radius, 80px) + 8px))
      rotate(calc(-1 * var(--mv-angle, -38deg))) translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    max-width: 150px;
    background: rgba(17, 17, 17, 0.9);
    color: #fff;
    padding: 3px 9px;
    border-radius: 4px;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.45);
  }
  /* Labels on the model's left half anchor from their right edge so they
     read away from the leader line instead of running back over it. */
  :global(.mv-callout[data-side='left'] .mv-callout__tag) {
    align-items: flex-end;
    text-align: right;
    transform: rotate(var(--mv-angle, -38deg)) translate(calc(var(--mv-radius, 80px) + 8px))
      rotate(calc(-1 * var(--mv-angle, -38deg))) translate(-100%, -50%);
  }
  :global(.mv-callout__name) {
    white-space: nowrap;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  :global(.mv-callout__desc) {
    white-space: normal;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.3;
    opacity: 0.8;
  }
</style>

<script>
  // The <model-viewer> import pulls in three.js and does real WebGL/GPU
  // work as soon as it registers the custom element — upgrading every
  // model-viewer already in the DOM, even ones below the fold. Deferred
  // behind an IntersectionObserver so it only loads once a model block is
  // actually about to be seen, instead of on every page load that happens
  // to contain one.
  function initModelViewer() {
    import('@google/model-viewer').then(() => {

    // Orientation cube: snap the camera to a preset view.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.mv-cube [data-orbit]');
      if (!btn) return;
      const mv = btn.closest('model-viewer') as any;
      const orbit = btn.getAttribute('data-orbit');
      if (mv && orbit) {
        // "auto" radius is model-viewer's bare-minimum bounding-sphere fit —
        // exactly snug at the model's single worst-case viewing angle, with
        // only whatever margin happens to fall out at every other angle. For
        // an asymmetric model (tall neurocranium + narrow splanchnocranium,
        // say) that worst case can be a plain front/back/top view, so those
        // snap points look noticeably tighter than others. Swap in our own
        // pre-measured, comfort-padded radius (see computeSnapRadius) so every
        // snap point gets the same breathing room, regardless of model shape.
        const radius = mv.__snapRadius ? `${mv.__snapRadius}m` : 'auto';
        mv.cameraOrbit = orbit.replace(/auto$/, radius);
        mv.jumpCameraToGoal?.();
      }
    });

    // Keep the cube's own rotation mirroring the model's camera orbit, so it
    // always reads as "which side am I looking at" rather than a static icon.
    function syncCube(mv: any) {
      const box = mv.querySelector('.mv-cube__box') as HTMLElement | null;
      if (!box || typeof mv.getCameraOrbit !== 'function') return;
      const { theta, phi } = mv.getCameraOrbit();
      const thetaDeg = (theta * 180) / Math.PI;
      const phiDeg = (phi * 180) / Math.PI;
      box.style.transform = `rotateX(${phiDeg - 90}deg) rotateY(${-thetaDeg}deg)`;
      // model-viewer fires 'camera-change' as soon as its controller
      // initializes — well before the actual glTF (and this model's real
      // starting orbit) has loaded — so only reveal once there's a loaded
      // model for the pose to actually correspond to.
      if (mv.loaded) mv.querySelector('.mv-cube')?.classList.add('mv-cube--ready');
    }

    function wireCube(mv: any) {
      // A plain JS property, not a dataset attribute: Present mode clones
      // model-viewers with cloneNode(), which copies attributes but never
      // live event listeners — a dataset flag would wrongly tell a fresh
      // clone "already wired" and leave its cube dead with no camera sync.
      if (mv.__cubeWired) return;
      mv.__cubeWired = true;
      // No eager syncCube() call here — getCameraOrbit() returns model-viewer's
      // generic idle default before the model has actually loaded, which isn't
      // this model's real starting angle. Drawing that default immediately just
      // shows a wrong pose that then visibly jumps once 'load' supplies the
      // real one; staying hidden (see .mv-cube's opacity in the style block)
      // until one of these listeners fires with real data avoids that.
      mv.addEventListener('camera-change', () => syncCube(mv));
      mv.addEventListener('load', () => syncCube(mv), { once: true });
    }

    // Wireframe overlay: edges drawn on top of the real, shaded material
    // rather than replacing it. Toggle just flips visibility of the overlay
    // meshes; building them happens once, in buildWireframeOverlay().
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.mv-wireframe-toggle');
      if (!btn) return;
      const mv = btn.closest('model-viewer') as any;
      if (!mv) return;
      const on = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(on));
      const scene = findScene(mv);
      scene?.target?.traverse((obj: any) => {
        if (obj.userData?.isWireframeOverlay) obj.visible = on;
      });
      scene?.queueRender?.();
    });

    // HDRI intensity slider: exposure is a plain model-viewer property, so
    // this needs no scene access at all.
    document.addEventListener('input', (e) => {
      const slider = (e.target as HTMLElement).closest('.mv-hdri-exposure') as HTMLInputElement | null;
      if (!slider) return;
      const mv = slider.closest('model-viewer') as any;
      if (!mv) return;
      mv.exposure = parseFloat(slider.value);
    });

    // HDRI rotation slider: unlike exposure, rotating the environment isn't a
    // model-viewer attribute — it's set directly on the underlying three.js
    // scene (a real Euler, in radians; the slider works in degrees).
    document.addEventListener('input', (e) => {
      const slider = (e.target as HTMLElement).closest('.mv-hdri-rotation') as HTMLInputElement | null;
      if (!slider) return;
      const mv = slider.closest('model-viewer') as any;
      const scene = mv && findScene(mv);
      if (!scene?.environmentRotation) return;
      scene.environmentRotation.y = (parseFloat(slider.value) * Math.PI) / 180;
      scene.queueRender?.();
    });

    // Fullscreen toggle: model-viewer resizes itself via its own internal
    // ResizeObserver, so entering/exiting fullscreen needs nothing from us
    // beyond calling the standard Fullscreen API on the element itself —
    // that keeps the cube/toggles/logo (all its light-DOM children) visible.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.mv-fullscreen-toggle');
      if (!btn) return;
      const mv = btn.closest('model-viewer') as any;
      if (!mv) return;
      if (document.fullscreenElement === mv) document.exitFullscreen?.();
      else mv.requestFullscreen?.();
    });
    document.addEventListener('fullscreenchange', () => {
      document.querySelectorAll('.mv-fullscreen-toggle').forEach((btn) => {
        const mv = btn.closest('model-viewer');
        btn.setAttribute('aria-pressed', String(document.fullscreenElement === mv));
      });
    });

    // Built from each named mesh's geometry, so it always shows the topology
    // as exported — the actual thing worth seeing for teaching purposes.
    async function buildWireframeOverlay(mv: any) {
      if (mv.__wireframeBuilt) return;
      const scene = findScene(mv);
      if (!scene?.target) return;
      mv.__wireframeBuilt = true; // instance property — see wireCube() comment

      const toggle = mv.querySelector('.mv-wireframe-toggle');
      const visible = toggle?.getAttribute('aria-pressed') === 'true';

      const THREE = await import('three');
      const meshes: any[] = [];
      scene.target.traverse((obj: any) => {
        if (obj.isMesh && obj.geometry && obj.name) meshes.push(obj);
      });
      for (const obj of meshes) {
        const wireGeom = new THREE.WireframeGeometry(obj.geometry);
        const wireMat = new THREE.LineBasicMaterial({
          color: 0x000000,
          transparent: true,
          opacity: 0.4,
          depthTest: true,
        });
        const overlay = new THREE.LineSegments(wireGeom, wireMat);
        overlay.userData.isWireframeOverlay = true;
        overlay.visible = visible;
        // Nudged slightly larger than the surface it traces, so the lines
        // don't z-fight with the shaded mesh underneath them.
        overlay.scale.setScalar(1.002);
        obj.add(overlay);
      }
      scene.queueRender?.();
    }

    // --- Runtime auto-labelling from the model's own named meshes ---
    const SKIP = /^(scene|rootnode|armature|root|node\d*|mesh\d*|object\d*|group\d*|primitive\d*)$/i;
    const clean = (n: string) => n.replace(/[_.]+/g, ' ').replace(/\s+/g, ' ').trim();
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // model-viewer keeps its three.js scene on a private symbol; find it.
    function findScene(mv: any) {
      for (const s of Object.getOwnPropertySymbols(mv)) {
        const v = mv[s];
        if (v && typeof v.forHotspots === 'function' && v.target) return v;
      }
      return null;
    }

    async function labelModel(mv: any) {
      if (mv.dataset.autolabelled) return;
      const scene = findScene(mv);
      if (!scene?.target) return;
      mv.dataset.autolabelled = '1';

      // three is loaded lazily so it can never block model-viewer from loading.
      const THREE = await import('three');
      const target = scene.target;
      target.updateWorldMatrix(true, true);
      const inv = new THREE.Matrix4().copy(target.matrixWorld).invert();
      const toLocal = (v: any) => v.clone().applyMatrix4(inv);
      const center = toLocal(new THREE.Box3().setFromObject(target).getCenter(new THREE.Vector3()));

      let overrides: Record<string, any> = {};
      try {
        overrides = JSON.parse(mv.dataset.overrides || '{}');
      } catch {}

      const seen = new Set<string>();
      const parts: { name: string; c: any }[] = [];
      target.traverse((obj: any) => {
        if (obj === target) return;
        const name = (obj.name || '').trim();
        if (!name || SKIP.test(name) || seen.has(name)) return;
        const meshyChildren = (obj.children || []).filter(
          (c: any) => c.isMesh || (c.children || []).some((g: any) => g.isMesh)
        );
        if (!obj.isMesh && meshyChildren.length === 0) return; // no mesh content at all
        // A group wrapping several independent meshy children is an umbrella
        // (e.g. the exporter's own root node) rather than a single named part.
        if (!obj.isMesh && meshyChildren.length > 1) return;
        const box = new THREE.Box3().setFromObject(obj);
        if (box.isEmpty()) return;
        seen.add(name);
        parts.push({ name, c: toLocal(box.getCenter(new THREE.Vector3())) });
      });

      const visible = parts
        .slice(0, 80)
        .map((p) => ({ ...p, ov: overrides[p.name.toLowerCase()] || {} }))
        .filter((p) => !p.ov.hide);
      if (!visible.length) return;

      // Direction from the model's center to each part, flattened to screen
      // space (3D up is screen -y; depth is dropped). Auto-labelled models
      // hold a fixed camera angle instead of auto-rotating, so this is a
      // reasonable stand-in for a true camera-space projection.
      const angleOf = (p: (typeof visible)[number]) => {
        const dx = p.c.x - center.x;
        const dy = p.c.y - center.y;
        const a = (Math.atan2(-dy, dx) * 180) / Math.PI;
        return a < 0 ? a + 360 : a;
      };
      const angDist = (a: number, b: number) => {
        const d = Math.abs(a - b) % 360;
        return d > 180 ? 360 - d : d;
      };

      // Fan labels out to evenly-spaced slots around the model so nearby
      // parts never stack their tags on top of each other, assigning each
      // part the free slot closest to its own natural direction. Slots start
      // at a fixed 45° rather than half a slot-width in: with an even part
      // count (2, 4, ...) that half-width offset lands exactly on 90/270 —
      // dead vertical leader lines. A 45° base keeps every line on a diagonal.
      const n = visible.length;
      const slots = Array.from({ length: n }, (_, i) => 45 + (360 / n) * i);
      const slotUsed = new Array(n).fill(false);
      const finalAngle: number[] = new Array(n);
      visible
        .map((p, idx) => ({ idx, angle: angleOf(p) }))
        .sort((a, b) => a.angle - b.angle)
        .forEach(({ idx, angle }) => {
          let best = 0;
          let bestDist = Infinity;
          for (let s = 0; s < n; s++) {
            if (slotUsed[s]) continue;
            const d = angDist(angle, slots[s]);
            if (d < bestDist) {
              bestDist = d;
              best = s;
            }
          }
          slotUsed[best] = true;
          finalAngle[idx] = slots[best];
        });

      const rect = mv.getBoundingClientRect();
      // Leave room for the tag itself (~150px wide) plus the leader's own gap,
      // so labels land inside the viewer instead of running off its edge —
      // model-viewer's shadow root clips anything outside its own box
      // (overflow: hidden), so "off its edge" means genuinely cut off, not
      // just visually crowded. Otherwise push labels out toward that edge
      // rather than hugging the model, so lines read against open space.
      const radius = Math.round(Math.max(65, Math.min(rect.width, rect.height) * 0.36 - 85));

      visible.forEach((p, idx) => {
        const dx = p.c.x - center.x;
        const dy = p.c.y - center.y;
        const dz = p.c.z - center.z;
        const len = Math.hypot(dx, dy, dz) || 1;
        const angle = finalAngle[idx];
        const side = Math.cos((angle * Math.PI) / 180) >= 0 ? 'right' : 'left';

        const btn = document.createElement('button');
        btn.slot = `hotspot-auto-${idx + 1}`;
        btn.className = 'mv-callout';
        btn.dataset.side = side;
        btn.style.setProperty('--mv-angle', `${angle}deg`);
        btn.style.setProperty('--mv-radius', `${radius}px`);
        btn.dataset.position = `${p.c.x}m ${p.c.y}m ${p.c.z}m`;
        btn.dataset.normal = `${dx / len} ${dy / len} ${dz / len}`;

        const label = esc(p.ov.label || clean(p.name));
        const desc = p.ov.description ? esc(p.ov.description) : '';
        if (p.ov.description) btn.title = p.ov.description;
        btn.innerHTML =
          '<span class="mv-callout__dot"></span><span class="mv-callout__leader"></span>' +
          '<span class="mv-callout__tag">' +
          `<span class="mv-callout__name">${label}</span>` +
          (desc ? `<span class="mv-callout__desc">${desc}</span>` : '') +
          '</span>';
        mv.appendChild(btn);
      });
    }

    // A comfort-padded version of model-viewer's own "auto" camera distance —
    // see the click handler above for why plain "auto" isn't enough on its
    // own. Reads the model's current bounding sphere, so it scales correctly
    // for whatever size a given imported model turns out to be, rather than
    // a distance tuned for one specific export.
    function computeSnapRadius(mv: any): number | null {
      const scene = findScene(mv);
      if (!scene?.boundingSphere || !scene.framedFoVDeg) return null;
      const halfFovRad = ((scene.framedFoVDeg / 2) * Math.PI) / 180;
      const ideal = scene.boundingSphere.radius / Math.sin(halfFovRad);
      return ideal * 1.15;
    }

    async function onModelLoad(mv: any) {
      // Re-frame with the padded radius immediately, before anything async
      // runs — model-viewer's own reveal fade hasn't happened yet at this
      // point, so the corrected framing is what fades in. Doing this later
      // meant the model would already be visible at the bare "auto" framing
      // and then visibly snap to the padded one — the "weird snap and pop"
      // the padding itself was supposed to fix.
      mv.__snapRadius = computeSnapRadius(mv);
      if (mv.__snapRadius) {
        const { theta, phi } = mv.getCameraOrbit();
        mv.cameraOrbit = `${(theta * 180) / Math.PI}deg ${(phi * 180) / Math.PI}deg ${mv.__snapRadius}m`;
        mv.jumpCameraToGoal?.();
      }

      await buildWireframeOverlay(mv);
      if (mv.matches('[data-autolabel]')) await labelModel(mv);
    }

    function wireModel(mv: any) {
      if (mv.__modelWired) return;
      mv.__modelWired = true;
      wireCube(mv);
      if (mv.loaded) onModelLoad(mv);
      else mv.addEventListener('load', () => onModelLoad(mv), { once: true });
    }

    document.querySelectorAll('model-viewer').forEach((mv) => wireModel(mv as any));

    // Present mode (and other dynamic inserts) clone model-viewers in later.
    new MutationObserver((records) => {
      for (const r of records) {
        for (const n of r.addedNodes) {
          if (!(n instanceof HTMLElement)) continue;
          const added = n.matches?.('model-viewer') ? [n] : Array.from(n.querySelectorAll?.('model-viewer') ?? []);
          for (const mv of added) wireModel(mv);
        }
      }
    }).observe(document.body, { childList: true, subtree: true });
    });
  }

  // IntersectionObserver fires its initial callback immediately for any
  // target that's already in view when observation starts, so this alone
  // correctly covers both "model is already visible on load" (no perceived
  // delay) and "model is offscreen, in a collapsed section, etc." (stays
  // dormant, unlike a plain getBoundingClientRect check which can't tell
  // "already visible" apart from "hidden" — both report a zero-ish rect).
  const frames = document.querySelectorAll<HTMLElement>('.model-viewer-frame');
  if (frames.length) {
    const io = new IntersectionObserver((entries, observer) => {
      if (entries.some((e) => e.isIntersecting)) {
        observer.disconnect();
        initModelViewer();
      }
    }, { rootMargin: '400px 0px' });
    frames.forEach((f) => io.observe(f));
  }
</script>
