---
// "Note" block style — a callout box, same visual language as the Learn
// page's WIP banner (border-accent/30 bg-accent/5). Registered as
// components.block.note in PortableText.astro; without that registration
// astro-portabletext falls back to its generic UnknownBlock (a bare <p>
// with no styling and a dev-console warning on every render).
---

<div class="lecture-note my-6 flex items-start gap-3 rounded-md border border-accent/30 bg-accent/5 px-4 py-3">
  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <line x1="12" y1="16" x2="12" y2="12" />
    <line x1="12" y1="8" x2="12.01" y2="8" />
  </svg>
  <p class="!my-0 text-sm text-foreground-secondary"><slot /></p>
</div>
