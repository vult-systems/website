---
// Presentation-only slide boundary; invisible in the reading view, read by the
// lecture presenter to decide where slides split and to title each slide.
const { node } = Astro.props;
---

<div
  class="lecture-slide-break"
  data-slide-break
  data-slide-title={node?.title}
  data-slide-subtitle={node?.subtitle}
  data-slide-layout={node?.layout}
  aria-hidden="true"
></div>
