---
import { urlFor } from '@/lib/sanity/image';

const { node } = Astro.props;

const src = urlFor(node).width(1200).auto('format').url();
const src2x = urlFor(node).width(2400).auto('format').url();
// Full-resolution source for the zoomable lightbox (clamped to the asset size).
const full = urlFor(node).width(3840).auto('format').url();

// Intrinsic size (from the asset ref `image-<hash>-<w>x<h>-<ext>`) to prevent layout shift.
const dims = (node?.asset?._ref as string | undefined)?.match(/-(\d+)x(\d+)-/);
const width = dims ? Number(dims[1]) : undefined;
const height = dims ? Number(dims[2]) : undefined;

const align = node?.align ?? 'center';

// Present mode (lecture-presenter.astro) builds its slides by reading the
// already-rendered .lecture-body DOM, not the raw Sanity body — so "hide on
// page" can't just skip rendering here, or the image would vanish from
// Present too. Instead it stays in the DOM but display:none in the page's
// own reading-view scope (see globals.css); Present clones nodes into a
// different container that scope doesn't reach, so it shows there
// normally. "Hide in Present" is the mirror case, handled by
// lecture-presenter.astro skipping any node carrying this attribute when
// it walks .lecture-body's children to build slide groups.
const hideOnPage = node?.hideOnPage === true;
const hideInPresent = node?.hideInPresent === true;
---

<figure
  id={node?._key ? `pt-${node._key}` : undefined}
  class="my-8 spotlight-card group relative"
  data-align={align}
  data-hide-on-page={hideOnPage ? 'true' : undefined}
  data-hide-in-present={hideInPresent ? 'true' : undefined}
>
  <div class="spotlight-inner rounded-lg overflow-hidden transition-all duration-300 group-hover:scale-[1.02]">
    <img
      src={src}
      srcset={`${src} 1200w, ${src2x} 2400w`}
      sizes="(max-width: 768px) 100vw, 1200px"
      width={width}
      height={height}
      data-full={full}
      alt={node?.alt ?? ''}
      class="w-full"
      loading="lazy"
      decoding="async"
    />
  </div>
  {
    node?.caption && (
      <figcaption class="mt-3 text-sm text-foreground-secondary text-center">
        {node.caption}
      </figcaption>
    )
  }
</figure>
