---
import { PortableText } from 'astro-portabletext';
import PortableTextFigure from './PortableTextFigure.astro';
import PortableTextLink from './PortableTextLink.astro';
import PortableTextDivider from './PortableTextDivider.astro';
import PortableTextHeading from './PortableTextHeading.astro';

interface Props {
  value: any;
}

const { value } = Astro.props;

const components = {
  type: {
    figure: PortableTextFigure,
    image: PortableTextFigure,
    divider: PortableTextDivider,
  },
  block: {
    h2: PortableTextHeading,
    h3: PortableTextHeading,
    h4: PortableTextHeading,
  },
  mark: {
    link: PortableTextLink,
  },
};
---

{value && <PortableText value={value} components={components} />}
