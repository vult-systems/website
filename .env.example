# Analytics Configuration
# Copy this file to .env and fill in your values
# Domain should match SITE.name in src/config/site.ts

# Analytics Provider
# Options: 'ga4' | 'plausible' | 'fathom' | 'umami' | 'none'
PUBLIC_ANALYTICS_PROVIDER=none

# Tracking ID (required for most providers)
# GA4: G-XXXXXXXXXX
# Plausible: (not needed, uses domain)
# Fathom: XXXXXXXX
# Umami: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_ANALYTICS_ID=

# Domain (for Plausible) - Should match SITE.name in src/config/site.ts
PUBLIC_ANALYTICS_DOMAIN=carlosgarcia.works

# Umami Script URL (if self-hosted)
# PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js

# -----------------------------------------------------------------------------
# Sanity CMS (Courses, Pipeline & Log content)
# -----------------------------------------------------------------------------
# Get these after creating a free project at https://www.sanity.io/manage
# When PUBLIC_SANITY_PROJECT_ID is set, the site switches to hybrid SSR (Vercel)
# so pages can read live from Sanity. When empty, the site builds fully static.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Same values under the names the Sanity CLI (studio:dev/build/deploy) reads:
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# -----------------------------------------------------------------------------
# Visual editing (Sanity Presentation) - /learn only
# -----------------------------------------------------------------------------
# Viewer-permission token from sanity.io/manage -> API -> Tokens.
# SERVER ONLY. Never rename this to PUBLIC_*: it can read unpublished content.
# Without it, /learn still works normally; only draft preview is disabled.
SANITY_API_READ_TOKEN=

# Where the Studio runs. Used to build the "edit this field" links that stega
# encodes into draft-mode responses.
#   local:  http://localhost:3333
#   hosted: https://carlosgarcia-works.sanity.studio
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Where Presentation points its preview iframe (read by the Sanity CLI).
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321/learn

